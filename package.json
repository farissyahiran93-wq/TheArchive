{
  "name": "the-archive-reboot",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader native",
    "build": "tsc -b && vite build --configLoader native",
    "typecheck": "tsc -b",
    "lint": "oxlint src tests",
    "test": "vitest run --configLoader native --pool threads",
    "test:e2e": "playwright test",
    "cap:sync": "npm run build && cap sync",
    "preview": "vite preview"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.3",
    "@capacitor/core": "8.4.3",
    "idb": "^8.0.4",
    "lucide-react": "^1.54.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@capacitor/cli": "8.4.3",
    "@playwright/test": "^1.64.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.2",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  }
}
