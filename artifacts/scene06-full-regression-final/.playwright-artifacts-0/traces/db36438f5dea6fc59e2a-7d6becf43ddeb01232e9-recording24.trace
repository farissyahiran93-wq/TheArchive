-22"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I understand."}},{"k":"read","v":{"b":false}}],"id":468},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-23"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Then why did you do it?"}},{"k":"read","v":{"b":false}}],"id":469},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-24"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Because I'm tired of sitting here doing nothing!"}},{"k":"read","v":{"b":false}}],"id":470},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-26"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Sorry."}},{"k":"read","v":{"b":false}}],"id":471},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-27"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I didn't mean to snap."}},{"k":"read","v":{"b":false}}],"id":472},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-28"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: It's okay."}},{"k":"read","v":{"b":false}}],"id":473},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-29"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: No, it's not."}},{"k":"read","v":{"b":false}}],"id":474},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-30"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Lucas..."}},{"k":"read","v":{"b":false}}],"id":475},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-31"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: We're making decisions because we're scared."}},{"k":"read","v":{"b":false}}],"id":476},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-32"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: And we don't even know what we're risking."}},{"k":"read","v":{"b":false}}],"id":477},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-33"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I know!"}},{"k":"read","v":{"b":false}}],"id":478},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-34"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Do you think I don't think about that?"}},{"k":"read","v":{"b":false}}],"id":479},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-35"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Then start acting like it."}},{"k":"read","v":{"b":false}}],"id":480},{"o":[{"k":"id","v":{"s":"OPEN-S02-C08-a-1"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: No."}},{"k":"read","v":{"b":false}}],"id":481},{"o":[{"k":"id","v":{"s":"OPEN-S02-C08-a-2"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: That's not what I want."}},{"k":"read","v":{"b":false}}],"id":482},{"o":[{"k":"id","v":{"s":"OPEN-S02-C08-a-3"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: And we haven't asked you to leave."}},{"k":"read","v":{"b":false}}],"id":483},{"o":[{"k":"id","v":{"s":"OPEN-S02-C08-a-4"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: I might."}},{"k":"read","v":{"b":false}}],"id":484},{"o":[{"k":"id","v":{"s":"OPEN-S02-C08-a-5"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Lucas."}},{"k":"read","v":{"b":false}}],"id":485},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-2"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Fine."}},{"k":"read","v":{"b":false}}],"id":486},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-3"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: What do you want me to do?"}},{"k":"read","v":{"b":false}}],"id":487},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-4"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: I want us to stop sharing things until we know who we're sharing them with."}},{"k":"read","v":{"b":false}}],"id":488},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-5"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: That seems reasonable."}},{"k":"read","v":{"b":false}}],"id":489},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-6"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: So what?"}},{"k":"read","v":{"b":false}}],"id":490},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-7"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: We just ignore the number?"}},{"k":"read","v":{"b":false}}],"id":491},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-8"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: No."}},{"k":"read","v":{"b":false}}],"id":492},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-9"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: We verify it."}},{"k":"read","v":{"b":false}}],"id":493},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-10"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: How?"}},{"k":"read","v":{"b":false}}],"id":494},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-11"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: I don't know yet."}},{"k":"read","v":{"b":false}}],"id":495},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-12"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Exactly."}},{"k":"read","v":{"b":false}}],"id":496},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-13"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Not knowing how to do something doesn't mean we should do the first thing that comes to mind."}},{"k":"read","v":{"b":false}}],"id":497},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-14"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: And waiting doesn't guarantee we'll learn anything!"}},{"k":"read","v":{"b":false}}],"id":498},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-16"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Can both of you stop for a second?"}},{"k":"read","v":{"b":false}}],"id":499},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-17"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Sorry."}},{"k":"read","v":{"b":false}}],"id":500},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-18"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: I'm listening."}},{"k":"read","v":{"b":false}}],"id":501},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-19"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Nobody here knows what happened to Daniel."}},{"k":"read","v":{"b":false}}],"id":502},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-20"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: We keep going in circles."}},{"k":"read","v":{"b":false}}],"id":503},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-21"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: We don't even agree about what happened that night."}},{"k":"read","v":{"b":false}}],"id":504},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-22"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Maya."}},{"k":"read","v":{"b":false}}],"id":505},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-23"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: What?"}},{"k":"read","v":{"b":false}}],"id":506},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-24"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Don't."}},{"k":"read","v":{"b":false}}],"id":507},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-26"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: She's right."}},{"k":"read","v":{"b":false}}],"id":508},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-27"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: ..."}},{"k":"read","v":{"b":false}}],"id":509},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-28"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: We keep acting like we have all these answers."}},{"k":"read","v":{"b":false}}],"id":510},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-29"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: But we don't."}},{"k":"read","v":{"b":false}}],"id":511},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-30"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Can we please not do this right now?"}},{"k":"read","v":{"b":false}}],"id":512},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-31"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: I'm not trying to start anything."}},{"k":"read","v":{"b":false}}],"id":513},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-32"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: I'm just saying we need to stop mixing up what we know and what we think we know."}},{"k":"read","v":{"b":false}}],"id":514},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-33"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Exactly."}},{"k":"read","v":{"b":false}}],"id":515},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-35"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Okay."}},{"k":"read","v":{"b":false}}],"id":516},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-36"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: You're right."}},{"k":"read","v":{"b":false}}],"id":517},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-37"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Both of you."}},{"k":"read","v":{"b":false}}],"id":518},{"o":[{"k":"id","v":{"s":"OPEN-S02-C09-a-1"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: That's what we're trying to establish."}},{"k":"read","v":{"b":false}}],"id":519},{"o":[{"k":"id","v":{"s":"OPEN-S02-C09-a-2"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Which is why we shouldn't be discussing it with someone we just met."}},{"k":"read","v":{"b":false}}],"id":520},{"o":[{"k":"id","v":{"s":"OPEN-S02-C09-a-3"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Lucas has a point."}},{"k":"read","v":{"b":false}}],"id":521},{"o":[{"k":"id","v":{"s":"OPEN-S02-C09-a-5"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Sorry."}},{"k":"read","v":{"b":false}}],"id":522},{"o":[{"k":"id","v":{"s":"OPEN-S02-C09-a-6"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I know that's frustrating."}},{"k":"read","v":{"b":false}}],"id":523},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-3"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Maya?"}},{"k":"read","v":{"b":false}}],"id":524},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-4"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Sorry."}},{"k":"read","v":{"b":false}}],"id":525},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-5"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Wrong chat."}},{"k":"read","v":{"b":false}}],"id":526},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-6"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: What did you delete?"}},{"k":"read","v":{"b":false}}],"id":527},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-7"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: A message meant for someone else."}},{"k":"read","v":{"b":false}}],"id":528},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-8"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: About what?"}},{"k":"read","v":{"b":false}}],"id":529},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-9"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Something unrelated."}},{"k":"read","v":{"b":false}}],"id":530},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-10"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Right."}},{"k":"read","v":{"b":false}}],"id":531},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-11"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Lucas."}},{"k":"read","v":{"b":false}}],"id":532},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-12"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: What?"}},{"k":"read","v":{"b":false}}],"id":533},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-13"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Please don't make something out of nothing."}},{"k":"read","v":{"b":false}}],"id":534},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-15"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: You know what bothers me the most?"}},{"k":"read","v":{"b":false}}],"id":535},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-16"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: What?"}},{"k":"read","v":{"b":false}}],"id":536},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-17"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: We keep saying we trust each other."}},{"k":"read","v":{"b":false}}],"id":537},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-18"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: But the moment something goes wrong, suddenly everyone has something they don't want to explain."}},{"k":"read","v":{"b":false}}],"id":538},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-19"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: That's not fair."}},{"k":"read","v":{"b":false}}],"id":539},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-20"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Isn't it?"}},{"k":"read","v":{"b":false}}],"id":540},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-21"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: What are you trying to say?"}},{"k":"read","v":{"b":false}}],"id":541},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-22"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: I'm saying maybe we should stop pretending everything's fine."}},{"k":"read","v":{"b":false}}],"id":542},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-23"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Nobody's pretending everything's fine."}},{"k":"read","v":{"b":false}}],"id":543},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-24"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Then why does it feel like I'm the only one asking the obvious questions?"}},{"k":"read","v":{"b":false}}],"id":544},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-25"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: You're not."}},{"k":"read","v":{"b":false}}],"id":545},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-26"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Really?"}},{"k":"read","v":{"b":false}}],"id":546},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-27"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Really."}},{"k":"read","v":{"b":false}}],"id":547},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-28"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Then answer this."}},{"k":"read","v":{"b":false}}],"id":548},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-30"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Why does Daniel have a stranger's number saved without a name?"}},{"k":"read","v":{"b":false}}],"id":549},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-31"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I don't know."}},{"k":"read","v":{"b":false}}],"id":550},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-32"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Who marked it with a star?"}},{"k":"read","v":{"b":false}}],"id":551},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-33"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I don't know!"}},{"k":"read","v":{"b":false}}],"id":552},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-34"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Why has nobody heard from him?"}},{"k":"read","v":{"b":false}}],"id":553},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-35"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: LUCAS!"}},{"k":"read","v":{"b":false}}],"id":554},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-37"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Stop."}},{"k":"read","v":{"b":false}}],"id":555},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-38"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Both of you."}},{"k":"read","v":{"b":false}}],"id":556},{"o":[{"k":"id","v":{"s":"OPEN-S02-C10-a-1"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Exactly."}},{"k":"read","v":{"b":false}}],"id":557},{"o":[{"k":"id","v":{"s":"OPEN-S02-C10-a-2"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Then maybe we shouldn't be acting like we do."}},{"k":"read","v":{"b":false}}],"id":558},{"o":[{"k":"id","v":{"s":"OPEN-S02-C10-a-3"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I'm not!"}},{"k":"read","v":{"b":false}}],"id":559},{"o":[{"k":"id","v":{"s":"OPEN-S02-C10-a-4"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Then stop making decisions for everyone."}},{"k":"read","v":{"b":false}}],"id":560},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-10-2"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Fine."}},{"k":"read","v":{"b":false}}],"id":561},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-10-3"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Maybe adding someone was a mistake."}},{"k":"read","v":{"b":false}}],"id":562},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-10-4"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: But I still think ignoring the number would've been worse."}},{"k":"read","v":{"b":false}}],"id":563},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-10-5"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: That's your opinion."}},{"k":"read","v":{"b":false}}],"id":564},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-10-6"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Yes."}},{"k":"read","v":{"b":false}}],"id":565},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-10-7"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: It is."}},{"k":"read","v":{"b":false}}],"id":566},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-10-9"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Nobody has to decide everything right now."}},{"k":"read","v":{"b":false}}],"id":567},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-10-10"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: No."}},{"k":"read","v":{"b":false}}],"id":568},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-10-11"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: But we do have to decide what we're willing to risk."}},{"k":"read","v":{"b":false}}],"id":569},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-10-12"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: What does that mean?"}},{"k":"read","v":{"b":false}}],"id":570},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-10-13"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: It means I'm not comfortable with this anymore."}},{"k":"read","v":{"b":false}}],"id":571},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-10-14"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: With what?"}},{"k":"read","v":{"b":false}}],"id":572},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-10-15"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: With how we're handling everything."}},{"k":"read","v":{"b":false}}],"id":573},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-10-16"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Lucas..."}},{"k":"read","v":{"b":false}}],"id":574},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-10-17"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: No, Sophie."}},{"k":"read","v":{"b":false}}],"id":575},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-10-18"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: I've been trying to say this for days."}},{"k":"read","v":{"b":false}}],"id":576},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-10-19"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Every time I question something, you act like I'm making things harder."}},{"k":"read","v":{"b":false}}],"id":577},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-10-20"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Because sometimes you are!"}},{"k":"read","v":{"b":false}}],"id":578},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-10-22"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: ..."}},{"k":"read","v":{"b":false}}],"id":579},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-10-23"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Sophie."}},{"k":"read","v":{"b":false}}],"id":580},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-10-24"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I'm sorry."}},{"k":"read","v":{"b":false}}],"id":581},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-10-25"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I didn't mean—"}},{"k":"read","v":{"b":false}}],"id":582},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-10-26"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: No."}},{"k":"read","v":{"b":false}}],"id":583},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-10-27"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: You did."}},{"k":"read","v":{"b":false}}],"id":584},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-10-29"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Lucas, please."}},{"k":"read","v":{"b":false}}],"id":585},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-10-30"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: I'm not doing this."}},{"k":"read","v":{"b":false}}],"id":586},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-10-31"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Don't be dramatic."}},{"k":"read","v":{"b":false}}],"id":587},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-10-32"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: I'm not being dramatic."}},{"k":"read","v":{"b":false}}],"id":588},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-10-33"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: I'm stepping away before I say something I regret."}},{"k":"read","v":{"b":false}}],"id":589},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-10-34"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: We're all upset."}},{"k":"read","v":{"b":false}}],"id":590},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-10-35"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: That's not the point."}},{"k":"read","v":{"b":false}}],"id":591},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-10-36"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Then what is?"}},{"k":"read","v":{"b":false}}],"id":592},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-10-37"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: The point is that none of us knows who we're supposed to trust right now."}},{"k":"read","v":{"b":false}}],"id":593},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-10-39"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: And apparently I'm the only one willing to admit it."}},{"k":"read","v":{"b":false}}],"id":594},{"o":[{"k":"id","v":{"s":"OPEN-S02-C11-a-1"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Good."}},{"k":"read","v":{"b":false}}],"id":595},{"o":[{"k":"id","v":{"s":"OPEN-S02-C11-a-2"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Because I don't."}},{"k":"read","v":{"b":false}}],"id":596},{"o":[{"k":"id","v":{"s":"OPEN-S02-C11-a-3"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Nobody's asking you to."}},{"k":"read","v":{"b":false}}],"id":597},{"o":[{"k":"id","v":{"s":"OPEN-S02-C11-a-4"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Then we're clear."}},{"k":"read","v":{"b":false}}],"id":598},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-11-2"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Sophie."}},{"k":"read","v":{"b":false}}],"id":599},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-11-3"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Yeah?"}},{"k":"read","v":{"b":false}}],"id":600},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-11-4"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Please be careful."}},{"k":"read","v":{"b":false}}],"id":601},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-11-5"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I am being careful."}},{"k":"read","v":{"b":false}}],"id":602},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-11-6"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: I know you think you are."}},{"k":"read","v":{"b":false}}],"id":603},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-11-8"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: That's what worries me."}},{"k":"read","v":{"b":false}}],"id":604},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-11-13"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Lucas, seriously?"}},{"k":"read","v":{"b":false}}],"id":605},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-11-15"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: He's gone, Soph."}},{"k":"read","v":{"b":false}}],"id":606},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-11-16"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I can see that."}},{"k":"read","v":{"b":false}}],"id":607},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-11-18"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: You should've told us before adding someone."}},{"k":"read","v":{"b":false}}],"id":608},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-11-19"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Would you have said yes?"}},{"k":"read","v":{"b":false}}],"id":609},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-11-20"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: That's not the point."}},{"k":"read","v":{"b":false}}],"id":610},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-11-23"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Can we not do this here?"}},{"k":"read","v":{"b":false}}],"id":611},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-11-24"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Fine."}},{"k":"read","v":{"b":false}}],"id":612},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-11-25"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: But we need to talk about this."}},{"k":"read","v":{"b":false}}],"id":613},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-11-26"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I know."}},{"k":"read","v":{"b":false}}],"id":614},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-11-28"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Later, then."}},{"k":"read","v":{"b":false}}],"id":615},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-11-31"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: ..."}},{"k":"read","v":{"b":false}}],"id":616},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-11-32"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Well."}},{"k":"read","v":{"b":false}}],"id":617},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-11-33"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: That went brilliantly."}},{"k":"read","v":{"b":false}}],"id":618},{"o":[{"k":"id","v":{"s":"OPEN-S02-C12-a-1"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I know."}},{"k":"read","v":{"b":false}}],"id":619},{"o":[{"k":"id","v":{"s":"OPEN-S02-C12-a-2"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: You didn't."}},{"k":"read","v":{"b":false}}],"id":620},{"o":[{"k":"id","v":{"s":"OPEN-S02-C12-a-3"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: This started long before you joined."}},{"k":"read","v":{"b":false}}],"id":621},{"o":[{"k":"id","v":{"s":"OPEN-S02-C12-a-4"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I'm sorry you had to see it."}},{"k":"read","v":{"b":false}}],"id":622},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-12-2"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Listen."}},{"k":"read","v":{"b":false}}],"id":623},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-12-3"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I think I owe you an explanation."}},{"k":"read","v":{"b":false}}],"id":624},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-12-4"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: But I'd rather not have this conversation in front of everyone."}},{"k":"read","v":{"b":false}}],"id":625},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-12-6"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Can we talk privately?"}},{"k":"read","v":{"b":false}}],"id":626},{"o":[{"k":"id","v":{"s":"OPEN-S02-C13-a-1"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Thank you."}},{"k":"read","v":{"b":false}}],"id":627},{"o":[{"k":"id","v":{"s":"OPEN-S02-C13-a-2"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I'll message you."}},{"k":"read","v":{"b":false}}],"id":628},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-13-2"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I'll send you a message."}},{"k":"read","v":{"b":false}}],"id":629},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-13-4"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: And..."}},{"k":"read","v":{"b":false}}],"id":630},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-13-5"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I'm sorry about all of this."}},{"k":"read","v":{"b":false}}],"id":631},{"o":[{"k":"id","v":{"s":"OPEN-S03-FIRST-MESSAGE"}},{"k":"text","v":{"s":"Sophie: Hey."}},{"k":"read","v":{"b":false}}],"id":632},{"o":[{"k":"id","v":{"s":"OPEN-S03-OPENING-2"}},{"k":"text","v":{"s":"Sophie: It's me."}},{"k":"read","v":{"b":false}}],"id":633},{"o":[{"k":"id","v":{"s":"OPEN-S03-OPENING-3"}},{"k":"text","v":{"s":"Sophie: Obviously."}},{"k":"read","v":{"b":false}}],"id":634},{"o":[{"k":"id","v":{"s":"OPEN-S03-OPENING-4"}},{"k":"text","v":{"s":"Sophie: Not sure why I felt the need to clarify that 😅"}},{"k":"read","v":{"b":false}}],"id":635},{"o":[{"k":"id","v":{"s":"OPEN-S03-OPENING-6"}},{"k":"text","v":{"s":"Sophie: Sorry about what happened back there."}},{"k":"read","v":{"b":false}}],"id":636},{"o":[{"k":"id","v":{"s":"OPEN-S03-OPENING-7"}},{"k":"text","v":{"s":"Sophie: That was..."}},{"k":"read","v":{"b":false}}],"id":637},{"o":[{"k":"id","v":{"s":"OPEN-S03-OPENING-9"}},{"k":"text","v":{"s":"Sophie: Well, you've seen it."}},{"k":"read","v":{"b":false}}],"id":638},{"o":[{"k":"id","v":{"s":"OPEN-S03-C01-a-1"}},{"k":"text","v":{"s":"Sophie: That's one word for it."}},{"k":"read","v":{"b":false}}],"id":639},{"o":[{"k":"id","v":{"s":"OPEN-S03-C01-a-2"}},{"k":"text","v":{"s":"Sophie: And you caught us on a relatively good day."}},{"k":"read","v":{"b":false}}],"id":640},{"o":[{"k":"id","v":{"s":"OPEN-S03-C01-a-4"}},{"k":"text","v":{"s":"Sophie: Kidding."}},{"k":"read","v":{"b":false}}],"id":641},{"o":[{"k":"id","v":{"s":"OPEN-S03-C01-a-5"}},{"k":"text","v":{"s":"Sophie: Mostly."}},{"k":"read","v":{"b":false}}],"id":642},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-01-1"}},{"k":"text","v":{"s":"Sophie: Okay."}},{"k":"read","v":{"b":false}}],"id":643},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-01-2"}},{"k":"text","v":{"s":"Sophie: Let's start over."}},{"k":"read","v":{"b":false}}],"id":644},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-01-3"}},{"k":"text","v":{"s":"Sophie: Properly this time."}},{"k":"read","v":{"b":false}}],"id":645},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-01-4"}},{"k":"text","v":{"s":"Sophie: There's something I should've told you before I added you."}},{"k":"read","v":{"b":false}}],"id":646},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-01-5"}},{"k":"text","v":{"s":"Sophie: Daniel isn't just someone I know."}},{"k":"read","v":{"b":false}}],"id":647},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-01-7"}},{"k":"text","v":{"s":"Sophie: He's my brother."}},{"k":"read","v":{"b":false}}],"id":648},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-01-8"}},{"k":"text","v":{"s":"Sophie: My older brother, actually."}},{"k":"read","v":{"b":false}}],"id":649},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-01-10"}},{"k":"text","v":{"s":"Sophie: Daniel Mercer."}},{"k":"read","v":{"b":false}}],"id":650},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-01-11"}},{"k":"text","v":{"s":"Sophie: I guess I should've mentioned that earlier."}},{"k":"read","v":{"b":false}}],"id":651},{"o":[{"k":"id","v":{"s":"OPEN-S03-C02-a-1"}},{"k":"text","v":{"s":"Sophie: Yeah."}},{"k":"read","v":{"b":false}}],"id":652},{"o":[{"k":"id","v":{"s":"OPEN-S03-C02-a-2"}},{"k":"text","v":{"s":"Sophie: Sorry."}},{"k":"read","v":{"b":false}}],"id":653},{"o":[{"k":"id","v":{"s":"OPEN-S03-C02-a-3"}},{"k":"text","v":{"s":"Sophie: I keep forgetting you don't know anything about us."}},{"k":"read","v":{"b":false}}],"id":654},{"o":[{"k":"id","v":{"s":"OPEN-S03-C02-a-4"}},{"k":"text","v":{"s":"Sophie: I've spent days talking to people who already know him."}},{"k":"read","v":{"b":false}}],"id":655},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-02-2"}},{"k":"text","v":{"s":"Sophie: It's strange."}},{"k":"read","v":{"b":false}}],"id":656},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-02-3"}},{"k":"text","v":{"s":"Sophie: I've spent all day talking about Daniel."}},{"k":"read","v":{"b":false}}],"id":657},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-02-4"}},{"k":"text","v":{"s":"Sophie: Where he might be."}},{"k":"read","v":{"b":false}}],"id":658},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-02-5"}},{"k":"text","v":{"s":"Sophie: Who he last spoke to."}},{"k":"read","v":{"b":false}}],"id":659},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-02-6"}},{"k":"text","v":{"s":"Sophie: Whether anyone remembers something useful."}},{"k":"read","v":{"b":false}}],"id":660},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-02-8"}},{"k":"text","v":{"s":"Sophie: But I haven't really told you what he's like."}},{"k":"read","v":{"b":false}}],"id":661},{"o":[{"k":"id","v":{"s":"OPEN-S03-C03-a-1"}},{"k":"text","v":{"s":"Sophie: That's harder than I expected."}},{"k":"read","v":{"b":false}}],"id":662},{"o":[{"k":"id","v":{"s":"OPEN-S03-C03-a-2"}},{"k":"text","v":{"s":"Sophie: He's a good person."}},{"k":"read","v":{"b":false}}],"id":663},{"o":[{"k":"id","v":{"s":"OPEN-S03-C03-a-3"}},{"k":"text","v":{"s":"Sophie: Which is what everybody says about someone they love."}},{"k":"read","v":{"b":false}}],"id":664},{"o":[{"k":"id","v":{"s":"OPEN-S03-C03-a-4"}},{"k":"text","v":{"s":"Sophie: Not very helpful, is it?"}},{"k":"read","v":{"b":false}}],"id":665},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-03-1"}},{"k":"text","v":{"s":"Sophie: He's patient with things."}},{"k":"read","v":{"b":false}}],"id":666},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-03-2"}},{"k":"text","v":{"s":"Sophie: Not always with people."}},{"k":"read","v":{"b":false}}],"id":667},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-03-3"}},{"k":"text","v":{"s":"Sophie: If something breaks, he'll spend hours trying to fix it."}},{"k":"read","v":{"b":false}}],"id":668},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-03-4"}},{"k":"text","v":{"s":"Sophie: Even if replacing it would take five minutes."}},{"k":"read","v":{"b":false}}],"id":669},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-03-5"}},{"k":"text","v":{"s":"Sophie: And he'll be absolutely convinced he's being clever about it."}},{"k":"read","v":{"b":false}}],"id":670},{"o":[{"k":"id","v":{"s":"OPEN-S03-C04-a-1"}},{"k":"text","v":{"s":"Sophie: Oh, incredibly."}},{"k":"read","v":{"b":false}}],"id":671},{"o":[{"k":"id","v":{"s":"OPEN-S03-C04-a-2"}},{"k":"text","v":{"s":"Sophie: Don't ever tell him that."}},{"k":"read","v":{"b":false}}],"id":672},{"o":[{"k":"id","v":{"s":"OPEN-S03-C04-a-3"}},{"k":"text","v":{"s":"Sophie: He'll spend the next twenty minutes explaining why he's not stubborn."}},{"k":"read","v":{"b":false}}],"id":673},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-04-1"}},{"k":"text","v":{"s":"Sophie: And he has this habit."}},{"k":"read","v":{"b":false}}],"id":674},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-04-2"}},{"k":"text","v":{"s":"Sophie: Whenever something gets complicated, he'll say..."}},{"k":"read","v":{"b":false}}],"id":675},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-04-3"}},{"k":"text","v":{"s":"Sophie: \"I'll explain later.\""}},{"k":"read","v":{"b":false}}],"id":676},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-04-5"}},{"k":"text","v":{"s":"Sophie: I hate that sentence."}},{"k":"read","v":{"b":false}}],"id":677},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-04-6"}},{"k":"text","v":{"s":"Sophie: Because he normally does explain later."}},{"k":"read","v":{"b":false}}],"id":678},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-04-7"}},{"k":"text","v":{"s":"Sophie: You just have to wait until he's ready."}},{"k":"read","v":{"b":false}}],"id":679},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-04-9"}},{"k":"text","v":{"s":"Sophie: This time..."}},{"k":"read","v":{"b":false}}],"id":680},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-04-13"}},{"k":"text","v":{"s":"Sophie: Never mind."}},{"k":"read","v":{"b":false}}],"id":681},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-04-14"}},{"k":"text","v":{"s":"Sophie: You know what I remembered earlier?"}},{"k":"read","v":{"b":false}}],"id":682},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-04-15"}},{"k":"text","v":{"s":"Sophie: My birthday."}},{"k":"read","v":{"b":false}}],"id":683},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-04-16"}},{"k":"text","v":{"s":"Sophie: Not this year."}},{"k":"read","v":{"b":false}}],"id":684},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-04-17"}},{"k":"text","v":{"s":"Sophie: A while ago."}},{"k":"read","v":{"b":false}}],"id":685},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-04-18"}},{"k":"text","v":{"s":"Sophie: Daniel told me he couldn't make it."}},{"k":"read","v":{"b":false}}],"id":686},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-04-19"}},{"k":"text","v":{"s":"Sophie: Said he was busy."}},{"k":"read","v":{"b":false}}],"id":687},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-04-20"}},{"k":"text","v":{"s":"Sophie: I was so annoyed with him."}},{"k":"read","v":{"b":false}}],"id":688},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-04-21"}},{"k":"text","v":{"s":"Sophie: Didn't speak to him all afternoon."}},{"k":"read","v":{"b":false}}],"id":689},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-04-23"}},{"k":"text","v":{"s":"Sophie: Then he showed up that evening."}},{"k":"read","v":{"b":false}}],"id":690},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-04-24"}},{"k":"text","v":{"s":"Sophie: With a cake."}},{"k":"read","v":{"b":false}}],"id":691},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-04-25"}},{"k":"text","v":{"s":"Sophie: A completely ruined cake."}},{"k":"read","v":{"b":false}}],"id":692},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-04-26"}},{"k":"text","v":{"s":"Sophie: It had slid sideways in the box."}},{"k":"read","v":{"b":false}}],"id":693},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-04-27"}},{"k":"text","v":{"s":"Sophie: Half the writing was stuck to the lid."}},{"k":"read","v":{"b":false}}],"id":694},{"o":[{"k":"id","v":{"s":"OPEN-S03-C05-a-1"}},{"k":"text","v":{"s":"Sophie: That's exactly what he said!"}},{"k":"read","v":{"b":false}}],"id":695},{"o":[{"k":"id","v":{"s":"OPEN-S03-C05-a-2"}},{"k":"text","v":{"s":"Sophie: Word for word."}},{"k":"read","v":{"b":false}}],"id":696},{"o":[{"k":"id","v":{"s":"OPEN-S03-C05-a-3"}},{"k":"text","v":{"s":"Sophie: Very convenient, considering the state of that cake."}},{"k":"read","v":{"b":false}}],"id":697},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-05-2"}},{"k":"text","v":{"s":"Sophie: Sorry."}},{"k":"read","v":{"b":false}}],"id":698},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-05-3"}},{"k":"text","v":{"s":"Sophie: I'm rambling."}},{"k":"read","v":{"b":false}}],"id":699},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-05-4"}},{"k":"text","v":{"s":"Sophie: You asked about Daniel and now I'm telling you about a cake."}},{"k":"read","v":{"b":false}}],"id":700},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-05-6"}},{"k":"text","v":{"s":"Sophie: But that's the kind of thing I think about when I think of him."}},{"k":"read","v":{"b":false}}],"id":701},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-05-7"}},{"k":"text","v":{"s":"Sophie: Not the arguments."}},{"k":"read","v":{"b":false}}],"id":702},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-05-8"}},{"k":"text","v":{"s":"Sophie: Not whatever is happening right now."}},{"k":"read","v":{"b":false}}],"id":703},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-05-9"}},{"k":"text","v":{"s":"Sophie: That's why I know something isn't right."}},{"k":"read","v":{"b":false}}],"id":704},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-05-10"}},{"k":"text","v":{"s":"Sophie: He might forget an appointment."}},{"k":"read","v":{"b":false}}],"id":705},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-05-11"}},{"k":"text","v":{"s":"Sophie: He might ignore a call because he's busy."}},{"k":"read","v":{"b":false}}],"id":706},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-05-12"}},{"k":"text","v":{"s":"Sophie: But if he knows people are worried..."}},{"k":"read","v":{"b":false}}],"id":707},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-05-13"}},{"k":"text","v":{"s":"Sophie: He doesn't usually leave them like that."}},{"k":"read","v":{"b":false}}],"id":708},{"o":[{"k":"id","v":{"s":"OPEN-S03-C06-a-1"}},{"k":"text","v":{"s":"Sophie: A few days without a proper answer."}},{"k":"read","v":{"b":false}}],"id":709},{"o":[{"k":"id","v":{"s":"OPEN-S03-C06-a-2"}},{"k":"text","v":{"s":"Sophie: It feels longer."}},{"k":"read","v":{"b":false}}],"id":710},{"o":[{"k":"id","v":{"s":"OPEN-S03-C06-a-3"}},{"k":"text","v":{"s":"Sophie: I keep counting the hours."}},{"k":"read","v":{"b":false}}],"id":711},{"o":[{"k":"id","v":{"s":"OPEN-S03-C06-a-4"}},{"k":"text","v":{"s":"Sophie: Which doesn't help at all."}},{"k":"read","v":{"b":false}}],"id":712},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-06-1"}},{"k":"text","v":{"s":"Sophie: And before you ask..."}},{"k":"read","v":{"b":false}}],"id":713},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-06-2"}},{"k":"text","v":{"s":"Sophie: No, we haven't figured out exactly what happened."}},{"k":"read","v":{"b":false}}],"id":714},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-06-3"}},{"k":"text","v":{"s":"Sophie: We don't even agree on parts of the timeline."}},{"k":"read","v":{"b":false}}],"id":715},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-06-4"}},{"k":"text","v":{"s":"Sophie: That's why things got so tense in the group."}},{"k":"read","v":{"b":false}}],"id":716},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-06-5"}},{"k":"text","v":{"s":"Sophie: Can I tell you something?"}},{"k":"read","v":{"b":false}}],"id":717},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-06-6"}},{"k":"text","v":{"s":"Sophie: I keep opening my last conversation with him."}},{"k":"read","v":{"b":false}}],"id":718},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-06-7"}},{"k":"text","v":{"s":"Sophie: I know it isn't going to change."}},{"k":"read","v":{"b":false}}],"id":719},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-06-8"}},{"k":"text","v":{"s":"Sophie: But I keep looking anyway."}},{"k":"read","v":{"b":false}}],"id":720},{"o":[{"k":"id","v":{"s":"OPEN-S03-C07-a-1"}},{"k":"text","v":{"s":"Sophie: Nothing dramatic."}},{"k":"read","v":{"b":false}}],"id":721},{"o":[{"k":"id","v":{"s":"OPEN-S03-C07-a-2"}},{"k":"text","v":{"s":"Sophie: That's the frustrating part."}},{"k":"read","v":{"b":false}}],"id":722},{"o":[{"k":"id","v":{"s":"OPEN-S03-C07-a-3"}},{"k":"text","v":{"s":"Sophie: Just normal things."}},{"k":"read","v":{"b":false}}],"id":723},{"o":[{"k":"id","v":{"s":"OPEN-S03-C07-a-4"}},{"k":"text","v":{"s":"Sophie: Like we were going to talk again the next day."}},{"k":"read","v":{"b":false}}],"id":724},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-07-1"}},{"k":"text","v":{"s":"Sophie: Anyway."}},{"k":"read","v":{"b":false}}],"id":725},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-07-2"}},{"k":"text","v":{"s":"Sophie: I don't want you thinking I already know what happened."}},{"k":"read","v":{"b":false}}],"id":726},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-07-3"}},{"k":"text","v":{"s":"Sophie: I don't."}},{"k":"read","v":{"b":false}}],"id":727},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-07-4"}},{"k":"text","v":{"s":"Sophie: I just know this silence doesn't feel like him."}},{"k":"read","v":{"b":false}}],"id":728},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-07-6"}},{"k":"text","v":{"s":"Sophie: Wow."}},{"k":"read","v":{"b":false}}],"id":729},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-07-7"}},{"k":"text","v":{"s":"Sophie: This conversation got depressing fast."}},{"k":"read","v":{"b":false}}],"id":730},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-07-8"}},{"k":"text","v":{"s":"Sophie: Sorry 😅"}},{"k":"read","v":{"b":false}}],"id":731},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-07-9"}},{"k":"text","v":{"s":"Sophie: I should probably tell you a little about the others."}},{"k":"read","v":{"b":false}}],"id":732},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-07-10"}},{"k":"text","v":{"s":"Sophie: Since you've already met them at their absolute best."}},{"k":"read","v":{"b":false}}],"id":733},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-07-11"}},{"k":"text","v":{"s":"Sophie: That was sarcasm, by the way."}},{"k":"read","v":{"b":false}}],"id":734},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-07-12"}},{"k":"text","v":{"s":"Sophie: In case it wasn't obvious."}},{"k":"read","v":{"b":false}}],"id":735},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-07-14"}},{"k":"text","v":{"s":"Sophie: Maya first."}},{"k":"read","v":{"b":false}}],"id":736},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-07-15"}},{"k":"text","v":{"s":"Sophie: She's been having a really hard time."}},{"k":"read","v":{"b":false}}],"id":737},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-07-16"}},{"k":"text","v":{"s":"Sophie: She barely sleeps."}},{"k":"read","v":{"b":false}}],"id":738},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-07-17"}},{"k":"text","v":{"s":"Sophie: Keeps saying she's fine."}},{"k":"read","v":{"b":false}}],"id":739},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-07-18"}},{"k":"text","v":{"s":"Sophie: Which is usually how I know she's not."}},{"k":"read","v":{"b":false}}],"id":740},{"o":[{"k":"id","v":{"s":"OPEN-S03-C08-a-1"}},{"k":"text","v":{"s":"Sophie: ..."}},{"k":"read","v":{"b":false}}],"id":741},{"o":[{"k":"id","v":{"s":"OPEN-S03-C08-a-2"}},{"k":"text","v":{"s":"Sophie: Because she's Daniel's fiancée."}},{"k":"read","v":{"b":false}}],"id":742},{"o":[{"k":"id","v":{"s":"OPEN-S03-C08-a-4"}},{"k":"text","v":{"s":"Sophie: They were planning a wedding."}},{"k":"read","v":{"b":false}}],"id":743},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-08-1"}},{"k":"text","v":{"s":"Sophie: Maya Chen."}},{"k":"read","v":{"b":false}}],"id":744},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-08-2"}},{"k":"text","v":{"s":"Sophie: That's her full name, by the way."}},{"k":"read","v":{"b":false}}],"id":745},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-08-3"}},{"k":"text","v":{"s":"Sophie: She's usually the organized one."}},{"k":"read","v":{"b":false}}],"id":746},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-08-4"}},{"k":"text","v":{"s":"Sophie: Lists."}},{"k":"read","v":{"b":false}}],"id":747},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-08-5"}},{"k":"text","v":{"s":"Sophie: Plans."}},{"k":"read","v":{"b":false}}],"id":748},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-08-6"}},{"k":"text","v":{"s":"Sophie: Reminders."}},{"k":"read","v":{"b":false}}],"id":749},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-08-7"}},{"k":"text","v":{"s":"Sophie: Sometimes I think she has a spreadsheet for everything."}},{"k":"read","v":{"b":false}}],"id":750},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-08-8"}},{"k":"text","v":{"s":"Sophie: Which is probably why Daniel needed her."}},{"k":"read","v":{"b":false}}],"id":751},{"o":[{"k":"id","v":{"s":"OPEN-S03-C09-a-2"}},{"k":"text","v":{"s":"Sophie: As far as I knew, yes."}},{"k":"read","v":{"b":false}}],"id":752},{"o":[{"k":"id","v":{"s":"OPEN-S03-C09-a-3"}},{"k":"text","v":{"s":"Sophie: Every couple has disagreements."}},{"k":"read","v":{"b":false}}],"id":753},{"o":[{"k":"id","v":{"s":"OPEN-S03-C09-a-4"}},{"k":"text","v":{"s":"Sophie: But they were making plans for the future."}},{"k":"read","v":{"b":false}}],"id":754},{"o":[{"k":"id","v":{"s":"OPEN-S03-C09-a-5"}},{"k":"text","v":{"s":"Sophie: Real plans."}},{"k":"read","v":{"b":false}}],"id":755},{"o":[{"k":"id","v":{"s":"OPEN-S03-C09-a-6"}},{"k":"text","v":{"s":"Sophie: I don't want to pretend I know every detail of their relationship, though."}},{"k":"read","v":{"b":false}}],"id":756},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-09-1"}},{"k":"text","v":{"s":"Sophie: Maya can be sarcastic."}},{"k":"read","v":{"b":false}}],"id":757},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-09-2"}},{"k":"text","v":{"s":"Sophie: Very sarcastic."}},{"k":"read","v":{"b":false}}],"id":758},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-09-3"}},{"k":"text","v":{"s":"Sophie: But she usually means well."}},{"k":"read","v":{"b":false}}],"id":759},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-09-4"}},{"k":"text","v":{"s":"Sophie: She also won't pretend to agree with you just to make you feel better."}},{"k":"read","v":{"b":false}}],"id":760},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-09-5"}},{"k":"text","v":{"s":"Sophie: Trust me."}},{"k":"read","v":{"b":false}}],"id":761},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-09-6"}},{"k":"text","v":{"s":"Sophie: I've been on the receiving end of that plenty of times."}},{"k":"read","v":{"b":false}}],"id":762},{"o":[{"k":"id","v":{"s":"OPEN-S03-C10-a-1"}},{"k":"text","v":{"s":"Sophie: I noticed."}},{"k":"read","v":{"b":false}}],"id":763},{"o":[{"k":"id","v":{"s":"OPEN-S03-C10-a-2"}},{"k":"text","v":{"s":"Sophie: I didn't see what it said."}},{"k":"read","v":{"b":false}}],"id":764},{"o":[{"k":"id","v":{"s":"OPEN-S03-C10-a-3"}},{"k":"text","v":{"s":"Sophie: I don't know if it was important."}},{"k":"read","v":{"b":false}}],"id":765},{"o":[{"k":"id","v":{"s":"OPEN-S03-C10-a-4"}},{"k":"text","v":{"s":"Sophie: We can ask her later."}},{"k":"read","v":{"b":false}}],"id":766},{"o":[{"k":"id","v":{"s":"OPEN-S03-C10-a-5"}},{"k":"text","v":{"s":"Sophie: I just don't want to turn every little thing into an accusation."}},{"k":"read","v":{"b":false}}],"id":767},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-10-1"}},{"k":"text","v":{"s":"Sophie: Just..."}},{"k":"read","v":{"b":false}}],"id":768},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-10-2"}},{"k":"text","v":{"s":"Sophie: Be patient with her, okay?"}},{"k":"read","v":{"b":false}}],"id":769},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-10-3"}},{"k":"text","v":{"s":"Sophie: She's dealing with more than she lets on."}},{"k":"read","v":{"b":false}}],"id":770},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-10-4"}},{"k":"text","v":{"s":"Sophie: And then there's Lucas."}},{"k":"read","v":{"b":false}}],"id":771},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-10-6"}},{"k":"text","v":{"s":"Sophie: Oh boy."}},{"k":"read","v":{"b":false}}],"id":772},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-10-7"}},{"k":"text","v":{"s":"Sophie: Where do I even start?"}},{"k":"read","v":{"b":false}}],"id":773},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-10-8"}},{"k":"text","v":{"s":"Sophie: He's known Daniel since they were kids."}},{"k":"read","v":{"b":false}}],"id":774},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-10-9"}},{"k":"text","v":{"s":"Sophie: They practically grew up together."}},{"k":"read","v":{"b":false}}],"id":775},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-10-10"}},{"k":"text","v":{"s":"Sophie: Which means he's had years to perfect the art of being impossible."}},{"k":"read","v":{"b":false}}],"id":776},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-10-11"}},{"k":"text","v":{"s":"Sophie: 😅"}},{"k":"read","v":{"b":false}}],"id":777},{"o":[{"k":"id","v":{"s":"OPEN-S03-C11-a-1"}},{"k":"text","v":{"s":"Sophie: Yeah."}},{"k":"read","v":{"b":false}}],"id":778},{"o":[{"k":"id","v":{"s":"OPEN-S03-C11-a-2"}},{"k":"text","v":{"s":"Sophie: That's a good word for him."}},{"k":"read","v":{"b":false}}],"id":779},{"o":[{"k":"id","v":{"s":"OPEN-S03-C11-a-3"}},{"k":"text","v":{"s":"Sophie: He doesn't always show it in the nicest way."}},{"k":"read","v":{"b":false}}],"id":780},{"o":[{"k":"id","v":{"s":"OPEN-S03-C11-a-4"}},{"k":"text","v":{"s":"Sophie: But he cares."}},{"k":"read","v":{"b":false}}],"id":781},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-11-1"}},{"k":"text","v":{"s":"Sophie: He and Daniel used to argue about the stupidest things."}},{"k":"read","v":{"b":false}}],"id":782},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-11-2"}},{"k":"text","v":{"s":"Sophie: Music."}},{"k":"read","v":{"b":false}}],"id":783},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-11-3"}},{"k":"text","v":{"s":"Sophie: Football."}},{"k":"read","v":{"b":false}}],"id":784},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-11-4"}},{"k":"text","v":{"s":"Sophie: Who was right about something neither of them actually understood."}},{"k":"read","v":{"b":false}}],"id":785},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-11-5"}},{"k":"text","v":{"s":"Sophie: And then five minutes later they'd be laughing again."}},{"k":"read","v":{"b":false}}],"id":786},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-11-6"}},{"k":"text","v":{"s":"Sophie: That's just how they were."}},{"k":"read","v":{"b":false}}],"id":787},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-11-8"}},{"k":"text","v":{"s":"Sophie: I think he's having a hard time accepting that he can't just call Daniel and argue with him about this."}},{"k":"read","v":{"b":false}}],"id":788},{"o":[{"k":"id","v":{"s":"OPEN-S03-C12-a-1"}},{"k":"text","v":{"s":"Sophie: I hope so."}},{"k":"read","v":{"b":false}}],"id":789},{"o":[{"k":"id","v":{"s":"OPEN-S03-C12-a-2"}},{"k":"text","v":{"s":"Sophie: He's angry, not heartless."}},{"k":"read","v":{"b":false}}],"id":790},{"o":[{"k":"id","v":{"s":"OPEN-S03-C12-a-3"}},{"k":"text","v":{"s":"Sophie: I don't think he wants to walk away from Daniel."}},{"k":"read","v":{"b":false}}],"id":791},{"o":[{"k":"id","v":{"s":"OPEN-S03-C12-a-4"}},{"k":"text","v":{"s":"Sophie: He just doesn't want to do things this way."}},{"k":"read","v":{"b":false}}],"id":792},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-12-1"}},{"k":"text","v":{"s":"Sophie: Whatever you think of Lucas..."}},{"k":"read","v":{"b":false}}],"id":793},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-12-2"}},{"k":"text","v":{"s":"Sophie: Please don't assume he's your enemy."}},{"k":"read","v":{"b":false}}],"id":794},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-12-3"}},{"k":"text","v":{"s":"Sophie: I don't think he is."}},{"k":"read","v":{"b":false}}],"id":795},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-12-5"}},{"k":"text","v":{"s":"Sophie: Oh!"}},{"k":"read","v":{"b":false}}],"id":796},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-12-6"}},{"k":"text","v":{"s":"Sophie: And there's Eli."}},{"k":"read","v":{"b":false}}],"id":797},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-12-7"}},{"k":"text","v":{"s":"Sophie: I almost forgot you haven't actually spoken to her."}},{"k":"read","v":{"b":false}}],"id":798},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-12-8"}},{"k":"text","v":{"s":"Sophie: She's much quieter in group chats."}},{"k":"read","v":{"b":false}}],"id":799},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-12-9"}},{"k":"text","v":{"s":"Sophie: Sometimes I wonder whether she even reads half the messages."}},{"k":"read","v":{"b":false}}],"id":800},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-12-10"}},{"k":"text","v":{"s":"Sophie: Then she'll reply to something from six hours ago."}},{"k":"read","v":{"b":false}}],"id":801},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-12-11"}},{"k":"text","v":{"s":"Sophie: Like the conversation never moved on."}},{"k":"read","v":{"b":false}}],"id":802},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-12-12"}},{"k":"text","v":{"s":"Sophie: 😅"}},{"k":"read","v":{"b":false}}],"id":803},{"o":[{"k":"id","v":{"s":"OPEN-S03-C13-a-1"}},{"k":"text","v":{"s":"Sophie: Eli Ward."}},{"k":"read","v":{"b":false}}],"id":804},{"o":[{"k":"id","v":{"s":"OPEN-S03-C13-a-2"}},{"k":"text","v":{"s":"Sophie: She works with Daniel."}},{"k":"read","v":{"b":false}}],"id":805},{"o":[{"k":"id","v":{"s":"OPEN-S03-C13-a-3"}},{"k":"text","v":{"s":"Sophie: At Axiom Recovery."}},{"k":"read","v":{"b":false}}],"id":806},{"o":[{"k":"id","v":{"s":"OPEN-S03-C13-a-4"}},{"k":"text","v":{"s":"Sophie: She's not exactly the loudest person in the room."}},{"k":"read","v":{"b":false}}],"id":807},{"o":[{"k":"id","v":{"s":"OPEN-S03-C13-a-5"}},{"k":"text","v":{"s":"Sophie: But she's pretty smart."}},{"k":"read","v":{"b":false}}],"id":808},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-13-1"}},{"k":"text","v":{"s":"Sophie: Eli's usually better with technical things than the rest of us."}},{"k":"read","v":{"b":false}}],"id":809},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-13-2"}},{"k":"text","v":{"s":"Sophie: Which isn't saying much in my case."}},{"k":"read","v":{"b":false}}],"id":810},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-13-3"}},{"k":"text","v":{"s":"Sophie: I once managed to delete an entire folder while trying to rename it."}},{"k":"read","v":{"b":false}}],"id":811},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-13-4"}},{"k":"text","v":{"s":"Sophie: Don't ask."}},{"k":"read","v":{"b":false}}],"id":812},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-13-6"}},{"k":"text","v":{"s":"Sophie: Anyway."}},{"k":"read","v":{"b":false}}],"id":813},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-13-7"}},{"k":"text","v":{"s":"Sophie: She's not some magician who can just pull answers out of nowhere."}},{"k":"read","v":{"b":false}}],"id":814},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-13-8"}},{"k":"text","v":{"s":"Sophie: But she might be able to help us understand some things later."}},{"k":"read","v":{"b":false}}],"id":815},{"o":[{"k":"id","v":{"s":"OPEN-S03-C14-a-1"}},{"k":"text","v":{"s":"Sophie: It's where Daniel works."}},{"k":"read","v":{"b":false}}],"id":816},{"o":[{"k":"id","v":{"s":"OPEN-S03-C14-a-2"}},{"k":"text","v":{"s":"Sophie: They deal with data and recovery-related work."}},{"k":"read","v":{"b":false}}],"id":817},{"o":[{"k":"id","v":{"s":"OPEN-S03-C14-a-3"}},{"k":"text","v":{"s":"Sophie: That's about the extent of my technical understanding."}},{"k":"read","v":{"b":false}}],"id":818},{"o":[{"k":"id","v":{"s":"OPEN-S03-C14-a-4"}},{"k":"text","v":{"s":"Sophie: Eli would explain it better than I could."}},{"k":"read","v":{"b":false}}],"id":819},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-14-1"}},{"k":"text","v":{"s":"Sophie: So yeah."}},{"k":"read","v":{"b":false}}],"id":820},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-14-2"}},{"k":"text","v":{"s":"Sophie: That's Eli."}},{"k":"read","v":{"b":false}}],"id":821},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-14-3"}},{"k":"text","v":{"s":"Sophie: She's easier to talk to when she isn't trying to explain something complicated."}},{"k":"read","v":{"b":false}}],"id":822},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-14-4"}},{"k":"text","v":{"s":"Sophie: Which, now that I think about it, might not be very often."}},{"k":"read","v":{"b":false}}],"id":823},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-14-5"}},{"k":"text","v":{"s":"Sophie: 😅"}},{"k":"read","v":{"b":false}}],"id":824},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-14-6"}},{"k":"text","v":{"s":"Sophie: So..."}},{"k":"read","v":{"b":false}}],"id":825},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-14-7"}},{"k":"text","v":{"s":"Sophie: That's Maya, Lucas and Eli."}},{"k":"read","v":{"b":false}}],"id":826},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-14-8"}},{"k":"text","v":{"s":"Sophie: In the world's least useful introduction."}},{"k":"read","v":{"b":false}}],"id":827},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-14-9"}},{"k":"text","v":{"s":"Sophie: They're all different."}},{"k":"read","v":{"b":false}}],"id":828},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-14-10"}},{"k":"text","v":{"s":"Sophie: Very different."}},{"k":"read","v":{"b":false}}],"id":829},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-14-11"}},{"k":"text","v":{"s":"Sophie: But they all care about Daniel."}},{"k":"read","v":{"b":false}}],"id":830},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-14-12"}},{"k":"text","v":{"s":"Sophie: In their own ways."}},{"k":"read","v":{"b":false}}],"id":831},{"o":[{"k":"id","v":{"s":"OPEN-S03-C15-a-1"}},{"k":"text","v":{"s":"Sophie: Me too."}},{"k":"read","v":{"b":false}}],"id":832},{"o":[{"k":"id","v":{"s":"OPEN-S03-C15-a-2"}},{"k":"text","v":{"s":"Sophie: She's trying so hard to stay strong."}},{"k":"read","v":{"b":false}}],"id":833},{"o":[{"k":"id","v":{"s":"OPEN-S03-C15-a-3"}},{"k":"text","v":{"s":"Sophie: I wish she didn't feel like she had to."}},{"k":"read","v":{"b":false}}],"id":834},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-15-1"}},{"k":"text","v":{"s":"Sophie: Including me, by the way."}},{"k":"read","v":{"b":false}}],"id":835},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-15-3"}},{"k":"text","v":{"s":"Sophie: I know I've told you a lot."}},{"k":"read","v":{"b":false}}],"id":836},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-15-4"}},{"k":"text","v":{"s":"Sophie: But it's still just my side of things."}},{"k":"read","v":{"b":false}}],"id":837},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-15-5"}},{"k":"text","v":{"s":"Sophie: You should remember that."}},{"k":"read","v":{"b":false}}],"id":838},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-15-6"}},{"k":"text","v":{"s":"Sophie: There's still something I can't stop thinking about."}},{"k":"read","v":{"b":false}}],"id":839},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-15-7"}},{"k":"text","v":{"s":"Sophie: Your number."}},{"k":"read","v":{"b":false}}],"id":840},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-15-8"}},{"k":"text","v":{"s":"Sophie: I know."}},{"k":"read","v":{"b":false}}],"id":841},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-15-9"}},{"k":"text","v":{"s":"Sophie: We keep coming back to it."}},{"k":"read","v":{"b":false}}],"id":842},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-15-10"}},{"k":"text","v":{"s":"Sophie: But it doesn't make sense."}},{"k":"read","v":{"b":false}}],"id":843},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-15-11"}},{"k":"text","v":{"s":"Sophie: I've checked that saved contact export more than once."}},{"k":"read","v":{"b":false}}],"id":844},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-15-12"}},{"k":"text","v":{"s":"Sophie: And there it was."}},{"k":"read","v":{"b":false}}],"id":845},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-15-13"}},{"k":"text","v":{"s":"Sophie: No name."}},{"k":"read","v":{"b":false}}],"id":846},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-15-14"}},{"k":"text","v":{"s":"Sophie: Just your number, with the star still beside it."}},{"k":"read","v":{"b":false}}],"id":847},{"o":[{"k":"id","v":{"s":"OPEN-S03-C16-a-1"}},{"k":"text","v":{"s":"Sophie: Maybe."}},{"k":"read","v":{"b":false}}],"id":848},{"o":[{"k":"id","v":{"s":"OPEN-S03-C16-a-2"}},{"k":"text","v":{"s":"Sophie: I really hope there's a simple explanation."}},{"k":"read","v":{"b":false}}],"id":849},{"o":[{"k":"id","v":{"s":"OPEN-S03-C16-a-3"}},{"k":"text","v":{"s":"Sophie: It would be nice if something about this turned out to be simple."}},{"k":"read","v":{"b":false}}],"id":850},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-16-1"}},{"k":"text","v":{"s":"Sophie: I wish I could give you something more useful."}},{"k":"read","v":{"b":false}}],"id":851},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-16-2"}},{"k":"text","v":{"s":"Sophie: I really do."}},{"k":"read","v":{"b":false}}],"id":852},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-16-3"}},{"k":"text","v":{"s":"Sophie: But I don't want to make up answers just because I don't like having questions."}},{"k":"read","v":{"b":false}}],"id":853},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-16-5"}},{"k":"text","v":{"s":"Sophie: There's something else I should say."}},{"k":"read","v":{"b":false}}],"id":854},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-16-6"}},{"k":"text","v":{"s":"Sophie: I know you've ended up in a really strange situation."}},{"k":"read","v":{"b":false}}],"id":855},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-16-7"}},{"k":"text","v":{"s":"Sophie: And it's mostly because of me."}},{"k":"read","v":{"b":false}}],"id":856},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-16-8"}},{"k":"text","v":{"s":"Sophie: You didn't ask to get involved."}},{"k":"read","v":{"b":false}}],"id":857},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-16-9"}},{"k":"text","v":{"s":"Sophie: I know that."}},{"k":"read","v":{"b":false}}],"id":858},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-16-11"}},{"k":"text","v":{"s":"Sophie: I don't actually expect you to find Daniel."}},{"k":"read","v":{"b":false}}],"id":859},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-16-12"}},{"k":"text","v":{"s":"Sophie: That's not fair to put on you."}},{"k":"read","v":{"b":false}}],"id":860},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-16-13"}},{"k":"text","v":{"s":"Sophie: I just thought..."}},{"k":"read","v":{"b":false}}],"id":861},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-16-14"}},{"k":"text","v":{"s":"Sophie: Maybe there's something we're missing."}},{"k":"read","v":{"b":false}}],"id":862},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-16-15"}},{"k":"text","v":{"s":"Sophie: Something someone outside all of this might notice."}},{"k":"read","v":{"b":false}}],"id":863},{"o":[{"k":"id","v":{"s":"OPEN-S03-C17-a-1"}},{"k":"text","v":{"s":"Sophie: Really?"}},{"k":"read","v":{"b":false}}],"id":864},{"o":[{"k":"id","v":{"s":"OPEN-S03-C17-a-2"}},{"k":"text","v":{"s":"Sophie: Thank you."}},{"k":"read","v":{"b":false}}],"id":865},{"o":[{"k":"id","v":{"s":"OPEN-S03-C17-a-3"}},{"k":"text","v":{"s":"Sophie: I mean it."}},{"k":"read","v":{"b":false}}],"id":866},{"o":[{"k":"id","v":{"s":"OPEN-S03-C17-a-4"}},{"k":"text","v":{"s":"Sophie: Even just talking things through might help.