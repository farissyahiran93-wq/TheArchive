"n":1792585815297}}],"id":1170},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-10-6"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Oh boy."}},{"k":"at","v":{"n":1792585818197}}],"id":1171},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-10-7"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Where do I even start?"}},{"k":"at","v":{"n":1792585819397}}],"id":1172},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-10-8"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"He's known Daniel since they were kids."}},{"k":"at","v":{"n":1792585820797}}],"id":1173},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-10-9"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"They practically grew up together."}},{"k":"at","v":{"n":1792585821997}}],"id":1174},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-10-10"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Which means he's had years to perfect the art of being impossible."}},{"k":"at","v":{"n":1792585823897}}],"id":1175},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-10-11"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"😅"}},{"k":"at","v":{"n":1792585824797}}],"id":1176},{"o":[{"k":"id","v":{"s":"OPEN-S03-C11-PLAYER-a"}},{"k":"sender","v":{"s":"player"}},{"k":"text","v":{"s":"He seems very protective."}},{"k":"at","v":{"n":1792585824897}}],"id":1177},{"o":[{"k":"id","v":{"s":"OPEN-S03-C11-a-1"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Yeah."}},{"k":"at","v":{"n":1792585825797}}],"id":1178},{"o":[{"k":"id","v":{"s":"OPEN-S03-C11-a-2"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"That's a good word for him."}},{"k":"at","v":{"n":1792585827097}}],"id":1179},{"o":[{"k":"id","v":{"s":"OPEN-S03-C11-a-3"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"He doesn't always show it in the nicest way."}},{"k":"at","v":{"n":1792585828697}}],"id":1180},{"o":[{"k":"id","v":{"s":"OPEN-S03-C11-a-4"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"But he cares."}},{"k":"at","v":{"n":1792585829697}}],"id":1181},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-11-1"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"He and Daniel used to argue about the stupidest things."}},{"k":"at","v":{"n":1792585831397}}],"id":1182},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-11-2"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Music."}},{"k":"at","v":{"n":1792585832297}}],"id":1183},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-11-3"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Football."}},{"k":"at","v":{"n":1792585833197}}],"id":1184},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-11-4"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Who was right about something neither of them actually understood."}},{"k":"at","v":{"n":1792585834897}}],"id":1185},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-11-5"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"And then five minutes later they'd be laughing again."}},{"k":"at","v":{"n":1792585836497}}],"id":1186},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-11-6"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"That's just how they were."}},{"k":"at","v":{"n":1792585837697}}],"id":1187},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-11-8"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"I think he's having a hard time accepting that he can't just call Daniel and argue with him about this."}},{"k":"at","v":{"n":1792585842397}}],"id":1188},{"o":[{"k":"id","v":{"s":"OPEN-S03-C12-PLAYER-a"}},{"k":"sender","v":{"s":"player"}},{"k":"text","v":{"s":"Do you think he'll come back?"}},{"k":"at","v":{"n":1792585842497}}],"id":1189},{"o":[{"k":"id","v":{"s":"OPEN-S03-C12-a-1"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"I hope so."}},{"k":"at","v":{"n":1792585843497}}],"id":1190},{"o":[{"k":"id","v":{"s":"OPEN-S03-C12-a-2"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"He's angry, not heartless."}},{"k":"at","v":{"n":1792585844597}}],"id":1191},{"o":[{"k":"id","v":{"s":"OPEN-S03-C12-a-3"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"I don't think he wants to walk away from Daniel."}},{"k":"at","v":{"n":1792585846297}}],"id":1192},{"o":[{"k":"id","v":{"s":"OPEN-S03-C12-a-4"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"He just doesn't want to do things this way."}},{"k":"at","v":{"n":1792585847897}}],"id":1193},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-12-1"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Whatever you think of Lucas..."}},{"k":"at","v":{"n":1792585849097}}],"id":1194},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-12-2"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Please don't assume he's your enemy."}},{"k":"at","v":{"n":1792585850397}}],"id":1195},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-12-3"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"I don't think he is."}},{"k":"at","v":{"n":1792585851597}}],"id":1196},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-12-5"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Oh!"}},{"k":"at","v":{"n":1792585854497}}],"id":1197},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-12-6"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"And there's Eli."}},{"k":"at","v":{"n":1792585855497}}],"id":1198},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-12-7"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"I almost forgot you haven't actually spoken to her."}},{"k":"at","v":{"n":1792585857097}}],"id":1199},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-12-8"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"She's much quieter in group chats."}},{"k":"at","v":{"n":1792585858397}}],"id":1200},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-12-9"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Sometimes I wonder whether she even reads half the messages."}},{"k":"at","v":{"n":1792585860097}}],"id":1201},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-12-10"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Then she'll reply to something from s