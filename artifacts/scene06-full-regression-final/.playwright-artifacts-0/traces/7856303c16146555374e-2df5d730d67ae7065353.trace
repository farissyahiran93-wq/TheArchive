"},["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble sophie"},"So that's Maya, Lucas and Eli."]]],["DIV",{"class":"conversation-line incoming chat-group-continuation chat-group-open"},["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble sophie"},"In the least useful introduction tour imaginable."]]],["DIV",{"class":"conversation-line incoming chat-group-continuation chat-group-open"},["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble sophie"},"They have one thing in common."]]],["DIV",{"class":"conversation-line incoming chat-group-continuation chat-group-open"},["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble sophie"},"They want Daniel back."]]],["DIV",{"class":"conversation-line incoming chat-group-continuation chat-group-open"},["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble sophie"},"And they disagree about almost everything else."]]],["DIV",{"class":"conversation-line incoming chat-group-continuation chat-group-end"},["SPAN",{"class":"chat-contact-avatar"},["SPAN",{"class":"character-avatar message-avatar","aria-hidden":"true"},["IMG",{"__playwright_current_src__":"http://127.0.0.1:4201/media/portraits/sophie-avatar.webp","alt":"","loading":"lazy","decoding":"async","src":"/media/portraits/sophie-avatar.webp"}]]],["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble sophie"},"I guess that's what happens when you ask five people to be scared in exactly the same way."]]],[[169,469]]],["DIV",{"class":"opening-actions opening-v4-composer"},["DIV",{"class":"opening-action-heading"},"Choose a reply"],["DIV",{"class":"scene01-options"},["BUTTON",{"class":"opening-choice ","aria-pressed":"false"},"Maya seems the easiest to talk to."],["BUTTON",{"class":"opening-choice ","aria-pressed":"false"},"I'm not sure about Lucas."],["BUTTON",{"class":"opening-choice ","aria-pressed":"false"},"Eli sounds interesting."],["BUTTON",{"class":"opening-choice ","aria-pressed":"f