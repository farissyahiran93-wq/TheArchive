",{"class":"conversation-body"},["DIV",{"class":"opening-bubble sophie"},"Lucas used to come over so often my mum stopped asking if he was staying for dinner."]]],["DIV",{"class":"conversation-line incoming chat-group-continuation chat-group-open"},["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble sophie"},"She just put out another plate."]]],["DIV",{"class":"conversation-line incoming chat-group-continuation chat-group-open"},["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble sophie"},"He'd complain about being treated like family."]]],["DIV",{"class":"conversation-line incoming chat-group-continuation chat-group-open"},["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble sophie"},"Then turn up the next day anyway."]]],["DIV",{"class":"conversation-line incoming chat-group-continuation chat-group-end"},["SPAN",{"class":"chat-contact-avatar"},["SPAN",{"class":"character-avatar message-avatar","aria-hidden":"true"},["IMG",{"__playwright_current_src__":"http://127.0.0.1:4201/media/portraits/sophie-avatar.webp","alt":"","loading":"lazy","decoding":"async","src":"/media/portraits/sophie-avatar.webp"}]]],["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble sophie"},"I don't know when the arguing stopped being the fun kind."]]],[[121,469]]],["DIV",{"class":"opening-actions opening-v4-composer"},["DIV",{"class":"opening-action-heading"},"Choose a reply"],["DIV",{"class":"scene01-options"},["BUTTON",{"class":"opening-choice ","aria-pressed":"false"},"He sounded very protective."],["BUTTON",{"class":"opening-choice ","aria-pressed":"false"},"He acted like I was a criminal."],["BUTTON",{"class":"opening-choice ","aria-pressed":"false"},"He had some fair questions."],["BUTTON",{"class":"opening-choice ","aria-pressed":"false"},"Why would he leave the group?"],["BUTTON",{"class":"opening-choice ","aria-pressed":"false"},["svg",{"xmlns":"http://www.w3.org/2000/svg","width":"14","height":"14","viewBox":"0 0 24 2