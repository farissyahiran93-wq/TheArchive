]],[[84,38]],[[84,45]],[[3,47]],[[72,6]],[[72,10]],[[72,14]],[[72,18]],[[72,22]],[[72,26]],[[72,33]],[[3,50]],[[60,6]],[[60,10]],[[60,14]],[[60,18]],[[60,22]],[[60,29]],[[3,53]],[[48,6]],[[48,10]],[[48,14]],[[48,18]],[[48,22]],[[48,26]],[[48,30]],[[48,34]],[[48,38]],[[48,42]],[[48,46]],[[48,50]],[[48,54]],[[48,58]],[[48,62]],[[48,69]],[[3,56]],[[36,6]],[[36,10]],[[36,14]],[[36,18]],[[36,22]],[[36,26]],[[36,30]],[[36,34]],[[36,41]],[[3,59]],[[24,6]],[[24,10]],[[24,14]],[[24,18]],[[24,22]],[[24,26]],[[24,33]],[[3,62]],[[12,6]],[[12,10]],[[12,14]],[[12,18]],[[12,22]],[[12,26]],[[12,30]],[[12,34]],[[12,38]],[[12,45]],[[1,3]],["DIV",{"class":"conversation-line incoming chat-group-start chat-group-open"},["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble sophie"},"She's Daniel's fiancée."]]],["DIV",{"class":"conversation-line incoming chat-group-continuation chat-group-open"},["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble sophie"},"They were planning a wedding."]]],["DIV",{"class":"conversation-line incoming chat-group-continuation chat-group-open"},["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble sophie"},"Maya Chen."]]],["DIV",{"class":"conversation-line incoming chat-group-continuation chat-group-open"},["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble sophie"},"That's her full name, by the way."]]],["DIV",{"class":"conversation-line incoming chat-group-continuation chat-group-open"},["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble sophie"},"She's frighteningly good at spreadsheets."]]],["DIV",{"class":"conversation-line incoming chat-group-continuation chat-group-open"},["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble sophie"},"Daniel once said dating her was like having an extremely attractive project manager."]]],["DIV",{"class":"conversation-line incoming chat-group-continuation chat-group-open"},["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble sophie"},"He said that in front of her."]]],["DIV",{"class":"conversation-line incoming chat-group-continuation chat-group-open"},["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble sophie"},"He was lucky to survive dinner."]]],["DIV",{"class":"conversation-line incoming chat-group-continuation chat-group-open"},["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble sophie"},"I can still hear her saying, \"I am not managing you as a project, Daniel.\""]]],["DIV",{"class":"conversation-line incoming chat-group-continuation chat-group-open"},["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble sophie"},"He said, \"Well, the results speak for themselves.\""]]],["DIV",{"class":"conversation-line incoming chat-group-continuation chat-group-end"},["SPAN",{"class":"chat-contact-avatar"},["SPAN",{"class":"character-avatar message-avatar","aria-hidden":"true"},["IMG",{"__playwright_current_src__":"http://127.0.0.1:4201/media/portraits/sophie-avatar.webp","alt":"","loading":"lazy","decoding":"async","src":"/media/portraits/sophie-avatar.webp"}]]],["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble sophie"},"And she threw a napkin at him."]]],[[97,469]]],["DIV",{"class":"opening-actions opening-v4-composer"},["DIV",{"class":"opening-action-heading"},"Choose a reply"],["DIV",{"class":"scene01-options"},["BUTTON",{"class":"opening-choice ","aria-pressed":"false"},"Did they seem happy together?"],["BUTTON",{"class":"opening-choice ","aria-pressed":"false"},"She doesn't seem convinced I'm safe."],["BUTTON",{"class":"opening-choice ","aria-pressed":"false"},"Do you think she knows something?"],["BUTTON",{"class":"opening-choice ","aria-pressed":"false"},"I feel bad for her."]],["BUTTON",{"class":"opening-primary","disabled":""},["svg",{"xmlns":"http://www.w3.org/2000/svg","width":"17","height":"17","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","stroke-width":"2","stroke-linecap":"round","