: flex; gap: 10px; }\n.chat-photo-viewer button { display: grid; place-items: center; width: 44px; height: 44px; border: 0; border-radius: 50%; background: #ffffff15; color: white; }\n.chat-photo-viewer button:disabled { opacity: .35; }\n.chat-photo-canvas { display: flex; flex: 1; min-height: 0; align-items: center; justify-content: center; overflow: hidden; touch-action: none; }\n.chat-photo-canvas img { width: 100%; max-height: 100%; object-fit: contain; user-select: none; transform-origin: center; }\n.phone-notification-layer { position: absolute; z-index: 2000; top: 52px; left: 10px; right: 10px; pointer-events: none; }\n.native-app .phone-notification-layer { top: calc(env(safe-area-inset-top) + 8px); }\n.phone-notification { position: relative; pointer-events: auto; background: color-mix(in srgb, var(--surface) 94%, transparent); border: 1px solid var(--line); border-radius: 19px; color: var(--text); box-shadow: 0 8px 28px #0003; backdrop-filter: blur(24px); touch-action: none; overflow: hidden; animation: phone-notice-enter .2s ease-out; }\n.phone-notification-open { display: flex; align-items: center; gap: 10px; width: 100%; min-height: 88px; background: none; border: 0; color: inherit; padding: 12px 34px 12px 12px; text-align: left; cursor: pointer; }\n.phone-notification-open > span:last-child { display: grid; gap: 3px; min-width: 0; flex: 1; }\n.phone-notification-open small { font-size: 9px; font-weight: 650; color: var(--muted); letter-spacing: .04em; }\n.phone-notification-open time { float: right; font-weight: 400; }\n.phone-notification-open strong { font-size: 13px; }\n.phone-notification-open > span > span { font-size: 12px; line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }\n.phone-notification .notice-avatar { flex: 0 0 38px; width: 38px; height: 38px; display: grid; place-items: center; border-radius: 11px; overflow: hidden; background: #476a70; color: white; }\n.notice-avatar img { width: 100%; height: 100%; object-fit: cover; }\n.phone-notification-dismiss { position: absolute; top: 4px; right: 3px; width: 30px; height: 30px; display: grid; place-items: center; background: none; border: 0; color: var(--muted); cursor: pointer; }\n@keyframes phone-notice-enter { from { translate: 0 -110%; opacity: 0; } to { translate: 0 0; opacity: 1; } }\n@media (prefers-reduced-motion: reduce) { .phone-notification { animation: none; } }\n"],["STYLE",{},":root{font-family:system-ui,-apple-system,\"Segoe UI\",sans-serif;font-synthesis:none;text-rendering:optimizeLegibility;color:#1e2935;background:#172734}\n*{box-sizing:border-box}html,body,#root{width:100%;height:100%;margin:0;overflow:hidden}button,input,select,textarea{font:inherit}button{cursor:pointer}button:disabled{cursor:not-allowed}button:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible{outline:3px solid #eaa26e;outline-offset:2px}h1,h2,p{margin-top:0}.sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap}\n.app-root{--phone-bg:#f5f3f8;--surface:#fff;--raised:#f8f7fb;--text:#202736;--muted:#667081;--line:#dedfe7;--accent:#6759aa;--button-accent:#6759aa;--incoming:#e9e9ef;--outgoing:#6b5caf;--outgoing-text:#fff;--header:#faf9fd;--shadow:0 10px 30px #192d3b12;display:flex;justify-content:center;width:100%;height:var(--visual-height,100dvh);overflow:hidden;background:#172734;color:var(--text)}\n.theme-dark{--phone-bg:#081c2c;--surface:#13293e;--raised:#1a344c;--text:#f2f6f8;--muted:#aec0d1;--line:#31495e;--accent:#5595ff;--button-accent:#286bd4;--incoming:#263d55;--outgoing:#2a70de;--outgoing-text:#fff;--header:#10283d;--shadow:0 10px 30px #0003}\n.device{width:min(100%,460px);height:100%;display:flex;flex-direction:column;min-height:0;overflow:hidden;position:relative;background:var(--phone-bg);box-shadow:0 0 70px #0005}\n.status-bar{flex:none;height:calc(36px + env(safe-area-inset-top));padding:env(safe-area-inset-top) 21px 0;