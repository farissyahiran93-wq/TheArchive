"v":{"s":"OPEN-S02-FINAL-C12-a-3"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: You just got the front-row seat."}},{"k":"read","v":{"b":false}}],"id":473},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-AFTER-12-2"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I should explain something to you."}},{"k":"read","v":{"b":false}}],"id":474},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-AFTER-12-3"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Not the whole story."}},{"k":"read","v":{"b":false}}],"id":475},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-AFTER-12-4"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I don't think I even know the whole story."}},{"k":"read","v":{"b":false}}],"id":476},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-AFTER-12-5"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: But enough so you understand why I wrote to you."}},{"k":"read","v":{"b":false}}],"id":477},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-AFTER-12-8"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Could we talk somewhere else?"}},{"k":"read","v":{"b":false}}],"id":478},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-AFTER-12-9"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Just you and me."}},{"k":"read","v":{"b":false}}],"id":479},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-AFTER-12-10"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I don't want to start another argument in here."}},{"k":"read","v":{"b":false}}],"id":480},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-C13-a-1"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Okay."}},{"k":"read","v":{"b":false}}],"id":481},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-C13-a-2"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Thanks."}},{"k":"read","v":{"b":false}}],"id":482},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-AFTER-13-1"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: And, um..."}},{"k":"read","v":{"b":false}}],"id":483},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-AFTER-13-2"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Thanks for staying as long as you did."}},{"k":"read","v":{"b"