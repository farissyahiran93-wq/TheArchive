: flex; gap: 10px; }\n.chat-photo-viewer button { display: grid; place-items: center; width: 44px; height: 44px; border: 0; border-radius: 50%; background: #ffffff15; color: white; }\n.chat-photo-viewer button:disabled { opacity: .35; }\n.chat-photo-canvas { display: flex; flex: 1; min-height: 0; align-items: center; justify-content: center; overflow: hidden; touch-action: none; }\n.chat-photo-canvas img { width: 100%; max-height: 100%; object-fit: contain; user-select: none; transform-origin: center; }\n.phone-notification-layer { position: absolute; z-index: 2000; top: 52px; left: 10px; right: 10px; pointer-events: none; }\n.native-app .phone-notification-layer { top: calc(env(safe-area-inset-top) + 8px); }\n.phone-notification { position: relative; pointer-events: auto; background: color-mix(in srgb, var(--surface) 94%, transparent); border: 1px solid var(--line); border-radius: 19px; color: var(--text); box-shadow: 0 8px 28px #0003; backdrop-filter: blur(24px); touch-action: none; overflow: hidden; animation: phone-notice-enter .2s ease-out; }\n.phone-notification-open { display: flex; align-items: center; gap: 10px; width: 100%; min-height: 88px; background: none; border: 0; color: inherit; padding: 12px 34px 12px 12px; text-align: left; cursor: pointer; }\n.phone-notification-open > span:last-child { display: grid; gap: 3px; min-width: 0; flex: 1; }\n.phone-notification-open small { font-size: 9px; font-weight: 650; color: var(--muted); letter-spacing: .04em; }\n.phone-notification-open time { float: right; font-weight: 400; }\n.phone-notification-open strong { font-size: 13px; }\n.phone-notification-open > span > span { font-size: 12px; line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }\n.phone-notification .notice-avatar { flex: 0 0 38px; width: 38px; height: 38px; display: grid; place-items: center; border-radius: 11px; overflow: hidden; background: #476a70; color: white; }\n.notice-avatar img { 