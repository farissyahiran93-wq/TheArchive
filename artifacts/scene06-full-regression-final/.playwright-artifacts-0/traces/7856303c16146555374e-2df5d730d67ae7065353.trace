"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"But I don't know what that symbol means in this file."}},{"k":"at","v":{"n":1800000071450}}],"id":521},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-03-2"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Do you know Daniel?"}},{"k":"at","v":{"n":1800000077118}}],"id":522},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-03-3"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Daniel Mercer?"}},{"k":"at","v":{"n":1800000079840}}],"id":523},{"o":[{"k":"id","v":{"s":"OPEN-S01-C04-PLAYER-a"}},{"k":"sender","v":{"s":"player"}},{"k":"text","v":{"s":"No. Never heard the name."}},{"k":"at","v":{"n":1800000079940}}],"id":524},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-C04-a-1"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Okay."}},{"k":"at","v":{"n":1800000082509}}],"id":525},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-C04-a-2"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"That was the most likely answer, I suppose."}},{"k":"at","v":{"n":1800000087055}}],"id":526},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-04-1"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Could you think back a little?"}},{"k":"at","v":{"n":1800000090795}}],"id":527},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-04-2"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Even an old online chat. A work message. Anything."}},{"k":"at","v":{"n":1800000095352}}],"id":528},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-04-3"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"I'm not asking you to guess."}},{"k":"at","v":{"n":1800000099058}}],"id":529},{"o":[{"k":"id","v":{"s":"OPEN-S01-C05-PLAYER-a"}},{"k":"sender","v":{"s":"player"}},{"k":"text","v":{"s":"I'm sure I haven't spoken to him."}},{"k":"at","v":{"n":1800000099158}}],"id":530},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-C05-a-1"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Then that's useful to know."}},{"k":"at","v":{"n":1800000102554}}],"id":531},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-05-1"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"I thought if I asked, the answer might be simple."}},{"k":"at","v":{"n":1800000107387}}],"id":532},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-05-2"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"“Oh, yeah. Daniel and I used to work together.”"}},{"k":"at","v":{"n":1800000112294}}],"id":533},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-05-3"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Something like that."}},{"k":"at","v":{"n":1800000115386}}],"id":534},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-05-5"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Sorry. I'm talking as if you already know what's happened."}},{"k":"at","v":{"n":1800000122372}}],"id":535},{"o":[{"k":"id","v":{"s":"OPEN-S01-C06-PLAYER-a"}},{"k":"sender","v":{"s":"player"}},{"k":"text","v":{"s":"Then tell me."}},{"k":"at","v":{"n":1800000122472}}],"id":536},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-C06-a-1"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Right."}},{"k":"at","v":{"n":1800000125058}}],"id":537},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-06-1"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Daniel stopped replying."}},{"k":"at","v":{"n":1800000127817}}],"id":538},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-06-2"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Messages. Calls."}},{"k":"at","v":{"n":1800000130573}}],"id":539},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-06-4"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"For days now."}},{"k":"at","v":{"n":1800000135746}}],"id":540},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-06-5"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"At first we thought he was busy."}},{"k":"at","v":{"n":1800000139813}}],"id":541},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-06-6"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Then we thought maybe he wanted space."}},{"k":"at","v":{"n":1800000143982}}],"id":542},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-06-8"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"I don't know what to think anymore."}},{"k":"at","v":{"n":1800000151600}}],"id":543},{"o":[{"k":"id","v":{"s":"OPEN-S01-C07-PLAYER-a"}},{"k":"sender","v":{"s":"player"}},{"k":"text","v":{"s":"Have you tried checking on him in person?"}},{"k":"at","v":{"n":1800000151700}}],"id":544},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-C07-a-1"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"We have tried to check he's safe."}},{"k":"at","v":{"n":1800000155784}}],"id":545},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-C07-a-2"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"I don't want to give you a version of events I'm not sure about."}},{"k":"at","v":{"n":1800000162043}}],"id":546},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-07-1"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"I'm sorry. I should've said that sooner."}},{"k":"at","v":{"n":1800000166246}}],"id":547},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-07-2"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"You don't owe me your time."}},{"k":"at","v":{"n":1800000169935}}],"id":548},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-07-3"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"I haven't even asked what to call you."}},{"k":"at","v":{"n":1800000174396}}],"id":549},{"o":[{"k":"id","v":{"s":"OPEN-S01-C08-PLAYER-a"}},{"k":"sender","v":{"s":"player"}},{"k":"text","v":{"s":"You can call me Alex."}},{"k":"at","v":{"n":1800000174496}}],"id":550},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-C08-a-1"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Alex. Got it."}},{"k":"at","v":{"n":1800000177622}}],"id":551},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-C08-a-2"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Nice to meet you. In a very odd way."}},{"k