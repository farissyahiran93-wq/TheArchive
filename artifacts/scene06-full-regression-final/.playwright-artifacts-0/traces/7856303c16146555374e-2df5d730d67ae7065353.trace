o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-AFTER-10-6"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: I know."}},{"k":"read","v":{"b":false}}],"id":413},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-AFTER-10-7"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: And I can't stand it."}},{"k":"read","v":{"b":false}}],"id":414},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-AFTER-10-8"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Lucas..."}},{"k":"read","v":{"b":false}}],"id":415},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-AFTER-10-9"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: There are conversations I should've had with him."}},{"k":"read","v":{"b":false}}],"id":416},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-AFTER-10-10"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Stuff I thought there'd be time for."}},{"k":"read","v":{"b":false}}],"id":417},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-AFTER-10-12"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: I keep thinking if I knew where to start looking, we could actually do something."}},{"k":"read","v":{"b":false}}],"id":418},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-AFTER-10-13"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Instead we're fighting about a star beside a number."}},{"k":"read","v":{"b":false}}],"id":419},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-AFTER-10-14"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: We don't know if it's meaningless."}},{"k":"read","v":{"b":false}}],"id":420},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-AFTER-10-15"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: I know."}},{"k":"read","v":{"b":false}}],"id":421},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-AFTER-10-16"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: That's what makes it worse."}},{"k":"read","v":{"b":false}}],"id":422},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-AFTER-10-18"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Nobody here knows what to do yet."}},{"k":"read","v":{"b":false}}],"id":423},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-AFTER-10-19"}},{"k":"text","v":{"s":"F