adius:4px;align-self:flex-start}\r\n.mirror-chat-bubble.outgoing{background:#0a84ff;border-bottom-right-radius:4px;align-self:flex-end;color:#fff}\r\n.mirror-email-body{background:#26262b;padding:15px;border-radius:13px;margin-top:14px}\r\n.mirror-mail-label{color:#89b8ec;font-weight:600;font-size:10px;letter-spacing:.09em}\r\n.mirror-note-body{border-radius:12px;background:#27282c;padding:15px;margin-top:14px}\r\n\r\n.opening-jump{position:absolute;right:16px;top:85px;z-index:3;background:#0a84ff;color:white;border:0;border-radius:20px;padding:10px 14px}\r\n.opening-actions{max-height:47%;overflow-y:auto;padding-bottom:max(12px,env(safe-area-inset-bottom))}\r\n.opening-screen{min-width:0;position:relative}.opening-choice{overflow-wrap:anywhere;min-height:44px}\r\n@media(prefers-reduced-motion:reduce){.opening-screen *{animation:none!important;transition:none!important;scroll-behavior:auto!important}}\r\n\r\n.opening-note[role=dialog]{position:absolute;inset:0;z-index:10;overflow-y:auto;margin:0;border-radius:0;background:#1c1c1e;padding:20px;color:#eee}\r\n.opening-note[role=dialog] img{display:block;width:100%;height:auto;margin:14px 0}\r\n.opening-note-close{min-height:44px;margin-left:auto!important}\r\n\r\n.opening-screen .opening-note[role=dialog]{max-width:none;width:auto;transform:none;border-radius:0!important;background:#1c1c1e!important;color:#eee!important}\r\n.opening-screen .opening-note[role=dialog]>p{color:#eee!important}\r\n.opening-screen .opening-note[role=dialog] .opening-confirm{color:#83d8aa}\r\n.daniel-note-content{max-width:480px;margin:0 auto 18px}\r\n.opening-note[role=dialog] .daniel-note-content img{max-height:62vh;object-fit:contain;margin:16px auto}\r\n.daniel-note-transcript{border:1px solid #45454d;border-radius:12px;background:#252529;color:#eee;overflow:hidden}\r\n.daniel-note-transcript summary{min-height:44px;padding:12px 14px;cursor:pointer;font:600 14px/1.5 system-ui,sans-serif}\r\n.daniel-note-transcript>div{padding:0 16px 12px;border-top:1px solid #45454d}\r\n.daniel-note-transcript p{font:15px/1.65 system-ui,sans-serif;margin:12px 0;overflow-wrap:anywhere}\r\n.daniel-note-caption{font:12px/1.5 system-ui,sans-serif;color:#b9b9c3;margin:12px 2px}\r\n.daniel-note-transcript summary:focus-visible{outline:2px solid #87c5ff;outline-offset:-3px}\r\n.opening-stage-top .mirror-back{margin:0 0 0 auto;padding:6px;font-size:12px;min-height:44px}\r\n"],["STYLE",{},".opening-v4 .opening-thread{min-height:0;overflow-y:auto;scroll-behavior:smooth}\n.opening-v4-attachment{display:block;width:min(62%,220px);margin:8px 15px 15px auto;padding:0;border:0;border-radius:12px;overflow:hidden;background:#202a36;color:white;text-align:left;box-shadow:0 4px 14px #0003}\n.opening-v4-attachment img{display:block;width:100%;max-height:250px;object-fit:cover;object-position:top}\n.opening-v4-attachment span{display:block;padding:8px 10px;font-size:12px}\n.opening-v4-full-photo{display:block;max-width:100%;max-height:75vh;object-fit:contain;margin:auto}\n.opening-v4-typing{display:flex;align-items:center;gap:8px;margin:10px 15px;font-size:12px;color:#7e8792}\n.opening-v4-name-row{display:flex;gap:8px;align-items:center}\n.opening-v4-name-row input{min-width:0;flex:1;border:1px solid #aeb8c4;border-radius:10px;padding:10px 12px;font:inherit}\n.opening-v4-name-row .opening-primary{width:auto;white-space:nowrap}\n.opening-v4-idle{display:block;text-align:center;padding:8px;color:#7e8792;font-size:13px}\n@media (prefers-reduced-motion:reduce){.opening-v4 .opening-thread{scroll-behavior:auto}.opening-v4 .typing-dots i{animation:none}}\n"],["STYLE",{},".recovery-sequence { min-height: 0; }\n.recovery-sequence .opening-thread { scroll-behavior: auto; }\n.recovery-caption { font-size: 12px; color: var(--muted); }\n.recovery-puzzle { border: 1px solid #536677; border-radius: 16px; padding: 16px; margin: 20px 0; background: #162231; color: #f3f6fa; }\n.recovery-puzzle h1 { font-size: 22px; margin: 0 0 10px; }\n.recovery-puzzle p { font-size: 13px; line-height: 1.6; }\n.recovery-cards { list-style: none; padding: 0; display: grid; gap: 10px; }\n.recovery-cards .opening-choice { width: 100%; display: grid; gap: 8px; text-align: left; margin: 0; min-height: 110px; }\n.recovery-cards small { font-size: 11px; line-height: 1.5; color: var(--muted); }\n.recovery-cards button:disabled { opacity: 1; cursor: default; }\n.recovery-tools { display: grid; gap: 8px; }\n.recovery-puzzle aside { border-left: 3px solid #8bcbd7; padding-left: 12px; }\n"],["STYLE",{},"/* Shared phone behaviour; independent of narrative progression. */\n.device * { scrollbar-width: none; }\n.device *::-webkit-scrollbar { display: none; width: 0; height: 0; }\n.device .opening-chat-header { justify-content: flex-start; gap: 11px; padding: 10px 14px; min-height: 72px; text-align: left; }\n.device .opening-chat-header > div { flex: 1; align-items: flex-start; text-align: left; min-width: 0; }\n.device .opening-chat-header > .icon-button { position: static; flex: 0 0 32px; padding: 4px; min-width: 32px; }\n.device .opening-chat-header strong { font-size: 15px; }\n.device .opening-chat-header small { margin-top: 4px; font-size: 11px; max-width: 100%; }\n.device .native-chat-header { display: flex; flex-direction: row; align-items: center; justify-content: flex-start; gap: 12px; min-height: 72px; padding: 10px 14px; }\n.device .native-chat-header > .native-back-button { position: static; flex: none; }\n.device .native-chat-contact { display: flex; flex-direction: row; gap: 10px; align-items: center; text-align: left; }\n.device .native-chat-contact .chat-title { align-items: flex-start; text-align: left; }\n.chat-contact-avatar { position: relative; display: flex; flex: none; }\n.presence-dot { position: absolute; bottom: 0; right: 0; border: 2px solid var(--header); background: #35af78; width: 11px; height: 11px; border-radius: 50%; }\n.device .thread-row { position: relative; }\n.thread-online { position: absolute; left: 46px; top: 48px; width: 11px; height: 11px; border-radius: 50%; background: #35af78; border: 2px solid var(--surface); }\n.device .conversation-line { display: flex; gap: 8px; align-items: flex-end; flex: none; width: 100%; }\n.device .conversation-line.outgoing { justify-content: flex-end; }\n.device .conversation-line.incoming.chat-group-open { padding-left: 36px; }\n.device .conversation-line.incoming.chat-group-open .conversation-body { max-width: 100%; }\n.device .conversation-line.chat-group-start { margin-top: 5px; }\n.device .conversation-body .opening-bubble { overflow-wrap: anywhere; }\n.device .scene01-chat .chat-group-action { display: inline-flex; align-items: center; justify-content: center; align-self: flex-start; flex: none; width: fit-content; max-width: 100%; min-height: 44px; margin: 12px 0 4px 36px; padding: 10px 14px; border: 1px solid #547e7b; border-radius: 12px; background: #244b4b; color: #f1faf8; font: inherit; font-size: 13px; font-weight: 600; cursor: pointer; }\n.device .scene01-chat .chat-group-action:focus-visible { outline: 2px solid #72bdb4; outline-offset: 3px; }\n.device .message-avatar { flex: 0 0 28px; width: 28px; height: 28px; border-radius: 50%; overflow: hidden; display: grid; place-items: center; background: #506576; color: white; font-size: 12px; }\n.message-avatar img { width: 100%; height: 100%; object-fit: cover; }\n.conversation-body { max-width: calc(100% - 38px); min-width: 0; }\n.outgoing .conversation-body { max-width: 84%; }\n.device .conversation-body .opening-bubble { max-width: 100% !important; margin: 0; border-radius: 15px 15px 15px 5px; padding: 11px 13px; }\n.device .conversation-body .opening-bubble.player { background: #286f70 !important; border-radius: 15px 15px 5px 15px; color: #fff !important; }\n.device .group-sender { display: block; font-size: 11px; font-weight: 650; margin: 0 0 5px 5px; color: var(--muted); }\n.device .opening-v4-typing { display: flex; align-items: center; gap: 8px; margin: 5px 0; min-hei