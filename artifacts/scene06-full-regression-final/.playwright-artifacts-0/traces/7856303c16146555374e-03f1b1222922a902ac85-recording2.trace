trust","v":{"n":0}},{"k":"affinity","v":{"n":0}},{"k":"suspicion","v":{"n":0}},{"k":"romance","v":{"n":0}}],"id":47}}],"id":41}},{"k":"evidence","v":{"o":[],"id":48}},{"k":"notifications","v":{"a":[{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-OPENING-1"}},{"k":"text","v":{"s":"Unknown number: Hi."}},{"k":"read","v":{"b":false}}],"id":50},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-OPENING-3"}},{"k":"text","v":{"s":"Unknown number: Sorry. This is going to sound odd."}},{"k":"read","v":{"b":false}}],"id":51},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-OPENING-6"}},{"k":"text","v":{"s":"Unknown number: Is this still your number?"}},{"k":"read","v":{"b":false}}],"id":52},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-C01-a-1"}},{"k":"text","v":{"s":"Unknown number: Fair question."}},{"k":"read","v":{"b":false}}],"id":53},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-C01-a-2"}},{"k":"text","v":{"s":"Sophie: I'm Sophie."}},{"k":"read","v":{"b":false}}],"id":54},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-C01-a-3"}},{"k":"text","v":{"s":"Sophie: And that probably doesn't help much."}},{"k":"read","v":{"b":false}}],"id":55},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-01-1"}},{"k":"text","v":{"s":"Sophie: I don't expect you to know me."}},{"k":"read","v":{"b":false}}],"id":56},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-01-2"}},{"k":"text","v":{"s":"Sophie: I found this number saved somewhere."}},{"k":"read","v":{"b":false}}],"id":57},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-01-4"}},{"k":"text","v":{"s":"Sophie: Can I explain?"}},{"k":"read","v":{"b":false}}],"id":58},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-C02-a-1"}},{"k":"text","v":{"s":"Sophie: Thank you."}},{"k":"read","v":{"b":false}}],"id":59},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-02-1"}},{"k":"text","v":{"s":"Sophie: It's a saved copy of someone's contacts."}},{"k":"read","v":{"b":false}}],"id":60},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-02-2"}},{"k":"text","v":{"s":"Sophie: The file says it belongs to Daniel Mercer."}},{"k":"read","v":{"b":false}}],"id":61},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-02-3"}},{"k":"text","v":{"s":"Sophie: I was looking through it earlier."}},{"k":"read","v":{"b":false}}],"id":62},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-02-5"}},{"k":"text","v":{"s":"Sophie: Your number is in there."}},{"k":"read","v":{"b":false}}],"id":63},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-02-6"}},{"k":"text","v":{"s":"Sophie: No name beside it."}},{"k":"read","v":{"b":false}}],"id":64},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-02-7"}},{"k":"text","v":{"s":"Sophie: Just a star."}},{"k":"read","v":{"b":false}}],"id":65},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-C03-a-1"}},{"k":"text","v":{"s":"Sophie: Yeah. Like a favourite, maybe."}},{"k":"read","v":{"b":false}}],"id":66},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-C03-a-2"}},{"k":"text","v":{"s":"Sophie: But I don't know what that symbol means in this file."}},{"k":"read","v":{"b":false}}],"id":67},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-03-2"}},{"k":"text","v":{"s":"Sophie: Do you know Daniel?"}},{"k":"read","v":{"b":false}}],"id":68},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-03-3"}},{"k":"text","v":{"s":"Sophie: Daniel Mercer?"}},{"k":"read","v":{"b":false}}],"id":69},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-C04-a-1"}},{"k":"text","v":{"s":"Sophie: Okay."}},{"k":"read","v":{"b":false}}],"id":70},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-C04-a-2"}},{"k":"text","v":{"s":"Sophie: That was the most likely answer, I suppose."}},{"k":"read","v":{"b":false}}],"id":71},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-04-1"}},{"k":"text","v":{"s":"Sophie: Could you think back a little?"}},{"k":"read","v":{"b":false}}],"id":72},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-04-2"}},{"k":"text","v":{"s":"Sophie: Even an old online chat. A work message. Anything."}},{"k":"read","v":{"b":false}}],"id":73},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-04-3"}},{"k":"text","v":{"s":"Sophie: I'm not asking you to guess."}},{"k":"read","v":{"b":false}}],"id":74},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-C05-a-1"}},{"k":"text","v":{"s":"Sophie: Then that's useful to know."}},{"k":"read","v":{"b":false}}],"id":75},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-05-1"}},{"k":"text","v":{"s":"Sophie: I thought if I asked, the answer might be simple."}},{"k":"read","v":{"b":false}}],"id":76},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-05-2"}},{"k":"text","v":{"s":"Sophie: “Oh, yeah. Daniel and I used to work together.”"}},{"k":"read","v":{"b":false}}],"id":77},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-05-3"}},{"k":"text","v":{"s":"Sophie: Something like that."}},{"k":"read","v":{"b":false}}],"id":78},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-05-5"}},{"k":"text","v":{"s":"Sophie: Sorry. I'm talking as if you already know what's happened."}},{"k":"read","v":{"b":false}}],"id":79},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-C06-a-1"}},{"k":"text","v":{"s":"Sophie: Right."}},{"k":"read","v":{"b":false}}],"id":80},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-06-1"}},{"k":"text","v":{"s":"Sophie: Daniel stopped replying."}},{"k":"read","v":{"b":false}}],"id":81},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-06-2"}},{"k":"text","v":{"s":"Sophie: Messages. Calls."}},{"k":"read","v":{"b":false}}],"id":82},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-06-4"}},{"k":"text","v":{"s":"Sophie: For days now."}},{"k":"read","v":{"b":false}}],"id":83},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-06-5"}},{"k":"text","v":{"s":"Sophie: At first we thought he was busy."}},{"k":"read","v":{"b":false}}],"id":84},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-06-6"}},{"k":"text","v":{"s":"Sophie: Then we thought maybe he wanted space."}},{"k":"read","v":{"b":false}}],"id":85},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-06-8"}},{"k":"text","v":{"s":"Sophie: I don't know what to think anymore."}},{"k":"read","v":{"b":false}}],"id":86},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-C07-a-1"}},{"k":"text","v":{"s":"Sophie: We have tried to check he's safe."}},{"k":"read","v":{"b":false}}],"id":87},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-C07-a-2"}},{"k":"text","v":{"s":"Sophie: I don't want to give you a version of events I'm not sure about."}},{"k":"read","v":{"b":false}}],"id":88},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-07-1"}},{"k":"text","v":{"s":"Sophie: I'm sorry. I should've said that sooner."}},{"k":"read","v":{"b":false}}],"id":89},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-07-2"}},{"k":"text","v":{"s":"Sophie: You don't owe me your time."}},{"k":"read","v":{"b":false}}],"id":90},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-07-3"}},{"k":"text","v":{"s":"Sophie: I haven't even asked what to call you."}},{"k":"read","v":{"b":false}}],"id":91},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-C08-a-1"}},{"k":"text","v":{"s":"Sophie: Alex. Got it."}},{"k":"read","v":{"b":false}}],"id":92},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-C08-a-2"}},{"k":"text","v":{"s":"Sophie: Nice to meet you. In a very odd way."}},{"k":"read","v":{"b":false}}],"id":93},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-08-1"}},{"k":"text","v":{"s":"Sophie: You know what's strange?"}},{"k":"read","v":{"b":false}}],"id":94},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-08-2"}},{"k":"text","v":{"s":"Sophie: I nearly deleted this number."}},{"k":"read","v":{"b":false}}],"id":95},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-08-3"}},{"k":"text","v":{"s":"Sophie: I had my finger over it and everything."}},{"k":"read","v":{"b":false}}],"id":96},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-C09-a-1"}},{"k":"text","v":{"s":"Sophie: I kept thinking: what if this is the one person who can tell us something ordinary and useful?"}},{"k":"read","v":{"b":false}}],"id":97},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-09-1"}},{"k":"text","v":{"s":"Sophie: I didn't want to start believing the star meant something just because I was scared."}},{"k":"read","v":{"b":false}}],"id":98},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-09-2"}},{"k":"text","v":{"s":"Sophie: But I didn't want to delete the question either."}},{"k":"read","v":{"b":false}}],"id":99},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-09-4"}},{"k":"text","v":{"s":"Sophie: There are other people trying to find him."}},{"k":"read","v":{"b":false}}],"id":100},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-09-5"}},{"k":"text","v":{"s":"Sophie: Some of us are talking in a group."}},{"k":"read","v":{"b":false}}],"id":101},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-09-6"}},{"k":"text","v":{"s":"Sophie: Well, arguing in a group, lately."}},{"k":"read","v":{"b":false}}],"id":102},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-C10-a-1"}},{"k":"text","v":{"s":"Sophie: People close to him."}},{"k":"read","v":{"b":false}}],"id":103},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-C10-a-2"}},{"k":"text","v":{"s":"Sophie: I can introduce you properly if you decide to join."}},{"k":"read","v":{"b":false}}],"id":104},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-10-1"}},{"k":"text","v":{"s":"Sophie: I haven't told them I've been messaging you."}},{"k":"read","v":{"b":false}}],"id":105},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-10-2"}},{"k":"text","v":{"s":"Sophie: They knew about the number. Not that I would actually contact it."}},{"k":"read","v":{"b":false}}],"id":106},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-10-4"}},{"k":"text","v":{"s":"Sophie: I'm going to get an earful."}},{"k":"read","v":{"b":false}}],"id":107},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-C11-a-1"}},{"k":"text","v":{"s":"Sophie: That's probably the sensible thing."}},{"k":"read","v":{"b":false}}],"id":108},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-C11-a-2"}},{"k":"text","v":{"s":"Sophie: Sensible hasn't been my strongest quality this week."}},{"k":"read","v":{"b":false}}],"id":109},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-11-1"}},{"k":"text","v":{"s":"Sophie: Could I ask you something slightly unreasonable?"}},{"k":"read","v":{"b":false}}],"id":110},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-11-3"}},{"k":"text","v":{"s":"Sophie: Would you consider joining the chat?"}},{"k":"read","v":{"b":false}}],"id":111},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-11-4"}},{"k":"text","v":{"s":"Sophie: Only to listen at first. If you want."}},{"k":"read","v":{"b":false}}],"id":112},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-11-5"}},{"k":"text","v":{"s":"Sophie: I don't need you to promise you'll solve anything."}},{"k":"read","v":{"b":false}}],"id":113},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-C12-a-1"}},{"k":"text","v":{"s":"Sophie: You can tell us what you do and don't recognise."}},{"k":"read","v":{"b":false}}],"id":114},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-C12-a-2"}},{"k":"text","v":{"s":"Sophie: That alone might stop us making up stories around your number."}},{"k":"read","v":{"b":false}}],"id":115},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-12-1"}},{"k":"text","v":{"s":"Sophie: Look, you can say no."}},{"k":"read","v":{"b":false}}],"id":116},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-12-2"}},{"k":"text","v":{"s":"Sophie: I won't turn it into some kind of test."}},{"k":"read","v":{"b":false}}],"id":117},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-12-3"}},{"k":"text","v":{"s":"Sophie: But if you join, there are people who'll want to ask you questions."}},{"k":"read","v":{"b":false}}],"id":118},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-12-5"}},{"k":"text","v":{"s":"Sophie: One in particular."}},{"k":"read","v":{"b":false}}],"id":119}],"id":49}},{"k":"settings","v":{"o":[{"k":"reduceMotion","v":{"b":false}}],"id":120}},{"k":"prologue","v":{"o":[{"k":"dialogueVersion","v":{"n":4}},{"k":"stage","v":{"s":"chat"}},{"k":"step","v":{"n":0}},{"k":"messages","v":{"a":[],"id":122}},{"k":"noteSeen","v":{"b":false}},{"k":"offerInspected","v":{"b":false}},{"k":"restored","v":{"b":false}},{"k":"viewed","v":{"a":[],"id":123}},{"k":"indexCompared","v":{"b":false}},{"k":"scene01",