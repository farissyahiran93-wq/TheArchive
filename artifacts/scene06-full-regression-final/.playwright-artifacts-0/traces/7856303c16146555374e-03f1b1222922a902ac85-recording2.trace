ble sophie"},"Sorry. This is going to sound odd."]]],["DIV",{"class":"conversation-line incoming chat-group-continuation chat-group-end"},["SPAN",{"class":"chat-contact-avatar"},["SPAN",{"class":"character-avatar message-avatar","aria-hidden":"true"},["IMG",{"__playwright_current_src__":"http://127.0.0.1:4201/media/portraits/sophie-avatar.webp","alt":"","loading":"lazy","decoding":"async","src":"/media/portraits/sophie-avatar.webp"}]]],["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble sophie"},"Is this still your number?"]]],["DIV",{"class":"conversation-line outgoing chat-group-start chat-group-end"},["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble player"},"Who's asking?"]]],["DIV",{"class":"conversation-line incoming chat-group-start chat-group-open"},["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble sophie"},"Fair question."]]],["DIV",{"class":"conversation-line incoming chat-group-continuation chat-group-open"},["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble sophie"},"I'm Sophie."]]],["DIV",{"class":"conversation-line incoming chat-group-continuation chat-group-open"},["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble sophie"},"And that probably doesn't help much."]]],["DIV",{"class":"conversation-line incoming chat-group-continuation chat-group-open"},["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble sophie"},"I don't expect you to know me."]]],["DIV",{"class":"conversation-line incoming chat-group-continuation chat-group-open"},["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble sophie"},"I found this number saved somewhere."]]],["DIV",{"class":"conversation-line incoming chat-group-continuation chat-group-end"},["SPAN",{"class":"chat-contact-avatar"},["SPAN",{"class":"character-avatar message-avatar","aria-hidden":"true"},["IMG",{"__playwright_current_src__":"http://127.0.0.1:4201/media/portraits/sophie-avatar.webp","alt":"","loading":"lazy","decoding":"async","src":"/media/portraits/sophie-avatar.webp"}]]],["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble sophie"},"Can I explain?"]]],["DIV",{"class":"conversation-line outgoing chat-group-start chat-group-end"},["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble player"},"Go ahead."]]],["DIV",{"class":"conversation-line incoming chat-group-start chat-group-open"},["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble sophie"},"Thank you."]]],["DIV",{"class":"conversation-line incoming chat-group-continuation chat-group-open"},["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble sophie"},"It's a saved copy of someone's contacts."]]],["DIV",{"class":"conversation-line incoming chat-group-continuation chat-group-open"},["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble sophie"},"The file says it belongs to Daniel Mercer."]]],["DIV",{"class":"conversation-line incoming chat-group-continuation chat-group-open"},["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble sophie"},"I was looking through it earlier."]]],["DIV",{"class":"conversation-line incoming chat-group-continuation chat-group-open"},["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble sophie"},"Your number is in there."]]],["DIV",{"class":"conversation-line incoming chat-group-continuation chat-group-open"},["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble sophie"},"No name beside it."]]],["DIV",{"class":"conversation-line incoming chat-group-continuation chat-group-end"},["SPAN",{"class":"chat-contact-avatar"},["SPAN",{"class":"character-avatar message-avatar","aria-hidden":"true"},["IMG",{"__playwright_current_src__":"http://127.0.0.1:4201/media/portraits/sophie-avatar.webp","alt":"","loading":"lazy","decoding":"async","src":"/media/portraits/sophie-avatar.webp"}]]],["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble sophie"},"Just a star."]]],["DIV",{"class":"conversation-line outgoing chat-group-start chat-group-end"},["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble player"},"A star?"]]],["DIV",{"class":"conversation-line incoming chat-group-start chat-group-open"},["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble sophie"},"Yeah. Like a favourite, maybe."]]],["DIV",{"class":"conversation-line incoming chat-group-continuation chat-group-open"},["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble sophie"},"But I don't know what that symbol means in this file."]]],["DIV",{"class":"conversation-line incoming chat-group-continuation chat-group-open"},["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble sophie"},"Do you know Daniel?"]]],["DIV",{"class":"conversation-line incoming chat-group-continuation chat-group-end"},["SPAN",{"class":"chat-contact-avatar"},["SPAN",{"class":"character-avatar message-avatar","aria-hidden":"true"},["IMG",{"__playwright_current_src__":"http://127.0.0.1:4201/media/portraits/sophie-avatar.webp","alt":"","loading":"lazy","decoding":"async","src":"/media/portraits/sophie-avatar.webp"}]]],["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble sophie"},"Daniel Mercer?"]]],["DIV",{"class":"conversation-line outgoing chat-group-start chat-group-end"},["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble player"},"No. Never heard the name."]]],["DIV",{"class":"conversation-line incoming chat-group-start chat-group-open"},["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble sophie"},"Okay."]]],["DIV",{"class":"conversation-line incoming chat-group-continuation chat-group-open"},["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble sophie"},"That was the most likely answer, I suppose."]]],["DIV",{"class":"conversation-line incoming chat-group-continuation chat-group-open"},["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble sophie"},"Could you think back a little?"]]],["DIV",{"class":"conversation-line incoming chat-group-continuation chat-group-open"},["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble sophie"},"Even an old online chat. A work message. Anything."]]],["DIV",{"class":"conversation-line incoming chat-group-continuation chat-group-end"},["SPAN",{"class":"chat-contact-avatar"},["SPAN",{"class":"character-avatar message-avatar","aria-hidden":"true"},["IMG",{"__playwright_current_src__":"http://127.0.0.1:4201/media/portraits/sophie-avatar.webp","alt":"","loading":"lazy","decoding":"async","src":"/media/portraits/sophie-avatar.webp"}]]],["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble sophie"},"I'm not asking you to guess."]]],["DIV",{"class":"conversation-line outgoing chat-group-start chat-group-end"},["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble player"},"I'm sure I haven't spoken to him."]]],["DIV",{"class":"conversation-line incoming chat-group-start chat-group-open"},["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble sophie"},"Then that's useful to know."]]],["DIV",{"class":"conversation-line incoming chat-group-continuation chat-group-open"},["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble sophie"},"I thought if I asked, the answer might be simple."]]],["DIV",{"class":"conversation-line incoming chat-group-continuation chat-group-open"},["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble sophie"},"“Oh, yeah. Daniel and I used to work together.”"]]],["DIV",{"class":"conversation-line incoming chat-group-continuation chat-group-open"},["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble sophie"},"Something like that."]]],["DIV",{"class":"conversation-line incoming chat-group-continuation chat-group-end"},["SPAN",{"class":"chat-contact-avatar"},["SPAN",{"class":"character-avatar message-avatar","aria-hidden":"true"},["IMG",{"__playwright_current_src__":"http://127.0.0.1:4201/media/portraits/sophie-avatar.webp","alt":"","loading":"lazy","decoding":"async","src":"/media/portraits/sophie-avatar.webp"}]]],["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble sophie"},"Sorry. I'm talking as if you already know what's happened."]]],["DIV",{"class":"conversation-line outgoing chat-group-start chat-group-end"},["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble player"},"Then tell me."]]],["DIV",{"class":"conversation-line incoming chat-group-start chat-group-open"},["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble sophie"},"Right."]]],["DIV",{"class":"conversation-line incoming chat-group-continuation chat-group-open"},["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble sophie"},"Daniel stopped replying."]]],["DIV",{"class":"conversation-line incoming chat-group-continuation chat-group-open"},["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble sophie"},"Messages. Calls."]]],["DIV",{"class":"conversation-line incoming chat-group-continuation chat-group-open"},["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble sophie"},"For days now."]]],["DIV",{"class":"conversation-line incoming chat-group-continuation chat-group-open"},["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble sophie"},"At first we thought he was busy."]]],["DIV",{"class":"conversation-line incoming chat-group-continuation chat-group-open"},["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble sophie"},"Then we thought maybe he wanted space."]]],["DIV",{"class":"conversation-line incoming chat-group-continuation chat-group-end"},["SPAN",{"class":"chat-contact-avatar"},["SPAN",{"class":"character-avatar message-avatar","aria-hidden":"true"},["IMG",{"__playwright_current_src__":"http://127.0.0.1:4201/media/portraits/sophie-avatar.webp","alt":"","loading":"lazy","decoding":"async","src":"/media/portraits/sophie-avatar.webp"}]]],["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble sophie"},"I don't know what to think anymore."]]],["DIV",{"class":"conversation-line outgoing chat-group-start chat-group-end"},["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble player"},"Have you tried checking on him in person?"]]],["DIV",{"class":"conversation-line incoming chat-group-start chat-group-open"},["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble sophie"},"We have tried to check he's safe."]]],["DIV",{"class":"conversation-line incoming chat-group-continuation chat-group-open"},["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble sophie"},"I don't want to give you a version of events I'm not sure about."]]],["DIV",{"class":"conversation-line incoming chat-group-continuation chat-group-open"},["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble sophie"},"I'm sorry. I should've said that sooner."]]],["DIV",{"class":"conversation-line incoming chat-group-continuation chat-group-open"},["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble sophie"},"You don't owe me your time."]]],["DIV",{"class":"conversation-line incoming chat-group-continuation chat-group-end"},["SPAN",{"class":"chat-contact-avatar"},["SPAN",{"class":"character-avatar message-avatar","aria-hidden":"true"},["IMG",{"__playwright_current_src__":"http://127.0.0.1:4201/media/portraits/sophie-avatar.webp","alt":"","loading":"lazy","decoding":"async","src":"/media/portraits/sophie-avatar.webp"}]]],["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble sophie"},"I haven't even asked what to call you."]]],["DIV",{"class":"conversation-line outgoing chat-group-start chat-group-end"},["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble player"},"You can call me Alex."]]],["DIV",{"class":"conversation-line incoming chat-group-start chat-group-open"},["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble sophie"},"Alex. Got it."]]],["DIV",{"class":"conversation-line incoming chat-group-continuation chat-group-open"},["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble sophie"},"Nice to meet you. In a very odd way."]]],["DIV",{"class":"conversation-line incoming chat-group-continuation chat-group-open"},["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble sophie"},"You know what's strange?"]]],["DIV",{"class":"conversation-line incoming chat-group-continuation chat-group-open"},["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble sophie"},"I nearly deleted this number."]]],["DIV",{"class":"conversation-line incoming chat-group-continuation chat-group-end"},["SPAN",{"class":"chat-contact-avatar"},["SPAN",{"class":"character-avatar message-avatar","aria-hidden":"true"},["IMG",{"__playwright_current_src__":"http://127.0.0.1:4201/media/portraits/sophie-avatar.webp","alt":"","loading":"lazy","decoding":"async","src":"/media/portraits/sophie-avatar.webp"}]]],["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble sophie"},"I had my finger over it and everything."]]],["DIV",{"class":"conversation-line outgoing chat-group-start chat-group-end"},["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble player"},"What changed your mind?"]]],["DIV",{"class":"conversation-line incoming chat-group-start chat-group-open"},["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble sophie"},"I kept thinking: what if this is the one person who can tell us something ordinary and useful?"]]],["DIV",{"class":"conversation-line incoming chat-group-continuation chat-group-open"},["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble sophie"},"I didn't want to start believing the star meant something just because I was scared."]]],["DIV",{"class":"conversation-line incoming chat-group-continuation chat-group-open"},["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble sophie"},"But I didn't want to delete the question either."]]],["DIV",{"class":"conversation-line incoming chat-group-continuation chat-group-open"},["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble sophie"},"There are other people trying to find him."]]],["DIV",{"class":"conversation-line incoming chat-group-continuation chat-group-open"},["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble sophie"},"Some of us are talking in a group."]]],["DIV",{"class":"conversation-line incoming chat-group-continuation chat-group-end"},["SPAN",{"class":"chat-contact-avatar"},["SPAN",{"class":"character-avatar message-avatar","aria-hidden":"true"},["IMG",{"__playwright_current_src__":"http://127.0.0.1:4201/media/portraits/sophie-avatar.webp","alt":"","loading":"lazy","decoding":"async","src":"/media/portraits/sophie-avatar.webp"}]]],["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble sophie"},"Well, arguing in a group, lately."]]],["DIV",{"class":"conversation-line outgoing chat-group-start chat-group-end"},["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble player"},"Who's in it?"]]],["DIV",{"class":"conversation-line incoming chat-group-start chat-group-open"},["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble sophie"},"People close to him."]]],["DIV",{"class":"conversation-line incoming chat-group-continuation chat-group-open"},["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble sophie"},"I can introduce you properly if you decide to join."]]],["DIV",{"class":"conversation-line incoming chat-group-continuation chat-group-open"},["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble sophie"},"I haven't told them I've been messaging you."]]],["DIV",{"class":"conversation-line incoming chat-group-continuation chat-group-open"},["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble sophie"},"They knew about the number. Not that I would actually contact it."]]],["DIV",{"class":"conversation-line incoming chat-group-continuation chat-group-end"},["SPAN",{"class":"chat-contact-avatar"},["SPAN",{"class":"character-avatar message-avatar","aria-hidden":"true"},["IMG",{"__playwright_current_src__":"http://127.0.0.1:4201/media/portraits/sophie-avatar.webp","alt":"","loading":"lazy","decoding":"async","src":"/media/portraits/sophie-avatar.webp"}]]],["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble sophie"},"I'm going to get an earful."]]],["DIV",{"class":"conversation-line outgoing chat-group-start chat-group-end"},["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble player"},"Then maybe talk to them first."]]],["DIV",{"class":"conversation-line incoming chat-group-start chat-group-open"},["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble sophie"},"That's probably the sensible thing."]]],["DIV",{"class":"conversation-line incoming chat-group-continuation chat-group-open"},["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble sophie"},"Sensible hasn't been my strongest quality this week."]]],["DIV",{"class":"conversation-line incoming chat-group-continuation chat-group-open"},["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble sophie"},"Could I ask you something slightly unreasonable?"]]],["DIV",{"class":"conversation-line incoming chat-group-continuation chat-group-open"},["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble sophie"},"Would you consider joining the chat?"]]],["DIV",{"class":"conversation-line incoming chat-group-continuation chat-group-open"},["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble sophie"},"Only to listen at first. If you want."]]],["DIV",{"class":"conversation-line incoming chat-group-continuation chat-group-end"},["SPAN",{"class":"chat-contact-avatar"},["SPAN",{"class":"character-avatar message-avatar","aria-hidden":"true"},["IMG",{"__playwright_current_src__":"http://127.0.0.1:4201/media/portraits/sophie-avatar.webp","alt":"","loading":"lazy","decoding":"async","src":"/media/portraits/sophie-avatar.webp"}]]],["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble sophie"},"I don't need you to promise you'll solve anything."]]],["DIV",{"class":"conversation-line outgoing chat-group-start chat-group-end"},["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble player"},"Why would I be any use?"]]],["DIV",{"class":"conversation-line incoming chat-group-start chat-group-open"},["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble sophie"},"You can tell us what you do and don't recognise."]]],["DIV",{"class":"conversation-line incoming chat-group-continuation chat-group-open"},["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble sophie"},"That alone might stop us making up stories around your number."]]],["DIV",{"class":"conversation-line incoming chat-group-continuation chat-group-open"},["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble sophie"},"Look, you can say no."]]],["DIV",{"class":"conversation-line incoming chat-group-continuation chat-group-open"},["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble sophie"},"I won't turn it into some kind of test."]]],["DIV",{"class":"conversation-line incoming chat-group-continuation chat-group-open"},["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble sophie"},"But if you join, there are people who'll want to ask you questions."]]],["DIV",{"class":"conversation-line incoming chat-group-continuation chat-group-end"},["SPAN",{"class":"chat-contact-avatar"},["SPAN",{"class":"character-avatar message-avatar","aria-hidden":"true"},["IMG",{"__playwright_current_src__":"http://127.0.0.1:4201/media/portraits/sophie-avatar.webp","alt":"","loading":"lazy","decoding":"async","src":"/media/portraits/sophie-avatar.webp"}]]],["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble sophie"},"One in particular."]]]],["DIV",{"class":"opening-actions opening-v4-composer"},["DIV",{"class":"opening-action-heading"},"Choose a reply"],["DIV",{"class":"scene01-options"},["BUTTON",{"class":"opening-choice ","aria-pressed":"false"},"Alright. Send it."],["BUTTON",{"class":"opening-choice ","aria-pressed":"false"},"I can listen, but that's all I'm agreeing to."],["BUTTON",{"class":"opening-choice ","aria-pressed":"false"},"I'll look. I make no promises."],["BUTTON",{"class":"opening-choice ","aria-pressed":"false"},"Not right now."]],["BUTTON",{"class":"opening-primary","disabled":""},["svg",{"xmlns":"http://www.w3.org/2000/svg","width":"17","height":"17","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","stroke-width":"2","stroke-linecap":"round","stroke-linejoin":"round","class":"lucide lucide-send","aria-hidden":"true"},["path",{"d":"M14.536 21.686a.5.5 0 0 0 .937-.024l6.5-19a.496.496 0 0 0-.635-.635l-19 6.5a.5.5 0 0 0-.024.937l7.93 3.18a2 2 0 0 1 1.112 1.11z"}],["path",{"d":"m21.854 2.147-10.94 10.939"}]]," Send"]]]],[[3,32]]]]],[[9,59]],[[9,60]]]],"viewport":{"width":320,"height":720},"timestamp":52429.954,"wallTime":1800000309526,"collectionTime":2,"resourceOverrides":[],"isMainFrame":true}}
