ere."}},{"k":"at","v":{"n":1800000030890}}],"id":135},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-01-4"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Can I explain?"}},{"k":"at","v":{"n":1800000035680}}],"id":136},{"o":[{"k":"id","v":{"s":"OPEN-S01-C02-PLAYER-a"}},{"k":"sender","v":{"s":"player"}},{"k":"text","v":{"s":"Go ahead."}},{"k":"at","v":{"n":1800000035780}}],"id":137},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-C02-a-1"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Thank you."}},{"k":"at","v":{"n":1800000038434}}],"id":138},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-02-1"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"It's a saved copy of someone's contacts."}},{"k":"at","v":{"n":1800000042637}}],"id":139},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-02-2"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"The file says it belongs to Daniel Mercer."}},{"k":"at","v":{"n":1800000047166}}],"id":140},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-02-3"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"I was looking through it earlier."}},{"k":"at","v":{"n":1800000050957}}],"id":141},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-02-5"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Your number is in there."}},{"k":"at","v":{"n":1800000056402}}],"id":142},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-02-6"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"No name beside it."}},{"k":"at","v":{"n":1800000059753}}],"id":143},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-02-7"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Just a star."}},{"k":"at","v":{"n":1800000062709}}],"id":144},{"o":[{"k":"id","v":{"s":"OPEN-S01-C03-PLAYER-a"}},{"k":"sender","v":{"s":"player"}},{"k":"text","v":{"s":"A star?"}},{"k":"at","v":{"n":1800000062809}}],"id":145},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-C03-a-1"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Yeah. Like a favourite, maybe."}},{"k":"at","v":{"n":1800000066256}}],"id":146},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-C03-a-2"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"But I don't know what that symbol means in this file."}},{"k":"at","v":{"n":1800000071450}}],"id":147},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-03-2"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Do you know Daniel?"}},{"k":"at","v":{"n":1800000077118}}],"id":148},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-03-3"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Daniel Mercer?"}},{"k":"at","v":{"n":1800000079840}}],"id":149},{"o":[{"k":"id","v":{"s":"OPEN-S01-C04-PLAYER-a"}},{"k":"sender","v":{"s":"player"}},{"k":"text","v":{"s":"No. Never heard the name."}},{"k":"at","v":{"n":1800000079940}}],"id":150},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-C04-a-1"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Okay."}},{"k":"at","v":{"n":1800000082509}}],"id":151},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-C04-a-2"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"That was the most likely answer, I suppose."}},{"k":"at","v":{"n":1800000087055}}],"id":152},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-04-1"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Could you think back a little?"}},{"k":"at","v":{"n":1800000090795}}],"id":153},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-04-2"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Even an old online chat. A work message. Anything."}},{"k":"at","v":{"n":1800000095352}}],"id":154},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-04-3"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"I'm not asking you to guess."}},{"k":"at","v":{"n":1800000099058}}],"id":155},{"o":[{"k":"id","v":{"s":"OPEN-S01-C05-PLAYER-a"}},{"k":"sender","v":{"s":"player"}},{"k":"text","v":{"s":"I'm sure I haven't spoken to him."}},{"k":"at","v":{"n":1800000099158}}],"id":156},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-C05-a-1"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Then that's useful to know."}},{"k":"at","v":{"n":1800000102554}}],"id":157},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-05-1"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"I thought if I asked, the answer might be simple."}},{"k":"at","v":{"n":1800000107387}}],"id":158},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-05-2"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"“Oh, yeah. Daniel and I used to work together.”"}},{"k":"at","v":{"n":1800000112294}}],"id":159},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-05-3"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Something like that."}},{"k":"at","v":{"n":1800000115386}}],"id":160},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-05-5"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Sorry. I'm talking as if you already know what's happened."}},{"k":"at","v":{"n":1800000122372}}],"id":161},{"o":[{"k":"id","v":{"s":"OPEN-S01-C06-PLAYER-a"}},{"k":"sender","v":{"s":"player"}},{"k":"text","v":{"s":"Then tell me."}},{"k":"at","v":{"n":1800000122472}}],"id":162},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-C06-a-1"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Right."}},{"k":"at","v":{"n":1800000125058}}],"id":163},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-06-1"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Daniel stopped replying."}},{"k":"at","v":{"n":1800000127817}}],"id":164},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-06-2"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Messages. Calls."}},{"k":"at","v":{"n":1800000130573}}],"id":165},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-06-4"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"For days now."}},{"k":"at","v":{"n":1800000135746}}],"id":166},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-06-5"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"At first we thought he was busy."}},{"k":"at","v":{"n":1800000139813}}],"id":167},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-06-6"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Then we thought maybe he wanted space."}},{"k":"at","v":{"n":1800000143982}}],"id":168},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-06-8"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"I don't know what to think anymore."}},{"k":"at","v":{"n":1800000151600}}],"id":169},{"o":[{"k":"id","v":{"s":"OPEN-S01-C07-PLAYER-a"}},{"k":"sender","v":{"s":"player"}},{"k":"text","v":{"s":"Have you tried checking on him in person?"}},{"k":"at","v":{"n":1800000151700}}],"id":170},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-C07-a-1"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"We have tried to check he's safe."}},{"k":"at","v":{"n":1800000155784}}],"id":171},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-C07-a-2"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"I don't want to give you a version of events I'm not sure about."}},{"k":"at","v":{"n":1800000162043}}],"id":172},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-07-1"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"I'm sorry. I should've said that sooner."}},{"k":"at","v":{"n":1800000166246}}],"id":173},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-07-2"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"You don't owe me your time."}},{"k":"at","v":{"n":1800000169935}}],"id":174},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-07-3"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"I haven't even asked what to call you."}},{"k":"at","v":{"n":1800000174396}}],"id":175},{"o":[{"k":"id","v":{"s":"OPEN-S01-C08-PLAYER-a"}},{"k":"sender","v":{"s":"player"}},{"k":"text","v":{"s":"You can call me Alex."}},{"k":"at","v":{"n":1800000174496}}],"id":176},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-C08-a-1"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Alex. Got it."}},{"k":"at","v":{"n":1800000177622}}],"id":177},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-C08-a-2"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Nice to meet you. In a very odd way."}},{"k":"at","v":{"n":1800000182342}}],"id":178},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-08-1"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"You know what's strange?"}},{"k":"at","v":{"n":1800000185394}}],"id":179},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-08-2"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"I nearly deleted this number."}},{"k":"at","v":{"n":1800000188824}}],"id":180},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-08-3"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"I had my finger over it and everything."}},{"k":"at","v":{"n":1800000193302}}],"id":181},{"o":[{"k":"id","v":{"s":"OPEN-S01-C09-PLAYER-a"}},{"k":"sender","v":{"s":"player"}},{"k":"text","v":{"s":"What changed your mind?"}},{"k":"at","v":{"n":1800000193402}}],"id":182},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-C09-a-1"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"I kept thinking: what if this is the one person who can tell us something ordinary and useful?"}},{"k":"at","v":{"n":1800000200941}}],"id":183},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-09-1"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"I didn't want to start believing the star meant something just because I was scared."}},{"k":"at","v":{"n":1800000207432}}],"id":184},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-09-2"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"But I didn't want to delete the question either."}},{"k":"at","v":{"n":1800000211955}}],"id":185},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-09-4"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"There are other people trying to find him."}},{"k":"at","v":{"n":1800000219184}}],"id":186},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-09-5"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Some of us are talking in a group."}},{"k":"at","v":{"n":1800000223577}}],"id":187},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-09-6"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Well, arguing in a group, lately."}},{"k":"at","v":{"n":1800000227368}}],"id":188},{"o":[{"k":"id","v":{"s":"OPEN-S01-C10-PLAYER-a"}},{"k":"sender","v":{"s":"player"}},{"k":"text","v":{"s":"Who's in it?"}},{"k":"at","v":{"n":1800000227468}}],"id":189},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-C10-a-1"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"People close to him."}},{"k":"at","v":{"n":1800000230853}}],"id":190},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-C10-a-2"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"I can introduce you properly if you decide to join."}},{"k":"at","v":{"n":1800000235720}}],"id":191},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-10-1"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"I haven't told them I've been messaging you."}},{"k":"at","v":{"n":1800000240283}}],"id":192},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-10-2"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"They knew about the number. Not that I would actually contact it."}},{"k":"at","v":{"n":1800000245974}}],"id":193},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-10-4"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"I'm going to get an earful."}},{"k":"at","v":{"n":1800000251263}}],"id":194},{"o":[{"k":"id","v":{"s":"OPEN-S01-C11-PLAYER-a"}},{"k":"sender","v":{"s":"player"}},{"k":"text","v":{"s":"Then maybe talk to them first."}},{"k":"at","v":{"n":1800000251363}}],"id":195},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-C11-a-1"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"That's probably the sensible thing."}},{"k":"at","v":{"n":1800000254895}}],"id":196},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-C11-a-2"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Sensible hasn't been my strongest quality this week."}},{"k":"at","v":{"n":1800000259193}}],"id":197},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-11-1"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Could I ask you something slightly unreasonable?"}},{"k":"at","v":{"n":1800000263131}}],"id":198},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-11-3"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Would you consider joining the chat?"}},{"k":"at","v":{"n":1800000268973}}],"id":199},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-11-4"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Only to listen at first. If you want."}},{"k":"at","v":{"n":1800000273417}}],"id":200},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-11-5"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"I don't need you to promise you'll solve anything."}},{"k":"at","v":{"n":1800000277974}}],"id":201},{"o":[{"k":"id","v":{"s":"OPEN-S01-C12-PLAYER-a"}},{"k":"sender","v":{"s":"player"}},{"k":"text","v":{"s":"Why would I be any use?"}},{"k":"at","v":{"n":1800000278074}}],"id":202},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-C12-a-1"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"You can tell us what you do and don't recognise."}},{"k":"at","v":{"n":1800000282890}}],"id":203},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-C12-a-2"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"That alone might stop us making up stories around your number."}},{"k":"at","v":{"n":1800000288237}}],"id":204},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-12-1"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Look, you can say no."}},{"k":"at","v":{"n":1800000291932}}],"id":205},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-12-2"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"I won't turn it into some kind of test."}},{"k":"at","v":{"n":1800000296703}}],"id":206},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-12-3"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"But if you join, there are people who'll want to ask you questions."}},{"k":"at","v":{"n":1800000302720}}],"id":207},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-12-5"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"One in particular."}},{"k":"at","v":{"n":1800000307378}}],"id":208}],"id":126}},{"k":"groupMessages","v":{"a":[],"id":209}},{"k":"groupReceipts","v":{"v":"undefined"}},{"k":"invitationApproved","v":{"v":"undefined"}},{"k":"disclosedName","v":{"s":"Alex"}}],"id":124}}],"id":121}}],"id":1},"handles":[]}}}
