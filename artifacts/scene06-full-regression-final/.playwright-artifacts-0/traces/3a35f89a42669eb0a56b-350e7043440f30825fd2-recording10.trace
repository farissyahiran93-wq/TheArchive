":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"But she's pretty smart."}},{"k":"at","v":{"n":1800001882697}}],"id":1210},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-13-1"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Eli's usually better with technical things than the rest of us."}},{"k":"at","v":{"n":1800001884497}}],"id":1211},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-13-2"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Which isn't saying much in my case."}},{"k":"at","v":{"n":1800001885897}}],"id":1212},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-13-3"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"I once managed to delete an entire folder while trying to rename it."}},{"k":"at","v":{"n":1800001887897}}],"id":1213},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-13-4"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Don't ask."}},{"k":"at","v":{"n":1800001888797}}],"id":1214},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-13-6"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Anyway."}},{"k":"at","v":{"n":1800001891697}}],"id":1215},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-13-7"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"She's not some magician who can just pull answers out of nowhere."}},{"k":"at","v":{"n":1800001893597}}],"id":1216},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-13-8"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"But she might be able to help us understand some things later."}},{"k":"at","v":{"n":1800001895497}}],"id":1217},{"o":[{"k":"id","v":{"s":"OPEN-S03-C14-PLAYER-a"}},{"k":"sender","v":{"s":"player"}},{"k":"text","v":{"s":"What's Axiom Recovery?"}},{"k":"at","v":{"n":1800001895597}}],"id":1218},{"o":[{"k":"id","v":{"s":"OPEN-S03-C14-a-1"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"It's where Daniel works."}},{"k":"at","v":{"n":1800001896697}}],"id":1219},{"o":[{"k":"id","v":{"s":"OPEN-S03-C14-a-2"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"They deal with data and recovery-related work."}},{"k":"at","v":{"n":1800001898097}}],"id":1220},{"o":[{"k":"id","v":{"s":"OPEN-S03-C14-a-3"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"That's about the extent of my technical understanding."}},{"k":"at","v":{"n":1800001899597}}],"id":1221},{"o":[{"k":"id","v":{"s":"OPEN-S03-C14-a-4"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Eli would explain it better than I could."}},{"k":"at","v":{"n":1800001901097}}],"id":1222},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-14-1"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"So yeah."}},{"k":"at","v":{"n":1800001901997}}],"id":1223},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-14-2"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"That's Eli."}},{"k":"at","v":{"n":1800001902897}}],"id":1224},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-14-3"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"She's easier to talk to when she isn't trying to explain something complicated."}},{"k":"at","v":{"n":1800001904897}}],"id":1225},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-14-4"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Which, now that I think about it, might not be very often."}},{"k":"at","v":{"n":1800001906797}}],"id":1226},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-14-5"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"😅"}},{"k":"at","v":{"n":1800001907697}}],"id":1227},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-14-6"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"So..."}},{"k":"at","v":{"n":1800001908597}}],"id":1228},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-14-7"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"That's Maya, Lucas and Eli."}},{"k":"at","v":{"n":1800001909797}}],"id":1229},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-14-8"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"In the world's least useful introduction."}},{"k":"at","v":{"n":1800001911097}}],"id":1230},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-14-9"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"They're all different."}},{"k":"at","v":{"n":1800001912097}}],"id":1231},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-14-10"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Very different."}},{"k":"at","v":{"n":1800001912997}}],"id":1232},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-14-11"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"But they all care about Daniel."}},{"k":"at","v":{"n":1800001914297}}],"id":1233},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-14-12"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"In their own ways."}},{"k":"at","v":{"n":1800001915397}}],"id":1234},{"o":[{"k":"id","v":{"s":"OPEN-S03-C15-PLAYER-a"}},{"k":"sender","v":{"s":"player"}},{"k":"text","v":{"s":"I feel bad for Maya."}},{"k":"at","v":{"n":1800001915497}}],"id":1235},{"o":[{"k":"id","v":{"s":"OPEN-S03-C15-a-1"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Me too."}},{"k":"at","v":{"n":1800001916397}}],"id":1236},{"o":[{"k":"id","v":{"s":"OPEN-S03-C15-a-2"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"She's trying so hard to stay strong."}},{"k":"at","v":{"n":1800001917797}}],"id":1237},{"o":[{"k":"id","v":{"s":"OPEN-S03-C15-a-3"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"I wish she didn't feel like she had to."}},{"k":"at","v":{"n":1800001919397}}],"id":1238},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-15-1"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Including me, by the way."}},{"k":"at","v":{"n":1800001920597}}],"id":1239},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-15-3"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"I know I've told you a lot."}},{"k":"at","v":{"n":1800001923997}}],"id":1240},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-15-4"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"But it's still just my side of things."}},{"k":"at","v":{"n":1800001925497}}],"id":1241},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-15-5"