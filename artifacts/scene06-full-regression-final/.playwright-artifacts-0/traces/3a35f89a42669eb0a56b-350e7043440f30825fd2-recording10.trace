,"fill":"none","stroke":"currentColor","stroke-width":"2","stroke-linecap":"round","stroke-linejoin":"round","class":"lucide lucide-chevron-right","aria-hidden":"true"},["path",{"d":"m9 18 6-6-6-6"}]],["B",{},"1"]]],["BUTTON",{"class":"thread-row","aria-label":"Open Chapter 1 nora conversation"},["SPAN",{"class":"character-avatar contact-avatar","aria-hidden":"true"},["IMG",{"__playwright_current_src__":"","alt":"","loading":"lazy","decoding":"async","src":"/media/portraits/nora-avatar.webp"}]],["SPAN",{"class":"thread-text"},["STRONG",{},"Nora"],["SMALL",{},"I've recorded your request. The retained copy isn't a verified original; I don't have an authenticated earlier file to provide."]],["SPAN",{"class":"thread-meta"},["svg",{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","stroke-width":"2","stroke-linecap":"round","stroke-linejoin":"round","class":"lucide lucide-chevron-right","aria-hidden":"true"},["path",{"d":"m9 18 6-6-6-6"}]],["B",{},"1"]]],["BUTTON",{"class":"thread-row","aria-label":"Open Chapter 1 eli conversation"},["SPAN",{"class":"character-avatar contact-avatar","aria-hidden":"true"},["IMG",{"__playwright_current_src__":"","alt":"","loading":"lazy","decoding":"async","src":"/media/portraits/eli-avatar.webp"}]],["SPAN",{"class":"thread-text"},["STRONG",{},"Eli"],["SMALL",{},"A reconstruction can preserve a number and lose its context. Missing logs don't settle what happened. I can't verify a file I haven't seen."]],["SPAN",{"class":"thread-meta"},["svg",{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","stroke-width":"2","stroke-linecap":"round","stroke-linejoin":"round","class":"lucide lucide-chevron-right","aria-hidden":"true"},["path",{"d":"m9 18 6-6-6-6"}]]]],["BUTTON",{"class":"thread-row","aria-label":"Open Chapter 1 maya conversation"},["SPAN",{"class":"character-avatar contact-avatar","aria-hidden":"true"},["IMG",{"__playwright_current_src__":"","alt":"","loading":"lazy","decoding":"async","src":"/media/portraits/maya-avatar.webp"}]],["SPAN",{"class":"thread-text"},["STRONG",{},"Maya"],["SMALL",{},"Daniel and I were planning a life together. I don't want every difficult conversation we had turned into evidence against someone."]],["SPAN",{"class":"thread-meta"},["svg",{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","stroke-width":"2","stroke-linecap":"round","stroke-linejoin":"round","class":"lucide lucide-chevron-right","aria-hidden":"true"},["path",{"d":"m9 18 6-6-6-6"}]]]],["BUTTON",{"class":"thread-row","aria-label":"Open Chapter 1 lucas conversation"},["SPAN",{"class":"character-avatar contact-avatar","aria-hidden":"true"},["IMG",{"__playwright_current_src__":"","alt":"","loading":"lazy","decoding":"async","src":"/media/portraits/lucas-avatar.webp"}]],["SPAN",{"class":"thread-text"},["STRONG",{},"Lucas"],["SMALL",{},"I've known Daniel for years. I still don't know what happened. I'm not ready to talk about everything, and this doesn't mean I'm rejoining the group."]],["SPAN",{"class":"thread-meta"},["svg",{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","stroke-width":"2","stroke-linecap":"round","stroke-linejoin":"round","class":"lucide lucide-chevron-right","aria-hidden":"true"},["path",{"d":"m9 18 6-6-6-6"}]]]],["BUTTON",{"class":"thread-row","aria-label":"Open Sophie conversation"},["SPAN",{"class":"character-avatar contact-avatar","aria-hidden":"true"},["IMG",{"__playwright_current_src__":"","alt":"","loading":"lazy","decoding":"async","src":"/media/portraits/sophie-avatar.webp"}]],["SPAN",{"class":"thread-text"},["STRONG",{},"Sophie"],["SMALL",{},"Eli works with Daniel. If you want to ask her a general recovery question, I can pass it on."]],["SPAN",{"class":"thread-meta"},["svg",{"xmlns":"http://