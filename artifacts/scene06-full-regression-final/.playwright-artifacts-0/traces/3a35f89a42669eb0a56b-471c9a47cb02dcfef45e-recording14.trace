-items:center;gap:5px;background:none;color:#dfe2ec;border:0;padding:3px;border-radius:10px;min-width:0}\r\n.mirror-photo-tile.selected{outline:2px solid #0a84ff}\r\n.mirror-photo-art{width:100%;aspect-ratio:1;display:grid;place-items:center;background:linear-gradient(145deg,#455674,#1e2b43 55%,#4c5668);border-radius:7px;color:#d5e3ef}\r\n.mirror-photo-tile:nth-child(2n) .mirror-photo-art{background:linear-gradient(145deg,#756749,#3b4448,#293851)}\r\n.mirror-photo-tile small{font-size:10px;white-space:nowrap;color:#b6c2d0}\r\n.mirror-media-preview{border-radius:12px;background:linear-gradient(130deg,#364760,#29354e 65%,#68583e);height:142px;display:flex;flex-direction:column;gap:7px;align-items:center;justify-content:center;color:#dceaf7;padding:15px;text-align:center;font-size:12px}\r\n.mirror-media-preview small{color:#bac2ca;font-size:10px}\r\n.mirror-source-note{font-size:11px!important;color:#a6adba!important;display:flex;align-items:center;gap:6px}\r\n.mirror-hint-toggle{background:#2b2c33!important;color:#a4cffe!important;border:1px solid #49505c!important}\r\n.mirror-hints{text-align:left;margin:0;padding:12px 12px 12px 29px;background:#252834;border-radius:12px;color:#e1e6f0;font-size:12px;line-height:1.7}\r\n.mirror-lock-panel p[role=alert]{color:#ffa9a0!important}\r\n.opening-next-lead{border:1px solid #3d6b89;background:#1a364d;padding:15px;border-radius:14px;margin-top:18px;color:#d9ecfb}\r\n.opening-next-lead strong{font-size:11px;letter-spacing:.03em}\r\n.opening-next-lead p{font-size:13px;line-height:1.6;margin-bottom:0}\r\n\r\n.mirror-message-history{display:flex;flex-direction:column;gap:9px;margin-top:16px;align-items:stretch}\r\n.mirror-chat-bubble{max-width:83%;padding:10px 13px;border-radius:18px;font-size:14px;line-height:1.45;display:flex;flex-direction:column;gap:4px}\r\n.mirror-chat-bubble small{font-size:10px;opacity:.75}\r\n.mirror-chat-bubble span{white-space:pre-wrap}\r\n.mirror-chat-bubble.incoming{background:#323237;border-bottom-left