ne incoming chat-group-continuation chat-group-open"},["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble sophie"},"People who know Daniel."]]],["DIV",{"class":"conversation-line incoming chat-group-continuation chat-group-open"},["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble sophie"},"We've been talking."]]],["DIV",{"class":"conversation-line incoming chat-group-continuation chat-group-end"},["SPAN",{"class":"chat-contact-avatar"},["SPAN",{"class":"character-avatar message-avatar","aria-hidden":"true"},["IMG",{"__playwright_current_src__":"http://127.0.0.1:4201/media/portraits/sophie-avatar.webp","alt":"","loading":"lazy","decoding":"async","src":"/media/portraits/sophie-avatar.webp"}]]],["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble sophie"},"Although \"talking\" might be a generous way of putting it lately."]]],["DIV",{"class":"conversation-line outgoing chat-group-start chat-group-end"},["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble player"},"What do you mean?"]]],["DIV",{"class":"conversation-line incoming chat-group-start chat-group-open"},["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble sophie"},"Everyone has their own idea of what we should do."]]],["DIV",{"class":"conversation-line incoming chat-group-continuation chat-group-open"},["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble sophie"},"And no one seems to agree."]]],["DIV",{"class":"conversation-line incoming chat-group-continuation chat-group-open"},["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble sophie"},"There's a group chat."]]],["DIV",{"class":"conversation-line incoming chat-group-continuation chat-group-open"},["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble sophie"},"We've been using it to keep track of things."]]],["DIV",{"class":"conversation-line incoming chat-group-continuation chat-group-open"},["DIV",{"class":"conversation-body"