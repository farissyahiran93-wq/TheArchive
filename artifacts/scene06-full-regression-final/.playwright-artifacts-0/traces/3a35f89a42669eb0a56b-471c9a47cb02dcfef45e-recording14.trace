er","v":{"s":"sophie"}},{"k":"text","v":{"s":"I know that."}},{"k":"at","v":{"n":1800001955397}}],"id":1263},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-16-11"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"I don't actually expect you to find Daniel."}},{"k":"at","v":{"n":1800001958897}}],"id":1264},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-16-12"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"That's not fair to put on you."}},{"k":"at","v":{"n":1800001960297}}],"id":1265},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-16-13"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"I just thought..."}},{"k":"at","v":{"n":1800001961297}}],"id":1266},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-16-14"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Maybe there's something we're missing."}},{"k":"at","v":{"n":1800001962497}}],"id":1267},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-16-15"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Something someone outside all of this might notice."}},{"k":"at","v":{"n":1800001963997}}],"id":1268},{"o":[{"k":"id","v":{"s":"OPEN-S03-C17-PLAYER-a"}},{"k":"sender","v":{"s":"player"}},{"k":"text","v":{"s":"I can try to help."}},{"k":"at","v":{"n":1800001964097}}],"id":1269},{"o":[{"k":"id","v":{"s":"OPEN-S03-C17-a-1"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Really?"}},{"k":"at","v":{"n":1800001964997}}],"id":1270},{"o":[{"k":"id","v":{"s":"OPEN-S03-C17-a-2"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Thank you."}},{"k":"at","v":{"n":1800001965897}}],"id":1271},{"o":[{"k":"id","v":{"s":"OPEN-S03-C17-a-3"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"I mean it."}},{"k":"at","v":{"n":1800001966897}}],"id":1272},{"o":[{"k":"id","v":{"s":"OPEN-S03-C17-a-4"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Even just talking things through might help."}},{"k":"at","v":{"n":1800001968297}}],"id":1273},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-17-1"}},{"k":"sender","v":{