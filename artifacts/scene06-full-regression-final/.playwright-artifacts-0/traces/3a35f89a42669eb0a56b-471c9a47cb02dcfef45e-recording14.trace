v":{"n":0}},{"k":"suspicion","v":{"n":0}},{"k":"romance","v":{"n":0}}],"id":142}}],"id":136}},{"k":"evidence","v":{"o":[],"id":143}},{"k":"notifications","v":{"a":[{"o":[{"k":"id","v":{"s":"OPEN-S01-OPENING-1"}},{"k":"text","v":{"s":"Unknown number: Hey"}},{"k":"read","v":{"b":false}}],"id":145},{"o":[{"k":"id","v":{"s":"OPEN-S01-OPENING-3"}},{"k":"text","v":{"s":"Unknown number: Sorry, is this a bad time?"}},{"k":"read","v":{"b":false}}],"id":146},{"o":[{"k":"id","v":{"s":"OPEN-S01-OPENING-5"}},{"k":"text","v":{"s":"Unknown number: Actually"}},{"k":"read","v":{"b":false}}],"id":147},{"o":[{"k":"id","v":{"s":"OPEN-S01-OPENING-6"}},{"k":"text","v":{"s":"Unknown number: I'm not even sure I have the right number 😅"}},{"k":"read","v":{"b":false}}],"id":148},{"o":[{"k":"id","v":{"s":"OPEN-S01-OPENING-8"}},{"k":"text","v":{"s":"Unknown number: Could you just reply when you see this?"}},{"k":"read","v":{"b":false}}],"id":149},{"o":[{"k":"id","v":{"s":"OPEN-S01-C01-a-1"}},{"k":"text","v":{"s":"Unknown number: Oh, right."}},{"k":"read","v":{"b":false}}],"id":150},{"o":[{"k":"id","v":{"s":"OPEN-S01-C01-a-2"}},{"k":"text","v":{"s":"Unknown number: Sorry."}},{"k":"read","v":{"b":false}}],"id":151},{"o":[{"k":"id","v":{"s":"OPEN-S01-C01-a-3"}},{"k":"text","v":{"s":"Sophie: I'm Sophie."}},{"k":"read","v":{"b":false}}],"id":152},{"o":[{"k":"id","v":{"s":"OPEN-S01-C01-a-4"}},{"k":"text","v":{"s":"Sophie: I probably should've started with that."}},{"k":"read","v":{"b":false}}],"id":153},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-01-1"}},{"k":"text","v":{"s":"Sophie: Can I ask you something?"}},{"k":"read","v":{"b":false}}],"id":154},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-01-2"}},{"k":"text","v":{"s":"Sophie: And I promise I'm not selling anything."}},{"k":"read","v":{"b":false}}],"id":155},{"o":[{"k":"id","v":{"s":"OPEN-S01-C02-a-1"}},{"k":"text","v":{"s":"Sophie: Thanks."}},{"k":"read","v":{"b":false}}],"id":156},{"o":[{"k":"id","v":{"s":"OPEN-S01-C02-a-2"}},{"k":"text","v":{"s":"Sophie: Okay, this might sound strange."}},{"k":"read","v":{"b":false}}],"id":157},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-02-1"}},{"k":"text","v":{"s":"Sophie: Okay."}},{"k":"read","v":{"b":false}}],"id":158},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-02-2"}},{"k":"text","v":{"s":"Sophie: I found your number in a saved copy of someone's contacts."}},{"k":"read","v":{"b":false}}],"id":159},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-02-3"}},{"k":"text","v":{"s":"Sophie: There wasn't a name attached to it."}},{"k":"read","v":{"b":false}}],"id":160},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-02-4"}},{"k":"text","v":{"s":"Sophie: Just the number."}},{"k":"read","v":{"b":false}}],"id":161},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-02-5"}},{"k":"text","v":{"s":"Sophie: And a star next to it."}},{"k":"read","v":{"b":false}}],"id":162},{"o":[{"k":"id","v":{"s":"OPEN-S01-C03-a-1"}},{"k":"text","v":{"s":"Sophie: Yeah. That's what caught my eye."}},{"k":"read","v":{"b":false}}],"id":163},{"o":[{"k":"id","v":{"s":"OPEN-S01-C03-a-2"}},{"k":"text","v":{"s":"Sophie: I don't know what it means."}},{"k":"read","v":{"b":false}}],"id":164},{"o":[{"k":"id","v":{"s":"OPEN-S01-C03-a-3"}},{"k":"text","v":{"s":"Sophie: I was hoping you might."}},{"k":"read","v":{"b":false}}],"id":165},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-03-1"}},{"k":"text","v":{"s":"Sophie: The copy is labelled as Daniel's contact export."}},{"k":"read","v":{"b":false}}],"id":166},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-03-3"}},{"k":"text","v":{"s":"Sophie: Daniel Mercer."}},{"k":"read","v":{"b":false}}],"id":167},{"o":[{"k":"id","v":{"s":"OPEN-S01-C04-a-1"}},{"k":"text","v":{"s":"Sophie: Okay."}},{"k":"read","v":{"b":false}}],"id":168},{"o":[{"k":"id","v":{"s":"OPEN-S01-C04-a-2"}},{"k":"text","v":{"s":"Sophie: That's what I was afraid you'd say."}},{"k":"read","v":{"b":false}}],"id":169},{"o":[{"k":"id","v":{"s":"OPEN-S01-C04-a-3"}},{"k":"text","v":{"s":"Sophie: Not that it's your fault."}},{"k":"read","v":{"b":false}}],"id":170},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-04-1"}},{"k":"text","v":{"s":"Sophie: Can I ask if you've ever spoken to anyone called Daniel?"}},{"k":"read","v":{"b":false}}],"id":171},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-04-2"}},{"k":"text","v":{"s":"Sophie: Even online?"}},{"k":"read","v":{"b":false}}],"id":172},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-04-3"}},{"k":"text","v":{"s":"Sophie: Maybe a long time ago?"}},{"k":"read","v":{"b":false}}],"id":173},{"o":[{"k":"id","v":{"s":"OPEN-S01-C05-a-1"}},{"k":"text","v":{"s":"Sophie: Okay."}},{"k":"read","v":{"b":false}}],"id":174},{"o":[{"k":"id","v":{"s":"OPEN-S01-C05-a-2"}},{"k":"text","v":{"s":"Sophie: Thanks for being clear."}},{"k":"read","v":{"b":false}}],"id":175},{"o":[{"k":"id","v":{"s":"OPEN-S01-C05-a-3"}},{"k":"text","v":{"s":"Sophie: That makes this even stranger, though."}},{"k":"read","v":{"b":false}}],"id":176},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-05-1"}},{"k":"text","v":{"s":"Sophie: Anyway."}},{"k":"read","v":{"b":false}}],"id":177},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-05-2"}},{"k":"text","v":{"s":"Sophie: If you don't know him, then I guess that answers one question."}},{"k":"read","v":{"b":false}}],"id":178},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-05-4"}},{"k":"text","v":{"s":"Sophie: Just not the one I really wanted answered."}},{"k":"read","v":{"b":false}}],"id":179},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-05-5"}},{"k":"text","v":{"s":"Sophie: Sorry."}},{"k":"read","v":{"b":false}}],"id":180},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-05-6"}},{"k":"text","v":{"s":"Sophie: I keep making this awkward."}},{"k":"read","v":{"b":false}}],"id":181},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-05-7"}},{"k":"text","v":{"s":"Sophie: You probably have better things to do than talk to a stranger."}},{"k":"read","v":{"b":false}}],"id":182},{"o":[{"k":"id","v":{"s":"OPEN-S01-C06-a-1"}},{"k":"text","v":{"s":"Sophie: Why your number was saved."}},{"k":"read","v":{"b":false}}],"id":183},{"o":[{"k":"id","v":{"s":"OPEN-S01-C06-a-2"}},{"k":"text","v":{"s":"Sophie: Whether Daniel knew you."}},{"k":"read","v":{"b":false}}],"id":184},{"o":[{"k":"id","v":{"s":"OPEN-S01-C06-a-3"}},{"k":"text","v":{"s":"Sophie: Whether you'd heard from him recently."}},{"k":"read","v":{"b":false}}],"id":185},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-06-2"}},{"k":"text","v":{"s":"Sophie: Daniel hasn't been answering anyone."}},{"k":"read","v":{"b":false}}],"id":186},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-06-3"}},{"k":"text","v":{"s":"Sophie: Calls, messages..."}},{"k":"read","v":{"b":false}}],"id":187},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-06-4"}},{"k":"text","v":{"s":"Sophie: Nothing."}},{"k":"read","v":{"b":false}}],"id":188},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-06-6"}},{"k":"text","v":{"s":"Sophie: For days."}},{"k":"read","v":{"b":false}}],"id":189},{"o":[{"k":"id","v":{"s":"OPEN-S01-C07-a-1"}},{"k":"text","v":{"s":"Sophie: I thought that too."}},{"k":"read","v":{"b":false}}],"id":190},{"o":[{"k":"id","v":{"s":"OPEN-S01-C07-a-2"}},{"k":"text","v":{"s":"Sophie: At first."}},{"k":"read","v":{"b":false}}],"id":191},{"o":[{"k":"id","v":{"s":"OPEN-S01-C07-a-3"}},{"k":"text","v":{"s":"Sophie: But it's gone on longer than anyone expected."}},{"k":"read","v":{"b":false}}],"id":192},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-07-1"}},{"k":"text","v":{"s":"Sophie: Sorry."}},{"k":"read","v":{"b":false}}],"id":193},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-07-2"}},{"k":"text","v":{"s":"Sophie: I shouldn't have dropped all that on you."}},{"k":"read","v":{"b":false}}],"id":194},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-07-3"}},{"k":"text","v":{"s":"Sophie: We don't even know each other."}},{"k":"read","v":{"b":false}}],"id":195},{"o":[{"k":"id","v":{"s":"OPEN-S01-C08-a-1"}},{"k":"text","v":{"s":"Sophie: Alex."}},{"k":"read","v":{"b":false}}],"id":196},{"o":[{"k":"id","v":{"s":"OPEN-S01-C08-a-2"}},{"k":"text","v":{"s":"Sophie: Okay. Nice to meet you."}},{"k":"read","v":{"b":false}}],"id":197},{"o":[{"k":"id","v":{"s":"OPEN-S01-C08-a-3"}},{"k":"text","v":{"s":"Sophie: Under very strange circumstances. 😅"}},{"k":"read","v":{"b":false}}],"id":198},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-08-1"}},{"k":"text","v":{"s":"Sophie: Can I be honest about something?"}},{"k":"read","v":{"b":false}}],"id":199},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-08-2"}},{"k":"text","v":{"s":"Sophie: I almost deleted your number before messaging you."}},{"k":"read","v":{"b":false}}],"id":200},{"o":[{"k":"id","v":{"s":"OPEN-S01-C09-a-1"}},{"k":"text","v":{"s":"Sophie: I kept thinking about the fact that it had been saved."}},{"k":"read","v":{"b":false}}],"id":201},{"o":[{"k":"id","v":{"s":"OPEN-S01-C09-a-2"}},{"k":"text","v":{"s":"Sophie: There had to be a reason."}},{"k":"read","v":{"b":false}}],"id":202},{"o":[{"k":"id","v":{"s":"OPEN-S01-C09-a-3"}},{"k":"text","v":{"s":"Sophie: Or at least I hoped there was."}},{"k":"read","v":{"b":false}}],"id":203},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-09-1"}},{"k":"text","v":{"s":"Sophie: Anyway."}},{"k":"read","v":{"b":false}}],"id":204},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-09-2"}},{"k":"text","v":{"s":"Sophie: I should probably let you go."}},{"k":"read","v":{"b":false}}],"id":205},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-09-3"}},{"k":"text","v":{"s":"Sophie: You've already been more patient than I expected."}},{"k":"read","v":{"b":false}}],"id":206},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-09-7"}},{"k":"text","v":{"s":"Sophie: Actually, wait."}},{"k":"read","v":{"b":false}}],"id":207},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-09-8"}},{"k":"text","v":{"s":"Sophie: There's something else."}},{"k":"read","v":{"b":false}}],"id":208},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-09-9"}},{"k":"text","v":{"s":"Sophie: I wasn't sure if I should mention it."}},{"k":"read","v":{"b":false}}],"id":209},{"o":[{"k":"id","v":{"s":"OPEN-S01-C10-a-1"}},{"k":"text","v":{"s":"Sophie: Okay."}},{"k":"read","v":{"b":false}}],"id":210},{"o":[{"k":"id","v":{"s":"OPEN-S01-C10-a-2"}},{"k":"text","v":{"s":"Sophie: Just give me a second."}},{"k":"read","v":{"b":false}}],"id":211},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-10-1"}},{"k":"text","v":{"s":"Sophie: I'm not the only one trying to understand what happened."}},{"k":"read","v":{"b":false}}],"id":212},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-10-2"}},{"k":"text","v":{"s":"Sophie: There are a few other people."}},{"k":"read","v":{"b":false}}],"id":213},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-10-3"}},{"k":"text","v":{"s":"Sophie: People who know Daniel."}},{"k":"read","v":{"b":false}}],"id":214},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-10-4"}},{"k":"text","v":{"s":"Sophie: We've been talking."}},{"k":"read","v":{"b":false}}],"id":215},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-10-5"}},{"k":"text","v":{"s":"Sophie: Although \"talking\" might be a generous way of putting it lately."}},{"k":"read","v":{"b":false}}],"id":216},{"o":[{"k":"id","v":{"s":"OPEN-S01-C11-a-1"}},{"k":"text","v":{"s":"Sophie: Everyone has their own idea of what we should do."}},{"k":"read","v":{"b":false}}],"id":217},{"o":[{"k":"id","v":{"s":"OPEN-S01-C11-a-2"}},{"k":"text","v":{"s":"Sophie: And no one seems to agree."}},{"k":"read","v":{"b":false}}],"id":218},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-11-1"}},{"k":"text","v":{"s":"Sophie: There's a group chat."}},{"k":"read","v":{"b":false}}],"id":219},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-11-2"}},{"k":"text","v":{"s":"Sophie: We've been using it to keep track of things."}},{"k":"read","v":{"b":false}}],"id":220},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-11-3"}},{"k":"text","v":{"s":"Sophie: Well..."}},{"k":"read","v":{"b":false}}],"id":221},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-11-4"}},{"k":"text","v":{"s":"Sophie: Trying to."}},{"k":"read","v":{"b":false}}],"id":222},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-11-5"}},{"k":"text","v":{"s":"Sophie: I was thinking..."}},{"k":"read","v":{"b":false}}],"id":223},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-11-7"}},{"k":"text","v":{"s":"Sophie: Maybe you could join us?"}},{"k":"read","v":{"b":false}}],"id":224},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-11-8"}},{"k":"text","v":{"s":"Sophie: Just for a little while."}},{"k":"read","v":{"b":false}}],"id":225},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-11-9"}},{"k":"text","v":{"s":"Sophie: You don't have to do anything."}},{"k":"read","v":{"b":false}}],"id":226},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-11-10"}},{"k":"text","v":{"s":"Sophie: You could just listen."}},{"k":"read","v":{"b":false}}],"id":227},{"o":[{"k":"id","v":{"s":"OPEN-S01-C12-a-1"}},{"k":"text","v":{"s":"Sophie: That's a very good question."}},{"k":"read","v":{"b":false}}],"id":228},{"o":[{"k":"id","v":{"s":"OPEN-S01-C12-a-2"}},{"k":"text","v":{"s":"Sophie: And I don't have a very convincing answer."}},{"k":"read","v":{"b":false}}],"id":229},{"o":[{"k":"id","v":{"s":"OPEN-S01-C12-a-3"}},{"k":"text","v":{"s":"Sophie: I just thought maybe you'd notice something we missed."}},{"k":"read","v":{"b":false}}],"id":230},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-12-1"}},{"k":"text","v":{"s":"Sophie: Look."}},{"k":"read","v":{"b":false}}],"id":231},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-12-2"}},{"k":"text","v":{"s":"Sophie: I'm not asking you to solve anything."}},{"k":"read","v":{"b":false}}],"id":232},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-12-3"}},{"k":"text","v":{"s":"Sophie: And I don't expect you to believe everything I'm saying."}},{"k":"read","v":{"b":false}}],"id":233},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-12-4"}},{"k":"text","v":{"s":"Sophie: I'd be suspicious too."}},{"k":"read","v":{"b":false}}],"id":234},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-12-5"}},{"k":"text","v":{"s":"Sophie: But if there's even a small chance your number means something..."}},{"k":"read","v":{"b":false}}],"id":235},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-12-6"}},{"k":"text","v":{"s":"Sophie: I don't want to ignore it."}},{"k":"read","v":{"b":false}}],"id":236},{"o":[{"k":"id","v":{"s":"OPEN-S01-C13-a-1"}},{"k":"text","v":{"s":"Sophie: Really?"}},{"k":"read","v":{"b":false}}],"id":237},{"o":[{"k":"id","v":{"s":"OPEN-S01-C13-a-2"}},{"k":"text","v":{"s":"Sophie: Okay."}},{"k":"read","v":{"b":false}}],"id":238},{"o":[{"k":"id","v":{"s":"OPEN-S01-C13-a-3"}},{"k":"text","v":{"s":"Sophie: Thank you."}},{"k":"read","v":{"b":false}}],"id":239},{"o":[{"k":"id","v":{"s":"OPEN-S01-C13-a-4"}},{"k":"text","v":{"s":"Sophie: I'll send you an invite."}},{"k":"read","v":{"b":false}}],"id":240},{"o":[{"k":"id","v":{"s":"OPEN-S01-WARNING-1"}},{"k":"text","v":{"s":"Sophie: Okay, before you join..."}},{"k":"read","v":{"b":false}}],"id":241},{"o":[{"k":"id","v":{"s":"OPEN-S01-WARNING-2"}},{"k":"text","v":{"s":"Sophie: Just so you know."}},{"k":"read","v":{"b":false}}],"id":242},{"o":[{"k":"id","v":{"s":"OPEN-S01-WARNING-3"}},{"k":"text","v":{"s":"Sophie: Not everyone in there is as friendly as me."}},{"k":"read","v":{"b":false}}],"id":243},{"o":[{"k":"id","v":{"s":"OPEN-S01-WARNING-5"}},{"k":"text","v":{"s":"Sophie: Wow. That sounded incredibly arrogant."}},{"k":"read","v":{"b":false}}],"id":244},{"o":[{"k":"id","v":{"s":"OPEN-S01-WARNING-6"}},{"k":"text","v":{"s":"Sophie: You know what I mean. 😅"}},{"k":"read","v":{"b":false}}],"id":245},{"o":[{"k":"id","v":{"s":"OPEN-S01-C14-a-1"}},{"k":"text","v":{"s":"Sophie: Good."}},{"k":"read","v":{"b":false}}],"id":246},{"o":[{"k":"id","v":{"s":"OPEN-S01-C14-a-2"}},{"k":"text","v":{"s":"Sophie: Because I can't guarantee a warm welcome."}},{"k":"read","v":{"b":false}}],"id":247},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-14-1"}},{"k":"text","v":{"s":"Sophie: Anyway."}},{"k":"read","v":{"b":false}}],"id":248},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-14-2"}},{"k":"text","v":{"s":"Sophie: Here goes nothing."}},{"k":"read","v":{"b":false}}],"id":249},{"o":[{"k":"id","v":{"s":"OPEN-S01-INVITATION"}},{"k":"text","v":{"s":"Sophie sent a group invitation"}},{"k":"read","v":{"b":false}}],"id":250},{"o":[{"k":"id","v":{"s":"OPEN-S02-OPENING-2"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Hey, everyone."}},{"k":"read","v":{"b":false}}],"id":251},{"o":[{"k":"id","v":{"s":"OPEN-S02-OPENING-4"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Before anyone says anything..."}},{"k":"read","v":{"b":false}}],"id":252},{"o":[{"k":"id","v":{"s":"OPEN-S02-OPENING-5"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I added someone."}},{"k":"read","v":{"b":false}}],"id":253},{"o":[{"k":"id","v":{"s":"OPEN-S02-OPENING-6"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: You added someone?"}},{"k":"read","v":{"b":false}}],"id":254},{"o":[{"k":"id","v":{"s":"OPEN-S02-OPENING-7"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Yes."}},{"k":"read","v":{"b":false}}],"id":255},{"o":[{"k":"id","v":{"s":"OPEN-S02-OPENING-8"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Sophie."}},{"k":"read","v":{"b":false}}],"id":256},{"o":[{"k":"id","v":{"s":"OPEN-S02-OPENING-9"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: We literally talked about this."}},{"k":"read","v":{"b":false}}],"id":257},{"o":[{"k":"id","v":{"s":"OPEN-S02-OPENING-10"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I know."}},{"k":"read","v":{"b":false}}],"id":258},{"o":[{"k":"id","v":{"s":"OPEN-S02-OPENING-11"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Who?"}},{"k":"read","v":{"b":false}}],"id":259},{"o":[{"k":"id","v":{"s":"OPEN-S02-OPENING-13"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Who did you add?"}},{"k":"read","v":{"b":false}}],"id":260},{"o":[{"k":"id","v":{"s":"OPEN-S02-OPENING-14"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: The number I told you about."}},{"k":"read","v":{"b":false}}],"id":261},{"o":[{"k":"id","v":{"s":"OPEN-S02-OPENING-15"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Wait."}},{"k":"read","v":{"b":false}}],"id":262},{"o":[{"k":"id","v":{"s":"OPEN-S02-OPENING-16"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: You actually contacted it?"}},{"k":"read","v":{"b":false}}],"id":263},{"o":[{"k":"id","v":{"s":"OPEN-S02-OPENING-17"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Yeah."}},{"k":"read","v":{"b":false}}],"id":264},{"o":[{"k":"id","v":{"s":"OPEN-S02-OPENING-18"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: You've got to be kidding me."}},{"k":"read","v":{"b":false}}],"id":265},{"o":[{"k":"id","v":{"s":"OPEN-S02-OPENING-19"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Lucas, please."}},{"k":"read","v":{"b":false}}],"id":266},{"o":[{"k":"id","v":{"s":"OPEN-S02-OPENING-20"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Please what?"}},{"k":"read","v":{"b":false}}],"id":267},{"o":[{"k":"id","v":{"s":"OPEN-S02-OPENING-21"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: We don't even know who this is."}},{"k":"read","v":{"b":false}}],"id":268},{"o":[{"k":"id","v":{"s":"OPEN-S02-OPENING-22"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Can we just calm down for a second?"}},{"k":"read","v":{"b":false}}],"id":269},{"o":[{"k":"id","v":{"s":"OPEN-S02-OPENING-23"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: I'm calm."}},{"k":"read","v":{"b":false}}],"id":270},{"o":[{"k":"id","v":{"s":"OPEN-S02-OPENING-24"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: You're really not."}},{"k":"read","v":{"b":false}}],"id":271},{"o":[{"k":"id","v":{"s":"OPEN-S02-OPENING-25"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Fine."}},{"k":"read","v":{"b":false}}],"id":272},{"o":[{"k":"id","v":{"s":"OPEN-S02-OPENING-26"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Then maybe our new guest would like to explain why they're here."}},{"k":"read","v":{"b":false}}],"id":273},{"o":[{"k":"id","v":{"s":"CH1-SENDER-FIRST"}},{"k":"text","v":{"s":"Be careful who you trust in that group."}},{"k":"read","v":{"b":true}}],"id":274},{"o":[{"k":"id","v":{"s":"OPEN-S02-C01-a-1"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Great."}},{"k":"read","v":{"b":false}}],"id":275},{"o":[{"k":"id","v":{"s":"OPEN-S02-C01-a-2"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: That makes two of us."}},{"k":"read","v":{"b":false}}],"id":276},{"o":[{"k":"id","v":{"s":"OPEN-S02-C01-a-3"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: At least they're being honest."}},{"k":"read","v":{"b":false}}],"id":277},{"o":[{"k":"id","v":{"s":"OPEN-S02-C01-a-4"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Or they know how to sound honest."}},{"k":"read","v":{"b":false}}],"id":278},{"o":[{"k":"id","v":{"s":"OPEN-S02-C01-a-5"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Lucas."}},{"k":"read","v":{"b":false}}],"id":279},{"o":[{"k":"id","v":{"s":"OPEN-S02-C01-a-6"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: What?"}},{"k":"read","v":{"b":false}}],"id":280},{"o":[{"k":"id","v":{"s":"OPEN-S02-C01-a-7"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: I'm allowed to have questions."}},{"k":"read","v":{"b":false}}],"id":281},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-01-2"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Alright."}},{"k":"read","v":{"b":false}}],"id":282},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-01-3"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Let's start with something simple."}},{"k":"read","v":{"b":false}}],"id":283},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-01-4"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Do you know Daniel?"}},{"k":"read","v":{"b":false}}],"id":284},{"o":[{"k":"id","v":{"s":"OPEN-S02-C02-a-1"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Then why was your number saved?"}},{"k":"read","v":{"b":false}}],"id":285},{"o":[{"k":"id","v":{"s":"OPEN-S02-C02-a-3"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Fair enough."}},{"k":"read","v":{"b":false}}],"id":286},{"o":[{"k":"id","v":{"s":"OPEN-S02-C02-a-4"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: See? That's why I added them."}},{"k":"read","v":{"b":false}}],"id":287},{"o":[{"k":"id","v":{"s":"OPEN-S02-C02-a-5"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: That doesn't answer anything."}},{"k":"read","v":{"b":false}}],"id":288},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-02-1"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: So let me get this straight."}},{"k":"read","v":{"b":false}}],"id":289},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-02-2"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Daniel had your number."}},{"k":"read","v":{"b":false}}],"id":290},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-02-3"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: You don't know Daniel."}},{"k":"read","v":{"b":false}}],"id":291},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-02-4"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: And you have absolutely no idea why he saved it."}},{"k":"read","v":{"b":false}}],"id":292},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-02-5"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: That's what we're trying to figure out."}},{"k":"read","v":{"b":false}}],"id":293},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-02-6"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Doesn't that seem a little convenient to anyone else?"}},{"k":"read","v":{"b":false}}],"id":294},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-02-7"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Convenient for who?"}},{"k":"read","v":{"b":false}}],"id":295},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-02-8"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: I don't know, Maya."}},{"k":"read","v":{"b":false}}],"id":296},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-02-9"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: That's the problem."}},{"k":"read","v":{"b":false}}],"id":297},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-02-11"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Maybe he saved the wrong number."}},{"k":"read","v":{"b":false}}],"id":298},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-02-12"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Possible."}},{"k":"read","v":{"b":false}}],"id":299},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-02-13"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Sure."}},{"k":"read","v":{"b":false}}],"id":300},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-02-14"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: And maybe this is all one big misunderstanding."}},{"k":"read","v":{"b":false}}],"id":301},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-02-15"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: It could be."}},{"k":"read","v":{"b":false}}],"id":302},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-02-16"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: You don't actually believe that."}},{"k":"read","v":{"b":false}}],"id":303},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-02-17"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: I believe we don't have enough information."}},{"k":"read","v":{"b":false}}],"id":304},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-02-19"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Fine."}},{"k":"read","v":{"b":false}}],"id":305},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-02-20"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Let's ask something else."}},{"k":"read","v":{"b":false}}],"id":306},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-02-21"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Lucas, don't start."}},{"k":"read","v":{"b":false}}],"id":307},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-02-22"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: It's a question, Sophie."}},{"k":"read","v":{"b":false}}],"id":308},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-02-23"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Where were you three nights ago?"}},{"k":"read","v":{"b":false}}],"id":309},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-02-24"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Oh, come on."}},{"k":"read","v":{"b":false}}],"id":310},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-02-25"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Lucas!"}},{"k":"read","v":{"b":false}}],"id":311},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-02-26"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: What?"}},{"k":"read","v":{"b":false}}],"id":312},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-02-27"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: We don't know anything about this person."}},{"k":"read","v":{"b":false}}],"id":313},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-02-28"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: And you think asking for an alibi is going to help?"}},{"k":"read","v":{"b":false}}],"id":314},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-02-29"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: It might."}},{"k":"read","v":{"b":false}}],"id":315},{"o":[{"k":"id","v":{"s":"OPEN-S02-C03-a-1"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: See?"}},{"k":"read","v":{"b":false}}],"id":316},{"o":[{"k":"id","v":{"s":"OPEN-S02-C03-a-2"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Already being difficult."}},{"k":"read","v":{"b":false}}],"id":317},{"o":[{"k":"id","v":{"s":"OPEN-S02-C03-a-3"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: No, they're setting a boundary."}},{"k":"read","v":{"b":false}}],"id":318},{"o":[{"k":"id","v":{"s":"OPEN-S02-C03-a-4"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I wouldn't answer that either."}},{"k":"read","v":{"b":false}}],"id":319},{"o":[{"k":"id","v":{"s":"OPEN-S02-C03-a-5"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Of course you wouldn't."}},{"k":"read","v":{"b":false}}],"id":320},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-03-1"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Okay."}},{"k":"read","v":{"b":false}}],"id":321},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-03-2"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Enough with the questions about where people were."}},{"k":"read","v":{"b":false}}],"id":322},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-03-3"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: We barely know who's on the other side of the screen."}},{"k":"read","v":{"b":false}}],"id":323},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-03-4"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Exactly my point."}},{"k":"read","v":{"b":false}}],"id":324},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-03-5"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: No. Your point was to accuse them before we know anything."}},{"k":"read","v":{"b":false}}],"id":325},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-03-6"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: I'm trying to be careful."}},{"k":"read","v":{"b":false}}],"id":326},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-03-7"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Then be careful."}},{"k":"read","v":{"b":false}}],"id":327},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-03-8"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Not cruel."}},{"k":"read","v":{"b":false}}],"id":328},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-03-10"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Can I explain why I thought adding them was a good idea?"}},{"k":"read","v":{"b":false}}],"id":329},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-03-11"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: You could try."}},{"k":"read","v":{"b":false}}],"id":330},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-03-12"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Go ahead, Soph."}},{"k":"read","v":{"b":false}}],"id":331},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-03-13"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I found a saved contact export."}},{"k":"read","v":{"b":false}}],"id":332},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-03-14"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: It's labelled as Daniel's contacts."}},{"k":"read","v":{"b":false}}],"id":333},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-03-15"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I already told you about it."}},{"k":"read","v":{"b":false}}],"id":334},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-03-16"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Right."}},{"k":"read","v":{"b":false}}],"id":335},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-03-17"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: And the number didn't have a name."}},{"k":"read","v":{"b":false}}],"id":336},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-03-18"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: We know."}},{"k":"read","v":{"b":false}}],"id":337},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-03-19"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I'm getting there."}},{"k":"read","v":{"b":false}}],"id":338},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-03-20"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: There was something beside it."}},{"k":"read","v":{"b":false}}],"id":339},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-03-21"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: A star next to the number."}},{"k":"read","v":{"b":false}}],"id":340},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-03-22"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: A favourite contact?"}},{"k":"read","v":{"b":false}}],"id":341},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-03-23"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Maybe. I don't know how that export uses it."}},{"k":"read","v":{"b":false}}],"id":342},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-03-24"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: It just says starred. There's no saved name or label."}},{"k":"read","v":{"b":false}}],"id":343},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-03-25"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Do we even know Daniel was the one who marked it?"}},{"k":"read","v":{"b":false}}],"id":344},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-03-26"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: No. We don't."}},{"k":"read","v":{"b":false}}],"id":345},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-03-27"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I know. I'm not saying he was."}},{"k":"read","v":{"b":false}}],"id":346},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-03-29"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Then what made you contact the number?"}},{"k":"read","v":{"b":false}}],"id":347},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-03-30"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I hoped whoever answered might recognise him."}},{"k":"read","v":{"b":false}}],"id":348},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-03-31"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Did they?"}},{"k":"read","v":{"b":false}}],"id":349},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-03-32"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: No. But I didn't want to shut the door without asking."}},{"k":"read","v":{"b":false}}],"id":350},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-03-34"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: ..."}},{"k":"read","v":{"b":false}}],"id":351},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-03-35"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: So this was a guess?"}},{"k":"read","v":{"b":false}}],"id":352},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-03-36"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: A question. I hoped it might lead somewhere."}},{"k":"read","v":{"b":false}}],"id":353},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-03-37"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: That's different from knowing it would."}},{"k":"read","v":{"b":false}}],"id":354},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-03-38"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: You've been going through a lot of his things."}},{"k":"read","v":{"b":false}}],"id":355},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-03-39"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: We can ask questions without treating the star as proof."}},{"k":"read","v":{"b":false}}],"id":356},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-03-40"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I know."}},{"k":"read","v":{"b":false}}],"id":357},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-03-41"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I just don't want us to stop looking."}},{"k":"read","v":{"b":false}}],"id":358},{"o":[{"k":"id","v":{"s":"OPEN-S02-C04-a-1"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: No. The copy doesn't show who did it."}},{"k":"read","v":{"b":false}}],"id":359},{"o":[{"k":"id","v":{"s":"OPEN-S02-C04-a-2"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I shouldn't have assumed it was Daniel."}},{"k":"read","v":{"b":false}}],"id":360},{"o":[{"k":"id","v":{"s":"OPEN-S02-C04-a-3"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: That's what I've been trying to say."}},{"k":"read","v":{"b":false}}],"id":361},{"o":[{"k":"id","v":{"s":"OPEN-S02-C04-a-4"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Then we keep that question open."}},{"k":"read","v":{"b":false}}],"id":362},{"o":[{"k":"id","v":{"s":"OPEN-S02-C04-a-5"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Yeah. That's fair."}},{"k":"read","v":{"b":false}}],"id":363},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-04-2"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Sophie, can you check something for me?"}},{"k":"read","v":{"b":false}}],"id":364},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-04-3"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Yeah?"}},{"k":"read","v":{"b":false}}],"id":365},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-04-4"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Does the export show when the number was starred?"}},{"k":"read","v":{"b":false}}],"id":366},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-04-5"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: No. Not in the copy I have."}},{"k":"read","v":{"b":false}}],"id":367},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-04-6"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Or who changed it?"}},{"k":"read","v":{"b":false}}],"id":368},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-04-7"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: No. I checked for that too."}},{"k":"read","v":{"b":false}}],"id":369},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-04-8"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Then the star doesn't tell us it was his decision."}},{"k":"read","v":{"b":false}}],"id":370},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-04-9"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Lucas, I am trying."}},{"k":"read","v":{"b":false}}],"id":371},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-04-10"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: I know."}},{"k":"read","v":{"b":false}}],"id":372},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-04-11"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: But we can't keep building theories around things nobody's verified."}},{"k":"read","v":{"b":false}}],"id":373},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-04-12"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: For once, that part is fair."}},{"k":"read","v":{"b":false}}],"id":374},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-04-13"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Okay."}},{"k":"read","v":{"b":false}}],"id":375},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-04-14"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I'll look at it again."}},{"k":"read","v":{"b":false}}],"id":376},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-04-17"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Can we talk about something else for a second?"}},{"k":"read","v":{"b":false}}],"id":377},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-04-18"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Like what?"}},{"k":"read","v":{"b":false}}],"id":378},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-04-19"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Whether anyone's actually eaten today."}},{"k":"read","v":{"b":false}}],"id":379},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-04-20"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Maya..."}},{"k":"read","v":{"b":false}}],"id":380},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-04-21"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: I'm serious."}},{"k":"read","v":{"b":false}}],"id":381},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-04-22"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: You were still awake when I went to bed."}},{"k":"read","v":{"b":false}}],"id":382},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-04-23"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I slept."}},{"k":"read","v":{"b":false}}],"id":383},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-04-24"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: For how long?"}},{"k":"read","v":{"b":false}}],"id":384},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-04-25"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Enough."}},{"k":"read","v":{"b":false}}],"id":385},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-04-26"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: That's not a number."}},{"k":"read","v":{"b":false}}],"id":386},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-04-27"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: You're starting to sound like my mother."}},{"k":"read","v":{"b":false}}],"id":387},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-04-28"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Someone has to."}},{"k":"read","v":{"b":false}}],"id":388},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-04-30"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: I ate."}},{"k":"read","v":{"b":false}}],"id":389},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-04-31"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Congratulations, Lucas."}},{"k":"read","v":{"b":false}}],"id":390},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-04-32"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: You asked."}},{"k":"read","v":{"b":false}}],"id":391},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-04-33"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: I did."}},{"k":"read","v":{"b":false}}],"id":392},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-04-34"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: 😂"}},{"k":"read","v":{"b":false}}],"id":393},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-04-35"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: There. See?"}},{"k":"read","v":{"b":false}}],"id":394},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-04-36"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: She still remembers how to laugh."}},{"k":"read","v":{"b":false}}],"id":395},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-04-37"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Barely."}},{"k":"read","v":{"b":false}}],"id":396},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-04-39"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: It isn't funny."}},{"k":"read","v":{"b":false}}],"id":397},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-04-40"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Nobody said the situation was funny."}},{"k":"read","v":{"b":false}}],"id":398},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-04-41"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Then can we stay focused?"}},{"k":"read","v":{"b":false}}],"id":399},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-04-42"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: We can be worried and still act like human beings."}},{"k":"read","v":{"b":false}}],"id":400},{"o":[{"k":"id","v":{"s":"OPEN-S02-C05-a-1"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Thank you."}},{"k":"read","v":{"b":false}}],"id":401},{"o":[{"k":"id","v":{"s":"OPEN-S02-C05-a-2"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I probably am."}},{"k":"read","v":{"b":false}}],"id":402},{"o":[{"k":"id","v":{"s":"OPEN-S02-C05-a-3"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: I'm fine."}},{"k":"read","v":{"b":false}}],"id":403},{"o":[{"k":"id","v":{"s":"OPEN-S02-C05-a-4"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: That's exactly what an exhausted person would say."}},{"k":"read","v":{"b":false}}],"id":404},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-05-1"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Okay."}},{"k":"read","v":{"b":false}}],"id":405},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-05-2"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I'm getting some water."}},{"k":"read","v":{"b":false}}],"id":406},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-05-3"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Finally."}},{"k":"read","v":{"b":false}}],"id":407},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-05-4"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Don't celebrate yet."}},{"k":"read","v":{"b":false}}],"id":408},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-05-5"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I'll be back in like two minutes."}},{"k":"read","v":{"b":false}}],"id":409},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-05-6"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Progress is progress."}},{"k":"read","v":{"b":false}}],"id":410},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-05-10"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Maya."}},{"k":"read","v":{"b":false}}],"id":411},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-05-11"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: What?"}},{"k":"read","v":{"b":false}}],"id":412},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-05-12"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: You're being awfully relaxed about this."}},{"k":"read","v":{"b":false}}],"id":413},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-05-13"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: About what?"}},{"k":"read","v":{"b":false}}],"id":414},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-05-14"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: This person."}},{"k":"read","v":{"b":false}}],"id":415},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-05-15"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: I'm not relaxed."}},{"k":"read","v":{"b":false}}],"id":416},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-05-16"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: You're joking with them."}},{"k":"read","v":{"b":false}}],"id":417},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-05-17"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: That doesn't mean I trust them."}},{"k":"read","v":{"b":false}}],"id":418},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-05-19"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Good."}},{"k":"read","v":{"b":false}}],"id":419},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-05-20"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Because I don't."}},{"k":"read","v":{"b":false}}],"id":420},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-05-21"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: You made that pretty clear."}},{"k":"read","v":{"b":false}}],"id":421},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-05-22"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: I don't understand why Sophie is doing this."}},{"k":"read","v":{"b":false}}],"id":422},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-05-23"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: She's scared."}},{"k":"read","v":{"b":false}}],"id":423},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-05-24"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: We're all scared."}},{"k":"read","v":{"b":false}}],"id":424},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-05-25"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: I know."}},{"k":"read","v":{"b":false}}],"id":425},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-05-26"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: And that doesn't mean we invite strangers into everything."}},{"k":"read","v":{"b":false}}],"id":426},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-05-28"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: You're still here, by the way."}},{"k":"read","v":{"b":false}}],"id":427},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-05-29"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: What?"}},{"k":"read","v":{"b":false}}],"id":428},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-05-30"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: The person you're talking about."}},{"k":"read","v":{"b":false}}],"id":429},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-05-31"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: They're still in the group."}},{"k":"read","v":{"b":false}}],"id":430},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-05-32"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: I know."}},{"k":"read","v":{"b":false}}],"id":431},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-05-33"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Then maybe stop talking about them like they aren't."}},{"k":"read","v":{"b":false}}],"id":432},{"o":[{"k":"id","v":{"s":"OPEN-S02-C06-a-1"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Exactly."}},{"k":"read","v":{"b":false}}],"id":433},{"o":[{"k":"id","v":{"s":"OPEN-S02-C06-a-2"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: I wasn't trying to hide it."}},{"k":"read","v":{"b":false}}],"id":434},{"o":[{"k":"id","v":{"s":"OPEN-S02-C06-a-4"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Lucas, just stop digging."}},{"k":"read","v":{"b":false}}],"id":435},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-06-2"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Listen."}},{"k":"read","v":{"b":false}}],"id":436},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-06-3"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: I'm not going to pretend this isn't strange."}},{"k":"read","v":{"b":false}}],"id":437},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-06-4"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: I don't know you."}},{"k":"read","v":{"b":false}}],"id":438},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-06-5"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: And I don't know what your number means."}},{"k":"read","v":{"b":false}}],"id":439},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-06-6"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: But I also don't think it's fair to assume the worst just because we don't have an answer."}},{"k":"read","v":{"b":false}}],"id":440},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-06-7"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: That goes both ways."}},{"k":"read","v":{"b":false}}],"id":441},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-06-8"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: It does."}},{"k":"read","v":{"b":false}}],"id":442},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-06-9"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Fine."}},{"k":"read","v":{"b":false}}],"id":443},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-06-11"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Then answer one thing."}},{"k":"read","v":{"b":false}}],"id":444},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-06-12"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Why are you still here?"}},{"k":"read","v":{"b":false}}],"id":445},{"o":[{"k":"id","v":{"s":"OPEN-S02-C07-a-1"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Okay."}},{"k":"read","v":{"b":false}}],"id":446},{"o":[{"k":"id","v":{"s":"OPEN-S02-C07-a-2"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: That's a fair answer."}},{"k":"read","v":{"b":false}}],"id":447},{"o":[{"k":"id","v":{"s":"OPEN-S02-C07-a-3"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: You're going to need a better reason eventually."}},{"k":"read","v":{"b":false}}],"id":448},{"o":[{"k":"id","v":{"s":"OPEN-S02-C07-a-4"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: They don't owe us a lifelong commitment, Lucas."}},{"k":"read","v":{"b":false}}],"id":449},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-2"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Okay, I'm back."}},{"k":"read","v":{"b":false}}],"id":450},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-3"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: What did I miss?"}},{"k":"read","v":{"b":false}}],"id":451},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-4"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Nothing."}},{"k":"read","v":{"b":false}}],"id":452},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-5"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Plenty."}},{"k":"read","v":{"b":false}}],"id":453},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-6"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: ..."}},{"k":"read","v":{"b":false}}],"id":454},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-7"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Oh no."}},{"k":"read","v":{"b":false}}],"id":455},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-8"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Please tell me you didn't start another argument."}},{"k":"read","v":{"b":false}}],"id":456},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-9"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: We were having a conversation."}},{"k":"read","v":{"b":false}}],"id":457},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-10"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: A very educational one."}},{"k":"read","v":{"b":false}}],"id":458},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-11"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Lucas."}},{"k":"read","v":{"b":false}}],"id":459},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-12"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Sophie."}},{"k":"read","v":{"b":false}}],"id":460},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-13"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Children."}},{"k":"read","v":{"b":false}}],"id":461},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-14"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: 🙄"}},{"k":"read","v":{"b":false}}],"id":462},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-16"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Look, I know adding someone without asking wasn't ideal."}},{"k":"read","v":{"b":false}}],"id":463},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-17"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: It wasn't ideal?"}},{"k":"read","v":{"b":false}}],"id":464},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-18"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Fine."}},{"k":"read","v":{"b":false}}],"id":465},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-19"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: It was a bad call."}},{"k":"read","v":{"b":false}}],"id":466},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-20"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Is that what you want me to say?"}},{"k":"read","v":{"b":false}}],"id":467},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-21"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: I want you to understand why it was a bad call."}},{"k":"read","v":{"b":false}}],"id":468},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-22"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I understand."}},{"k":"read","v":{"b":false}}],"id":469},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-23"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Then why did you do it?"}},{"k":"read","v":{"b":false}}],"id":470},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-24"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Because I'm tired of sitting here doing nothing!"}},{"k":"read","v":{"b":false}}],"id":471},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-26"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Sorry."}},{"k":"read","v":{"b":false}}],"id":472},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-27"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I didn't mean to snap."}},{"k":"read","v":{"b":false}}],"id":473},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-28"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: It's okay."}},{"k":"read","v":{"b":false}}],"id":474},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-29"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: No, it's not."}},{"k":"read","v":{"b":false}}],"id":475},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-30"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Lucas..."}},{"k":"read","v":{"b":false}}],"id":476},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-31"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: We're making decisions because we're scared."}},{"k":"read","v":{"b":false}}],"id":477},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-32"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: And we don't even know what we're risking."}},{"k":"read","v":{"b":false}}],"id":478},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-33"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I know!"}},{"k":"read","v":{"b":false}}],"id":479},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-34"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Do you think I don't think about that?"}},{"k":"read","v":{"b":false}}],"id":480},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-35"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Then start acting like it."}},{"k":"read","v":{"b":false}}],"id":481},{"o":[{"k":"id","v":{"s":"OPEN-S02-C08-a-1"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: No."}},{"k":"read","v":{"b":false}}],"id":482},{"o":[{"k":"id","v":{"s":"OPEN-S02-C08-a-2"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: That's not what I want."}},{"k":"read","v":{"b":false}}],"id":483},{"o":[{"k":"id","v":{"s":"OPEN-S02-C08-a-3"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: And we haven't asked you to leave."}},{"k":"read","v":{"b":false}}],"id":484},{"o":[{"k":"id","v":{"s":"OPEN-S02-C08-a-4"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: I might."}},{"k":"read","v":{"b":false}}],"id":485},{"o":[{"k":"id","v":{"s":"OPEN-S02-C08-a-5"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Lucas."}},{"k":"read","v":{"b":false}}],"id":486},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-2"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Fine."}},{"k":"read","v":{"b":false}}],"id":487},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-3"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: What do you want me to do?"}},{"k":"read","v":{"b":false}}],"id":488},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-4"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: I want us to stop sharing things until we know who we're sharing them with."}},{"k":"read","v":{"b":false}}],"id":489},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-5"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: That seems reasonable."}},{"k":"read","v":{"b":false}}],"id":490},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-6"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: So what?"}},{"k":"read","v":{"b":false}}],"id":491},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-7"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: We just ignore the number?"}},{"k":"read","v":{"b":false}}],"id":492},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-8"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: No."}},{"k":"read","v":{"b":false}}],"id":493},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-9"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: We verify it."}},{"k":"read","v":{"b":false}}],"id":494},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-10"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: How?"}},{"k":"read","v":{"b":false}}],"id":495},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-11"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: I don't know yet."}},{"k":"read","v":{"b":false}}],"id":496},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-12"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Exactly."}},{"k":"read","v":{"b":false}}],"id":497},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-13"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Not knowing how to do something doesn't mean we should do the first thing that comes to mind."}},{"k":"read","v":{"b":false}}],"id":498},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-14"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: And waiting doesn't guarantee we'll learn anything!"}},{"k":"read","v":{"b":false}}],"id":499},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-16"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Can both of you stop for a second?"}},{"k":"read","v":{"b":false}}],"id":500},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-17"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Sorry."}},{"k":"read","v":{"b":false}}],"id":501},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-18"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: I'm listening."}},{"k":"read","v":{"b":false}}],"id":502},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-19"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Nobody here knows what happened to Daniel."}},{"k":"read","v":{"b":false}}],"id":503},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-20"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: We keep going in circles."}},{"k":"read","v":{"b":false}}],"id":504},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-21"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: We don't even agree about what happened that night."}},{"k":"read","v":{"b":false}}],"id":505},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-22"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Maya."}},{"k":"read","v":{"b":false}}],"id":506},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-23"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: What?"}},{"k":"read","v":{"b":false}}],"id":507},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-24"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Don't."}},{"k":"read","v":{"b":false}}],"id":508},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-26"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: She's right."}},{"k":"read","v":{"b":false}}],"id":509},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-27"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: ..."}},{"k":"read","v":{"b":false}}],"id":510},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-28"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: We keep acting like we have all these answers."}},{"k":"read","v":{"b":false}}],"id":511},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-29"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: But we don't."}},{"k":"read","v":{"b":false}}],"id":512},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-30"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Can we please not do this right now?"}},{"k":"read","v":{"b":false}}],"id":513},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-31"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: I'm not trying to start anything."}},{"k":"read","v":{"b":false}}],"id":514},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-32"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: I'm just saying we need to stop mixing up what we know and what we think we know."}},{"k":"read","v":{"b":false}}],"id":515},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-33"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Exactly."}},{"k":"read","v":{"b":false}}],"id":516},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-35"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Okay."}},{"k":"read","v":{"b":false}}],"id":517},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-36"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: You're right."}},{"k":"read","v":{"b":false}}],"id":518},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-37"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Both of you."}},{"k":"read","v":{"b":false}}],"id":519},{"o":[{"k":"id","v":{"s":"OPEN-S02-C09-a-1"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: That's what we're trying to establish."}},{"k":"read","v":{"b":false}}],"id":520},{"o":[{"k":"id","v":{"s":"OPEN-S02-C09-a-2"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Which is why we shouldn't be discussing it with someone we just met."}},{"k":"read","v":{"b":false}}],"id":521},{"o":[{"k":"id","v":{"s":"OPEN-S02-C09-a-3"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Lucas has a point."}},{"k":"read","v":{"b":false}}],"id":522},{"o":[{"k":"id","v":{"s":"OPEN-S02-C09-a-5"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Sorry."}},{"k":"read","v":{"b":false}}],"id":523},{"o":[{"k":"id","v":{"s":"OPEN-S02-C09-a-6"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I know that's frustrating."}},{"k":"read","v":{"b":false}}],"id":524},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-3"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Maya?"}},{"k":"read","v":{"b":false}}],"id":525},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-4"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Sorry."}},{"k":"read","v":{"b":false}}],"id":526},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-5"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Wrong chat."}},{"k":"read","v":{"b":false}}],"id":527},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-6"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: What did you delete?"}},{"k":"read","v":{"b":false}}],"id":528},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-7"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: A message meant for someone else."}},{"k":"read","v":{"b":false}}],"id":529},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-8"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: About what?"}},{"k":"read","v":{"b":false}}],"id":530},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-9"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Something unrelated."}},{"k":"read","v":{"b":false}}],"id":531},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-10"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Right."}},{"k":"read","v":{"b":false}}],"id":532},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-11"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Lucas."}},{"k":"read","v":{"b":false}}],"id":533},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-12"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: What?"}},{"k":"read","v":{"b":false}}],"id":534},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-13"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Please don't make something out of nothing."}},{"k":"read","v":{"b":false}}],"id":535},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-15"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: You know what bothers me the most?"}},{"k":"read","v":{"b":false}}],"id":536},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-16"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: What?"}},{"k":"read","v":{"b":false}}],"id":537},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-17"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: We keep saying we trust each other."}},{"k":"read","v":{"b":false}}],"id":538},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-18"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: But the moment something goes wrong, suddenly everyone has something they don't want to explain."}},{"k":"read","v":{"b":false}}],"id":539},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-19"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: That's not fair."}},{"k":"read","v":{"b":false}}],"id":540},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-20"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Isn't it?"}},{"k":"read","v":{"b":false}}],"id":541},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-21"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: What are you trying to say?"}},{"k":"read","v":{"b":false}}],"id":542},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-22"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: I'm saying maybe we should stop pretending everything's fine."}},{"k":"read","v":{"b":false}}],"id":543},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-23"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Nobody's pretending everything's fine."}},{"k":"read","v":{"b":false}}],"id":544},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-24"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Then why does it feel like I'm the only one asking the obvious questions?"}},{"k":"read","v":{"b":false}}],"id":545},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-25"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: You're not."}},{"k":"read","v":{"b":false}}],"id":546},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-26"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Really?"}},{"k":"read","v":{"b":false}}],"id":547},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-27"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Really."}},{"k":"read","v":{"b":false}}],"id":548},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-28"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Then answer this."}},{"k":"read","v":{"b":false}}],"id":549},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-30"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Why does Daniel have a stranger's number saved without a name?"}},{"k":"read","v":{"b":false}}],"id":550},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-31"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I don't know."}},{"k":"read","v":{"b":false}}],"id":551},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-32"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Who marked it with a star?"}},{"k":"read","v":{"b":false}}],"id":552},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-33"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I don't know!"}},{"k":"read","v":{"b":false}}],"id":553},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-34"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Why has nobody heard from him?"}},{"k":"read","v":{"b":false}}],"id":554},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-35"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: LUCAS!"}},{"k":"read","v":{"b":false}}],"id":555},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-37"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Stop."}},{"k":"read","v":{"b":false}}],"id":556},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-38"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Both of you."}},{"k":"read","v":{"b":false}}],"id":557},{"o":[{"k":"id","v":{"s":"OPEN-S02-C10-a-1"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Exactly."}},{"k":"read","v":{"b":false}}],"id":558},{"o":[{"k":"id","v":{"s":"OPEN-S02-C10-a-2"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Then maybe we shouldn't be acting like we do."}},{"k":"read","v":{"b":false}}],"id":559},{"o":[{"k":"id","v":{"s":"OPEN-S02-C10-a-3"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I'm not!"}},{"k":"read","v":{"b":false}}],"id":560},{"o":[{"k":"id","v":{"s":"OPEN-S02-C10-a-4"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Then stop making decisions for everyone."}},{"k":"read","v":{"b":false}}],"id":561},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-10-2"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Fine."}},{"k":"read","v":{"b":false}}],"id":562},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-10-3"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Maybe adding someone was a mistake."}},{"k":"read","v":{"b":false}}],"id":563},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-10-4"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: But I still think ignoring the number would've been worse."}},{"k":"read","v":{"b":false}}],"id":564},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-10-5"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: That's your opinion."}},{"k":"read","v":{"b":false}}],"id":565},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-10-6"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Yes."}},{"k":"read","v":{"b":false}}],"id":566},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-10-7"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: It is."}},{"k":"read","v":{"b":false}}],"id":567},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-10-9"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Nobody has to decide everything right now."}},{"k":"read","v":{"b":false}}],"id":568},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-10-10"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: No."}},{"k":"read","v":{"b":false}}],"id":569},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-10-11"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: But we do have to decide what we're willing to risk."}},{"k":"read","v":{"b":false}}],"id":570},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-10-12"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: What does that mean?"}},{"k":"read","v":{"b":false}}],"id":571},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-10-13"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: It means I'm not comfortable with this anymore."}},{"k":"read","v":{"b":false}}],"id":572},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-10-14"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: With what?"}},{"k":"read","v":{"b":false}}],"id":573},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-10-15"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: With how we're handling everything."}},{"k":"read","v":{"b":false}}],"id":574},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-10-16"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Lucas..."}},{"k":"read","v":{"b":false}}],"id":575},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-10-17"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: No, S