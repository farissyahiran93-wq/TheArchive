},{"o":[{"k":"id","v":{"s":"OPEN-S03-C01-a-2"}},{"k":"text","v":{"s":"Sophie: And you caught us on a relatively good day."}},{"k":"read","v":{"b":false}}],"id":641},{"o":[{"k":"id","v":{"s":"OPEN-S03-C01-a-4"}},{"k":"text","v":{"s":"Sophie: Kidding."}},{"k":"read","v":{"b":false}}],"id":642},{"o":[{"k":"id","v":{"s":"OPEN-S03-C01-a-5"}},{"k":"text","v":{"s":"Sophie: Mostly."}},{"k":"read","v":{"b":false}}],"id":643},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-01-1"}},{"k":"text","v":{"s":"Sophie: Okay."}},{"k":"read","v":{"b":false}}],"id":644},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-01-2"}},{"k":"text","v":{"s":"Sophie: Let's start over."}},{"k":"read","v":{"b":false}}],"id":645},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-01-3"}},{"k":"text","v":{"s":"Sophie: Properly this time."}},{"k":"read","v":{"b":false}}],"id":646},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-01-4"}},{"k":"text","v":{"s":"Sophie: There's something I should've told you before I added you."}},{"k":"read","v":{"b":false}}],"id":647},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-01-5"}},{"k":"text","v":{"s":"Sophie: Daniel isn't just someone I know."}},{"k":"read","v":{"b":false}}],"id":648},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-01-7"}},{"k":"text","v":{"s":"Sophie: He's my brother."}},{"k":"read","v":{"b":false}}],"id":649},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-01-8"}},{"k":"text","v":{"s":"Sophie: My older brother, actually."}},{"k":"read","v":{"b":false}}],"id":650},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-01-10"}},{"k":"text","v":{"s":"Sophie: Daniel Mercer."}},{"k":"read","v":{"b":false}}],"id":651},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-01-11"}},{"k":"text","v":{"s":"Sophie: I guess I should've mentioned that earlier."}},{"k":"read","v":{"b":false}}],"id":652},{"o":[{"k":"id","v":{"s":"OPEN-S03-C02-a-1"}},{"k":"text","v":{"s":"Sophie: Yeah."}},{"k":"read","v":{"b":false}}],"id":653},{"o":[{"k":"id","v":{"s":"OPEN-S03-C02-a-2"}},{"k":"text","v":{"s":"Sophie: Sorry."}},{"k":"read","v":{"b":false}}],"id":654},{"o":[{"k":"id","v":{"s":"OPEN-S03-C02-a-3"}},{"k":"text","v":{"s":"Sophie: I keep forgetting you don't know anything about us."}},{"k":"read","v":{"b":false}}],"id":655},{"o":[{"k":"id","v":{"s":"OPEN-S03-C02-a-4"}},{"k":"text","v":{"s":"Sophie: I've spent days talking to people who already know him."}},{"k":"read","v":{"b":false}}],"id":656},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-02-2"}},{"k":"text","v":{"s":"Sophie: It's strange."}},{"k":"read","v":{"b":false}}],"id":657},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-02-3"}},{"k":"text","v":{"s":"Sophie: I've spent all day talking about Daniel."}},{"k":"read","v":{"b":false}}],"id":658},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-02-4"}},{"k":"text","v":{"s":"Sophie: Where he might be."}},{"k":"read","v":{"b":false}}],"id":659},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-02-5"}},{"k":"text","v":{"s":"Sophie: Who he last spoke to."}},{"k":"read","v":{"b":false}}],"id":660},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-02-6"}},{"k":"text","v":{"s":"Sophie: Whether anyone remembers something useful."}},{"k":"read","v":{"b":false}}],"id":661},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-02-8"}},{"k":"text","v":{"s":"Sophie: But I haven't really told you what he's like."}},{"k":"read","v":{"b":false}}],"id":662},{"o":[{"k":"id","v":{"s":"OPEN-S03-C03-a-1"}},{"k":"text","v":{"s":"Sophie: That's harder than I expected."}},{"k":"read","v":{"b":false}}],"id":663},{"o":[{"k":"id","v":{"s":"OPEN-S03-C03-a-2"}},{"k":"text","v":{"s":"Sophie: He's a good person."}},{"k":"read","v":{"b":false}}],"id":664},{"o":[{"k":"id","v":{"s":"OPEN-S03-C03-a-3"}},{"k":"text","v":{"s":"Sophie: Which is what everybody says about someone they love."}},{"k":"read","v":{"b":false}}],"id":665},{"o":[{"k":"id","v":{"s":"OPEN-S03-C03-a-4"}},{"k":"text","v":{"s":"Sophie: Not very helpful, is it?"}},{"k":"read","v":{"b":false}}],"id":666},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-03-1"}},{"k":"text","v":{"s":"Sophie: He's patient with things."}},{"k":"read","v":{"b":false}}],"id":667},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-03-2"}},{"k":"text","v":{"s":"Sophie: Not always with people."}},{"k":"read","v":{"b":false}}],"id":668},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-03-3"}},{"k":"text","v":{"s":"Sophie: If something breaks, he'll spend hours trying to fix it."}},{"k":"read","v":{"b":false}}],"id":669},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-03-4"}},{"k":"text","v":{"s":"Sophie: Even if replacing it would take five minutes."}},{"k":"read","v":{"b":false}}],"id":670},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-03-5"}},{"k":"text","v":{"s":"Sophie: And he'll be absolutely convinced he's being clever about it."}},{"k":"read","v":{"b":false}}],"id":671},{"o":[{"k":"id","v":{"s":"OPEN-S03-C04-a-1"}},{"k":"text","v":{"s":"Sophie: Oh, incredibly."}},{"k":"read","v":{"b":false}}],"id":672},{"o":[{"k":"id","v":{"s":"OPEN-S03-C04-a-2"}},{"k":"text","v":{"s":"Sophie: Don't ever tell him that."}},{"k":"read","v":{"b":false}}],"id":673},{"o":[{"k":"id","v":{"s":"OPEN-S03-C04-a-3"}},{"k":"text","v":{"s":"Sophie: He'll spend the next twenty minutes explaining why he's not stubborn."}},{"k":"read","v":{"b":false}}],"id":674},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-04-1"}},{"k":"text","v":{"s":"Sophie: And he has this habit."}},{"k":"read","v":{"b":false}}],"id":675},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-04-2"}},{"k":"text","v":{"s":"Sophie: Whenever something gets complicated, he'll say..."}},{"k":"read","v":{"b":false}}],"id":676},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-04-3"}},{"k":"text","v":{"s":"Sophie: \"I'll explain later.\""}},{"k":"read","v":{"b":false}}],"id":677},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-04-5"}},{"k":"text","v":{"s":"Sophie: I hate that sentence."}},{"k":"read","v":{"b":false}}],"id":678},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-04-6"}},{"k":"text","v":{"s":"Sophie: Because he normally does explain later."}},{"k":"read","v":{"b":false}}],"id":679},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-04-7"}},{"k":"text","v":{"s":"Sophie: You just have to wait until he's ready."}},{"k":"read","v":{"b":false}}],"id":680},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-04-9"}},{"k":"text","v":{"s":"Sophie: This time..."}},{"k":"read","v":{"b":false}}],"id":681},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-04-13"}},{"k":"text","v":{"s":"Sophie: Never mind."}},{"k":"read","v":{"b":false}}],"id":682},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-04-14"}},{"k":"text","v":{"s":"Sophie: You know what I remembered earlier?"}},{"k":"read","v":{"b":false}}],"id":683},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-04-15"}},{"k":"text","v":{"s":"Sophie: My birthday."}},{"k":"read","v":{"b":false}}],"id":684},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-04-16"}},{"k":"text","v":{"s":"Sophie: Not this year."}},{"k":"read","v":{"b":false}}],"id":685},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-04-17"}},{"k":"text","v":{"s":"Sophie: A while ago."}},{"k":"read","v":{"b":false}}],"id":686},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-04-18"}},{"k":"text","v":{"s":"Sophie: Daniel told me he couldn't make it."}},{"k":"read","v":{"b":false}}],"id":687},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-04-19"}},{"k":"text","v":{"s":"Sophie: Said he was busy."}},{"k":"read","v":{"b":false}}],"id":688},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-04-20"}},{"k":"text","v":{"s":"Sophie: I was so annoyed with him."}},{"k":"read","v":{"b":false}}],"id":689},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-04-21"}},{"k":"text","v":{"s":"Sophie: Didn't speak to him all afternoon."}},{"k":"read","v":{"b":false}}],"id":690},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-04-23"}},{"k":"text","v":{"s":"Sophie: Then he showed up that evening."}},{"k":"read","v":{"b":false}}],"id":691},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-04-24"}},{"k":"text","v":{"s":"Sophie: With a cake."}},{"k":"read","v":{"b":false}}],"id":692},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-04-25"}},{"k":"text","v":{"s":"Sophie: A completely ruined cake."}},{"k":"read","v":{"b":false}}],"id":693},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-04-26"}},{"k":"text","v":{"s":"Sophie: It had slid sideways in the box."}},{"k":"read","v":{"b":false}}],"id":694},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-04-27"}},{"k":"text","v":{"s":"Sophie: Half the writing was stuck to the lid."}},{"k":"read","v":{"b":false}}],"id":695},{"o":[{"k":"id","v":{"s":"OPEN-S03-C05-a-1"}},{"k":"text","v":{"s":"Sophie: That's exactly what he said!"}},{"k":"read","v":{"b":false}}],"id":696},{"o":[{"k":"id","v":{"s":"OPEN-S03-C05-a-2"}},{"k":"text","v":{"s":"Sophie: Word for word."}},{"k":"read","v":{"b":false}}],"id":697},{"o":[{"k":"id","v":{"s":"OPEN-S03-C05-a-3"}},{"k":"text","v":{"s":"Sophie: Very convenient, considering the state of that cake."}},{"k":"read","v":{"b":false}}],"id":698},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-05-2"}},{"k":"text","v":{"s":"Sophie: Sorry."}},{"k":"read","v":{"b":false}}],"id":699},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-05-3"}},{"k":"text","v":{"s":"Sophie: I'm rambling."}},{"k":"read","v":{"b":false}}],"id":700},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-05-4"}},{"k":"text","v":{"s":"Sophie: You asked about Daniel and now I'm telling you about a cake."}},{"k":"read","v":{"b":false}}],"id":701},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-05-6"}},{"k":"text","v":{"s":"Sophie: But that's the kind of thing I think about when I think of him."}},{"k":"read","v":{"b":false}}],"id":702},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-05-7"}},{"k":"text","v":{"s":"Sophie: Not the arguments."}},{"k":"read","v":{"b":false}}],"id":703},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-05-8"}},{"k":"text","v":{"s":"Sophie: Not whatever is happening right now."}},{"k":"read","v":{"b":false}}],"id":704},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-05-9"}},{"k":"text","v":{"s":"Sophie: That's why I know something isn't right."}},{"k":"read","v":{"b":false}}],"id":705},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-05-10"}},{"k":"text","v":{"s":"Sophie: He might forget an appointment."}},{"k":"read","v":{"b":false}}],"id":706},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-05-11"}},{"k":"text","v":{"s":"Sophie: He might ignore a call because he's busy."}},{"k":"read","v":{"b":false}}],"id":707},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-05-12"}},{"k":"text","v":{"s":"Sophie: But if he knows people are worried..."}},{"k":"read","v":{"b":false}}],"id":708},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-05-13"}},{"k":"text","v":{"s":"Sophie: He doesn't usually leave them like that."}},{"k":"read","v":{"b":false}}],"id":709},{"o":[{"k":"id","v":{"s":"OPEN-S03-C06-a-1"}},{"k":"text","v":{"s":"Sophie: A few days without a proper answer."}},{"k":"read","v":{"b":false}}],"id":710},{"o":[{"k":"id","v":{"s":"OPEN-S03-C06-a-2"}},{"k":"text","v":{"s":"Sophie: It feels longer."}},{"k":"read","v":{"b":false}}],"id":711},{"o":[{"k":"id","v":{"s":"OPEN-S03-C06-a-3"}},{"k":"text","v":{"s":"Sophie: I keep counting the hours."}},{"k":"read","v":{"b":false}}],"id":712},{"o":[{"k":"id","v":{"s":"OPEN-S03-C06-a-4"}},{"k":"text","v":{"s":"Sophie: Which doesn't help at all."}},{"k":"read","v":{"b":false}}],"id":713},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-06-1"}},{"k":"text","v":{"s":"Sophie: And before you ask..."}},{"k":"read","v":{"b":false}}],"id":714},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-06-2"}},{"k":"text","v":{"s":"Sophie: No, we haven't figured out exactly what happened."}},{"k":"read","v":{"b":false}}],"id":715},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-06-3"}},{"k":"text","v":{"s":"Sophie: We don't even agree on parts of the timeline."}},{"k":"read","v":{"b":false}}],"id":716},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-06-4"}},{"k":"text","v":{"s":"Sophie: That's why things got so tense in the group."}},{"k":"read","v":{"b":false}}],"id":717},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-06-5"}},{"k":"text","v":{"s":"Sophie: Can I tell you something?"}},{"k":"read","v":{"b":false}}],"id":718},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-06-6"}},{"k":"text","v":{"s":"Sophie: I keep opening my last conversation with him."}},{"k":"read","v":{"b":false}}],"id":719},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-06-7"}},{"k":"text","v":{"s":"Sophie: I know it isn't going to change."}},{"k":"read","v":{"b":false}}],"id":720},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-06-8"}},{"k":"text","v":{"s":"Sophie: But I keep looking anyway."}},{"k":"read","v":{"b":false}}],"id":721},{"o":[{"k":"id","v":{"s":"OPEN-S03-C07-a-1"}},{"k":"text","v":{"s":"Sophie: Nothing dramatic."}},{"k":"read","v":{"b":false}}],"id":722},{"o":[{"k":"id","v":{"s":"OPEN-S03-C07-a-2"}},{"k":"text","v":{"s":"Sophie: That's the frustrating part."}},{"k":"read","v":{"b":false}}],"id":723},{"o":[{"k":"id","v":{"s":"OPEN-S03-C07-a-3"}},{"k":"text","v":{"s":"Sophie: Just normal things."}},{"k":"read","v":{"b":false}}],"id":724},{"o":[{"k":"id","v":{"s":"OPEN-S03-C07-a-4"}},{"k":"text","v":{"s":"Sophie: Like we were going to talk again the next day."}},{"k":"read","v":{"b":false}}],"id":725},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-07-1"}},{"k":"text","v":{"s":"Sophie: Anyway."}},{"k":"read","v":{"b":false}}],"id":726},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-07-2"}},{"k":"text","v":{"s":"Sophie: I don't want you thinking I already know what happened."}},{"k":"read","v":{"b":false}}],"id":727},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-07-3"}},{"k":"text","v":{"s":"Sophie: I don't."}},{"k":"read","v":{"b":false}}],"id":728},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-07-4"}},{"k":"text","v":{"s":"Sophie: I just know this silence doesn't feel like him."}},{"k":"read","v":{"b":false}}],"id":729},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-07-6"}},{"k":"text","v":{"s":"Sophie: Wow."}},{"k":"read","v":{"b":false}}],"id":730},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-07-7"}},{"k":"text","v":{"s":"Sophie: This conversation got depressing fast."}},{"k":"read","v":{"b":false}}],"id":731},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-07-8"}},{"k":"text","v":{"s":"Sophie: Sorry 😅"}},{"k":"read","v":{"b":false}}],"id":732},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-07-9"}},{"k":"text","v":{"s":"Sophie: I should probably tell you a little about the others."}},{"k":"read","v":{"b":false}}],"id":733},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-07-10"}},{"k":"text","v":{"s":"Sophie: Since you've already met them at their absolute best."}},{"k":"read","v":{"b":false}}],"id":734},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-07-11"}},{"k":"text","v":{"s":"Sophie: That was sarcasm, by the way."}},{"k":"read","v":{"b":false}}],"id":735},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-07-12"}},{"k":"text","v":{"s":"Sophie: In case it wasn't obvious."}},{"k":"read","v":{"b":false}}],"id":736},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-07-14"}},{"k":"text","v":{"s":"Sophie: Maya first."}},{"k":"read","v":{"b":false}}],"id":737},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-07-15"}},{"k":"text","v":{"s":"Sophie: She's been having a really hard time."}},{"k":"read","v":{"b":false}}],"id":738},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-07-16"}},{"k":"text","v":{"s":"Sophie: She barely sleeps."}},{"k":"read","v":{"b":false}}],"id":739},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-07-17"}},{"k":"text","v":{"s":"Sophie: Keeps saying she's fine."}},{"k":"read","v":{"b":false}}],"id":740},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-07-18"}},{"k":"text","v":{"s":"Sophie: Which is usually how I know she's not."}},{"k":"read","v":{"b":false}}],"id":741},{"o":[{"k":"id","v":{"s":"OPEN-S03-C08-a-1"}},{"k":"text","v":{"s":"Sophie: ..."}},{"k":"read","v":{"b":false}}],"id":742},{"o":[{"k":"id","v":{"s":"OPEN-S03-C08-a-2"}},{"k":"text","v":{"s":"Sophie: Because she's Daniel's fiancée."}},{"k":"read","v":{"b":false}}],"id":743},{"o":[{"k":"id","v":{"s":"OPEN-S03-C08-a-4"}},{"k":"text","v":{"s":"Sophie: They were planning a wedding."}},{"k":"read","v":{"b":false}}],"id":744},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-08-1"}},{"k":"text","v":{"s":"Sophie: Maya Chen."}},{"k":"read","v":{"b":false}}],"id":745},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-08-2"}},{"k":"text","v":{"s":"Sophie: That's her full name, by the way."}},{"k":"read","v":{"b":false}}],"id":746},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-08-3"}},{"k":"text","v":{"s":"Sophie: She's usually the organized one."}},{"k":"read","v":{"b":false}}],"id":747},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-08-4"}},{"k":"text","v":{"s":"Sophie: Lists."}},{"k":"read","v":{"b":false}}],"id":748},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-08-5"}},{"k":"text","v":{"s":"Sophie: Plans."}},{"k":"read","v":{"b":false}}],"id":749},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-08-6"}},{"k":"text","v":{"s":"Sophie: Reminders."}},{"k":"read","v":{"b":false}}],"id":750},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-08-7"}},{"k":"text","v":{"s":"Sophie: Sometimes I think she has a spreadsheet for everything."}},{"k":"read","v":{"b":false}}],"id":751},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-08-8"}},{"k":"text","v":{"s":"Sophie: Which is probably why Daniel needed her."}},{"k":"read","v":{"b":false}}],"id":752},{"o":[{"k":"id","v":{"s":"OPEN-S03-C09-a-2"}},{"k":"text","v":{"s":"Sophie: As far as I knew, yes."}},{"k":"read","v":{"b":false}}],"id":753},{"o":[{"k":"id","v":{"s":"OPEN-S03-C09-a-3"}},{"k":"text","v":{"s":"Sophie: Every couple has disagreements."}},{"k":"read","v":{"b":false}}],"id":754},{"o":[{"k":"id","v":{"s":"OPEN-S03-C09-a-4"}},{"k":"text","v":{"s":"Sophie: But they were making plans for the future."}},{"k":"read","v":{"b":false}}],"id":755},{"o":[{"k":"id","v":{"s":"OPEN-S03-C09-a-5"}},{"k":"text","v":{"s":"Sophie: Real plans."}},{"k":"read","v":{"b":false}}],"id":756},{"o":[{"k":"id","v":{"s":"OPEN-S03-C09-a-6"}},{"k":"text","v":{"s":"Sophie: I don't want to pretend I know every detail of their relationship, though."}},{"k":"read","v":{"b":false}}],"id":757},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-09-1"}},{"k":"text","v":{"s":"Sophie: Maya can be sarcastic."}},{"k":"read","v":{"b":false}}],"id":758},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-09-2"}},{"k":"text","v":{"s":"Sophie: Very sarcastic."}},{"k":"read","v":{"b":false}}],"id":759},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-09-3"}},{"k":"text","v":{"s":"Sophie: But she usually means well."}},{"k":"read","v":{"b":false}}],"id":760},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-09-4"}},{"k":"text","v":{"s":"Sophie: She also won't pretend to agree with you just to make you feel better."}},{"k":"read","v":{"b":false}}],"id":761},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-09-5"}},{"k":"text","v":{"s":"Sophie: Trust me."}},{"k":"read","v":{"b":false}}],"id":762},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-09-6"}},{"k":"text","v":{"s":"Sophie: I've been on the receiving end of that plenty of times."}},{"k":"read","v":{"b":false}}],"id":763},{"o":[{"k":"id","v":{"s":"OPEN-S03-C10-a-1"}},{"k":"text","v":{"s":"Sophie: I noticed."}},{"k":"read","v":{"b":false}}],"id":764},{"o":[{"k":"id","v":{"s":"OPEN-S03-C10-a-2"}},{"k":"text","v":{"s":"Sophie: I didn't see what it said."}},{"k":"read","v":{"b":false}}],"id":765},{"o":[{"k":"id","v":{"s":"OPEN-S03-C10-a-3"}},{"k":"text","v":{"s":"Sophie: I don't know if it was important."}},{"k":"read","v":{"b":false}}],"id":766},{"o":[{"k":"id","v":{"s":"OPEN-S03-C10-a-4"}},{"k":"text","v":{"s":"Sophie: We can ask her later."}},{"k":"read","v":{"b":false}}],"id":767},{"o":[{"k":"id","v":{"s":"OPEN-S03-C10-a-5"}},{"k":"text","v":{"s":"Sophie: I just don't want to turn every little thing into an accusation."}},{"k":"read","v":{"b":false}}],"id":768},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-10-1"}},{"k":"text","v":{"s":"Sophie: Just..."}},{"k":"read","v":{"b":false}}],"id":769},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-10-2"}},{"k":"text","v":{"s":"Sophie: Be patient with her, okay?"}},{"k":"read","v":{"b":false}}],"id":770},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-10-3"}},{"k":"text","v":{"s":"Sophie: She's dealing with more than she lets on."}},{"k":"read","v":{"b":false}}],"id":771},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-10-4"}},{"k":"text","v":{"s":"Sophie: And then there's Lucas."}},{"k":"read","v":{"b":false}}],"id":772},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-10-6"}},{"k":"text","v":{"s":"Sophie: Oh boy."}},{"k":"read","v":{"b":false}}],"id":773},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-10-7"}},{"k":"text","v":{"s":"Sophie: Where do I even start?"}},{"k":"read","v":{"b":false}}],"id":774},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-10-8"}},{"k":"text","v":{"s":"Sophie: He's known Daniel since they were kids."}},{"k":"read","v":{"b":false}}],"id":775},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-10-9"}},{"k":"text","v":{"s":"Sophie: They practically grew up together."}},{"k":"read","v":{"b":false}}],"id":776},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-10-10"}},{"k":"text","v":{"s":"Sophie: Which means he's had years to perfect the art of being impossible."}},{"k":"read","v":{"b":false}}],"id":777},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-10-11"}},{"k":"text","v":{"s":"Sophie: 😅"}},{"k":"read","v":{"b":false}}],"id":778},{"o":[{"k":"id","v":{"s":"OPEN-S03-C11-a-1"}},{"k":"text","v":{"s":"Sophie: Yeah."}},{"k":"read","v":{"b":false}}],"id":779},{"o":[{"k":"id","v":{"s":"OPEN-S03-C11-a-2"}},{"k":"text","v":{"s":"Sophie: That's a good word for him."}},{"k":"read","v":{"b":false}}],"id":780},{"o":[{"k":"id","v":{"s":"OPEN-S03-C11-a-3"}},{"k":"text","v":{"s":"Sophie: He doesn't always show it in the nicest way."}},{"k":"read","v":{"b":false}}],"id":781},{"o":[{"k":"id","v":{"s":"OPEN-S03-C11-a-4"}},{"k":"text","v":{"s":"Sophie: But he cares."}},{"k":"read","v":{"b":false}}],"id":782},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-11-1"}},{"k":"text","v":{"s":"Sophie: He and Daniel used to argue about the stupidest things."}},{"k":"read","v":{"b":false}}],"id":783},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-11-2"}},{"k":"text","v":{"s":"Sophie: Music."}},{"k":"read","v":{"b":false}}],"id":784},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-11-3"}},{"k":"text","v":{"s":"Sophie: Football."}},{"k":"read","v":{"b":false}}],"id":785},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-11-4"}},{"k":"text","v":{"s":"Sophie: Who was right about something neither of them actually understood."}},{"k":"read","v":{"b":false}}],"id":786},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-11-5"}},{"k":"text","v":{"s":"Sophie: And then five minutes later they'd be laughing again."}},{"k":"read","v":{"b":false}}],"id":787},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-11-6"}},{"k":"text","v":{"s":"Sophie: That's just how they were."}},{"k":"read","v":{"b":false}}],"id":788},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-11-8"}},{"k":"text","v":{"s":"Sophie: I think he's having a hard time accepting that he can't just call Daniel and argue with him about this."}},{"k":"read","v":{"b":false}}],"id":789},{"o":[{"k":"id","v":{"s":"OPEN-S03-C12-a-1"}},{"k":"text","v":{"s":"Sophie: I hope so."}},{"k":"read","v":{"b":false}}],"id":790},{"o":[{"k":"id","v":{"s":"OPEN-S03-C12-a-2"}},{"k":"text","v":{"s":"Sophie: He's angry, not heartless."}},{"k":"read","v":{"b":false}}],"id":791},{"o":[{"k":"id","v":{"s":"OPEN-S03-C12-a-3"}},{"k":"text","v":{"s":"Sophie: I don't think he wants to walk away from Daniel."}},{"k":"read","v":{"b":false}}],"id":792},{"o":[{"k":"id","v":{"s":"OPEN-S03-C12-a-4"}},{"k":"text","v":{"s":"Sophie: He just doesn't want to do things this way."}},{"k":"read","v":{"b":false}}],"id":793},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-12-1"}},{"k":"text","v":{"s":"Sophie: Whatever you think of Lucas..."}},{"k":"read","v":{"b":false}}],"id":794},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-12-2"}},{"k":"text","v":{"s":"Sophie: Please don't assume he's your enemy."}},{"k":"read","v":{"b":false}}],"id":795},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-12-3"}},{"k":"text","v":{"s":"Sophie: I don't think he is."}},{"k":"read","v":{"b":false}}],"id":796},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-12-5"}},{"k":"text","v":{"s":"Sophie: Oh!"}},{"k":"read","v":{"b":false}}],"id":797},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-12-6"}},{"k":"text","v":{"s":"Sophie: And there's Eli."}},{"k":"read","v":{"b":false}}],"id":798},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-12-7"}},{"k":"text","v":{"s":"Sophie: I almost forgot you haven't actually spoken to her."}},{"k":"read","v":{"b":false}}],"id":799},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-12-8"}},{"k":"text","v":{"s":"Sophie: She's much quieter in group chats."}},{"k":"read","v":{"b":false}}],"id":800},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-12-9"}},{"k":"text","v":{"s":"Sophie: Sometimes I wonder whether she even reads half the messages."}},{"k":"read","v":{"b":false}}],"id":801},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-12-10"}},{"k":"text","v":{"s":"Sophie: Then she'll reply to something from six hours ago."}},{"k":"read","v":{"b":false}}],"id":802},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-12-11"}},{"k":"text","v":{"s":"Sophie: Like the conversation never moved on."}},{"k":"read","v":{"b":false}}],"id":803},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-12-12"}},{"k":"text","v":{"s":"Sophie: 😅"}},{"k":"read","v":{"b":false}}],"id":804},{"o":[{"k":"id","v":{"s":"OPEN-S03-C13-a-1"}},{"k":"text","v":{"s":"Sophie: Eli Ward."}},{"k":"read","v":{"b":false}}],"id":805},{"o":[{"k":"id","v":{"s":"OPEN-S03-C13-a-2"}},{"k":"text","v":{"s":"Sophie: She works with Daniel."}},{"k":"read","v":{"b":false}}],"id":806},{"o":[{"k":"id","v":{"s":"OPEN-S03-C13-a-3"}},{"k":"text","v":{"s":"Sophie: At Axiom Recovery."}},{"k":"read","v":{"b":false}}],"id":807},{"o":[{"k":"id","v":{"s":"OPEN-S03-C13-a-4"}},{"k":"text","v":{"s":"Sophie: She's not exactly the loudest person in the room."}},{"k":"read","v":{"b":false}}],"id":808},{"o":[{"k":"id","v":{"s":"OPEN-S03-C13-a-5"}},{"k":"text","v":{"s":"Sophie: But she's pretty smart."}},{"k":"read","v":{"b":false}}],"id":809},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-13-1"}},{"k":"text","v":{"s":"Sophie: Eli's usually better with technical things than the rest of us."}},{"k":"read","v":{"b":false}}],"id":810},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-13-2"}},{"k":"text","v":{"s":"Sophie: Which isn't saying much in my case."}},{"k":"read","v":{"b":false}}],"id":811},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-13-3"}},{"k":"text","v":{"s":"Sophie: I once managed to delete an entire folder while trying to rename it."}},{"k":"read","v":{"b":false}}],"id":812},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-13-4"}},{"k":"text","v":{"s":"Sophie: Don't ask."}},{"k":"read","v":{"b":false}}],"id":813},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-13-6"}},{"k":"text","v":{"s":"Sophie: Anyway."}},{"k":"read","v":{"b":false}}],"id":814},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-13-7"}},{"k":"text","v":{"s":"Sophie: She's not some magician who can just pull answers out of nowhere."}},{"k":"read","v":{"b":false}}],"id":815},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-13-8"}},{"k":"text","v":{"s":"Sophie: But she might be able to help us understand some things later."}},{"k":"read","v":{"b":false}}],"id":816},{"o":[{"k":"id","v":{"s":"OPEN-S03-C14-a-1"}},{"k":"text","v":{"s":"Sophie: It's where Daniel works."}},{"k":"read","v":{"b":false}}],"id":817},{"o":[{"k":"id","v":{"s":"OPEN-S03-C14-a-2"}},{"k":"text","v":{"s":"Sophie: They deal with data and recovery-related work."}},{"k":"read","v":{"b":false}}],"id":818},{"o":[{"k":"id","v":{"s":"OPEN-S03-C14-a-3"}},{"k":"text","v":{"s":"Sophie: That's about the extent of my technical understanding."}},{"k":"read","v":{"b":false}}],"id":819},{"o":[{"k":"id","v":{"s":"OPEN-S03-C14-a-4"}},{"k":"text","v":{"s":"Sophie: Eli would explain it better than I could."}},{"k":"read","v":{"b":false}}],"id":820},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-14-1"}},{"k":"text","v":{"s":"Sophie: So yeah."}},{"k":"read","v":{"b":false}}],"id":821},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-14-2"}},{"k":"text","v":{"s":"Sophie: That's Eli."}},{"k":"read","v":{"b":false}}],"id":822},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-14-3"}},{"k":"text","v":{"s":"Sophie: She's easier to talk to when she isn't trying to explain something complicated."}},{"k":"read","v":{"b":false}}],"id":823},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-14-4"}},{"k":"text","v":{"s":"Sophie: Which, now that I think about it, might not be very often."}},{"k":"read","v":{"b":false}}],"id":824},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-14-5"}},{"k":"text","v":{"s":"Sophie: 😅"}},{"k":"read","v":{"b":false}}],"id":825},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-14-6"}},{"k":"text","v":{"s":"Sophie: So..."}},{"k":"read","v":{"b":false}}],"id":826},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-14-7"}},{"k":"text","v":{"s":"Sophie: That's Maya, Lucas and Eli."}},{"k":"read","v":{"b":false}}],"id":827},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-14-8"}},{"k":"text","v":{"s":"Sophie: In the world's least useful introduction."}},{"k":"read","v":{"b":false}}],"id":828},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-14-9"}},{"k":"text","v":{"s":"Sophie: They're all different."}},{"k":"read","v":{"b":false}}],"id":829},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-14-10"}},{"k":"text","v":{"s":"Sophie: Very different."}},{"k":"read","v":{"b":false}}],"id":830},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-14-11"}},{"k":"text","v":{"s":"Sophie: But they all care about Daniel."}},{"k":"read","v":{"b":false}}],"id":831},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-14-12"}},{"k":"text","v":{"s":"Sophie: In their own ways."}},{"k":"read","v":{"b":false}}],"id":832},{"o":[{"k":"id","v":{"s":"OPEN-S03-C15-a-1"}},{"k":"text","v":{"s":"Sophie: Me too."}},{"k":"read","v":{"b":false}}],"id":833},{"o":[{"k":"id","v":{"s":"OPEN-S03-C15-a-2"}},{"k":"text","v":{"s":"Sophie: She's trying so hard to stay strong."}},{"k":"read","v":{"b":false}}],"id":834},{"o":[{"k":"id","v":{"s":"OPEN-S03-C15-a-3"}},{"k":"text","v":{"s":"Sophie: I wish she didn't feel like she had to."}},{"k":"read","v":{"b":false}}],"id":835},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-15-1"}},{"k":"text","v":{"s":"Sophie: Including me, by the way."}},{"k":"read","v":{"b":false}}],"id":836},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-15-3"}},{"k":"text","v":{"s":"Sophie: I know I've told you a lot."}},{"k":"read","v":{"b":false}}],"id":837},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-15-4"}},{"k":"text","v":{"s":"Sophie: But it's still just my side of things."}},{"k":"read","v":{"b":false}}],"id":838},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-15-5"}},{"k":"text","v":{"s":"Sophie: You should remember that."}},{"k":"read","v":{"b":false}}],"id":839},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-15-6"}},{"k":"text","v":{"s":"Sophie: There's still something I can't stop thinking about."}},{"k":"read","v":{"b":false}}],"id":840},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-15-7"}},{"k":"text","v":{"s":"Sophie: Your number."}},{"k":"read","v":{"b":false}}],"id":841},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-15-8"}},{"k":"text","v":{"s":"Sophie: I know."}},{"k":"read","v":{"b":false}}],"id":842},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-15-9"}},{"k":"text","v":{"s":"Sophie: We keep coming back to it."}},{"k":"read","v":{"b":false}}],"id":843},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-15-10"}},{"k":"text","v":{"s":"Sophie: But it doesn't make sense."}},{"k":"read","v":{"b":false}}],"id":844},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-15-11"}},{"k":"text","v":{"s":"Sophie: I've checked that saved contact export more than once."}},{"k":"read","v":{"b":false}}],"id":845},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-15-12"}},{"k":"text","v":{"s":"Sophie: And there it was."}},{"k":"read","v":{"b":false}}],"id":846},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-15-13"}},{"k":"text","v":{"s":"Sophie: No name."}},{"k":"read","v":{"b":false}}],"id":847},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-15-14"}},{"k":"text","v":{"s":"Sophie: Just your number, with the star still beside it."}},{"k":"read","v":{"b":false}}],"id":848},{"o":[{"k":"id","v":{"s":"OPEN-S03-C16-a-1"}},{"k":"text","v":{"s":"Sophie: Maybe."}},{"k":"read","v":{"b":false}}],"id":849},{"o":[{"k":"id","v":{"s":"OPEN-S03-C16-a-2"}},{"k":"text","v":{"s":"Sophie: I really hope there's a simple explanation."}},{"k":"read","v":{"b":false}}],"id":850},{"o":[{"k":"id","v":{"s":"OPEN-S03-C16-a-3"}},{"k":"text","v":{"s":"Sophie: It would be nice if something about this turned out to be simple."}},{"k":"read","v":{"b":false}}],"id":851},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-16-1"}},{"k":"text","v":{"s":"Sophie: I wish I could give you something more useful."}},{"k":"read","v":{"b":false}}],"id":852},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-16-2"}},{"k":"text","v":{"s":"Sophie: I really do."}},{"k":"read","v":{"b":false}}],"id":853},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-16-3"}},{"k":"text","v":{"s":"Sophie: But I don't want to make up answers just because I don't like having questions."}},{"k":"read","v":{"b":false}}],"id":854},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-16-5"}},{"k":"text","v":{"s":"Sophie: There's something else I should say."}},{"k":"read","v":{"b":false}}],"id":855},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-16-6"}},{"k":"text","v":{"s":"Sophie: I know you've ended up in a really strange situation."}},{"k":"read","v":{"b":false}}],"id":856},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-16-7"}},{"k":"text","v":{"s":"Sophie: And it's mostly because of me."}},{"k":"read","v":{"b":false}}],"id":857},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-16-8"}},{"k":"text","v":{"s":"Sophie: You didn't ask to get involved."}},{"k":"read","v":{"b":false}}],"id":858},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-16-9"}},{"k":"text","v":{"s":"Sophie: I know that."}},{"k":"read","v":{"b":false}}],"id":859},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-16-11"}},{"k":"text","v":{"s":"Sophie: I don't actually expect you to find Daniel."}},{"k":"read","v":{"b":false}}],"id":860},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-16-12"}},{"k":"text","v":{"s":"Sophie: That's not fair to put on you."}},{"k":"read","v":{"b":false}}],"id":861},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-16-13"}},{"k":"text","v":{"s":"Sophie: I just thought..."}},{"k":"read","v":{"b":false}}],"id":862},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-16-14"}},{"k":"text","v":{"s":"Sophie: Maybe there's something we're missing."}},{"k":"read","v":{"b":false}}],"id":863},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-16-15"}},{"k":"text","v":{"s":"Sophie: Something someone outside all of this might notice."}},{"k":"read","v":{"b":false}}],"id":864},{"o":[{"k":"id","v":{"s":"OPEN-S03-C17-a-1"}},{"k":"text","v":{"s":"Sophie: Really?"}},{"k":"read","v":{"b":false}}],"id":865},{"o":[{"k":"id","v":{"s":"OPEN-S03-C17-a-2"}},{"k":"text","v":{"s":"Sophie: Thank you."}},{"k":"read","v":{"b":false}}],"id":866},{"o":[{"k":"id","v":{"s":"OPEN-S03-C17-a-3"}},{"k":"text","v":{"s":"Sophie: I mean it."}},{"k":"read","v":{"b":false}}],"id":867},{"o":[{"k":"id","v":{"s":"OPEN-S03-C17-a-4"}},{"k":"text","v":{"s":"Sophie: Even just talking things through might help."}},{"k":"read","v":{"b":false}}],"id":868},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-17-1"}},{"k":"text","v":{"s":"Sophie: Just promise me one thing."}},{"k":"read","v":{"b":false}}],"id":869},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-17-3"}},{"k":"text","v":{"s":"Sophie: If something feels wrong, don't ignore it."}},{"k":"read","v":{"b":false}}],"id":870},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-17-4"}},{"k":"text","v":{"s":"Sophie: And don't put yourself in danger over any of this."}},{"k":"read","v":{"b":false}}],"id":871},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-17-5"}},{"k":"text","v":{"s":"Sophie: I don't want someone else getting hurt."}},{"k":"read","v":{"b":false}}],"id":872},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-17-7"}},{"k":"text","v":{"s":"Sophie: Wow."}},{"k":"read","v":{"b":false}}],"id":873},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-17-8"}},{"k":"text","v":{"s":"Sophie: I've been talking for ages."}},{"k":"read","v":{"b":false}}],"id":874},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-17-9"}},{"k":"text","v":{"s":"Sophie: Sorry."}},{"k":"read","v":{"b":false}}],"id":875},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-17-10"}},{"k":"text","v":{"s":"Sophie: You probably didn't expect to get my entire life story in one conversation."}},{"k":"read","v":{"b":false}}],"id":876},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-17-11"}},{"k":"text","v":{"s":"Sophie: Although, to be fair, you only got the very confusing version."}},{"k":"read","v":{"b":false}}],"id":877},{"o":[{"k":"id","v":{"s":"OPEN-S03-C18-a-1"}},{"k":"text","v":{"s":"Sophie: Good."}},{"k":"read","v":{"b":false}}],"id":878},{"o":[{"k":"id","v":{"s":"OPEN-S03-C18-a-2"}},{"k":"text","v":{"s":"Sophie: Because apparently I have no idea when to stop talking."}},{"k":"read","v":{"b":false}}],"id":879},{"o":[{"k":"id","v":{"s":"OPEN-S03-C18-a-3"}},{"k":"text","v":{"s":"Sophie: Maya reminds me of that constantly."}},{"k":"read","v":{"b":false}}],"id":880},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-18-1"}},{"k":"text","v":{"s":"Sophie: I think I'm going to put my phone down for a little while."}},{"k":"read","v":{"b":false}}],"id":881},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-18-2"}},{"k":"text","v":{"s":"Sophie: Maybe make some tea."}},{"k":"read","v":{"b":false}}],"id":882},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-18-3"}},{"k":"text","v":{"s":"Sophie: Or at least try to take a break."}},{"k":"read","v":{"b":false}}],"id":883},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-18-4"}},{"k":"text","v":{"s":"Sophie: Maya would be proud."}},{"k":"read","v":{"b":false}}],"id":884},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-18-5"}},{"k":"text","v":{"s":"Sophie: Oh."}},{"k":"read","v":{"b":false}}],"id":885},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-18-6"}},{"k":"text","v":{"s":"Sophie: One more thing."}},{"k":"read","v":{"b":false}}],"id":886},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-18-7"}},{"k":"text","v":{"s":"Sophie: If anyone in the group gives you a hard time again..."}},{"k":"read","v":{"b":false}}],"id":887},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-18-8"}},{"k":"text","v":{"s":"Sophie: Just tell me, okay?"}},{"k":"read","v":{"b":false}}],"id":888},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-18-9"}},{"k"