adient(150deg,#203649,#142536);border-radius:18px;padding:19px 12px;margin-bottom:19px}.mirror-hero svg{margin:0 auto 7px;color:#9ecfdf}.mirror-hero strong,.mirror-hero small{display:block}.mirror-hero strong{font-size:20px}.mirror-hero small{font-size:11px;margin-top:6px;color:#99b6c8}.mirror-hero p{font-size:11px;color:#abc0ce;line-height:1.5;margin:12px auto 0;max-width:300px}.mirror-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px 9px}.mirror-icon{border:0;background:none;color:#ddebf5;min-width:0;display:flex;flex-direction:column;align-items:center;gap:4px}.mirror-icon>span{width:57px;height:57px;border:1px solid #365269;background:#203a4e;border-radius:17px;display:grid;place-items:center;color:#b3d9e6}.mirror-icon strong{font-size:11px}.mirror-icon small{color:#8faabc;font-size:9px;line-height:1.2}.mirror-caption,.mirror-guidance{display:flex;align-items:flex-start;gap:8px;font-size:11px;line-height:1.55;color:#9cb8c5;background:#183042;border-radius:11px;padding:11px;margin-top:15px}.mirror-caption svg,.mirror-guidance svg{flex:none}.mirror-guidance{color:#b8e6d4;border:1px solid #326859}.mirror-back{display:flex;align-items:center;gap:8px;border:0;background:none;color:#99c5d5;padding:4px 0 17px}.mirror-detail h2{font-size:25px;margin:0 0 7px}.mirror-detail>small{color:#91abbd}.mirror-items{margin:20px 0;display:grid;gap:8px}.mirror-file{display:flex;align-items:center;gap:10px;color:#d8e8f1;background:#17293a;padding:12px;border-radius:12px;text-align:left;border:1px solid #344a5f;font-size:12px}.mirror-file span{flex:1}.mirror-file.is-active{border-color:#7aafb9;background:#254454}.mirror-document{border:1px solid #365668;background:#17293a;border-radius:13px;padding:19px}.mirror-document small{font-size:10px;color:#a3cdcf}.mirror-document h3{font-size:15px}.mirror-document p{white-space:pre-wrap;line-height:1.65;font-size:13px;color:#d6e4ec}.mirror-compare{display:flex;align-items:center;justify-content:center;gap:6px;width:100%;border:0;border-radius:12px;background:#3a8082;color:#fff;font-weight:700;padding:14px 10px;margin-top:16px}.mirror-compare:disabled{opacity:.5}.opening-found .opening-stage-scroll>svg{color:#dda67b;margin-top:18px}.opening-found h1{font-size:30px}.opening-found small{color:#b4c8d9;letter-spacing:.13em}.opening-mismatch{display:grid;gap:10px;background:#203243;padding:17px;border-radius:14px;border:1px solid #4d6477}.opening-mismatch span{display:flex;justify-content:space-between}.opening-mismatch strong{font-size:20px}.opening-hook{display:flex;gap:11px;margin-top:23px;background:#223648;border-radius:13px;padding:15px}.opening-hook p{margin:0;flex:1;font-size:13px;line-height:1.5}.opening-hook p span{display:block;margin-top:5px}.opening-found h2{font-size:16px;margin:25px 0 8px}.opening-found ol{font-size:13px;line-height:1.8;color:#c7d9e4;padding-left:20px}\r\n\r\n.opening-lock-message{position:absolute;left:18px;right:18px;bottom:118px;z-index:3;border:1px solid #bed7e888;border-radius:15px;background:#12293cdd;backdrop-filter:blur(12px);padding:13px;text-align:left;color:#fff;display:grid;gap:4px;box-shadow:0 8px 28px #0004}.opening-lock-message span{font-size:10px;color:#b6c9d7;letter-spacing:.09em}.opening-lock-message strong{font-size:14px}.opening-lock-message small{font-size:12px;color:#d1dce4}\r\n\r\n/* Daniel's iPhone mirror and protected apps */\r\n.mirror{background:linear-gradient(145deg,#111b32,#0b101c 62%,#202b49);color:#f5f5f7}.mirror-ios-status{color:#f7f7fa;background:#101623;border-bottom:0;padding:11px 20px;font-weight:700}.mirror-main{padding:15px 16px 28px}.mirror-hero{min-height:142px;display:flex;flex-direction:column;justify-content:center;background:transparent;margin-bottom:14px}.mirror-hero strong{font-weight:650;font-size:31px;letter-spacing:-1.3px}.mirror-hero p{font-size:10px}.mirror-grid{grid-template-columns:repeat(4,minmax(0,1fr));gap:16px 5px}.mirror-icon>span{width:56px;height:56px;border:0;background:linear-gradient(160deg,#4094ed,#1a64b8);border-radius:15px;box-shadow:0 4px 10px #0004;color:#fff}.mirror-icon:nth-child(2n)>span{background:linear-gradient(150deg,#767d8a,#3e4757)}.mirror-icon:nth-child(3n)>span{background:linear-gradient(140deg,#64bd8c,#218551)}.mirror-icon:nth-child(5n)>span{background:linear-gradient(140deg,#e3bb65,#ad7531)}.mirror-icon strong{font-size:10px}.mirror-icon small{font-size:8px}.mirror-detail{background:#080809}.mirror-detail h2{font-size:32px;letter-spacing:-.04em}.mirror-file{background:#1c1c1e;border:0;border-radius:11px;min-height:51px}.mirror-file.is-active{background:#2c2c2e;border:1px solid #0a84ff}.mirror-document{background:#1c1c1e;border:0;border-radius:14px}.mirror-lock-panel{display:flex;align-items:stretch;flex-direction:column;gap:12px;text-align:center;padding:16px 2px}.mirror-lock-panel>svg{align-self:center;color:#a6a6ad}.mirror-lock-panel strong{font-size:16px}.mirror-lock-panel p{color:#aaa;font-size:12px}.mirror-lock-panel label{text-align:left;font-size:11px;color:#babac0}.mirror-lock-panel input{height:44px;padding:12px;color:white;background:#323237;border:1px solid #5d5d65;border-radius:11px}.mirror-lock-panel button{display:flex;justify-content:center;align-items:center;gap:8px;border:0;color:#fff;background:#0a84ff;border-radius:12px;padding:13px}.mirror-success{display:flex;align-items:center;gap:7px;color:#45d28c!important}.opening-bubble.player{background:#0a84ff}.opening-bubble.sophie{background:#303033}.opening-chat-header{background:#1c1c1ecc;backdrop-filter:blur(12px)}.opening-actions{background:#151517}.opening-choice.selected{border-color:#0a84ff;background:#203b60}.opening-primary{background:#0a84ff}\r\n\r\n/* Episode 01: item-level iOS-style locks and clue-driven optional puzzles */\r\n.mirror-folder-count{color:#aaaab1;font-size:12px;margin:12px 0 4px}\r\n.mirror-photo-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:7px;margin:16px 0 5px}\r\n.mirror-photo-tile{display:flex;flex-direction:column;align-items:center;gap:5px;background:none;color:#dfe2ec;border:0;padding:3px;border-radius:10px;min-width:0}\r\n.mirror-photo-tile.selected{outline:2px solid #0a84ff}\r\n.mirror-photo-art{width:100%;aspect-ratio:1;display:grid;place-items:center;background:linear-gradient(145deg,#455674,#1e2b43 55%,#4c5668);border-radius:7px;color:#d5e3ef}\r\n.mirror-photo-tile:nth-child(2n) .mirror-photo-art{background:linear-gradient(145deg,#756749,#3b4448,#293851)}\r\n.mirror-photo-tile small{font-size:10px;white-space:nowrap;color:#b6c2d0}\r\n.mirror-media-preview{border-radius:12px;background:linear-gradient(130deg,#364760,#29354e 65%,#68583e);height:142px;display:flex;flex-direction:column;gap:7px;align-items:center;justify-content:center;color:#dceaf7;padding:15px;text-align:center;font-size:12px}\r\n.mirror-media-preview small{color:#bac2ca;font-size:10px}\r\n.mirror-source-note{font-size:11px!important;color:#a6adba!important;display:flex;align-items:center;gap:6px}\r\n.mirror-hint-toggle{background:#2b2c33!important;color:#a4cffe!important;border:1px solid #49505c!important}\r\n.mirror-hints{text-align:left;margin:0;padding:12px 12px 12px 29px;background:#252834;border-radius:12px;color:#e1e6f0;font-size:12px;line-height:1.7}\r\n.mirror-lock-panel p[role=alert]{color:#ffa9a0!important}\r\n.opening-next-lead{border:1px solid #3d6b89;background:#1a364d;padding:15px;border-radius:14px;margin-top:18px;color:#d9ecfb}\r\n.opening-next-lead strong{font-size:11px;letter-spacing:.03em}\r\n.opening-next-lead p{font-size:13px;line-height:1.6;margin-bottom:0}\r\n\r\n.mirror-message-history{display:flex;flex-direction:column;gap:9px;margin-top:16px;align-items:stretch}\r\n.mirror-chat-bubble{max-width:83%;padding:10px 13px;border-radius:18px;font-size:14px;line-height:1.45;display:flex;flex-direction:column;gap:4px}\r\n.mirror-chat-bubble small{font-size:10px;opacity:.75}\r\n.mirror-chat-bubble span{white-space:pre-wrap}\r\n.mirror-chat-bubble.incoming{background:#323237;border-bottom-left-radius:4px;align-self:flex-start}\r\n.mirror-chat-bubble.outgoing{background:#0a84ff;border-bottom-right-radius:4px;align-self:flex-end;color:#fff}\r\n.mirror-email-body{background:#26262b;padding:15px;border-radius:13px;margin-top:14px}\r\n.mirror-mail-label{color:#89b8ec;font-weight:600;font-size:10px;letter-spacing:.09em}\r\n.mirror-note-body{border-radius:12px;background:#27282c;padding:15px;margin-top:14px}\r\n\r\n.opening-jump{position:absolute;right:16px;top:85px;z-index:3;background:#0a84ff;color:white;border:0;border-radius:20px;padding:10px 14px}\r\n.opening-actions{max-height:47%;overflow-y:auto;padding-bottom:max(12px,env(safe-area-inset-bottom))}\r\n.opening-screen{min-width:0;position:relative}.opening-choice{overflow-wrap:anywhere;min-height:44px}\r\n@media(prefers-reduced-motion:reduce){.opening-screen *{animation:none!important;transition:none!important;scroll-behavior:auto!important}}\r\n\r\n.opening-note[role=dialog]{position:absolute;inset:0;z-index:10;overflow-y:auto;margin:0;border-radius:0;background:#1c1c1e;padding:20px;color:#eee}\r\n.opening-note[role=dialog] img{display:block;width:100%;height:auto;margin:14px 0}\r\n.opening-note-close{min-height:44px;margin-left:auto!important}\r\n\r\n.opening-screen .opening-note[role=dialog]{max-width:none;width:auto;transform:none;border-radius:0!important;background:#1c1c1e!important;color:#eee!important}\r\n.opening-screen .opening-note[role=dialog]>p{color:#eee!important}\r\n.opening-screen .opening-note[role=dialog] .opening-confirm{color:#83d8aa}\r\n.daniel-note-content{max-width:480px;margin:0 auto 18px}\r\n.opening-note[role=dialog] .daniel-note-content img{max-height:62vh;object-fit:contain;margin:16px auto}\r\n.daniel-note-transcript{border:1px solid #45454d;border-radius:12px;background:#252529;color:#eee;overflow:hidden}\r\n.daniel-note-transcript summary{min-height:44px;padding:12px 14px;cursor:pointer;font:600 14px/1.5 system-ui,sans-serif}\r\n.daniel-note-transcript>div{padding:0 16px 12px;border-top:1px solid #45454d}\r\n.daniel-note-transcript p{font:15px/1.65 system-ui,sans-serif;margin:12px 0;overflow-wrap:anywhere}\r\n.daniel-note-caption{font:12px/1.5 system-ui,sans-serif;color:#b9b9c3;margin:12px 2px}\r\n.daniel-note-transcript summary:focus-visible{outline:2px solid #87c5ff;outline-offset:-3px}\r\n.opening-stage-top .mirror-back{margin:0 0 0 auto;padding:6px;font-size:12px;min-height:44px}\r\n"],["STYLE",{},".opening-v4 .opening-thread{min-height:0;overflow-y:auto;scroll-behavior:smooth}\n.opening-v4-attachment{display:block;width:min(62%,220px);margin:8px 15px 15px auto;padding:0;border:0;border-radius:12px;overflow:hidden;background:#202a36;color:white;text-align:left;box-shadow:0 4px 14px #0003}\n.opening-v4-attachment img{display:block;width:100%;max-height:250px;object-fit:cover;object-position:top}\n.opening-v4-attachment span{display:block;padding:8px 10px;font-size:12px}\n.opening-v4-full-photo{display:block;max-width:100%;max-height:75vh;object-fit:contain;margin:auto}\n.opening-v4-typing{display:flex;align-items:center;gap:8px;margin:10px 15px;font-size:12px;color:#7e8792}\n.opening-v4-name-row{display:flex;gap:8px;align-items:center}\n.opening-v4-name-row input{min-width:0;flex:1;border:1px solid #aeb8c4;border-radius:10px;padding:10px 12px;font:inherit}\n.opening-v4-name-row .opening-primary{width:auto;white-space:nowrap}\n.opening-v4-idle{display:block;text-align:center;padding:8px;color:#7e8792;font-size:13px}\n@media (prefers-reduced-motion:reduce){.opening-v4 .opening-thread{scroll-behavior:auto}.opening-v4 .typing-dots i{animation:none}}\n"],["STYLE",{},".recovery-sequence { min-height: 0; }\n.recovery-sequence .opening-thread { scroll-behavior: auto; }\n.recovery-caption { font-size: 12px; color: var(--muted); }\n.recovery-puzzle { border: 1px solid #536677; border-radius: 16px; padding: 16px; margin: 20px 0; background: #162231; color: #f3f6fa; }\n.recovery-puzzle h1 { font-size: 22px; margin: 0 0 10px; }\n.recovery-puzzle p { font-size: 13px; line-height: 1.6; }\n.recovery-cards { list-style: none; padding: 0; display: grid; gap: 10px; }\n.recovery-cards .opening-choice { width: 100%; display: grid; gap: 8px; text-align: left; margin: 0; min-height: 110px; }\n.recovery-cards small { font-size: 11px; line-height: 1.5; color: var(--muted); }\n.recovery-cards button:disabled { opacity: 1; cursor: default; }\n.recovery-tools { display: grid; gap: 8px; }\n.recovery-puzzle aside { border-left: 3px solid #8bcbd7; padding-left: 12px; }\n"],["STYLE",{},"/* Shared phone behaviour; independent of narrative progression. */\n.device * { scrollbar-width: none; }\n.device *::-webkit-scrollbar { display: none; width: 0; height: 0; }\n.device .opening-chat-header { justify-content: flex-start; gap: 11px; padding: 10px 14px; min-height: 72px; text-align: left; }\n.device .opening-chat-header > div { flex: 1; align-items: flex-start; text-align: left; min-width: 0; }\n.device .opening-chat-header > .icon-button { position: static; flex: 0 0 32px; padding: 4px; min-width: 32px; }\n.device .opening-chat-header strong { font-size: 15px; }\n.device .opening-chat-header small { margin-top: 4px; font-size: 11px; max-width: 100%; }\n.device .native-chat-header { display: flex; flex-direction: row; align-items: center; justify-content: flex-start; gap: 12px; min-height: 72px; padding: 10px 14px; }\n.device .native-chat-header > .native-back-button { position: static; flex: none; }\n.device .native-chat-contact { display: flex; flex-direction: row; gap: 10px; align-items: center; text-align: left; }\n.device .native-chat-contact .chat-title { align-items: flex-start; text-align: left; }\n.chat-contact-avatar { position: relative; display: flex; flex: none; }\n.presence-dot { position: absolute; bottom: 0; right: 0; border: 2px solid var(--header); background: #35af78; width: 11px; height: 11px; border-radius: 50%; }\n.device .thread-row { position: relative; }\n.thread-online { position: absolute; left: 46px; top: 48px; width: 11px; height: 11px; border-radius: 50%; background: #35af78; border: 2px solid var(--surface); }\n.device .conversation-line { display: flex; gap: 8px; align-items: flex-end; flex: none; width: 100%; }\n.device .conversation-line.outgoing { justify-content: flex-end; }\n.device .conversation-line.incoming.chat-group-open { padding-left: 36px; }\n.device .conversation-line.incoming.chat-group-open .conversation-body { max-width: 100%; }\n.device .conversation-line.chat-group-start { margin-top: 5px; }\n.device .conversation-body .opening-bubble { overflow-wrap: anywhere; }\n.device .scene01-chat .chat-group-action { display: inline-flex; align-items: center; justify-content: center; align-self: flex-start; flex: none; width: fit-content; max-width: 100%; min-height: 44px; margin: 12px 0 4px 36px; padding: 10px 14px; border: 1px solid #547e7b; border-radius: 12px; background: #244b4b; color: #f1faf8; font: inherit; font-size: 13px; font-weight: 600; cursor: pointer; }\n.device .scene01-chat .chat-group-action:focus-visible { outline: 2px solid #72bdb4; outline-offset: 3px; }\n.device .message-avatar { flex: 0 0 28px; width: 28px; height: 28px; border-radius: 50%; overflow: hidden; display: grid; place-items: center; background: #506576; color: white; font-size: 12px; }\n.message-avatar img { width: 100%; height: 100%; object-fit: cover; }\n.conversation-body { max-width: calc(100% - 38px); min-width: 0; }\n.outgoing .conversation-body { max-width: 84%; }\n.device .conversation-body .opening-bubble { max-width: 100% !important; margin: 0; border-radius: 15px 15px 15px 5px; padding: 11px 13px; }\n.device .conversation-body .opening-bubble.player { background: #286f70 !important; border-radius: 15px 15px 5px 15px; color: #fff !important; }\n.device .group-sender { display: block; font-size: 11px; font-weight: 650; margin: 0 0 5px 5px; color: var(--muted); }\n.device .opening-v4-typing { display: flex; align-items: center; gap: 8px; margin: 5px 0; min-height: 32px; }\n.device .opening-v4-typing .typing-dots { background: var(--incoming); border-radius: 14px; padding: 11px 15px; }\n.presence-event { align-self: center; margin: 8px 0; color: var(--muted); font-size: 11px; }\n.opening-v4-composer:empty { display: none; }\n.device .scene01-chat .opening-thread { scroll-behavior: auto; }\n.scene01-invitation { align-self: flex-start; width: min(100%, 290px); margin-top: 12px; padding: 16px; border: 1px solid var(--line); border-radius: 16px; background: var(--surface); }\n.scene01-invitation p { color: var(--muted); font-size: 12px; line-height: 1.6; }\n.scene01-codename { display: grid; gap: 6px; font-size: 12px; margin: 12px 0; }\n.scene01-codename input { width: 100%; padding: 11px; border: 1px solid var(--line); border-radius: 10px; background: var(--surface); color: var(--text); font: inherit; }\n.scene01-chat .opening-choice > svg { display: inline; vertical-align: -2px; margin-right: 6px; color: #b58c32; }\n.device .scene01-chat .opening-actions { display: flex; flex-direction: column; overflow: hidden; }\n.scene01-chat .scene01-options { min-height: 0; overflow-y: auto; overscroll-behavior: contain; }\n.scene01-chat .opening-action-heading, .scene01-chat .opening-actions > .opening-primary { flex-shrink: 0; }\n.device .status-time { white-space: nowrap; }\n.device .chat-attachment { display: block; width: min(230px, 100%); margin: 8px 0 0; padding: 0; border: 0; border-radius: 13px; overflow: hidden; background: #182028; }\n.chat-attachment img { display: block; width: 100%; height: auto; max-height: 290px; object-fit: cover; object-position: top; }\n.chat-photo-viewer { position: absolute; inset: 0; z-index: 1300; background: #080b0e; color: white; display: flex; flex-direction: column; overflow: hidden; }\n.chat-photo-viewer > header { display: flex; justify-content: space-between; align-items: center; flex: none; padding: 16px; min-height: 64px; background: #080b0e; }\n.chat-photo-viewer header > div { display: flex; gap: 10px; }\n.chat-photo-viewer button { display: grid; place-items: center; width: 44px; height: 44px; border: 0; border-radius: 50%; background: #ffffff15; color: white; }\n.chat-photo-viewer button:disabled { opacity: .35; }\n.chat-photo-canvas { display: flex; flex: 1; min-height: 0; align-items: center; justify-content: center; overflow: hidden; touch-action: none; }\n.chat-photo-canvas img { width: 100%; max-height: 100%; object-fit: contain; user-select: none; transform-origin: center; }\n.phone-notification-layer { position: absolute; z-index: 2000; top: 52px; left: 10px; right: 10px; pointer-events: none; }\n.native-app .phone-notification-layer { top: calc(env(safe-area-inset-top) + 8px); }\n.phone-notification { position: relative; pointer-events: auto; background: color-mix(in srgb, var(--surface) 94%, transparent); border: 1px solid var(--line); border-radius: 19px; color: var(--text); box-shadow: 0 8px 28px #0003; backdrop-filter: blur(24px); touch-action: none; overflow: hidden; animation: phone-notice-enter .2s ease-out; }\n.phone-notification-open { display: flex; align-items: center; gap: 10px; width: 100%; min-height: 88px; background: none; border: 0; color: inherit; padding: 12px 34px 12px 12px; text-align: left; cursor: pointer; }\n.phone-notification-open > span:last-child { display: grid; gap: 3px; min-width: 0; flex: 1; }\n.phone-notification-open small { font-size: 9px; font-weight: 650; color: var(--muted); letter-spacing: .04em; }\n.phone-notification-open time { float: right; font-weight: 400; }\n.phone-notification-open strong { font-size: 13px; }\n.phone-notification-open > span > span { font-size: 12px; line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }\n.phone-notification .notice-avatar { flex: 0 0 38px; width: 38px; height: 38px; display: grid; place-items: center; border-radius: 11px; overflow: hidden; background: #476a70; color: white; }\n.notice-avatar img { width: 100%; height: 100%; object-fit: cover; }\n.phone-notification-dismiss { position: absolute; top: 4px; right: 3px; width: 30px; height: 30px; display: grid; place-items: center; background: none; border: 0; color: var(--muted); cursor: pointer; }\n@keyframes phone-notice-enter { from { translate: 0 -110%; opacity: 0; } to { translate: 0 0; opacity: 1; } }\n@media (prefers-reduced-motion: reduce) { .phone-notification { animation: none; } }\n"],["STYLE",{},":root{font-family:system-ui,-apple-system,\"Segoe UI\",sans-serif;font-synthesis:none;text-rendering:optimizeLegibility;color:#1e2935;background:#172734}\n*{box-sizing:border-box}html,body,#root{width:100%;height:100%;margin:0;overflow:hidden}button,input,select,textarea{font:inherit}button{cursor:pointer}button:disabled{cursor:not-allowed}button:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible{outline:3px solid #eaa26e;outline-offset:2px}h1,h2,p{margin-top:0}.sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap}\n.app-root{--phone-bg:#f5f3f8;--surface:#fff;--raised:#f8f7fb;--text:#202736;--muted:#667081;--line:#dedfe7;--accent:#6759aa;--button-accent:#6759aa;--incoming:#e9e9ef;--outgoing:#6b5caf;--outgoing-text:#fff;--header:#faf9fd;--shadow:0 10px 30px #192d3b12;display:flex;justify-content:center;width:100%;height:var(--visual-height,100dvh);overflow:hidden;background:#172734;color:var(--text)}\n.theme-dark{--phone-bg:#081c2c;--surface:#13293e;--raised:#1a344c;--text:#f2f6f8;--muted:#aec0d1;--line:#31495e;--accent:#5595ff;--button-accent:#286bd4;--incoming:#263d55;--outgoing:#2a70de;--outgoing-text:#fff;--header:#10283d;--shadow:0 10px 30px #0003}\n.device{width:min(100%,460px);height:100%;display:flex;flex-direction:column;min-height:0;overflow:hidden;position:relative;background:var(--phone-bg);box-shadow:0 0 70px #0005}\n.status-bar{flex:none;height:calc(36px + env(safe-area-inset-top));padding:env(safe-area-inset-top) 21px 