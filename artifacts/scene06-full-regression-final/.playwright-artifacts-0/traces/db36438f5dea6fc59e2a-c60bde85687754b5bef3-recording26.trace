{"o":[{"k":"id","v":{"s":"C2-PLAYER-U02_A"}},{"k":"sender","v":{"s":"player"}},{"k":"text","v":{"s":"Then how do you know about him?"}},{"k":"at","v":{"n":1792586191131}}],"id":3152},{"o":[{"k":"id","v":{"s":"C2-UNKNOWN-U02_A-0"}},{"k":"sender","v":{"s":"unknown"}},{"k":"text","v":{"s":"Because he tried to keep a set of records from being overwritten."}},{"k":"at","v":{"n":1792586193101}}],"id":3153},{"o":[{"k":"id","v":{"s":"C2-UNKNOWN-U02_A-1"}},{"k":"sender","v":{"s":"unknown"}},{"k":"text","v":{"s":"I know the attempt happened. I don't know what happened after."}},{"k":"at","v":{"n":1792586194961}}],"id":3154},{"o":[{"k":"id","v":{"s":"C2-UNKNOWN-U02-COMMON-0"}},{"k":"sender","v":{"s":"unknown"}},{"k":"text","v":{"s":"Let me ask you something."}},{"k":"at","v":{"n":1792586196161}}],"id":3155},{"o":[{"k":"id","v":{"s":"C2-UNKNOWN-U02-COMMON-1"}},{"k":"sender","v":{"s":"unknown"}},{"k":"text","v":{"s":"You've spoken to the people around him, haven't you?"}},{"k":"at","v":{"n":1792586197801}}],"id":3156},{"o":[{"k":"id","v":{"s":"C2-UNKNOWN-U02-COMMON-2"}},{"k":"sender","v":{"s":"unknown"}},{"k":"text","v":{"s":"Maya remembers the man she was going to marry."}},{"k":"at","v":{"n":1792586199441}}],"id":3157},{"o":[{"k":"id","v":{"s":"C2-UNKNOWN-U02-COMMON-3"}},{"k":"sender","v":{"s":"unknown"}},{"k":"text","v":{"s":"Sophie remembers her brother."}},{"k":"at","v":{"n":1792586200531}}],"id":3158},{"o":[{"k":"id","v":{"s":"C2-UNKNOWN-U02-COMMON-4"}},{"k":"sender","v":{"s":"unknown"}},{"k":"text","v":{"s":"Lucas remembers a friend he thought he knew."}},{"k":"at","v":{"n":1792586202061}}],"id":3159},{"o":[{"k":"id","v":{"s":"C2-UNKNOWN-U02-COMMON-5"}},{"k":"sender","v":{"s":"unknown"}},{"k":"text","v":{"s":"Eli may have known a side of Daniel the others didn't see."}},{"k":"at","v":{"n":1792586204031}}],"id":3160},{"o":[{"k":"id","v":{"s":"C2-UNKNOWN-U02-COMMON-6"}},{"k":"sender","v":{"s":"unknown"}},{"k":"text","v":{"s":"None of that means anyone's lying."}},{"k":"at",