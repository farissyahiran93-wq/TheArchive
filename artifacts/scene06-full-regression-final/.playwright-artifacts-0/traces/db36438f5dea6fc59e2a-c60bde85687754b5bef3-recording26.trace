,{"k":"at","v":{"n":1792585874897}}],"id":1293},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-13-4"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Don't ask."}},{"k":"at","v":{"n":1792585875797}}],"id":1294},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-13-6"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Anyway."}},{"k":"at","v":{"n":1792585878697}}],"id":1295},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-13-7"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"She's not some magician who can just pull answers out of nowhere."}},{"k":"at","v":{"n":1792585880597}}],"id":1296},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-13-8"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"But she might be able to help us understand some things later."}},{"k":"at","v":{"n":1792585882497}}],"id":1297},{"o":[{"k":"id","v":{"s":"OPEN-S03-C14-PLAYER-a"}},{"k":"sender","v":{"s":"player"}},{"k":"text","v":{"s":"What's Axiom Recovery?"}},{"k":"at","v":{"n":1792585882597}}],"id":1298},{"o":[{"k":"id","v":{"s":"OPEN-S03-C14-a-1"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"It's where Daniel works."}},{"k":"at","v":{"n":1792585883697}}],"id":1299},{"o":[{"k":"id","v":{"s":"OPEN-S03-C14-a-2"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"They deal with data and recovery-related work."}},{"k":"at","v":{"n":1792585885097}}],"id":1300},{"o":[{"k":"id","v":{"s":"OPEN-S03-C14-a-3"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"That's about the extent of my technical understanding."}},{"k":"at","v":{"n":1792585886597}}],"id":1301},{"o":[{"k":"id","v":{"s":"OPEN-S03-C14-a-4"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Eli would explain it better than I could."}},{"k":"at","v":{"n":1792585888097}}],"id":1302},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-14-1"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"So yeah."}},{"k":"at","v":{"n":1792585888997}}],"id":1303},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-14-2"}},{"k":"sender",