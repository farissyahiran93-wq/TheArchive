"text","v":{"s":"I just don't want to turn every little thing into an accusation."}},{"k":"at","v":{"n":1792585810597}}],"id":1269},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-10-1"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Just..."}},{"k":"at","v":{"n":1792585811497}}],"id":1270},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-10-2"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Be patient with her, okay?"}},{"k":"at","v":{"n":1792585812697}}],"id":1271},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-10-3"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"She's dealing with more than she lets on."}},{"k":"at","v":{"n":1792585814197}}],"id":1272},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-10-4"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"And then there's Lucas."}},{"k":"at","v":{"n":1792585815297}}],"id":1273},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-10-6"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Oh boy."}},{"k":"at","v":{"n":1792585818197}}],"id":1274},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-10-7"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Where do I even start?"}},{"k":"at","v":{"n":1792585819397}}],"id":1275},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-10-8"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"He's known Daniel since they were kids."}},{"k":"at","v":{"n":1792585820797}}],"id":1276},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-10-9"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"They practically grew up together."}},{"k":"at","v":{"n":1792585821997}}],"id":1277},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-10-10"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Which means he's had years to perfect the art of being impossible."}},{"k":"at","v":{"n":1792585823897}}],"id":1278},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-10-11"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"😅"}},{"k":"at","v":{"n":1792585824797}}],"id":1279},{"o":[{"k":"id","v":{"s":"OPEN-S03-C11-PLAYER-a"}},{"k":"sender","v":{"s":"player"}},{"k":"text","v":{"s":"He seems very protective."}},{"k":"at","v":{"n":1792585824897}}],"id":1280},{"o":[{"k":"id","v":{"s":"OPEN-S03-C11-a-1"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Yeah."}},{"k":"at","v":{"n":1792585825797}}],"id":1281},{"o":[{"k":"id","v":{"s":"OPEN-S03-C11-a-2"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"That's a good word for him."}},{"k":"at","v":{"n":1792585827097}}],"id":1282},{"o":[{"k":"id","v":{"s":"OPEN-S03-C11-a-3"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"He doesn't always show it in the nicest way."}},{"k":"at","v":{"n":1792585828697}}],"id":1283},{"o":[{"k":"id","v":{"s":"OPEN-S03-C11-a-4"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"But he cares."}},{"k":"at","v":{"n":1792585829697}}],"id":1284},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-11-1"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"He and Daniel used to argue about the stupidest things."}},{"k":"at","v":{"n":1792585831397}}],"id":1285},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-11-2"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Music."}},{"k":"at","v":{"n":1792585832297}}],"id":1286},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-11-3"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Football."}},{"k":"at","v":{"n":1792585833197}}],"id":1287},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-11-4"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Who was right about something neither of them actually understood."}},{"k":"at","v":{"n":1792585834897}}],"id":1288},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-11-5"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"And then five minutes later they'd be laughing again."}},{"k":"at","v":{"n":1792585836497}}],"id":1289},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-11-6"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"That's just how they were."}},{"k":"at","v":{"n":1792585837697}}],"id":1290},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-11-8"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"I think he's having a hard time accepting that he can't just call Daniel and argue with him about this."}},{"k":"at","v":{"n":1792585842397}}],"id":1291},{"o":[{"k":"id","v":{"s":"OPEN-S03-C12-PLAYER-a"}},{"k":"sender","v":{"s":"player"}},{"k":"text","v":{"s":"Do you think he'll come back?"}},{"k":"at","v":{"n":1792585842497}}],"id":1292},{"o":[{"k":"id","v":{"s":"OPEN-S03-C12-a-1"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"I hope so."}},{"k":"at","v":{"n":1792585843497}}],"id":1293},{"o":[{"k":"id","v":{"s":"OPEN-S03-C12-a-2"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"He's angry, not heartless."}},{"k":"at","v":{"n":1792585844597}}],"id":1294},{"o":[{"k":"id","v":{"s":"OPEN-S03-C12-a-3"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"I don't think he wants to walk away from Daniel."}},{"k":"at","v":{"n":1792585846297}}],"id":1295},{"o":[{"k":"id","v":{"s":"OPEN-S03-C12-a-4"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"He just doesn't want to do things this way."}},{"k":"at","v":{"n":1792585847897}}],"id":1296},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-12-1"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Whatever you think of Lucas..."}},{"k":"at","v":{"n":1792585849097}}],"id":1297},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-12-2"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Please don't assume he's your enemy."}},{"k":"at","v":{"n":1792585850397}}],"id":1298},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-12-3"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"I don't think he is."}},{"k":"at","v":{"n":1792585851597}}],"id":1299},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-12-5"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Oh!"}},{"k":"at","v":{"n":1792585854497}}],"id":1300},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-12-6"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"And there's Eli."}},{"k":"at","v":{"n":1792585855497}}],"id":1301},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-12-7"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"I almost forgot you haven't actually spoken to her."}},{"k":"at","v":{"n":1792585857097}}],"id":1302},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-12-8"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"She's much quieter in group chats."}},{"k":"at","v":{"n":1792585858397}}],"id":1303},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-12-9"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Sometimes I wonder whether she even reads half the messages."}},{"k":"at","v":{"n":1792585860097}}],"id":1304},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-12-10"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Then she'll reply to something from six hours ago."}},{"k":"at","v":{"n":1792585861697}}],"id":1305},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-12-11"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Like the conversation never moved on."}},{"k":"at","v":{"n":1792585862997}}],"id":1306},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-12-12"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"😅"}},{"k":"at","v":{"n":1792585863897}}],"id":1307},{"o":[{"k":"id","v":{"s":"OPEN-S03-C13-PLAYER-a"}},{"k":"sender","v":{"s":"player"}},{"k":"text","v":{"s":"Who's Eli?"}},{"k":"at","v":{"n":1792585863997}}],"id":1308},{"o":[{"k":"id","v":{"s":"OPEN-S03-C13-a-1"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Eli Ward."}},{"k":"at","v":{"n":1792585864897}}],"id":1309},{"o":[{"k":"id","v":{"s":"OPEN-S03-C13-a-2"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"She works with Daniel."}},{"k":"at","v":{"n":1792585865997}}],"id":1310},{"o":[{"k":"id","v":{"s":"OPEN-S03-C13-a-3"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"At Axiom Recovery."}},{"k":"at","v":{"n":1792585866997}}],"id":1311},{"o":[{"k":"id","v":{"s":"OPEN-S03-C13-a-4"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"She's not exactly the loudest person in the room."}},{"k":"at","v":{"n":1792585868597}}],"id":1312},{"o":[{"k":"id","v":{"s":"OPEN-S03-C13-a-5"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"But she's pretty smart."}},{"k":"at","v":{"n":1792585869697}}],"id":1313},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-13-1"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Eli's usually better with technical things than the rest of us."}},{"k":"at","v":{"n":1792585871497}}],"id":1314},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-13-2"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Which isn't saying much in my case."}},{"k":"at","v":{"n":1792585872897}}],"id":1315},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-13-3"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"I once managed to delete an entire folder while trying to rename it."}},{"k":"at","v":{"n":1792585874897}}],"id":1316},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-13-4"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Don't ask."}},{"k":"at","v":{"n":1792585875797}}],"id":1317},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-13-6"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Anyway."}},{"k":"at","v":{"n":1792585878697}}],"id":1318},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-13-7"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"She's not some magician who can just pull answers out of nowhere."}},{"k":"at","v":{"n":1792585880597}}],"id":1319},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-13-8"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"But she might be able to help us understand some things later."}},{"k":"at","v":{"n":1792585882497}}],"id":1320},{"o":[{"k":"id","v":{"s":"OPEN-S03-C14-PLAYER-a"}},{"k":"sender","v":{"s":"player"}},{"k":"text","v":{"s":"What's Axiom Recovery?"}},{"k":"at","v":{"n":1792585882597}}],"id":1321},{"o":[{"k":"id","v":{"s":"OPEN-S03-C14-a-1"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"It's where Daniel works."