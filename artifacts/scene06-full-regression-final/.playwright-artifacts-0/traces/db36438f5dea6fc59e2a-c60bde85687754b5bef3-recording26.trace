C04-a-2"}},{"k":"text","v":{"s":"Sophie: That's what I was afraid you'd say."}},{"k":"read","v":{"b":false}}],"id":169},{"o":[{"k":"id","v":{"s":"OPEN-S01-C04-a-3"}},{"k":"text","v":{"s":"Sophie: Not that it's your fault."}},{"k":"read","v":{"b":false}}],"id":170},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-04-1"}},{"k":"text","v":{"s":"Sophie: Can I ask if you've ever spoken to anyone called Daniel?"}},{"k":"read","v":{"b":false}}],"id":171},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-04-2"}},{"k":"text","v":{"s":"Sophie: Even online?"}},{"k":"read","v":{"b":false}}],"id":172},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-04-3"}},{"k":"text","v":{"s":"Sophie: Maybe a long time ago?"}},{"k":"read","v":{"b":false}}],"id":173},{"o":[{"k":"id","v":{"s":"OPEN-S01-C05-a-1"}},{"k":"text","v":{"s":"Sophie: Okay."}},{"k":"read","v":{"b":false}}],"id":174},{"o":[{"k":"id","v":{"s":"OPEN-S01-C05-a-2"}},{"k":"text","v":{"s":"Sophie: Thanks for being clear."}},{"k":"read","v":{"b":false}}],"id":175},{"o":[{"k":"id","v":{"s":"OPEN-S01-C05-a-3"}},{"k":"text","v":{"s":"Sophie: That makes this even stranger, though."}},{"k":"read","v":{"b":false}}],"id":176},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-05-1"}},{"k":"text","v":{"s":"Sophie: Anyway."}},{"k":"read","v":{"b":false}}],"id":177},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-05-2"}},{"k":"text","v":{"s":"Sophie: If you don't know him, then I guess that answers one question."}},{"k":"read","v":{"b":false}}],"id":178},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-05-4"}},{"k":"text","v":{"s":"Sophie: Just not the one I really wanted answered."}},{"k":"read","v":{"b":false}}],"id":179},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-05-5"}},{"k":"text","v":{"s":"Sophie: Sorry."}},{"k":"read","v":{"b":false}}],"id":180},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-05-6"}},{"k":"text","v":{"s":"Sophie: I keep making this awkward."}},{"k":"read","v":{"b":false}}],"id":181},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-05-7"}},{"k":"text","v":{"s":"Sophie: You probably