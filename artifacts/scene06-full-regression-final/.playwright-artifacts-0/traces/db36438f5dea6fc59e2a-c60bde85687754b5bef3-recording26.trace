":{"b":false}}],"id":454},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-8"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Please tell me you didn't start another argument."}},{"k":"read","v":{"b":false}}],"id":455},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-9"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: We were having a conversation."}},{"k":"read","v":{"b":false}}],"id":456},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-10"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: A very educational one."}},{"k":"read","v":{"b":false}}],"id":457},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-11"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Lucas."}},{"k":"read","v":{"b":false}}],"id":458},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-12"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Sophie."}},{"k":"read","v":{"b":false}}],"id":459},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-13"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Children."}},{"k":"read","v":{"b":false}}],"id":460},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-14"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: 🙄"}},{"k":"read","v":{"b":false}}],"id":461},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-16"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Look, I know adding someone without asking wasn't ideal."}},{"k":"read","v":{"b":false}}],"id":462},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-17"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: It wasn't ideal?"}},{"k":"read","v":{"b":false}}],"id":463},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-18"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Fine."}},{"k":"read","v":{"b":false}}],"id":464},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-19"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: It was a bad call."}},{"k":"read","v":{"b":false}}],"id":465},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-20"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Is that what you want me to say?"}},{"k":"read","v":{"b":false}}],"id":466},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-21"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: I want you to understand why it was a bad call."}},{"k":"read","v":{"b":false}}],"id":467},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-22"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I understand."}},{"k":"read","v":{"b":false}}],"id":468},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-23"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Then why did you do it?"}},{"k":"read","v":{"b":false}}],"id":469},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-24"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Because I'm tired of sitting here doing nothing!"}},{"k":"read","v":{"b":false}}],"id":470},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-26"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Sorry."}},{"k":"read","v":{"b":false}}],"id":471},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-27"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I didn't mean to snap."}},{"k":"read","v":{"b":false}}],"id":472},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-28"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: It's okay."}},{"k":"read","v":{"b":false}}],"id":473},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-29"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: No, it's not."}},{"k":"read","v":{"b":false}}],"id":474},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-30"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Lucas..."}},{"k":"read","v":{"b":false}}],"id":475},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-31"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: We're making decisions because we're scared."}},{"k":"read","v":{"b":false}}],"id":476},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-32"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: And we don't even know what we're risking."}},{"k":"read","v":{"b":false}}],"id":477},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-33"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I know!"}},{"k":"read","v":{"b":false}}],"id":478},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-34"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Do you think I don't think about that?"}},{"k":"read","v":{"b":false}}],"id":479},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-35"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Then start acting like it."}},{"k":"read","v":{"b":false}}],"id":480},{"o":[{"k":"id","v":{"s":"OPEN-S02-C08-a-1"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: No."}},{"k":"read","v":{"b":false}}],"id":481},{"o":[{"k":"id","v":{"s":"OPEN-S02-C08-a-2"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: That's not what I want."}},{"k":"read","v":{"b":false}}],"id":482},{"o":[{"k":"id","v":{"s":"OPEN-S02-C08-a-3"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: And we haven't asked you to leave."}},{"k":"read","v":{"b":false}}],"id":483},{"o":[{"k":"id","v":{"s":"OPEN-S02-C08-a-4"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: I might."}},{"k":"read","v":{"b":false}}],"id":484},{"o":[{"k":"id","v":{"s":"OPEN-S02-C08-a-5"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Lucas."}},{"k":"read","v":{"b":false}}],"id":485},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-2"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Fine."}},{"k":"read","v":{"b":false}}],"id":486},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-3"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: What do you want me to do?"}},{"k":"read","v":{"b":false}}],"id":487},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-4"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: I want us to stop sharing things until we know who we're sharing them with."}},{"k":"read","v":{"b":false}}],"id":488},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-5"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: That seems reasonable."}},{"k":"read","v":{"b":false}}],"id":489},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-6"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: So what?"}},{"k":"read","v":{"b":false}}],"id":490},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-7"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: We just ignore the number?"}},{"k":"read","v":{"b":false}}],"id":491},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-8"}},{"k":"text","v":{"s":"FIND DANIEL · L