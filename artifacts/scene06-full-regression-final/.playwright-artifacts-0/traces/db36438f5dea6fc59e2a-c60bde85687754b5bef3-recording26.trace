id":292},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-02-6"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Doesn't that seem a little convenient to anyone else?"}},{"k":"read","v":{"b":false}}],"id":293},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-02-7"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Convenient for who?"}},{"k":"read","v":{"b":false}}],"id":294},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-02-8"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: I don't know, Maya."}},{"k":"read","v":{"b":false}}],"id":295},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-02-9"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: That's the problem."}},{"k":"read","v":{"b":false}}],"id":296},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-02-11"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Maybe he saved the wrong number."}},{"k":"read","v":{"b":false}}],"id":297},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-02-12"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Possible."}},{"k":"read","v":{"b":false}}],"id":298},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-02-13"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Sure."}},{"k":"read","v":{"b":false}}],"id":299},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-02-14"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: And maybe this is all one big misunderstanding."}},{"k":"read","v":{"b":false}}],"id":300},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-02-15"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: It could be."}},{"k":"read","v":{"b":false}}],"id":301},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-02-16"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: You don't actually believe that."}},{"k":"read","v":{"b":false}}],"id":302},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-02-17"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: I believe we don't have enough information."}},{"k":"read","v":{"b":false}}],"id":303},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-02-19"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Fine."}},{"k":"read","v":{"b":false}}],"id":304},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-02-20"}},{"k":"tex