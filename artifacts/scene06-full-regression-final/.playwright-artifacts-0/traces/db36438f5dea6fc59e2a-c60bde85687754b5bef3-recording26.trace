3-AFTER-13-4"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Don't ask."}},{"k":"at","v":{"n":1792585875797}}],"id":1294},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-13-6"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Anyway."}},{"k":"at","v":{"n":1792585878697}}],"id":1295},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-13-7"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"She's not some magician who can just pull answers out of nowhere."}},{"k":"at","v":{"n":1792585880597}}],"id":1296},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-13-8"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"But she might be able to help us understand some things later."}},{"k":"at","v":{"n":1792585882497}}],"id":1297},{"o":[{"k":"id","v":{"s":"OPEN-S03-C14-PLAYER-a"}},{"k":"sender","v":{"s":"player"}},{"k":"text","v":{"s":"What's Axiom Recovery?"}},{"k":"at","v":{"n":1792585882597}}],"id":1298},{"o":[{"k":"id","v":{"s":"OPEN-S03-C14-a-1"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"It's where Daniel works."}},{"k":"at","v":{"n":1792585883697}}],"id":1299},{"o":[{"k":"id","v":{"s":"OPEN-S03-C14-a-2"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"They deal with data and recovery-related work."}},{"k":"at","v":{"n":1792585885097}}],"id":1300},{"o":[{"k":"id","v":{"s":"OPEN-S03-C14-a-3"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"That's about the extent of my technical understanding."}},{"k":"at","v":{"n":1792585886597}}],"id":1301},{"o":[{"k":"id","v":{"s":"OPEN-S03-C14-a-4"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Eli would explain it better than I could."}},{"k":"at","v":{"n":1792585888097}}],"id":1302},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-14-1"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"So yeah."}},{"k":"at","v":{"n":1792585888997}}],"id":1303},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-14-2"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"That's Eli."}},{"k":"at","v":{"n":1792585889897}}],"id":1304},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-14-3"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"She's easier to talk to when she isn't trying to explain something complicated."}},{"k":"at","v":{"n":1792585891897}}],"id":1305},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-14-4"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Which, now that I think about it, might not be very often."}},{"k":"at","v":{"n":1792585893797}}],"id":1306},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-14-5"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"😅"}},{"k":"at","v":{"n":1792585894697}}],"id":1307},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-14-6"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"So..."}},{"k":"at","v":{"n":1792585895597}}],"id":1308},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-14-7"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"That's Maya, Lucas and Eli."}},{"k":"at","v":{"n":1792585896797}}],"id":1309},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-14-8"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"In the world's least useful introduction."}},{"k":"at","v":{"n":1792585898097}}],"id":1310},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-14-9"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"They're all different."}},{"k":"at","v":{"n":1792585899097}}],"id":1311},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-14-10"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Very different."}},{"k":"at","v":{"n":1792585899997}}],"id":1312},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-14-11"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"But they all care about Daniel."}},{"k":"at","v":{"n":1792585901297}}],"id":1313},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-14-12"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"In their own ways."}},{"k":"at","v":{"n":1792585902397}}],"id":1314},{"o":[{"k":"id","v":{"s":"OPEN-S03-C15-PLAYER-a"}},{"k":"sender","v":{"s":"player"}},{"k":"text","v":{"s":"I feel bad