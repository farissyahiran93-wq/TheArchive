layer"}},{"k":"text","v":{"s":"Who is this?"}},{"k":"at","v":{"n":1792586010967}}],"id":3225},{"o":[{"k":"id","v":{"s":"C2-UNKNOWN-U01_A-0"}},{"k":"sender","v":{"s":"unknown"}},{"k":"text","v":{"s":"Someone who knows you've been asking questions."}},{"k":"at","v":{"n":1792586012387}}],"id":3226},{"o":[{"k":"id","v":{"s":"C2-PLAYER-U01_A_FOLLOWUP_A"}},{"k":"sender","v":{"s":"player"}},{"k":"text","v":{"s":"That doesn't answer anything."}},{"k":"at","v":{"n":1792586101054}}],"id":3227},{"o":[{"k":"id","v":{"s":"C2-UNKNOWN-U01_A_FOLLOWUP_A-0"}},{"k":"sender","v":{"s":"unknown"}},{"k":"text","v":{"s":"I wasn't trying to answer that yet."}},{"k":"at","v":{"n":1792586102474}}],"id":3228},{"o":[{"k":"id","v":{"s":"C2-UNKNOWN-U01-COMMON-0"}},{"k":"sender","v":{"s":"unknown"}},{"k":"text","v":{"s":"I know you're going to ask whether I have him hidden somewhere."}},{"k":"at","v":{"n":1792586104444}}],"id":3229},{"o":[{"k":"id","v":{"s":"C2-UNKNOWN-U01-COMMON-1"}},{"k":"sender","v":{"s":"unknown"}},{"k":"text","v":{"s":"I don't know where Daniel is."}},{"k":"at","v":{"n":1792586105754}}],"id":3230},{"o":[{"k":"id","v":{"s":"C2-UNKNOWN-U01-COMMON-2"}},{"k":"sender","v":{"s":"unknown"}},{"k":"text","v":{"s":"And I'm not going to pretend I do."}},{"k":"at","v":{"n":1792586107284}}],"id":3231},{"o":[{"k":"id","v":{"s":"C2-PLAYER-U02_A"}},{"k":"sender","v":{"s":"player"}},{"k":"text","v":{"s":"Then how do you know about him?"}},{"k":"at","v":{"n":1792586191131}}],"id":3232},{"o":[{"k":"id","v":{"s":"C2-UNKNOWN-U02_A-0"}},{"k":"sender","v":{"s":"unknown"}},{"k":"text","v":{"s":"Because he tried to keep a set of records from being overwritten."}},{"k":"at","v":{"n":1792586193101}}],"id":3233},{"o":[{"k":"id","v":{"s":"C2-UNKNOWN-U02_A-1"}},{"k":"sender","v":{"s":"unknown"}},{"k":"text","v":{"s":"I know the attempt happened. I don't know what happened after."}},{"k":"at","v":{"n":1792586194961}}],"id":3234},{"o":[{"k":"id","v":{"s":"C2-UNKNOWN-U02-COMMON-0"}},{"k":"sender","v":{"s":"unknown"}},{"k":"text","v":{"s":"Let me ask you something."}},{"k":"at","v":{"n":1792586196161}}],"id":3235},{"o":[{"k":"id","v":{"s":"C2-UNKNOWN-U02-COMMON-1"}},{"k":"sender","v":{"s":"unknown"}},{"k":"text","v":{"s":"You've spoken to the people around him, haven't you?"}},{"k":"at","v":{"n":1792586197801}}],"id":3236},{"o":[{"k":"id","v":{"s":"C2-UNKNOWN-U02-COMMON-2"}},{"k":"sender","v":{"s":"unknown"}},{"k":"text","v":{"s":"Maya remembers the man she was going to marry."}},{"k":"at","v":{"n":1792586199441}}],"id":3237},{"o":[{"k":"id","v":{"s":"C2-UNKNOWN-U02-COMMON-3"}},{"k":"sender","v":{"s":"unknown"}},{"k":"text","v":{"s":"Sophie remembers her brother."}},{"k":"at","v":{"n":1792586200531}}],"id":3238},{"o":[{"k":"id","v":{"s":"C2-UNKNOWN-U02-COMMON-4"}},{"k":"sender","v":{"s":"unknown"}},{"k":"text","v":{"s":"Lucas remembers a friend he thought he knew."}},{"k":"at","v":{"n":1792586202061}}],"id":3239},{"o":[{"k":"id","v":{"s":"C2-UNKNOWN-U02-COMMON-5"}},{"k":"sender","v":{"s":"unknown"}},{"k":"text","v":{"s":"Eli may have known a side of Daniel the others didn't see."}},{"k":"at","v":{"n":1792586204031}}],"id":3240},{"o":[{"k":"id","v":{"s":"C2-UNKNOWN-U02-COMMON-6"}},{"k":"sender","v":{"s":"unknown"}},{"k":"text","v":{"s":"None of that means anyone's lying."}},{"k":"at","v":{"n":1792586205341}}],"id":3241},{"o":[{"k":"id","v":{"s":"C2-UNKNOWN-U02-COMMON-7"}},{"k":"sender","v":{"s":"unknown"}},{"k":"text","v":{"s":"But they can't all have seen the whole picture."}},{"k":"at","v":{"n":1792586206981}}],"id":3242},{"o":[{"k":"id","v":{"s":"C2-PLAYER-U03_B"}},{"k":"sender","v":{"s":"player"}},{"k":"text","v":{"s":"Have you been reading my messages?"}},{"k":"at","v":{"n":1792586281217}}],"id":3243},{"o":[{"k":"id","v":{"s":"C2-UNKNOWN-U03_B-0"}},{"k":"sender","v":{"s":"unknown"}},{"k":"text","v":{"s":"I can see some names and connections in the recovered data."}},{"k":"at","v":{"n":1792586283077}}],"id":3244},{"o":[{"k":"id","v":{"s":"C2-UNKNOWN-U03_B-1"}},{"k":"sender","v":{"s":"unknown"}},{"k":"text","v":{"s":"I can't prove to you what else I have or haven't seen."}},{"k":"at","v":{"n":1792586285047}}],"id":3245},{"o":[{"k":"id","v":{"s":"C2-UNKNOWN-U03_B-2"}},{"k":"sender","v":{"s":"unknown"}},{"k":"text","v":{"s":"You should treat that as a reason not to trust me blindly."}},{"k":"at","v":{"n":1792586287017}}],"id":3246},{"o":[{"k":"id","v":{"s":"C2-UNKNOWN-U03-COMMON-0"}},{"k":"sender","v":{"s":"unknown"}},{"k":"text","v":{"s":"Imagine somebody opening your phone tomorrow."}},{"k":"at","v":{"n":1792586288327}}],"id":3247},{"o":[{"k":"id","v":{"s":"C2-UNKNOWN-U03-COMMON-1"}},{"k":"sender","v":{"s":"unknown"}},{"k":"text","v":{"s":"They'd find conversations that end in the middle. Photos without explanations."}},{"k":"at","v":{"n":1792586290187}}],"id":3248},{"o":[{"k":"id","v":{"s":"C2-UNKNOWN-U03-COMMON-2"}},{"k":"sender","v":{"s":"unknown"}},{"k":"text","v":{"s":"Notes you'd forgotten you wrote."}},{"k":"at","v":{"n":1792586291387}}],"id":3249},{"o":[{"k":"id","v":{"s":"C2-UNKNOWN-U03-COMMON-3"}},{"k":"sender","v":{"s":"unknown"}},{"k":"text","v":{"s":"They could build a story about you from all of it."}},{"k":"at","v":{"n":1792586293247}}],"id":3250},{"o":[{"k":"id","v":{"s":"C2-UNKNOWN-U03-COMMON-4"}},{"k":"sender","v":{"s":"unknown"}},{"k":"text","v":{"s":"They'd probably get parts of it wrong."}},{"k":"at","v":{"n":1792586294667}}],"id":3251},{"o":[{"k":"id","v":{"s":"C2-UNKNOWN-U03-COMMON-5"}},{"k":"sender","v":{"s":"unknown"}},{"k":"text","v":{"s":"Daniel left behind something like that."}},{"k":"at","v":{"n":1792586297777}}],"id":3252},{"o":[{"k":"id","v":{"s":"C2-UNKNOWN-U03-COMMON-6"}},{"k":"sender","v":{"s":"unknown"}},{"k":"text","v":{"s":"Not his actual phone."}},{"k":"at","v":{"n":1792586298867}}],"id":3253},{"o":[{"k":"id","v":{"s":"C2-UNKNOWN-U03-COMMON-7"}},{"k":"sender","v":{"s":"unknown"}},{"k":"text","v":{"s":"A mirror. An incomplete copy of certain records."}},{"k":"at","v":{"n":1792586300397}}],"id":3254},{"o":[{"k":"id","v":{"s":"C2-UNKNOWN-U03-COMMON-8"}},{"k":"sender","v":{"s":"unknown"}},{"k":"text","v":{"s":"Some older than others. Some possibly changed."}},{"k":"at","v":{"n":1792586301817}}],"id":3255},{"o":[{"k":"id","v":{"s":"C2-PLAYER-U04_C"}},{"k":"sender","v":{"s":"player"}},{"k":"text","v":{"s":"Prove it."}},{"k":"at","v":{"n":1792586371325}}],"id":3256},{"o":[{"k":"id","v":{"s":"C2-UNKNOWN-U04_C-0"}},{"k":"sender","v":{"s":"unknown"}},{"k":"text","v":{"s":"A good demand."}},{"k":"at","v":{"n":1792586372305}}],"id":3257},{"o":[{"k":"id","v":{"s":"C2-UNKNOWN-U04-NO-0"}},{"k":"sender","v":{"s":"unknown"}},{"k":"text","v":{"s":"I could send you a screenshot. I could also have made it."}},{"k":"at","v":{"n":1792586374275}}],"id":3258},{"o":[{"k":"id","v":{"s":"C2-UNKNOWN-U04-NO-1"}},{"k":"sender","v":{"s":"unknown"}},{"k":"text","v":{"s":"If you inspect the copy, you'll see what it contains. That still won't prove where it came from."}},{"k":"at","v":{"n":1792586376905}}],"id":3259},{"o":[{"k":"id","v":{"s":"C2-UNKNOWN-U04-COMMON-0"}},{"k":"sender","v":{"s":"unknown"}},{"k":"text","v":{"s":"The point isn't that I can hand you the truth."}},{"k":"at","v":{"n":1792586378655}}],"id":3260},{"o":[{"k":"id","v":{"s":"C2-UNKNOWN-U04-COMMON-1"}},{"k":"sender","v":{"s":"unknown"}},{"k":"text","v":{"s":"It's that you could compare what people remember with what was written down."}},{"k":"at","v":{"n":1792586380735}}],"id":3261},{"o":[{"k":"id","v":{"s":"C2-UNKNOWN-U04-COMMON-2"}},{"k":"sender","v":{"s":"unknown"}},{"k":"text","v":{"s":"Daniel didn't keep everything in one place."}},{"k":"at","v":{"n":1792586382155}}],"id":3262},{"o":[{"k":"id","v":{"s":"C2-UNKNOWN-U04-COMMON-3"}},{"k":"sender","v":{"s":"unknown"}},{"k":"text","v":{"s":"The records he was worried about weren't all in one place either."}},{"k":"at","v":{"n":1792586384125}}],"id":3263},{"o":[{"k":"id","v":{"s":"C2-UNKNOWN-U04-COMMON-4"}},{"k":"sender","v":{"s":"unknown"}},{"k":"text","v":{"s":"This mirror won't give you an answer by itself."}},{"k":"at","v":{"n":1792586385765}}],"id":3264},{"o":[{"k":"id","v":{"s":"C2-UNKNOWN-U04-COMMON-5"}},{"k":"sender","v":{"s":"unknown"}},{"k":"text","v":{"s":"But it may give you better questions."}},{"k":"at","v":{"n":1792586387185}}],"id":3265},{"o":[{"k":"id","v":{"s":"C2-UNKNOWN-U04-COMMON-6"}},{"k":"sender","v":{"s":"unknown"}},{"k":"text","v":{"s":"I can give you access."}},{"k":"at","v":{"n":1792586388385}}],"id":3266},{"o":[{"k":"id","v":{"s":"C2-PLAYER-U05_C"}},{"k":"sender","v":{"s":"player"}},{"k":"text","v":{"s":"What do you want in return?"}},{"k":"at","v":{"n":1792586461422}}],"id":3267},{"o":[{"k":"id","v":{"s":"C2-UNKNOWN-U05_C-0"}},{"k":"sender","v":{"s":"unknown"}},{"k":"text","v":{"s":"Right now? Nothing you can send me."}},{"k":"at","v":{"n":1792586462842}}],"id":3268},{"o":[{"k":"id","v":{"s":"C2-UNKNOWN-U05_C-1"}},{"k":"sender","v":{"s":"unknown"}},{"k":"text","v":{"s":"Later, you might find something I want to know."}},{"k":"at","v":{"n":1792586464482}}],"id":3269},{"o":[{"k":"id","v":{"s":"C2-UNKNOWN-U05_C-2"}},{"k":"sender","v":{"s":"unknown"}},{"k":"text","v":{"s":"Don't promise me anything. Especially not before you see it."}},{"k":"at","v":{"n":1792586466232}}],"id":3270},{"o":[{"k":"id","v":{"s":"C2-UNKNOWN-U05-COMMON-0"}},{"k":"sender","v":{"s":"unknown"}},{"k":"text","v":{"s":"One warning before you decide."}},{"k":"at","v":{"n":1792586467432}}],"id":3271},{"o":[{"k":"id","v":{"s":"C2-UNKNOWN-U05-COMMON-1"}},{"k":"sender","v":{"s":"unknown"}},{"k":"text","v":{"s":"Some of what you'll see was never meant for you."}},{"k":"at","v":{"n":1792586469182}}],"id":3272},{"o":[{"k":"id","v":{"s":"C2-UNKNOWN-U05-COMMON-2"}},{"k":"sender","v":{"s":"unknown"}},{"k":"text","v":{"s":"Old arguments. Unsent messages. Things Daniel may have regretted writing."}},{"k":"at","v":{"n":1792586470932}}],"id":3273},{"o":[{"k":"id","v":{"s":"C2-UNKNOWN-U05-COMMON-3"}},{"k":"sender","v":{"s":"unknown"}},{"k":"text","v":{"s":"And fragments that might make innocent people look guilty when they're taken out of context."}},{"k":"at","v":{"n":1792586473232}}],"id":3274},{"o":[{"k":"id","v":{"s":"C2-UNKNOWN-U05-COMMON-4"}},{"k":"sender","v":{"s":"unknown"}},{"k":"text","v":{"s":"You decide what to open. You decide what to share."}},{"k":"at","v":{"n":1792586474982}}],"id":3275},{"o":[{"k":"id","v":{"s":"C2-PLAYER-U06_A"}},{"k":"sender","v":{"s":"player"}},{"k":"text","v":{"s":"That sounds like a serious invasion of privacy."}},{"k":"at","v":{"n":1792586551543}}],"id":3276},{"o":[{"k":"id","v":{"s":"C2-UNKNOWN-U06_A-0"}},{"k":"sender","v":{"s":"unknown"}},{"k":"text","v":{"s":"It is."}},{"k":"at","v":{"n":1792586552443}}],"id":3277},{"o":[{"k":"id","v":{"s":"C2-UNKNOWN-U06_A-1"}},{"k":"sender","v":{"s":"unknown"}},{"k":"text","v":{"s":"I'm not going to pretend otherwise."}},{"k":"at","v":{"n":1792586553753}}],"id":3278},{"o":[{"k":"id","v":{"s":"C2-UNKNOWN-U06_A-2"}},{"k":"sender","v":{"s":"unknown"}},{"k":"text","v":{"s":"If you open it, be prepared to question your own reasons, too."}},{"k":"at","v":{"n":1792586555723}}],"id":3279},{"o":[{"k":"id","v":{"s":"C2-UNKNOWN-U06-COMMON-0"}},{"k":"sender","v":{"s":"unknown"}},{"k":"text","v":{"s":"There's something else you need to understand."}},{"k":"at","v":{"n":1792586557143}}],"id":3280},{"o":[{"k":"id","v":{"s":"C2-UNKNOWN-U06-COMMON-1"}},{"k":"sender","v":{"s":"unknown"}},{"k":"text","v":{"s":"A copy can be incomplete. It can also be arranged to mislead you."}},{"k":"at","v":{"n":1792586559223}}],"id":3281},{"o":[{"k":"id","v":{"s":"C2-PLAYER-U06B_A"}},{"k":"sender","v":{"s":"player"}},{"k":"text","v":{"s":"How do I know you're not manipulating what I see?"}},{"k":"at","v":{"n":1792586641656}}],"id":3282},{"o":[{"k":"id","v":{"s":"C2-UNKNOWN-U06B_A-0"}},{"k":"sender","v":{"s":"unknown"}},{"k":"text","v":{"s":"You don't."}},{"k":"at","v":{"n":1792586642556}}],"id":3283},{"o":[{"k":"id","v":{"s":"C2-UNKNOWN-U06B_A-1"}},{"k":"sender","v":{"s":"unknown"}},{"k":"text","v":{"s":"Check dates and context. Compare things from different sources."}},{"k":"at","v":{"n":1792586644196}}],"id":3284},{"o":[{"k":"id","v":{"s":"C2-UNKNOWN-U06B-COMMON-0"}},{"k":"sender","v":{"s":"unknown"}},{"k":"text","v":{"s":"And when two copies disagree, don't automatically trust the newer one."}},{"k":"at","v":{"n":1792586646056}}],"id":3285},{"o":[{"k":"id","v":{"s":"C2-UNKNOWN-U06B-COMMON-1"}},{"k":"sender","v":{"s":"unknown"}},{"k":"text","v":{"s":"The Archive is already installed on your device."}},{"k":"at","v":{"n":1792586650086}}],"id":3286},{"o":[{"k":"id","v":{"s":"C2-UNKNOWN-U06B-COMMON-2"}},{"k":"sender","v":{"s":"unknown"}},{"k":"text","v":{"s":"It was never fully activated."}},{"k":"at","v":{"n":1792586651286}}],"id":3287},{"o":[{"k":"id","v":{"s":"C2-UNKNOWN-U06B-COMMON-3"}},{"k":"sender","v":{"s":"unknown"}},{"k":"text","v":{"s":"I can send the missing access package."}},{"k":"at","v":{"n":1792586652706}}],"id":3288},{"o":[{"k":"id","v":{"s":"C2-UNKNOWN-U06B-COMMON-4"}},{"k":"sender","v":{"s":"unknown"}},{"k":"text","v":{"s":"After that, it's your decision what to do with it."}},{"k":"at","v":{"n":1792586654456}}],"id":3289},{"o":[{"k":"id","v":{"s":"C2-PLAYER-U07Q_C"}},{"k":"sender","v":{"s":"player"}},{"k":"text","v":{"s":"What exactly will change on my phone?"}},{"k":"at","v":{"n":1792586821943}}],"id":3290},{"o":[{"k":"id","v":{"s":"C2-UNKNOWN-U07Q_C-0"}},{"k":"sender","v":{"s":"unknown"}},{"k":"text","v":{"s":"The Archive gains a device mirror."}},{"k":"at","v":{"n":1792586823253}}],"id":3291},{"o":[{"k":"id","v":{"s":"C2-UNKNOWN-U07Q_C-1"}},{"k":"sender","v":{"s":"unknown"}},{"k":"text","v":{"s":"Messages gets a passive relay component. It won't have anything to display until a relay is available."}},{"k":"at","v":{"n":1792586825773}}],"id":3292},{"o":[{"k":"id","v":{"s":"C2-PLAYER-DECLINE"}},{"k":"sender","v":{"s":"player"}},{"k":"text","v":{"s":"No. I'm not opening an unverified package."}},{"k":"at","v":{"n":1792586912105}}],"id":3293},{"o":[{"k":"id","v":{"s":"C2-UNKNOWN-DECLINE-0"}},{"k":"sender","v":{"s":"unknown"}},{"k":"text","v":{"s":"That's a reasonable decision."}},{"k":"at","v":{"n":1792586913195}}],"id":3294},{"o":[{"k":"id","v":{"s":"C2-UNKNOWN-DECLINE-1"}},{"k":"sender","v":{"s":"unknown"}},{"k":"text","v":{"s":"I'm leaving the package in this thread. You can inspect it again later."}},{"k":"at","v":{"n":1792586915275}}],"id":3295},{"o":[{"k":"id","v":{"s":"C2-UNKNOWN-DECLINE-2"}},{"k":"sender","v":{"s":"unknown"}},{"k":"text","v":{"s":"I won't install it for you."}},{"k":"at","v":{"n":1792586916585}}],"id":3296},{"o":[{"k":"id","v":{"s":"C2-PLAYER-ACCEPT"}},{"k":"sender","v":{"s":"player"}},{"k":"text","v":{"s":"Fine. I'll open it."}},{"k":"at","v":{"n":1792587010706}}],"id":3297},{"o":[{"k":"id","v":{"s":"C2-UNKNOWN-ACCEPT-0"}},{"k":"sender","v":{"s":"unknown"}},{"k":"text","v":{"s":"You don't sound convinced."}},{"k":"at","v":{"n":1792587011796}}],"id":3298},{"o":[{"k":"id","v":{"s":"C2-PLAYER-U07_ACK_C"}},{"k":"sender","v":{"s":"player"}},{"k":"text","v":{"s":"Don't mistake this for trust."}},{"k":"at","v":{"n":1792587100873}}],"id":3299},{"o":[{"k":"id","v":{"s":"C2-UNKNOWN-U07_ACK_C-0"}},{"k":"sender","v":{"s":"unknown"}},{"k":"text","v":{"s":"I won't."}},{"k":"at","v":{"n":1792587101773}}],"id":3300},{"o":[{"k":"id","v":{"s":"C2-UNKNOWN-U08-INTRO-0"}},{"k":"sender","v":{"s":"unknown"}},{"k":"text","v":{"s":"One more thing."}},{"k":"at","v":{"n":1792587102753}}],"id":3301},{"o":[{"k":"id","v":{"s":"C2-UNKNOWN-U08-INTRO-1"}},{"k":"sender","v":{"s":"unknown"}},{"k":"text","v":{"s":"Don't mistake access for proof."}},{"k":"at","v":{"n":1792587103953}}],"id":3302},{"o":[{"k":"id","v":{"s":"C2-UNKNOWN-U08-INTRO-2"}},{"k":"sender","v":{"s":"unknown"}},{"k":"text","v":{"s":"Some records are incomplete. Some may have been changed."}},{"k":"at","v":{"n":1792587105593}}],"id":3303},{"o":[{"k":"id","v":{"s":"C2-UNKNOWN-U08-INTRO-3"}},{"k":"sender","v":{"s":"unknown"}},{"k":"text","v":{"s":"And the hardest ones to read will probably be the ones about people you know."}},{"k":"at","v":{"n":1792587107893}}],"id":3304},{"o":[{"k":"id","v":{"s":"C2-PLAYER-U08_C"}},{"k":"sender","v":{"s":"player"}},{"k":"text","v":{"s":"Why should I trust any of this?"}},{"k":"at","v":{"n":1792587191034}}],"id":3305},{"o":[{"k":"id","v":{"s":"C2-UNKNOWN-U08_C-0"}},{"k":"sender","v":{"s":"unknown"}},{"k":"text","v":{"s":"You shouldn't. Not yet."}},{"k":"at","v":{"n":1792587192124}}],"id":3306},{"o":[{"k":"id","v":{"s":"C2-UNKNOWN-U08_C-1"}},{"k":"sender","v":{"s":"unknown"}},{"k":"text","v":{"s":"Not me, and not a copy you can't authenticate."}},{"k":"at","v":{"n":1792587193764}}],"id":3307},{"o":[{"k":"id","v":{"s":"C2-UNKNOWN-U08_C-2"}},{"k":"sender","v":{"s":"unknown"}},{"k":"text","v":{"s":"Use it to find questions you can verify somewhere else."}},{"k":"at","v":{"n":1792587195514}}],"id":3308},{"o":[{"k":"id","v":{"s":"C2-UNKNOWN-U08-COMMON-0"}},{"k":"sender","v":{"s":"unknown"}},{"k":"text","v":{"s":"Start with his phone."}},{"k":"at","v":{"n":1792587196604}}],"id":3309},{"o":[{"k":"id","v":{"s":"C2-UNKNOWN-U08-COMMON-1"}},{"k":"sender","v":{"s":"unknown"}},{"k":"text","v":{"s":"Don't look for the strangest thing first."}},{"k":"at","v":{"n":1792587198024}}],"id":3310},{"o":[{"k":"id","v":{"s":"C2-UNKNOWN-U08-COMMON-2"}},{"k":"sender","v":{"s":"unknown"}},{"k":"text","v":{"s":"Look for the thing that doesn't belong."}},{"k":"at","v":{"n":1792587199444}}],"id":3311},{"o":[{"k":"id","v":{"s":"C2-UNKNOWN-U08-COMMON-3"}},{"k":"sender","v":{"s":"unknown"}},{"k":"text","v":{"s":"Sometimes that's harder to notice."}},{"k":"at","v":{"n":1792587200644}}],"id":3312},{"o":[{"k":"id","v":{"s":"C2-UNKNOWN-U08-COMMON-4"}},{"k":"sender","v":{"s":"unknown"}},{"k":"text","v":{"s":"And if you find something..."}},{"k":"at","v":{"n":1792587203644}}],"id":3313},{"o":[{"k":"id","v":{"s":"C2-UNKNOWN-U08-COMMON-5"}},{"k":"sender","v":{"s":"unknown"}},{"k"