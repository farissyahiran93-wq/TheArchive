":127}}],"id":121}}],"id":119}},{"k":"relationships","v":{"o":[{"k":"maya","v":{"o":[{"k":"trust","v":{"n":0}},{"k":"affinity","v":{"n":0}},{"k":"suspicion","v":{"n":0}},{"k":"romance","v":{"n":0}}],"id":129}},{"k":"daniel","v":{"o":[{"k":"trust","v":{"n":0}},{"k":"affinity","v":{"n":0}},{"k":"suspicion","v":{"n":0}},{"k":"romance","v":{"n":0}}],"id":130}},{"k":"lucas","v":{"o":[{"k":"trust","v":{"n":0}},{"k":"affinity","v":{"n":0}},{"k":"suspicion","v":{"n":0}},{"k":"romance","v":{"n":0}}],"id":131}},{"k":"sophie","v":{"o":[{"k":"trust","v":{"n":0}},{"k":"affinity","v":{"n":0}},{"k":"suspicion","v":{"n":0}},{"k":"romance","v":{"n":0}}],"id":132}},{"k":"eli","v":{"o":[{"k":"trust","v":{"n":0}},{"k":"affinity","v":{"n":0}},{"k":"suspicion","v":{"n":0}},{"k":"romance","v":{"n":0}}],"id":133}},{"k":"nora","v":{"o":[{"k":"trust","v":{"n":0}},{"k":"affinity","v":{"n":0}},{"k":"suspicion","v":{"n":0}},{"k":"romance","v":{"n":0}}],"id":134}}],"id":128}},{"k":"evidence","v":{"o":[],"id":135}},{"k":"notifications","v":{"a":[{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-OPENING-1"}},{"k":"text","v":{"s":"Unknown number: Hi."}},{"k":"read","v":{"b":false}}],"id":137},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-OPENING-3"}},{"k":"text","v":{"s":"Unknown number: Sorry. This is going to sound odd."}},{"k":"read","v":{"b":false}}],"id":138},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-OPENING-6"}},{"k":"text","v":{"s":"Unknown number: Is this still your number?"}},{"k":"read","v":{"b":false}}],"id":139},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-C01-a-1"}},{"k":"text","v":{"s":"Unknown number: Fair question."}},{"k":"read","v":{"b":false}}],"id":140},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-C01-a-2"}},{"k":"text","v":{"s":"Sophie: I'm Sophie."}},{"k":"read","v":{"b":false}}],"id":141},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-C01-a-3"}},{"k":"text","v":{"s":"Sophie: And that probably doesn't help much."}},{"k":"read","v":{"b":false}}],"id":142},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-01-1"}},{"k":"text","v":{"s":"Sophie: I don't expect you to know me."}},{"k":"read","v":{"b":false}}],"id":143},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-01-2"}},{"k":"text","v":{"s":"Sophie: I found this number saved somewhere."}},{"k":"read","v":{"b":false}}],"id":144},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-01-4"}},{"k":"text","v":{"s":"Sophie: Can I explain?"}},{"k":"read","v":{"b":false}}],"id":145},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-C02-a-1"}},{"k":"text","v":{"s":"Sophie: Thank you."}},{"k":"read","v":{"b":false}}],"id":146},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-02-1"}},{"k":"text","v":{"s":"Sophie: It's a saved copy of someone's contacts."}},{"k":"read","v":{"b":false}}],"id":147},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-02-2"}},{"k":"text","v":{"s":"Sophie: The file says it belongs to Daniel Mercer."}},{"k":"read","v":{"b":false}}],"id":148},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-02-3"}},{"k":"text","v":{"s":"Sophie: I was looking through it earlier."}},{"k":"read","v":{"b":false}}],"id":149},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-02-5"}},{"k":"text","v":{"s":"Sophie: Your number is in there."}},{"k":"read","v":{"b":false}}],"id":150},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-02-6"}},{"k":"text","v":{"s":"Sophie: No name beside it."}},{"k":"read","v":{"b":false}}],"id":151},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-02-7"}},{"k":"text","v":{"s":"Sophie: Just a star."}},{"k":"read","v":{"b":false}}],"id":152},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-C03-a-1"}},{"k":"text","v":{"s":"Sophie: Yeah. Like a favourite, maybe."}},{"k":"read","v":{"b":false}}],"id":153},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-C03-a-2"}},{"k":"text","v":{"s":"Sophie: But I don't know what that symbol means in this file."}},{"k":"read","v":{"b":false}}],"id":154},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-03-2"}},{"k":"text","v":{"s":"Sophie: Do you know Daniel?"}},{"k":"read","v":{"b":false}}],"id":155},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-03-3"}},{"k":"text","v":{"s":"Sophie: Daniel Mercer?"}},{"k":"read","v":{"b":false}}],"id":156},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-C04-a-1"}},{"k":"text","v":{"s":"Sophie: Okay."}},{"k":"read","v":{"b":false}}],"id":157},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-C04-a-2"}},{"k":"text","v":{"s":"Sophie: That was the most likely answer, I suppose."}},{"k":"read","v":{"b":false}}],"id":158},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-04-1"}},{"k":"text","v":{"s":"Sophie: Could you think back a little?"}},{"k":"read","v":{"b":false}}],"id":159},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-04-2"}},{"k":"text","v":{"s":"Sophie: Even an old online chat. A work message. Anything."}},{"k":"read","v":{"b":false}}],"id":160},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-04-3"}},{"k":"text","v":{"s":"Sophie: I'm not asking you to guess."}},{"k":"read","v":{"b":false}}],"id":161},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-C05-a-1"}},{"k":"text","v":{"s":"Sophie: Then that's useful to know."}},{"k":"read","v":{"b":false}}],"id":162},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-05-1"}},{"k":"text","v":{"s":"Sophie: I thought if I asked, the answer might be simple."}},{"k":"read","v":{"b":false}}],"id":163},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-05-2"}},{"k":"text","v":{"s":"Sophie: “Oh, yeah. Daniel and I used to work together.”"}},{"k":"read","v":{"b":false}}],"id":164},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-05-3"}},{"k":"text","v":{"s":"Sophie: Something like that."}},{"k":"read","v":{"b":false}}],"id":165},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-05-5"}},{"k":"text","v":{"s":"Sophie: Sorry. I'm talking as if you already know what's happened."}},{"k":"read","v":{"b":false}}],"id":166},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-C06-a-1"}},{"k":"text","v":{"s":"Sophie: Right."}},{"k":"read","v":{"b":false}}],"id":167},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-06-1"}},{"k":"text","v":{"s":"Sophie: Daniel stopped replying."}},{"k":"read","v":{"b":false}}],"id":168},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-06-2"}},{"k":"text","v":{"s":"Sophie: Messages. Calls."}},{"k":"read","v":{"b":false}}],"id":169},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-06-4"}},{"k":"text","v":{"s":"Sophie: For days now."}},{"k":"read","v":{"b":false}}],"id":170},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-06-5"}},{"k":"text","v":{"s":"Sophie: At first we thought he was busy."}},{"k":"read","v":{"b":false}}],"id":171},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-06-6"}},{"k":"text","v":{"s":"Sophie: Then we thought maybe he wanted space."}},{"k":"read","v":{"b":false}}],"id":172},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-06-8"}},{"k":"text","v":{"s":"Sophie: I don't know what to think anymore."}},{"k":"read","v":{"b":false}}],"id":173},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-C07-a-1"}},{"k":"text","v":{"s":"Sophie: We have tried to check he's safe."}},{"k":"read","v":{"b":false}}],"id":174},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-C07-a-2"}},{"k":"text","v":{"s":"Sophie: I don't want to give you a version of events I'm not sure about."}},{"k":"read","v":{"b":false}}],"id":175},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-07-1"}},{"k":"text","v":{"s":"Sophie: I'm sorry. I should've said that sooner."}},{"k":"read","v":{"b":false}}],"id":176},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-07-2"}},{"k":"text","v":{"s":"Sophie: You don't owe me your time."}},{"k":"read","v":{"b":false}}],"id":177},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-07-3"}},{"k":"text","v":{"s":"Sophie: I haven't even asked what to call you."}},{"k":"read","v":{"b":false}}],"id":178},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-C08-a-1"}},{"k":"text","v":{"s":"Sophie: Alex. Got it."}},{"k":"read","v":{"b":false}}],"id":179},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-C08-a-2"}},{"k":"text","v":{"s":"Sophie: Nice to meet you. In a very odd way."}},{"k":"read","v":{"b":false}}],"id":180},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-08-1"}},{"k":"text","v":{"s":"Sophie: You know what's strange?"}},{"k":"read","v":{"b":false}}],"id":181},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-08-2"}},{"k":"text","v":{"s":"Sophie: I nearly deleted this number."}},{"k":"read","v":{"b":false}}],"id":182},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-08-3"}},{"k":"text","v":{"s":"Sophie: I had my finger over it and everything."}},{"k":"read","v":{"b":false}}],"id":183},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-C09-a-1"}},{"k":"text","v":{"s":"Sophie: I kept thinking: what if this is the one person who can tell us something ordinary and useful?"}},{"k":"read","v":{"b":false}}],"id":184},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-09-1"}},{"k":"text","v":{"s":"Sophie: I didn't want to start believing the star meant something just because I was scared."}},{"k":"read","v":{"b":false}}],"id":185},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-09-2"}},{"k":"text","v":{"s":"Sophie: But I didn't want to delete the question either."}},{"k":"read","v":{"b":false}}],"id":186},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-09-4"}},{"k":"text","v":{"s":"Sophie: There are other people trying to find him."}},{"k":"read","v":{"b":false}}],"id":187},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-09-5"}},{"k":"text","v":{"s":"Sophie: Some of us are talking in a group."}},{"k":"read","v":{"b":false}}],"id":188},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-09-6"}},{"k":"text","v":{"s":"Sophie: Well, arguing in a group, lately."}},{"k":"read","v":{"b":false}}],"id":189},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-C10-a-1"}},{"k":"text","v":{"s":"Sophie: People close to him."}},{"k":"read","v":{"b":false}}],"id":190},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-C10-a-2"}},{"k":"text","v":{"s":"Sophie: I can introduce you properly if you decide to join."}},{"k":"read","v":{"b":false}}],"id":191},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-10-1"}},{"k":"text","v":{"s":"Sophie: I haven't told them I've been messaging you."}},{"k":"read","v":{"b":false}}],"id":192},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-10-2"}},{"k":"text","v":{"s":"Sophie: They knew about the number. Not that I would actually contact it."}},{"k":"read","v":{"b":false}}],"id":193},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-10-4"}},{"k":"text","v":{"s":"Sophie: I'm going to get an earful."}},{"k":"read","v":{"b":false}}],"id":194},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-C11-a-1"}},{"k":"text","v":{"s":"Sophie: That's probably the sensible thing."}},{"k":"read","v":{"b":false}}],"id":195},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-C11-a-2"}},{"k":"text","v":{"s":"Sophie: Sensible hasn't been my strongest quality this week."}},{"k":"read","v":{"b":false}}],"id":196},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-11-1"}},{"k":"text","v":{"s":"Sophie: Could I ask you something slightly unreasonable?"}},{"k":"read","v":{"b":false}}],"id":197},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-11-3"}},{"k":"text","v":{"s":"Sophie: Would you consider joining the chat?"}},{"k":"read","v":{"b":false}}],"id":198},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-11-4"}},{"k":"text","v":{"s":"Sophie: Only to listen at first. If you want."}},{"k":"read","v":{"b":false}}],"id":199},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-11-5"}},{"k":"text","v":{"s":"Sophie: I don't need you to promise you'll solve anything."}},{"k":"read","v":{"b":false}}],"id":200},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-C12-a-1"}},{"k":"text","v":{"s":"Sophie: You can tell us what you do and don't recognise."}},{"k":"read","v":{"b":false}}],"id":201},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-C12-a-2"}},{"k":"text","v":{"s":"Sophie: That alone might stop us making up stories around your number."}},{"k":"read","v":{"b":false}}],"id":202},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-12-1"}},{"k":"text","v":{"s":"Sophie: Look, you can say no."}},{"k":"read","v":{"b":false}}],"id":203},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-12-2"}},{"k":"text","v":{"s":"Sophie: I won't turn it into some kind of test."}},{"k":"read","v":{"b":false}}],"id":204},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-12-3"}},{"k":"text","v":{"s":"Sophie: But if you join, there are people who'll want to ask you questions."}},{"k":"read","v":{"b":false}}],"id":205},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-12-5"}},{"k":"text","v":{"s":"Sophie: One in particular."}},{"k":"read","v":{"b":false}}],"id":206},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-C13-a-1"}},{"k":"text","v":{"s":"Sophie: Okay."}},{"k":"read","v":{"b":false}}],"id":207},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-C13-a-2"}},{"k":"text","v":{"s":"Sophie: Thank you."}},{"k":"read","v":{"b":false}}],"id":208},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-BEFORE-14-1"}},{"k":"text","v":{"s":"Sophie: Fair warning."}},{"k":"read","v":{"b":false}}],"id":209},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-BEFORE-14-2"}},{"k":"text","v":{"s":"Sophie: The group isn't exactly having its finest week."}},{"k":"read","v":{"b":false}}],"id":210},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-BEFORE-14-3"}},{"k":"text","v":{"s":"Sophie: If someone comes across as rude, please don't assume everyone feels the same way."}},{"k":"read","v":{"b":false}}],"id":211},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-C14-a-1"}},{"k":"text","v":{"s":"Sophie: I hope so."}},{"k":"read","v":{"b":false}}],"id":212},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-C14-a-2"}},{"k":"text","v":{"s":"Sophie: I know one who could give lessons."}},{"k":"read","v":{"b":false}}],"id":213},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-14-1"}},{"k":"text","v":{"s":"Sophie: I should tell them first."}},{"k":"read","v":{"b":false}}],"id":214},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-14-3"}},{"k":"text","v":{"s":"Sophie: Actually, if I overthink this I'll never do it."}},{"k":"read","v":{"b":false}}],"id":215},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-INVITATION"}},{"k":"text","v":{"s":"Sophie sent a group invitation"}},{"k":"read","v":{"b":false}}],"id":216},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-OPENING-2"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Okay."}},{"k":"read","v":{"b":false}}],"id":217},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-OPENING-3"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Hi, everyone."}},{"k":"read","v":{"b":false}}],"id":218},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-OPENING-5"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Before anyone gets annoyed with me—"}},{"k":"read","v":{"b":false}}],"id":219},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-OPENING-6"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: That's an interesting way to start a message."}},{"k":"read","v":{"b":false}}],"id":220},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-OPENING-7"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Maya."}},{"k":"read","v":{"b":false}}],"id":221},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-OPENING-8"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: What did you do?"}},{"k":"read","v":{"b":false}}],"id":222},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-OPENING-9"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I invited someone."}},{"k":"read","v":{"b":false}}],"id":223},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-OPENING-11"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Who?"}},{"k":"read","v":{"b":false}}],"id":224},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-OPENING-12"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: The number I told you about."}},{"k":"read","v":{"b":false}}],"id":225},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-OPENING-13"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: The number from the export?"}},{"k":"read","v":{"b":false}}],"id":226},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-OPENING-14"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Yes."}},{"k":"read","v":{"b":false}}],"id":227},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-OPENING-15"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: You contacted it."}},{"k":"read","v":{"b":false}}],"id":228},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-OPENING-16"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I did."}},{"k":"read","v":{"b":false}}],"id":229},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-OPENING-17"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: And invited whoever answered into this chat."}},{"k":"read","v":{"b":false}}],"id":230},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-OPENING-18"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Yes, Lucas."}},{"k":"read","v":{"b":false}}],"id":231},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-OPENING-20"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Soph."}},{"k":"read","v":{"b":false}}],"id":232},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-OPENING-21"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: We agreed we'd talk before adding anyone else."}},{"k":"read","v":{"b":false}}],"id":233},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-OPENING-22"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I know."}},{"k":"read","v":{"b":false}}],"id":234},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-OPENING-23"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I was going to tell you."}},{"k":"read","v":{"b":false}}],"id":235},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-OPENING-24"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: When? After we'd given them the whole family history?"}},{"k":"read","v":{"b":false}}],"id":236},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-OPENING-25"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Lucas."}},{"k":"read","v":{"b":false}}],"id":237},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-OPENING-26"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: It's a genuine question."}},{"k":"read","v":{"b":false}}],"id":238},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-OPENING-27"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: And we can ask it without making someone who just joined regret owning a phone."}},{"k":"read","v":{"b":false}}],"id":239},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-OPENING-29"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Hi, by the way."}},{"k":"read","v":{"b":false}}],"id":240},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-OPENING-30"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: I'm Maya."}},{"k":"read","v":{"b":false}}],"id":241},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-OPENING-31"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Sorry about this."}},{"k":"read","v":{"b":false}}],"id":242},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-OPENING-32"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: I'm Lucas."}},{"k":"read","v":{"b":false}}],"id":243},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-OPENING-33"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: And I'd quite like to know why you're here."}},{"k":"read","v":{"b":false}}],"id":244},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-C01-a-1"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Fair enough."}},{"k":"read","v":{"b":false}}],"id":245},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-C01-a-2"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Doesn't make it a good idea."}},{"k":"read","v":{"b":false}}],"id":246},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-C01-a-3"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I didn't say it was a good idea. I said I wanted to try."}},{"k":"read","v":{"b":false}}],"id":247},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-C01-a-4"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: They're answering what you asked, Lucas."}},{"k":"read","v":{"b":false}}],"id":248},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-AFTER-01-2"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Alright."}},{"k":"read","v":{"b":false}}],"id":249},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-AFTER-01-3"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Simple question."}},{"k":"read","v":{"b":false}}],"id":250},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-AFTER-01-4"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Do you know Daniel Mercer?"}},{"k":"read","v":{"b":false}}],"id":251},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-C02-a-1"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Then why would your number be in his contacts?"}},{"k":"read","v":{"b":false}}],"id":252},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-C02-a-3"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: We can't. That's why we're asking."}},{"k":"read","v":{"b":false}}],"id":253},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-AFTER-02-1"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Here's what bothers me."}},{"k":"read","v":{"b":false}}],"id":254},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-AFTER-02-2"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: There's a phone number in a file."}},{"k":"read","v":{"b":false}}],"id":255},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-AFTER-02-3"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: No name."}},{"k":"read","v":{"b":false}}],"id":256},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-AFTER-02-4"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Someone marked it with a star."}},{"k":"read","v":{"b":false}}],"id":257},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-AFTER-02-5"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: And now the person using that number is sitting in our private group."}},{"k":"read","v":{"b":false}}],"id":258},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-AFTER-02-6"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: You're assuming the file is exactly what it claims to be."}},{"k":"read","v":{"b":false}}],"id":259},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-AFTER-02-7"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: I'm asking whether anyone checked."}},{"k":"read","v":{"b":false}}],"id":260},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-AFTER-02-8"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I looked through it."}},{"k":"read","v":{"b":false}}],"id":261},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-AFTER-02-9"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: That's not quite the same thing."}},{"k":"read","v":{"b":false}}],"id":262},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-AFTER-02-11"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I know."}},{"k":"read","v":{"b":false}}],"id":263},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-AFTER-02-12"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I thought speaking to the person might clear it up."}},{"k":"read","v":{"b":false}}],"id":264},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-AFTER-02-13"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Did it?"}},{"k":"read","v":{"b":false}}],"id":265},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-AFTER-02-14"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: No."}},{"k":"read","v":{"b":false}}],"id":266},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-AFTER-02-15"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: But at least now we know someone actually uses the number."}},{"k":"read","v":{"b":false}}],"id":267},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-AFTER-02-16"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: That isn't what we were trying to establish."}},{"k":"read","v":{"b":false}}],"id":268},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-AFTER-02-17"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Lucas, tell me what you want without turning it into an interrogation."}},{"k":"read","v":{"b":false}}],"id":269},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-AFTER-02-18"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Fine."}},{"k":"read","v":{"b":false}}],"id":270},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-AFTER-02-19"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: I want to know we're not making another mistake."}},{"k":"read","v":{"b":false}}],"id":271},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-AFTER-02-21"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Have you ever spoken to Daniel? Even online?"}},{"k":"read","v":{"b":false}}],"id":272},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-C03-a-1"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Alright."}},{"k":"read","v":{"b":false}}],"id":273},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-C03-a-2"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Then I can't connect you to him."}},{"k":"read","v":{"b":false}}],"id":274},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-C03-a-3"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Neither can we."}},{"k":"read","v":{"b":false}}],"id":275},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-AFTER-03-1"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Sophie, can I ask you to check something?"}},{"k":"read","v":{"b":false}}],"id":276},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-AFTER-03-2"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Yeah."}},{"k":"read","v":{"b":false}}],"id":277},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-AFTER-03-3"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Does the export say when that number was saved?"}},{"k":"read","v":{"b":false}}],"id":278},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-AFTER-03-4"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: No."}},{"k":"read","v":{"b":false}}],"id":279},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-AFTER-03-5"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Or who starred it?"}},{"k":"read","v":{"b":false}}],"id":280},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-AFTER-03-6"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: No."}},{"k":"read","v":{"b":false}}],"id":281},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-AFTER-03-7"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Is there any indication the star was added by Daniel, rather than copied from somewhere else?"}},{"k":"read","v":{"b":false}}],"id":282},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-AFTER-03-8"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Not in the version I have."}},{"k":"read","v":{"b":false}}],"id":283},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-AFTER-03-9"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: That's what I was trying to say."}},{"k":"read","v":{"b":false}}],"id":284},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-AFTER-03-10"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I know, Lucas."}},{"k":"read","v":{"b":false}}],"id":285},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-AFTER-03-11"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I've heard you."}},{"k":"read","v":{"b":false}}],"id":286},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-AFTER-03-12"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Then why do I feel like nobody is listening?"}},{"k":"read","v":{"b":false}}],"id":287},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-AFTER-03-13"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Because you're not the only one who's frightened."}},{"k":"read","v":{"b":false}}],"id":288},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-AFTER-03-15"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: The star made me stop scrolling."}},{"k":"read","v":{"b":false}}],"id":289},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-AFTER-03-16"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: That's all."}},{"k":"read","v":{"b":false}}],"id":290},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-AFTER-03-17"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I saw a number I didn't recognise and hoped it meant something."}},{"k":"read","v":{"b":false}}],"id":291},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-AFTER-03-18"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Maybe I just wanted it to."}},{"k":"read","v":{"b":false}}],"id":292},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-C04-a-1"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I know."}},{"k":"read","v":{"b":false}}],"id":293},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-C04-a-2"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: That would be a really ordinary answer."}},{"k":"read","v":{"b":false}}],"id":294},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-C04-a-3"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I'd like an ordinary answer, actually."}},{"k":"read","v":{"b":false}}],"id":295},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-AFTER-04-1"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: So here's where we are."}},{"k":"read","v":{"b":false}}],"id":296},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-AFTER-04-2"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: We have a number in an export."}},{"k":"read","v":{"b":false}}],"id":297},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-AFTER-04-3"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: We haven't verified where the star came from."}},{"k":"read","v":{"b":false}}],"id":298},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-AFTER-04-4"}},{"k":"text","v"