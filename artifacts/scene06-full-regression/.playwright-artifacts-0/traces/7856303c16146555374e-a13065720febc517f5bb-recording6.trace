k":"id","v":{"s":"OPEN-S02-FINAL-RETURN-10"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: I just said it."}},{"k":"read","v":{"b":false}}],"id":416},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-RETURN-11"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: After we all saw that you'd deleted something."}},{"k":"read","v":{"b":false}}],"id":417},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-RETURN-12"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Lucas."}},{"k":"read","v":{"b":false}}],"id":418},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-RETURN-13"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: What?"}},{"k":"read","v":{"b":false}}],"id":419},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-RETURN-14"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Not every deleted message is a conspiracy."}},{"k":"read","v":{"b":false}}],"id":420},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-RETURN-16"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Can we call it a night?"}},{"k":"read","v":{"b":false}}],"id":421},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-RETURN-17"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: We said that yesterday."}},{"k":"read","v":{"b":false}}],"id":422},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-RETURN-18"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I know."}},{"k":"read","v":{"b":false}}],"id":423},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-RETURN-19"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: And the day before."}},{"k":"read","v":{"b":false}}],"id":424},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-RETURN-20"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: We don't have to solve anything in this chat tonight."}},{"k":"read","v":{"b":false}}],"id":425},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-RETURN-21"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: That's easy to say when nobody will admit we're running out of things to try."}},{"k":"read","v":{"b":false}}],"id":426},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-RETURN-22"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I haven't stopped trying."}},{"k":"read","v":{"b":false}}],"id":427},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-RETURN-23"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: I know you haven't."}},{"k":"read","v":{"b":false}}],"id":428},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-RETURN-24"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: I just don't think all of this is helping."}},{"k":"read","v":{"b":false}}],"id":429},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-RETURN-25"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Then what would help?"}},{"k":"read","v":{"b":false}}],"id":430},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-RETURN-26"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Not inviting people we can't identify into private conversations, for a start."}},{"k":"read","v":{"b":false}}],"id":431},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-RETURN-27"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: They're still here, Lucas."}},{"k":"read","v":{"b":false}}],"id":432},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-RETURN-28"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Yes, I can see that."}},{"k":"read","v":{"b":false}}],"id":433},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-RETURN-29"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Then stop talking as if they aren't."}},{"k":"read","v":{"b":false}}],"id":434},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-RETURN-31"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I thought one more person might make something clearer."}},{"k":"read","v":{"b":false}}],"id":435},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-RETURN-32"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Instead I've made everyone angrier."}},{"k":"read","v":{"b":false}}],"id":436},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-C10-a-1"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: You're right."}},{"k":"read","v":{"b":false}}],"id":437},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-C10-a-2"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I know."}},{"k":"read","v":{"b":false}}],"id":438},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-C10-a-3"}},{"k":"text","v":{"s"