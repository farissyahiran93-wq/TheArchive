d","v":{"b":false}}],"id":486},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-AFTER-11-26"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: No."}},{"k":"read","v":{"b":false}}],"id":487},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-AFTER-11-27"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: I don't."}},{"k":"read","v":{"b":false}}],"id":488},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-AFTER-11-28"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: I just know he cares about Daniel."}},{"k":"read","v":{"b":false}}],"id":489},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-AFTER-11-29"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I know."}},{"k":"read","v":{"b":false}}],"id":490},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-AFTER-11-30"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Sophie, we should talk separately."}},{"k":"read","v":{"b":false}}],"id":491},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-AFTER-11-31"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Can it wait?"}},{"k":"read","v":{"b":false}}],"id":492},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-AFTER-11-32"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Yeah."}},{"k":"read","v":{"b":false}}],"id":493},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-AFTER-11-33"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: It can wait."}},{"k":"read","v":{"b":false}}],"id":494},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-AFTER-11-34"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Thank you."}},{"k":"read","v":{"b":false}}],"id":495},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-AFTER-11-35"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Please get some sleep."}},{"k":"read","v":{"b":false}}],"id":496},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-AFTER-11-36"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: You too."}},{"k":"read","v":{"b":false}}],"id":497},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-AFTER-11-40"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Well."}},{"k":"read","v":{"b":false}}],"id":498},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-AFTER-11-41"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: That went beautifully."}},{"k":"read","v":{"b":false}}],"id":499},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-AFTER-11-42"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I think I deserve some kind of award for making things worse."}},{"k":"read","v":{"b":false}}],"id":500},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-C12-a-1"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: You didn't."}},{"k":"read","v":{"b":false}}],"id":501},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-C12-a-2"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: This didn't start when you arrived."}},{"k":"read","v":{"b":false}}],"id":502},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-C12-a-3"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: You just got the front-row seat."}},{"k":"read","v":{"b":false}}],"id":503},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-AFTER-12-2"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I should explain something to you."}},{"k":"read","v":{"b":false}}],"id":504},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-AFTER-12-3"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Not the whole story."}},{"k":"read","v":{"b":false}}],"id":505},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-AFTER-12-4"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I don't think I even know the whole story."}},{"k":"read","v":{"b":false}}],"id":506},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-AFTER-12-5"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: But enough so you understand why I wrote to you."}},{"k":"read","v":{"b":false}}],"id":507},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-AFTER-12-8"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Could we talk somewhere else?"}},{"k":"read","v":{"b":false}}],"id":508},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-AFTER-12-9"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Just you and me."}},{"k":"read","v":{"b":false}}],"id":509},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-AFTER-12-10"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I don't want to start another argument in here."}},{"k":"read","v":{"b":false}}],"id":510},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-C13-a-1"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Okay."}},{"k":"read","v":{"b":false}}],"id":511},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-C13-a-2"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Thanks."}},{"k":"read","v":{"b":false}}],"id":512},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-AFTER-13-1"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: And, um..."}},{"k":"read","v":{"b":false}}],"id":513},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-AFTER-13-2"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Thanks for staying as long as you did."}},{"k":"read","v":{"b":false}}],"id":514},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-AFTER-13-3"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I know this wasn't what you signed up for."}},{"k":"read","v":{"b":false}}],"id":515},{"o":[{"k":"id","v":{"s":"OPEN-S03-FIRST-MESSAGE"}},{"k":"text","v":{"s":"Sophie: Hey. You got a minute?"}},{"k":"read","v":{"b":false}}],"id":516},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-OPENING-1"}},{"k":"text","v":{"s":"Sophie: Hey."}},{"k":"read","v":{"b":false}}],"id":517},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-OPENING-3"}},{"k":"text","v":{"s":"Sophie: I'm sorry about earlier."}},{"k":"read","v":{"b":false}}],"id":518},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-OPENING-4"}},{"k":"text","v":{"s":"Sophie: Not because Lucas disagreed with me."}},{"k":"read","v":{"b":false}}],"id":519},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-OPENING-5"}},{"k":"text","v":{"s":"Sophie: I knew he would."}},{"k":"read","v":{"b":false}}],"id":520},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-OPENING-7"}},{"k":"text","v":{"s":"Sophie: Because I put you in the middle of it."}},{"k":"read","v":{"b":false}}],"id":521},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-OPENING-9"}},{"k":"text","v":{"s":"Sophie: I could actually feel myself making it worse and somehow kept talking."}},{"k":"read","v":{"b":false}}],"id":522},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-OPENING-10"}},{"k":"text","v":{"s":"Sophie: Impressive, really."}},{"k":"read","v":{"b":false}}],"id":523},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-C01-a-1"}},{"k":"text","v":{"s":"Sophie: Yeah."}},{"k":"read","v":{"b":false}}],"id":524},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-C01-a-2"}},{"k":"text","v":{"s":"Sophie: We usually try to save the group meltdown for the second meeting."}},{"k":"read","v":{"b":false}}],"id":525},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-C01-a-3"}},{"k":"text","v":{"s":"Sophie: Sorry. Bad joke."}},{"k":"read","v":{"b":false}}],"id":526},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-01-1"}},{"k":"text","v":{"s":"Sophie: There's something I should've told you before I invited you."}},{"k":"read","v":{"b":false}}],"id":527},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-01-2"}},{"k":"text","v":{"s":"Sophie: Daniel isn't just someone I'm trying to find."}},{"k":"read","v":{"b":false}}],"id":528},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-01-4"}},{"k":"text","v":{"s":"Sophie: He's my brother."}},{"k":"read","v":{"b":false}}],"id":529},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-01-5"}},{"k":"text","v":{"s":"Sophie: My older brother."}},{"k":"read","v":{"b":false}}],"id":530},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-01-7"}},{"k":"text","v":{"s":"Sophie: That's why I couldn't leave the contact list alone."}},{"k":"read","v":{"b":false}}],"id":531},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-01-9"}},{"k":"text","v":{"s":"Sophie: I wasn't trying to trick you into joining us."}},{"k":"read","v":{"b":false}}],"id":532},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-01-10"}},{"k":"text","v":{"s":"Sophie: I just kept thinking: what if this is the one person I don't ask?"}},{"k":"read","v":{"b":false}}],"id":533},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-C02-a-1"}},{"k":"text","v":{"s":"Sophie: Yeah."}},{"k":"read","v":{"b":false}}],"id":534},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-C02-a-2"}},{"k":"text","v":{"s":"Sophie: I should've led with that."}},{"k":"read","v":{"b":false}}],"id":535},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-02-1"}},{"k":"text","v":{"s":"Sophie: It's funny."}},{"k":"read","v":{"b":false}}],"id":536},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-02-2"}},{"k":"text","v":{"s":"Sophie: I've spent so much time saying his name lately."}},{"k":"read","v":{"b":false}}],"id":537},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-02-3"}},{"k":"text","v":{"s":"Sophie: Daniel did this. Daniel said that. Has anyone heard from Daniel?"}},{"k":"read","v":{"b":false}}],"id":538},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-02-5"}},{"k":"text","v":{"s":"Sophie: I haven't told you what he's actually like."}},{"k":"read","v":{"b":false}}],"id":539},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-02-7"}},{"k":"text","v":{"s":"Sophie: Which is a strange thing to realise when he's the person I've known longest."}},{"k":"read","v":{"b":false}}],"id":540},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-C03-a-1"}},{"k":"text","v":{"s":"Sophie: That's a harder question than it should be."}},{"k":"read","v":{"b":false}}],"id":541},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-C03-a-2"}},{"k":"text","v":{"s":"Sophie: He's thoughtful. And unbelievably annoying."}},{"k":"read","v":{"b":false}}],"id":542},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-03-1"}},{"k":"text","v":{"s":"Sophie: He'll spend an entire afternoon fixing something that would've been cheaper to replace."}},{"k":"read","v":{"b":false}}],"id":543},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-03-2"}},{"k":"text","v":{"s":"Sophie: Then he'll act offended if you suggest it was a waste of time."}},{"k":"read","v":{"b":false}}],"id":544},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-03-3"}},{"k":"text","v":{"s":"Sophie: It's not always easy being his sister."}},{"k":"read","v":{"b":false}}],"id":545},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-03-4"}},{"k":"text","v":{"s":"Sophie: But it is very rarely boring."}},{"k":"read","v":{"b":false}}],"id":546},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-C04-a-1"}},{"k":"text","v":{"s":"Sophie: Incredibly."}},{"k":"read","v":{"b":false}}],"id":547},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-C04-a-2"}},{"k":"text","v":{"s":"Sophie: He'd give you a twenty-minute lecture on why he isn't."}},{"k":"read","v":{"b":false}}],"id":548},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-04-1"}},{"k":"text","v":{"s":"Sophie: And whenever he gets busy, he says the same thing."}},{"k":"read","v":{"b":false}}],"id":549},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-04-2"}},{"k":"text","v":{"s":"Sophie: “I'll explain later.”"}},{"k":"read","v":{"b":false}}],"id":550},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-04-3"}},{"k":"text","v":{"s":"Sophie: It's become a joke between us."}},{"k":"read","v":{"b":false}}],"id":551},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-04-5"}},{"k":"text","v":{"s":"Sophie: It used to be funny."}},{"k":"read","v":{"b":false}}],"id":552},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-04-8"}},{"k":"text","v":{"s":"Sophie: Sorry. That sounds more dramatic than I meant it to."}},{"k":"read","v":{"b":false}}],"id":553},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-04-9"}},{"k":"text","v":{"s":"Sophie: I was going to tell you a better story."}},{"k":"read","v":{"b":false}}],"id":554},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-04-10"}},{"k":"text","v":{"s":"Sophie: One year he told me he couldn't make it to my birthday."}},{"k":"read","v":{"b":false}}],"id":555},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-04-11"}},{"k":"text","v":{"s":"Sophie: He said he was working late."}},{"k":"read","v":{"b":false}}],"id":556},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-04-12"}},{"k":"text","v":{"s":"Sophie: I was furious."}},{"k":"read","v":{"b":false}}],"id":557},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-04-13"}},{"k":"text","v":{"s":"Sophie: Then he turned up after dinner with a cake."}},{"k":"read","v":{"b":false}}],"id":558},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-04-14"}},{"k":"text","v":{"s":"Sophie: The icing had slid to one side."}},{"k":"read","v":{"b":false}}],"id":559},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-04-15"}},{"k":"text","v":{"s":"Sophie: Half of “Happy Birthday” was stuck to the inside of the box."}},{"k":"read","v":{"b":false}}],"id":560},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-04-16"}},{"k":"text","v":{"s":"Sophie: He looked so proud of it. 😭"}},{"k":"read","v":{"b":false}}],"id":561},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-04-18"}},{"k":"text","v":{"s":"Sophie: The cake was leaning. Somehow he was the one acting offended when I laughed."}},{"k":"read","v":{"b":false}}],"id":562},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-C05-a-1"}},{"k":"text","v":{"s":"Sophie: That's exactly what he said!"}},{"k":"read","v":{"b":false}}],"id":563},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-C05-a-2"}},{"k":"text","v":{"s":"Sophie: I swear he practised that line in the car."}},{"k":"read","v":{"b":false}}],"id":564},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-05-2"}},{"k":"text","v":{"s":"Sophie: That's the part I keep thinking about."}},{"k":"read","v":{"b":false}}],"id":565},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-05-3"}},{"k":"text","v":{"s":"Sophie: Daniel always turned up eventually."}},{"k":"read","v":{"b":false}}],"id":566},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-05-4"}},{"k":"text","v":{"s":"Sophie: Late, usually. With a terrible excuse."}},{"k":"read","v":{"b":false}}],"id":567},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-05-5"}},{"k":"text","v":{"s":"Sophie: But he turned up."}},{"k":"read","v":{"b":false}}],"id":568},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-05-7"}},{"k":"text","v":{"s":"Sophie: And now I can't get him to answer one message."}},{"k":"read","v":{"b":false}}],"id":569},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-05-10"}},{"k":"text","v":{"s":"Sophie: Sorry."}},{"k":"read","v":{"b":false}}],"id":570},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-05-11"}},{"k":"text","v":{"s":"Sophie: You didn't come here to be sad with me."}},{"k":"read","v":{"b":false}}],"id":571},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-C06-a-1"}},{"k":"text","v":{"s":"Sophie: A few days without a proper answer."}},{"k":"read","v":{"b":false}}],"id":572},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-C06-a-2"}},{"k":"text","v":{"s":"Sophie: I keep counting them like it'll change something."}},{"k":"read","v":{"b":false}}],"id":573},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-06-1"}},{"k":"text","v":{"s":"Sophie: I've been rereading our last chat."}},{"k":"read","v":{"b":false}}],"id":574},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-06-2"}},{"k":"text","v":{"s":"Sophie: I know it isn't going to grow a new message if I stare long enough."}},{"k":"read","v":{"b":false}}],"id":575},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-06-4"}},{"k":"text","v":{"s":"Sophie: Doesn't stop me."}},{"k":"read","v":{"b":false}}],"id":576},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-06-5"}},{"k":"text","v":{"s":"Sophie: I still know where the conversation ends. Every time I open it."}},{"k":"read","v":{"b":false}}],"id":577},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-06-7"}},{"k":"text","v":{"s":"Sophie: I keep expecting to be wrong."}},{"k":"read","v":{"b":false}}],"id":578},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-C07-a-1"}},{"k":"text","v":{"s":"Sophie: Nothing dramatic."}},{"k":"read","v":{"b":false}}],"id":579},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-C07-a-2"}},{"k":"text","v":{"s":"Sophie: Normal things. That's almost worse."}},{"k":"read","v":{"b":false}}],"id":580},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-07-1"}},{"k":"text","v":{"s":"Sophie: There's somebody else I worry about just as much."}},{"k":"read","v":{"b":false}}],"id":581},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-07-2"}},{"k":"text","v":{"s":"Sophie: Maya."}},{"k":"read","v":{"b":false}}],"id":582},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-07-3"}},{"k":"text","v":{"s":"Sophie: You met her at a pretty terrible moment."}},{"k":"read","v":{"b":false}}],"id":583},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-07-4"}},{"k":"text","v":{"s":"Sophie: She's usually the one with a plan."}},{"k":"read","v":{"b":false}}],"id":584},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-07-5"}},{"k":"text","v":{"s":"Sophie: And a backup plan if the plan goes wrong."}},{"k":"read","v":{"b":false}}],"id":585},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-07-6"}},{"k":"text","v":{"s":"Sophie: She also remembers to feed the rest of us."}},{"k":"read","v":{"b":false}}],"id":586},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-07-7"}},{"k":"text","v":{"s":"Sophie: Which probably sounds like a small thing."}},{"k":"read","v":{"b":false}}],"id":587},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-07-8"}},{"k":"text","v":{"s":"Sophie: Lately it's not."}},{"k":"read","v":{"b":false}}],"id":588},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-C08-a-2"}},{"k":"text","v":{"s":"Sophie: She's Daniel's fiancée."}},{"k":"read","v":{"b":false}}],"id":589},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-C08-a-3"}},{"k":"text","v":{"s":"Sophie: They were planning a wedding."}},{"k":"read","v":{"b":false}}],"id":590},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-08-1"}},{"k":"text","v":{"s":"Sophie: Maya Chen."}},{"k":"read","v":{"b":false}}],"id":591},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-08-2"}},{"k":"text","v":{"s":"Sophie: That's her full name, by the way."}},{"k":"read","v":{"b":false}}],"id":592},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-08-3"}},{"k":"text","v":{"s":"Sophie: She's frighteningly good at spreadsheets."}},{"k":"read","v":{"b":false}}],"id":593},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-08-4"}},{"k":"text","v":{"s":"Sophie: Daniel once said dating her was like having an extremely attractive project manager."}},{"k":"read","v":{"b":false}}],"id":594},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-08-6"}},{"k":"text","v":{"s":"Sophie: He said that in front of her."}},{"k":"read","v":{"b":false}}],"id":595},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-08-7"}},{"k":"text","v":{"s":"Sophie: He was lucky to survive dinner."}},{"k":"read","v":{"b":false}}],"id":596},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-08-9"}},{"k":"text","v":{"s":"Sophie: I can still hear her saying, \"I am not managing you as a project, Daniel.\""}},{"k":"read","v":{"b":false}}],"id":597},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-08-10"}},{"k":"text","v":{"s":"Sophie: He said, \"Well, the results speak for themselves.\""}},{"k":"read","v":{"b":false}}],"id":598},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-08-11"}},{"k":"text","v":{"s":"Sophie: And she threw a napkin at him."}},{"k":"read","v":{"b":false}}],"id":599},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-C09-a-1"}},{"k":"text","v":{"s":"Sophie: As far as I could tell, yes."}},{"k":"read","v":{"b":false}}],"id":600},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-C09-a-2"}},{"k":"text","v":{"s":"Sophie: I wasn't there for every private conversation, though."}},{"k":"read","v":{"b":false}}],"id":601},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-09-1"}},{"k":"text","v":{"s":"Sophie: You probably noticed she deleted a message."}},{"k":"read","v":{"b":false}}],"id":602},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-09-2"}},{"k":"text","v":{"s":"Sophie: In the group."}},{"k":"read","v":{"b":false}}],"id":603},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-09-3"}},{"k":"text","v":{"s":"Sophie: She's been very strict about not calling guesses facts."}},{"k":"read","v":{"b":false}}],"id":604},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-09-4"}},{"k":"text","v":{"s":"Sophie: She said she was trying to put a guess into words and couldn't stand behind it."}},{"k":"read","v":{"b":false}}],"id":605},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-09-5"}},{"k":"text","v":{"s":"Sophie: I only know that because she said it in the chat."}},{"k":"read","v":{"b":false}}],"id":606},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-09-6"}},{"k":"text","v":{"s":"Sophie: I didn't see what she'd deleted."}},{"k":"read","v":{"b":false}}],"id":607},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-C10-a-1"}},{"k":"text","v":{"s":"Sophie: No."}},{"k":"read","v":{"b":false}}],"id":608},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-C10-a-2"}},{"k":"text","v":{"s":"Sophie: And I won't pretend I did."}},{"k":"read","v":{"b":false}}],"id":609},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-10-1"}},{"k":"text","v":{"s":"Sophie: And Lucas..."}},{"k":"read","v":{"b":false}}],"id":610},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-10-3"}},{"k":"text","v":{"s":"Sophie: Where do I even start with Lucas?"}},{"k":"read","v":{"b":false}}],"id":611},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-10-4"}},{"k":"text","v":{"s":"Sophie: He and Daniel have known each other since they were kids."}},{"k":"read","v":{"b":false}}],"id":612},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-10-5"}},{"k":"text","v":{"s":"Sophie: Lucas used to come over so often my mum stopped asking if he was staying for dinner."}},{"k":"read","v":{"b":false}}],"id":613},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-10-6"}},{"k":"text","v":{"s":"Sophie: She just put out another plate."}},{"k":"read","v":{"b":false}}],"id":614},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-10-7"}},{"k":"text","v":{"s":"Sophie: He'd complain about being treated like family."}},{"k":"read","v":{"b":false}}],"id":615},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-10-8"}},{"k":"text","v":{"s":"Sophie: Then turn up the next day anyway."}},{"k":"read","v":{"b":false}}],"id":616},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-10-10"}},{"k":"text","v":{"s":"Sophie: I don't know when the arguing stopped being the fun kind."}},{"k":"read","v":{"b":false}}],"id":617},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-C11-a-1"}},{"k":"text","v":{"s":"Sophie: He is."}},{"k":"read","v":{"b":false}}],"id":618},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-C11-a-2"}},{"k":"text","v":{"s":"Sophie: His timing needs work. So does his delivery."}},{"k":"read","v":{"b":false}}],"id":619},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-11-1"}},{"k":"text","v":{"s":"Sophie: He and Daniel used to fight about music."}},{"k":"read","v":{"b":false}}],"id":620},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-11-2"}},{"k":"text","v":{"s":"Sophie: And football."}},{"k":"read","v":{"b":false}}],"id":621},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-11-3"}},{"k":"text","v":{"s":"Sophie: And things neither of them had the slightest idea about."}},{"k":"read","v":{"b":false}}],"id":622},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-11-4"}},{"k":"text","v":{"s":"Sophie: Then they'd share a pizza an hour later."}},{"k":"read","v":{"b":false}}],"id":623},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-11-6"}},{"k":"text","v":{"s":"Sophie: I think what's hurting Lucas is that Daniel isn't here for them to argue with."}},{"k":"read","v":{"b":false}}],"id":624},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-C12-a-1"}},{"k":"text","v":{"s":"Sophie: I hope so."}},{"k":"read","v":{"b":false}}],"id":625},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-C12-a-2"}},{"k":"text","v":{"s":"Sophie: He left a chat. I don't think he stopped caring."}},{"k":"read","v":{"b":false}}],"id":626},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-12-1"}},{"k":"text","v":{"s":"Sophie: There is someone you haven't really met yet."}},{"k":"read","v":{"b":false}}],"id":627},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-12-2"}},{"k":"text","v":{"s":"Sophie: Eli."}},{"k":"read","v":{"b":false}}],"id":628},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-12-3"}},{"k":"text","v":{"s":"Sophie: She doesn't usually say much in the group."}},{"k":"read","v":{"b":false}}],"id":629},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-12-4"}},{"k":"text","v":{"s":"Sophie: Then she'll respond to a question from six hours ago like it was posted five seconds ago."}},{"k":"read","v":{"b":false}}],"id":630},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-12-5"}},{"k":"text","v":{"s":"Sophie: It's oddly impressive."}},{"k":"read","v":{"b":false}}],"id":631},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-12-6"}},{"k":"text","v":{"s":"Sophie: She once answered a question two days late with \"Technically, no,\" and nothing else."}},{"k":"read","v":{"b":false}}],"id":632},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-12-7"}},{"k":"text","v":{"s":"Sophie: We had to ask her which question she meant."}},{"k":"read","v":{"b":false}}],"id":633},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-C13-a-1"}},{"k":"text","v":{"s":"Sophie: Eli Ward."}},{"k":"read","v":{"b":false}}],"id":634},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-C13-a-2"}},{"k":"text","v":{"s":"Sophie: She works with Daniel at Axiom Recovery."}},{"k":"read","v":{"b":false}}],"id":635},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-13-1"}},{"k":"text","v":{"s":"Sophie: She knows much more about Daniel's work than I do."}},{"k":"read","v":{"b":false}}],"id":636},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-13-2"}},{"k":"text","v":{"s":"Sophie: I'm the person who calls tech support and says, “the thing won't do the thing.”"}},{"k":"read","v":{"b":false}}],"id":637},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-C14-a-1"}},{"k":"text","v":{"s":"Sophie: Where Daniel works."}},{"k":"read","v":{"b":false}}],"id":638},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-C14-a-2"}},{"k":"text","v":{"s":"Sophie: They do data recovery and related technical work."}},{"k":"read","v":{"b":false}}],"id":639},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-C14-a-3"}},{"k":"text","v":{"s":"Sophie: That's about as far as my expertise goes."}},{"k":"read","v":{"b":false}}],"id":640},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-14-1"}},{"k":"text","v":{"s":"Sophie: So that's Maya, Lucas and Eli."}},{"k":"read","v":{"b":false}}],"id":641},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-14-2"}},{"k":"text","v":{"s":"Sophie: In the least useful introduction tour imaginable."}},{"k":"read","v":{"b":false}}],"id":642},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-14-3"}},{"k":"text","v":{"s":"Sophie: They have one thing in common."}},{"k":"read","v":{"b":false}}],"id":643},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-14-4"}},{"k":"text","v":{"s":"Sophie: They want Daniel back."}},{"k":"read","v":{"b":false}}],"id":644},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-14-6"}},{"k":"text","v":{"s":"Sophie: And they disagree about almost everything else."}},{"k":"read","v":{"b":false}}],"id":645},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-14-7"}},{"k":"text","v":{"s":"Sophie: I guess that's what happens when you ask five people to be scared in exactly the same way."}},{"k":"read","v":{"b":false}}],"id":646},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-C15-a-1"}},{"k":"text","v":{"s":"Sophie: She's good at making people feel heard."}},{"k":"read","v":{"b":false}}],"id":647},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-C15-a-2"}},{"k":"text","v":{"s":"Sophie: Unless she's very tired. Then the sarcasm comes out."}},{"k":"read","v":{"b":false}}],"id":648},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-15-1"}},{"k":"text","v":{"s":"Sophie: Including what I say about myself."}},{"k":"read","v":{"b":false}}],"id":649},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-15-2"}},{"k":"text","v":{"s":"Sophie: I'm not some impartial narrator here."}},{"k":"read","v":{"b":false}}],"id":650},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-15-3"}},{"k":"text","v":{"s":"Sophie: I'm his sister."}},{"k":"read","v":{"b":false}}],"id":651},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-15-4"}},{"k":"text","v":{"s":"Sophie: And right now I want anything that might bring him home to mean something."}},{"k":"read","v":{"b":false}}],"id":652},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-PERSONAL"}},{"k":"text","v":{"s":"Sophie: I'm glad you stayed, Alex."}},{"k":"read","v":{"b":false}}],"id":653}],"id":136}},{"k":"settings","v":{"o":[{"k":"reduceMotion","v":{"b":false}}],"id":654}},{"k":"prologue","v":{"o":[{"k":"dialogueVersion","v":{"n":4}},{"k":"stage","v":{"s":"chat"}},{"k":"step","v":{"n":0}},{"k":"messages","v":{"a":[],"id":656}},{"k":"noteSeen","v":{"b":false}},{"k":"offerInspected","v":{"b":false}},{"k":"restored","v":{"b":false}},{"k":"viewed","v":{"a":[],"id":657}},{"k":"indexCompared","v":{"b":false}},{"k":"scene01","v":{"o":[{"k":"version","v":{"n":1}},{"k":"scriptRevision","v":{"s":"final-2026-10-23"}},{"k":"nodeId","v":{"s":"OPEN-S03-FINAL-DISCLOSURE-OFFER"}},{"k":"startedAt","v":{"n":1800000000000}},{"k":"introduced","v":{"b":true}},{"k":"nameDisclosed","v":{"b":true}},{"k":"invitation","v":{"s":"joined"}},{"k":"invitationDismissed","v":{"b":false}},{"k":"complete","v":{"b":true}},{"k":"queue","v":{"a":[],"id":659}},{"k":"messages","v":{"a":[{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-OPENING-1"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Hi."}},{"k":"at","v":{"n":1800000000000}}],"id":661},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-OPENING-3"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Sorry. This is going to sound odd."}},{"k":"at","v":{"n":1800000005801}}],"id":662},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-OPENING-6"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Is this still your number?"}},{"k":"at","v":{"n":1800000013680}}],"id":663},{"o":[{"k":"id","v":{"s":"OPEN-S01-C01-PLAYER-a"}},{"k":"sender","v":{"s":"player"}},{"k":"text","v":{"s":"Who's asking?"}},{"k":"at","v":{"n":1800000013780}}],"id":664},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-C01-a-1"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Fair question."}},{"k":"at","v":{"n":1800000016502}}],"id":665},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-C01-a-2"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"I'm Sophie."}},{"k":"at","v":{"n":1800000019173}}],"id":666},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-C01-a-3"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"And that probably doesn't help much."}},{"k":"at","v":{"n":1800000023015}}],"id":667},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-01-1"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"I don't expect you to know me."}},{"k":"at","v":{"n":1800000027048}}],"id":668},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-01-2"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"I found this number saved somewhere."}},{"k":"at","v":{"n":1800000030890}}],"id":669},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-01-4"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Can I explain?"}},{"k":"at","v":{"n":1800000035680}}],"id":670},{"o":[{"k":"id","v":{"s":"OPEN-S01-C02-PLAYER-a"}},{"k":"sender","v":{"s":"player"}},{"k":"text","v":{"s":"Go ahead."}},{"k":"at","v":{"n":1800000035780}}],"id":671},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-C02-a-1"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Thank you."}},{"k":"at","v":{"n":1800000038434}}],"id":672},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-02-1"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"It's a saved copy of someone's contacts."}},{"k":"at","v":{"n":1800000042637}}],"id":673},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-02-2"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"The file says it belongs to Daniel Mercer."}},{"k":"at","v":{"n":1800000047166}}],"id":674},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-02-3"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"I was looking through it earlier."}},{"k":"at","v":{"n":1800000050957}}],"id":675},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-02-5"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Your number is in there."}},{"k":"at","v":{"n":1800000056402}}],"id":676},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-02-6"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"No name beside it."}},{"k":"at","v":{"n":1800000059753}}],"id":677},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-02-7"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Just a star."}},{"k":"at","v":{"n":1800000062709}}],"id":678},{"o":[{"k":"id","v":{"s":"OPEN-S01-C03-PLAYER-a"}},{"k":"sender","v":{"s":"player"}},{"k":"text","v":{"s":"A star?"}},{"k":"at","v":{"n":1800000062809}}],"id":679},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-C03-a-1"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Yeah. Like a favourite, maybe."}},{"k":"at","v":{"n":1800000066256}}],"id":680},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-C03-a-2"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"But I don't know what that symbol means in this file."}},{"k":"at","v":{"n":1800000071450}}],"id":681},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-03-2"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Do you know Daniel?"}},{"k":"at","v":{"n":1800000077118}}],"id":682},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-03-3"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Daniel Mercer?"}},{"k":"at","v":{"n":1800000079840}}],"id":683},{"o":[{"k":"id","v":{"s":"OPEN-S01-C04-PLAYER-a"}},{"k":"sender","v":{"s":"player"}},{"k":"text","v":{"s":"No. Never heard the name."}},{"k":"at","v":{"n":1800000079940}}],"id":684},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-C04-a-1"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Okay."}},{"k":"at","v":{"n":1800000082509}}],"id":685},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-C04-a-2"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"That was the most likely answer, I suppose."}},{"k":"at","v":{"n":1800000087055}}],"id":686},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-04-1"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Could you think back a little?"}},{"k":"at","v":{"n":1800000090795}}],"id":687},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-04-2"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Even an old online chat. A work message. Anything."}},{"k":"at","v":{"n":1800000095352}}],"id":688},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-04-3"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"I'm not asking you to guess."}},{"k":"at","v":{"n":1800000099058}}],"id":689},{"o":[{"k":"id","v":{"s":"OPEN-S01-C05-PLAYER-a"}},{"k":"sender","v":{"s":"player"}},{"k":"text","v":{"s":"I'm sure I haven't spoken to him."}},{"k":"at","v":{"n":1800000099158}}],"id":690},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-C05-a-1"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Then that's useful to know."}},{"k":"at","v":{"n":1800000102554}}],"id":691},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-05-1"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"I thought if I asked, the answer might be simple."}},{"k":"at","v":{"n":1800000107387}}],"id":692},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-05-2"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"“Oh, yeah. Daniel and I used to work together.”"}},{"k":"at","v":{"n":1800000112294}}],"id":693},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-05-3"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Something like that."}},{"k":"at","v":{"n":1800000115386}}],"id":694},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-05-5"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Sorry. I'm talking as if you already know what's happened."}},{"k":"at","v":{"n":1800000122372}}],"id":695},{"o":[{"k":"id","v":{"s":"OPEN-S01-C06-PLAYER-a"}},{"k":"sender","v":{"s":"player"}},{"k":"text","v":{"s":"Then tell me."}},{"k":"at","v":{"n":1800000122472}}],"id":696},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-C06-a-1"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Right."}},{"k":"at","v":{"n":1800000125058}}],"id":697},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-06-1"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Daniel stopped replying."}},{"k":"at","v":{"n":1800000127817}}],"id":698},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-06-2"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Messages. Calls."}},{"k":"at","v":{"n":1800000130573}}],"id":699},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-06-4"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"For days now."}},{"k":"at","v":{"n":1800000135746}}],"id":700},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-06-5"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"At first we thought he was busy."}},{"k":"at","v":{"n":1800000139813}}],"id":701},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-06-6"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Then we thought maybe he wanted space."}},{"k":"at","v":{"n":1800000143982}}],"id":702},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-06-8"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"I don't know what to think anymore."}},{"k":"at","v":{"n":1800000151600}}],"id":703},{"o":[{"k":"id","v":{"s":"OPEN-S01-C07-PLAYER-a"}},{"k":"sender","v":{"s":"player"}},{"k":"text","v":{"s":"Have you tried checking on him in person?"}},{"k":"at","v":{"n":1800000151700}}],"id":704},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-C07-a-1"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"We have tried to check he's safe."}},{"k":"at","v":{"n":1800000155784}}],"id":705},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-C07-a-2"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"I don't want to give you a version of events I'm not sure about."}},{"k":"at","v":{"n":1800000162043}}],"id":706},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-07-1"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"I'm sorry. I should've said that sooner."}},{"k":"at","v":{"n":1800000166246}}],"id":707},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-07-2"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"You don't owe me your time."}},{"k":"at","v":{"n":1800000169935}}],"id":708},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-07-3"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"I haven't even asked what to call you."}},{"k":"at","v":{"n":1800000174396}}],"id":709},{"o":[{"k":"id","v":{"s":"OPEN-S01-C08-PLAYER-a"}},{"k":"sender","v":{"s":"player"}},{"k":"text","v":{"s":"You can call me Alex."}},{"k":"at","v":{"n":1800000174496}}],"id":710},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-C08-a-1"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Alex. Got it."}},{"k":"at","v":{"n":1800000177622}}],"id":711},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-C08-a-2"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Nice to meet you. In a very odd way."}},{"k":"at","v":{"n":1800000182342}}],"id":712},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-08-1"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"You know what's strange?"}},{"k":"at","v":{"n":1800000185394}}],"id":713},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-08-2"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"I nearly deleted this number."}},{"k":"at","v":{"n":1800000188824}}],"id":714},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-08-3"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"I had my finger over it and everything."}},{"k":"at","v":{"n":1800000193302}}],"id":715},{"o":[{"k":"id","v":{"s":"OPEN-S01-C09-PLAYER-a"}},{"k":"sender","v":{"s":"player"}},{"k":"text","v":{"s":"What changed your mind?"}},{"k":"at","v":{"n":1800000193402}}],"id":716},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-C09-a-1"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"I kept thinking: what if this is the one person who can tell us something ordinary and useful?"}},{"k":"at","v":{"n":1800000200941}}],"id":717},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-09-1"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"I didn't want to start believing the star meant something just because I was scared."}},{"k":"at","v":{"n":1800000207432}}],"id":718},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-09-2"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"But I didn't want to delete the question either."}},{"k":"at","v":{"n":1800000211955}}],"id":719},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-09-4"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"There are other people trying to find him."}},{"k":"at","v":{"n":1800000219184}}],"id":720},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-09-5"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Some of us are talking in a group."}},{"k":"at","v":{"n":1800000223577}}],"id":721},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-09-6"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Well, arguing in a group, lately."}},{"k":"at","v":{"n":1800000227368}}],"id":722},{"o":[{"k":"id","v":{"s":"OPEN-S01-C10-PLAYER-a"}},{"k":"sender","v":{"s":"player"}},{"k":"text","v":{"s":"Who's in it?"}},{"k":"at","v":{"n":1800000227468}}],"id":723},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-C10-a-1"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"People close to him."}},{"k":"at","v":{"n":1800000230853}}],"id":724},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-C10-a-2"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"I can introduce you properly if you decide to join."}},{"k":"at","v":{"n":1800000235720}}],"id":725},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-10-1"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"I haven't told them I've been messaging you."}},{"k":"at","v":{"n":1800000240283}}],"id":726},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-10-2"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"They knew about the number. Not that I would actually contact it."}},{"k":"at","v":{"n":1800000245974}}],"id":727},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-10-4"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"I'm going to get an earful."}},{"k":"at","v":{"n":1800000251263}}],"id":728},{"o":[{"k":"id","v":{"s":"OPEN-S01-C11-PLAYER-a"}},{"k":"sender","v":{"s":"player"}},{"k":"text","v":{"s":"Then maybe talk to them first."}},{"k":"at","v":{"n":1800000251363}}],"id":729},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-C11-a-1"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"That's probably the sensible thing."}},{"k":"at","v":{"n":1800000254895}}],"id":730},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-C11-a-2"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Sensible hasn't been my strongest quality this week."}},{"k":"at","v":{"n":1800000259193}}],"id":731},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-11-1"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Could I ask you something slightly unreasonable?"}},{"k":"at","v":{"n":1800000263131}}],"id":732},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-11-3"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Would you consider joining the chat?"}},{"k":"at","v":{"n":1800000268973}}],"id":733},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-11-4"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Only to listen at first. If you want."}},{"k":"at","v":{"n":1800000273417}}],"id":734},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-11-5"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"I don't need you to promise you'll solve anything."}},{"k":"at","v":{"n":1800000277974}}],"id":735},{"o":[{"k":"id","v":{"s":"OPEN-S01-C12-PLAYER-a"}},{"k":"sender","v":{"s":"player"}},{"k":"text","v":{"s":"Why would I be any use?"}},{"k":"at","v":{"n":1800000278074}}],"id":736},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-C12-a-1"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"You can tell us what you do and don't recognise."}},{"k":"at","v":{"n":1800000282890}}],"id":737},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-C12-a-2"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"That alone might stop us making up stories around your number."}},{"k":"at","v":{"n":1800000288237}}],"id":738},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-12-1"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Look, you can say no."}},{"k":"at","v":{"n":1800000291932}}],"id":739},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-12-2"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"I won't turn it into some kind of test."}},{"k":"at","v":{"n":1800000296703}}],"id":740},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-12-3"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"But if you join, there are people who'll want to ask you questions."}},{"k":"at","v":{"n":1800000302720}}],"id":741},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-12-5"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"One in particular."}},{"k":"at","v":{"n":1800000307378}}],"id":742},{"o":[{"k":"id","v":{"s":"OPEN-S01-C13-PLAYER-a"}},{"k":"sender","v":{"s":"player"}},{"k":"text","v":{"s":"Alright. Send it."}},{"k":"at","v":{"n":1800000307478}}],"id":743},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-C13-a-1"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Okay."}},{"k":"at","v":{"n":1800000310047}}],"id":744},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-C13-a-2"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Thank you."}},{"k":"at","v":{"n":1800000312701}}],"id":745},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-BEFORE-14-1"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Fair warning."}},{"k":"at","v":{"n":1800000315406}}],"id":746},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-BEFORE-14-2"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"The group isn't exactly having its finest week."}},{"k":"at","v":{"n":1800000320020}}],"id":747},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-BEFORE-14-3"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"If someone comes across as rude, please don't assume everyone feels the same way."}},{"k":"at","v":{"n":1800000326167}}],"id":748},{"o":[{"k":"id","v":{"s":"OPEN-S01-C14-PLAYER-a"}},{"k":"sender","v":{"s":"player"}},{"k":"text","v":{"s":"I can handle a rude person."}},{"k":"at","v":{"n":1800000326267}}],"id":749},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-C14-a-1"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"I hope so."}},{"k":"at","v":{"n":1800000329189}}],"id":750},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-C14-a-2"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"I know one who could give lessons."}},{"k":"at","v":{"n":1800000333290}}],"id":751},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-14-1"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"I should tell them first."}},{"k":"at","v":{"n":1800000336652}}],"id":752},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-14-3"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Actually, if I overthink this I'll never do it."}},{"k":"at","v":{"n":1800000342859}}],"id":753},{"o":[{"k":"id","v":{"s":"OPEN-S03-FIRST-MESSAGE"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Hey. You got a minute?"}},{"k":"at","v":{"n":1800001361761}}],"id":754},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-OPENING-1"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Hey."}},{"k":"at","v":{"n":1800001362761}}],"id":755},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-OPENING-3"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"I'm sorry about earlier."}},{"k":"at","v":{"n":1800001365061}}],"id":756},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-OPENING-4"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Not because Lucas disagreed with me."}},{"k":"at","v":{"n":1800001366361}}],"id":757},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-OPENING-5"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"I knew he would."}},{"k":"at","v":{"n":1800001367461}}],"id":758},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-OPENING-7"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Because I put you in the middle of it."}},{"k":"at","v":{"n":1800001370961}}],"id":759},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-OPENING-9"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"I could actually feel myself making it worse and somehow kept talking."}},{"k":"at","v":{"n":1800001375261}}],"id":760},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-OPENING-10"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Impressive, really."}},{"k":"at","v":{"n":1800001376161}}],"id":761},{"o":[{"k":"id","v":{"s":"OPEN-S03-C01-PLAYER-a"}},{"k":"sender","v":{"s":"player"}},{"k":"text","v":{"s":"That was a lot for a first meeting."}},{"k":"at","v":{"n":1800001376261}}],"id":762},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-C01-a-1"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Yeah."}},{"k":"at","v":{"n":1800001377161}}],"id":763},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-C01-a-2"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"We usually try to save the group meltdown for the second meeting."}},{"k":"at","v":{"n":1800001379061}}],"id":764},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-C01-a-3"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Sorry. Bad joke."}},{"k":"at","v":{"n":1800001380061}}],"id":765},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-01-1"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"There's something I should've told you before I invited you."}},{"k":"at","v":{"n":1800001381761}}],"id":766},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-01-2"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Daniel isn't just someone I'm trying to find."}},{"k":"at","v":{"n":1800001383261}}],"id":767},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-01-4"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"He's my brother."}},{"k":"at","v":{"n":1800001387261}}],"id":768},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-01-5"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"My older brother."}},{"k":"at","v":{"n":1800001388261}}],"id":769},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-01-7"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"That's why I couldn't leave the contact list alone."}},{"k":"at","v":{"n":1800001391861}}],"id":770},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-01-9"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"I wasn't trying to trick you into joining us."}},{"k":"at","v":{"n":1800001395461}}],"id":771},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-01-10"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"I just kept thinking: what if this is the one person I don't ask?"}},{"k":"at","v":{"n":1800001397561}}],"id":772},{"o":[{"k":"id","v":{"s":"OPEN-S03-C02-PLAYER-a"}},{"k":"sender","v":{"s":"player"}},{"k":"text","v":{"s":"Daniel is your brother?"}},{"k":"at","v":{"n":1800001397661}}],"id":773},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-C02-a-1"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Yeah."}},{"k":"at","v":{"n":1800001398561}}],"id":774},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-C02-a-2"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"I should've led with that."}},{"k":"at","v":{"n":1800001399761}}],"id":775},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-02-1"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"It's funny."}},{"k":"at","v":{"n":1800001400661}}],"id":776},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-02-2"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"I've spent so much time saying his name lately."}},{"k":"at","v":{"n":1800001402261}}],"id":777},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-02-3"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Daniel did this. Daniel said that. Has anyone heard from Daniel?"}},{"k":"at","v":{"n":1800001404061}}],"id":778},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-02-5"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"I haven't told you what he's actually like."}},{"k":"at","v":{"n":1800001407661}}],"id":779},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-02-7"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Which is a strange thing to realise when he's the person I've known longest."}},{"k":"at","v":{"n":1800001411761}}],"id":780},{"o":[{"k":"id","v":{"s":"OPEN-S03-C03-PLAYER-a"}},{"k":"sender","v":{"s":"player"}},{"k":"text","v":{"s":"Tell me about him."}},{"k":"at","v":{"n":1800001411861}}],"id":781},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-C03-a-1"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"That's a harder question than it should be."}},{"k":"at","v":{"n":1800001413361}}],"id":782},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-C03-a-2"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"He's thoughtful. And unbelievably annoying."}},{"k":"at","v":{"n":1800001414561}}],"id":783},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-03-1"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"He'll spend an entire afternoon fixing something that would've been cheaper to replace."}},{"k":"at","v":{"n":1800001416561}}],"id":784},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-03-2"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Then he'll act offended if you suggest it was a waste of time."}},{"k":"at","v":{"n":1800001418561}}],"id":785},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-03-3"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"It's not always easy being his sister."}},{"k":"at","v":{"n":1800001419961}}],"id":786},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-03-4"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"But it is very rarely boring."}},{"k":"at","v":{"n":1800001421261}}],"id":787},{"o":[{"k":"id","v":{"s":"OPEN-S03-C04-PLAYER-a"}},{"k":"sender","v":{"s":"player"}},{"k":"text","v":{"s":"He sounds stubborn."}},{"k":"at","v":{"n":1800001421361}}],"id":788},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-C04-a-1"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Incredibly."}},{"k":"at","v":{"n":1800001422261}}],"id":789},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-C04-a-2"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"He'd give you a twenty-minute lecture on why he isn't."}},{"k":"at","v":{"n":1800001423961}}],"id":790},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-04-1"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"And whenever he gets busy, he says the same thing."}},{"k":"at","v":{"n":1800001425661}}],"id":791},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-04-2"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"“I'll explain later.”"}},{"k":"at","v":{"n":1800001426661}}],"id":792},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-04-3"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"It's become a joke between us."}},{"k":"at","v":{"n":1800001427961}}],"id":793},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-04-5"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"It used to be funny."}},{"k":"at","v":{"n":1800001432161}}],"id":794},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-04-8"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Sorry. That sounds more dramatic than I meant it to."}},{"k":"at","v":{"n":1800001438061}}],"id":795},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-04-9"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"I was going to tell you a better story."}},{"k":"at","v":{"n":1800001439661}}],"id":796},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-04-10"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"One year he told me he couldn't make it to my birthday."}},{"k":"at","v":{"n":1800001441561}}],"id":797},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-04-11"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"He said he was working late."}},{"k":"at","v":{"n":1800001442861}}],"id":798},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-04-12"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"I was furious."}},{"k":"at","v":{"n":1800001443861}}],"id":799},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-04-13"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Then he turned up after dinner with a cake."}},{"k":"at","v":{"n":1800001445461}}],"id":800},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-04-14"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"The icing had slid to one side."}},{"k":"at","v":{"n":1800001446861}}],"id":801},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-04-15"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Half of “Happy Birthday” was stuck to the inside of the box."}},{"k":"at","v":{"n":1800001448761}}],"id":802},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-04-16"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"He looked so proud of it. 😭"}},{"k":"at","v":{"n":1800001450161}}],"id":803},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-04-18"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"The cake was leaning. Somehow he was the one acting offended when I laughed."}},{"k":"at","v":{"n":1800001453861}}],"id":804},{"o":[{"k":"id","v":{"s":"OPEN-S03-C05-PLAYER-a"}},{"k":"sender","v":{"s":"player"}},{"k":"text","v":{"s":"It's the thought that counts."}},{"k":"at","v":{"n":1800001453961}}],"id":805},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-C05-a-1"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"That's exactly what he said!"}},{"k":"at","v":{"n":1800001455161}}],"id":806},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-C05-a-2"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"I swear he practised that line in the car."}},{"k":"at","v":{"n":1800001456761}}],"id":807},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-05-2"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"That's the part I keep thinking about."}},{"k":"at","v":{"n":1800001462161}}],"id":808},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-05-3"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Daniel always turned up eventually."}},{"k":"at","v":{"n":1800001463361}}],"id":809},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-05-4"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Late, usually. With a terrible excuse."}},{"k":"at","v":{"n":1800001464661}}],"id":810},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-05-5"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"But he turned up."}},{"k":"at","v":{"n":1800001465761}}],"id":811},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-05-7"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"And now I can't get him to answer one message."}},{"k":"at","v":{"n":1800001469661}}],"id":812},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-05-10"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Sorry."}},{"k":"at","v":{"n":1800001476561}}],"id":813},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-05-11"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"You didn't come here to be sad with me."}},{"k":"at","v":{"n":1800001478161}}],"id":814},{"o":[{"k":"id","v":{"s":"OPEN-S03-C06-PLAYER-a"}},{"k":"sender","v":{"s":"player"}},{"k":"text","v":{"s":"How long has it been?"}},{"k":"at","v":{"n":1800001478261}}],"id":815},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-C06-a-1"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"A few days without a proper answer."}},{"k":"at","v":{"n":1800001479661}}],"id":816},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-C06-a-2"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"I keep counting them like it'll change something."}},{"k":"at","v":{"n":1800001481161}}],"id":817},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-06-1"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"I've been rereading our last chat."}},{"k":"at","v":{"n":1800001482461}}],"id":818},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-06-2"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"I know it isn't going to grow a new message if I stare long enough."}},{"k":"at","v":{"n":1800001484661}}],"id":819},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-06-4"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Doesn't stop me."}},{"k":"at","v":{"n":1800001487861}}],"id":820},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-06-5"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"I still know where the conversation ends. Every time I open it."}},{"k":"at","v":{"n":1800001489761}}],"id":821},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-06-7"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"I keep expecting to be wrong."}},{"k":"at","v":{"n":1800001493561}}],"id":822},{"o":[{"k":"id","v":{"s":"OPEN-S03-C07-PLAYER-a"}},{"k":"sender","v":{"s":"player"}},{"k":"text","v":{"s":"What did he say?"}},{"k":"at","v":{"n":1800001493661}}],"id":823},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-C07-a-1"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Nothing dramatic."}},{"k":"at","v":{"n":1800001494561}}],"id":824},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-C07-a-2"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Normal things. That's almost worse."}},{"k":"at","v":{"n":1800001495761}}],"id":825},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-07-1"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"There's somebody else I worry about just as much."}},{"k":"at","v":{"n":1800001497361}}],"id":826},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-07-2"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Maya."}},{"k":"at","v":{"n":1800001498261}}],"id":827},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-07-3"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"You met her at a pretty terrible moment."}},{"k":"at","v":{"n":1800001499761}}],"id":828},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-07-4"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"She's usually the one with a plan."}},{"k":"at","v":{"n":1800001501161}}],"id":829},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-07-5"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"And a backup plan if the plan goes wrong."}},{"k":"at","v":{"n":1800001502761}}],"id":830},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-07-6"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"She also remembers to feed the rest of us."}},{"k":"at","v":{"n":1800001504361}}],"id":831},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-07-7"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Which probably sounds like a small thing."}},{"k":"at","v":{"n":1800001505761}}],"id":832},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-07-8"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Lately it's not."}},{"k":"at","v":{"n":1800001506761}}],"id":833},{"o":[{"k":"id","v":{"s":"OPEN-S03-C08-PLAYER-a"}},{"k":"sender","v":{"s":"player"}},{"k":"text","v":{"s":"Why is this so personal for her?"}},{"k":"at","v":{"n":1800001506861}}],"id":834},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-C08-a-2"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"She's Daniel's fiancée."}},{"k":"at","v":{"n":1800001510661}}],"id":835},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-C08-a-3"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"They were planning a wedding."}},{"k":"at","v":{"n":1800001511861}}],"id":836},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-08-1"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Maya Chen."}},{"k":"at","v":{"n":1800001512761}}],"id":837},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-08-2"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"That's her full name, by the way."}},{"k":"at","v":{"n":1800001514161}}],"id":838},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-08-3"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"She's frighteningly good at spreadsheets."}},{"k":"at","v":{"n":1800001515361}}],"id":839},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-08-4"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Daniel once said dating her was like having an extremely attractive project manager."}},{"k":"at","v":{"n":1800001517361}}],"id":840},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-08-6"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"He said that in front of her."}},{"k":"at","v":{"n":1800001520861}}],"id":841},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-08-7"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"He was lucky to survive dinner."}},{"k":"at","v":{"n":1800001522161}}],"id":842},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-08-9"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"I can still hear her saying, \"I am not managing you as a project, Daniel.\""}},{"k":"at","v":{"n":1800001526361}}],"id":843},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-08-10"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"He said, \"Well, the results speak for themselves.\""}},{"k":"at","v":{"n":1800001527861}}],"id":844},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-08-11"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"And she threw a napkin at him."}},{"k":"at","v":{"n":1800001529261}}],"id":845},{"o":[{"k":"id","v":{"s":"OPEN-S03-C09-PLAYER-a"}},{"k":"sender","v":{"s":"player"}},{"k":"text","v":{"s":"Did they seem happy together?"}},{"k":"at","v":{"n":1800001529361}}],"id":846},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-C09-a-1"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"As far as I could tell, yes."}},{"k":"at","v":{"n":1800001530761}}],"id":847},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-C09-a-2"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"I wasn't there for every private conversation, though."}},{"k":"at","v":{"n":1800001532261}}],"id":848},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-09-1"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"You probably noticed she deleted a message."}},{"k":"at","v":{"n":1800001533661}}],"id":849},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-09-2"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"In the group."}},{"k":"at","v":{"n":1800001534661}}],"id":850},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-09-3"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"She's been very strict about not calling guesses facts."}},{"k":"at","v":{"n":1800001536261}}],"id":851},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-09-4"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"She said she was trying to put a guess into words and couldn't stand behind it."}},{"k":"at","v":{"n":1800001538561}}],"id":852},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-09-5"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"I only know that because she said it in the chat."}},{"k":"at","v":{"n":1800001540361}}],"id":853},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-09-6"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"I didn't see what she'd deleted."}},{"k":"at","v":{"n":1800001541661}}],"id":854},{"o":[{"k":"id","v":{"s":"OPEN-S03-C10-PLAYER-a"}},{"k":"sender","v":{"s":"player"}},{"k":"text","v":{"s":"Did you see what it said?"}},{"k":"at","v":{"n":1800001541761}}],"id":855},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-C10-a-1"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"No."}},{"k":"at","v":{"n":1800001542661}}],"id":856},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-C10-a-2"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"And I won't pretend I did."}},{"k":"at","v":{"n":1800001543961}}],"id":857},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-10-1"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"And Lucas..."}},{"k":"at","v":{"n":1800001544861}}],"id":858},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-10-3"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Where do I even start with Lucas?"}},{"k":"at","v":{"n":1800001548261}}],"id":859},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-10-4"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"He and Daniel have known each other since they were kids."}},{"k":"at","v":{"n":1800001550061}}],"id":860},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-10-5"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Lucas used to come over so often my mum stopped asking if he was staying for dinner."}},{"k":"at","v":{"n":1800001552461}}],"id":861},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-10-6"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"She just put out another plate."}},{"k":"at","v":{"n":1800001553761}}],"id":862},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-10-7"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"He'd complain about being treated like family."}},{"k":"at","v":{"n":1800001555161}}],"id":863},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-10-8"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Then turn up the next day anyway."}},{"k":"at","v":{"n":1800001556561}}],"id":864},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-10-10"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"I don't know when the arguing stopped being the fun kind."}},{"k":"at","v":{"n":1800001560361}}],"id":865},{"o":[{"k":"id","v":{"s":"OPEN-S03-C11-PLAYER-a"}},{"k":"sender","v":{"s":"player"}},{"k":"text","v":{"s":"He sounded very protective."}},{"k":"at","v":{"n":1800001560461}}],"id":866},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-C11-a-1"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"He is."}},{"k":"at","v":{"n":1800001561361}}],"id":867},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-C11-a-2"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"His timing needs work. So does his delivery."}},{"k":"at","v":{"n":1800001562861}}],"id":868},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-11-1"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"He and Daniel used to fight about music."}},{"k":"at","v":{"n":1800001564361}}],"id":869},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-11-2"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"And football."}},{"k":"at","v":{"n":1800001565261}}],"id":870},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-11-3"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"And things neither of them had the slightest idea about."}},{"k":"at","v":{"n":1800001566961}}],"id":871},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-11-4"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Then they'd share a pizza an hour later."}},{"k":"at","v":{"n":1800001568461}}],"id":872},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-11-6"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"I think what's hurting Lucas is that Daniel isn't here for them to argue with."}},{"k":"at","v":{"n":1800001572961}}],"id":873},{"o":[{"k":"id","v":{"s":"OPEN-S03-C12-PLAYER-a"}},{"k":"sender","v":{"s":"player"}},{"k":"text","v":{"s":"Do you think he'll come back?"}},{"k":"at","v":{"n":1800001573061}}],"id":874},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-C12-a-1"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"I hope so."}},{"k":"at","v":{"n":1800001574061}}],"id":875},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-C12-a-2"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"He left a chat. I don't think he stopped caring."}},{"k":"at","v":{"n":1800001575761}}],"id":876},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-12-1"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"There is someone you haven't really met yet."}},{"k":"at","v":{"n":1800001577261}}],"id":877},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-12-2"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Eli."}},{"k":"at","v":{"n":1800001578161}}],"id":878},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-12-3"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"She doesn't usually say much in the group."}},{"k":"at","v":{"n":1800001579661}}],"id":879},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-12-4"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Then she'll respond to a question from six hours ago like it was posted five seconds ago."}},{"k":"at","v":{"n":1800001582061}}],"id":880},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-12-5"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"It's oddly impressive."}},{"k":"at","v":{"n":1800001583061}}],"id":881},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-12-6"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"She once answered a question two days late with \"Technically, no,\" and nothing else."}},{"k":"at","v":{"n":1800001585161}}],"id":882},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-12-7"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"We had to ask her which question she meant."}},{"k":"at","v":{"n":1800001586761}}],"id":883},{"o":[{"k":"id","v":{"s":"OPEN-S03-C13-PLAYER-a"}},{"k":"sender","v":{"s":"player"}},{"k":"text","v":{"s":"Who is she?"}},{"k":"at","v":{"n":1800001586861}}],"id":884},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-C13-a-1"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Eli Ward."}},{"k":"at","v":{"n":1800001587761}}],"id":885},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-C13-a-2"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"She works with Daniel at Axiom Recovery."}},{"k":"at","v":{"n":1800001589161}}],"id":886},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-13-1"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"She knows much more about Daniel's work than I do."}},{"k":"at","v":{"n":1800001590861}}],"id":887},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-AFTER-13-2"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"I'm the person who calls tech support and says, “the thing won't do the thing.”"}},{"k":"at","v":{"n":1800001593061}}],"id":888},{"o":[{"k":"id","v":{"s":"OPEN-S03-C14-PLAYER-a"}},{"k":"sender","v":{"s":"player"}},{"k":"text","v":{"s":"What's Axiom Recovery?"}},{"k":"at","v":{"n":1800001593161}}],"id":889},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-C14-a-1"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Where Daniel works."}},{"k":"at","v":{"n":1800001594161}}],"id":890},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-C14-a-2"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"They do data recovery and related technical work."}},{"k":"at","v":{"n":1800001595661}}],"id":891},{"o":[{"k":"id","v":{"s":"OPEN-S03-FINAL-C14-a-3"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"That's about as far as my expertise goes."}},{"k":"at","v":{"n":1800001597161}}],"id"