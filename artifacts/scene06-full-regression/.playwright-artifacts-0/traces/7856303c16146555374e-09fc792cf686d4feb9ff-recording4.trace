-shadow:0 7px 15px #14253255,inset 0 1px #fff4;color:#fff;transition:transform .2s ease}.app-tile:hover .app-icon,.dock button:hover .app-icon{transform:translateY(-3px)}.app-icon.peach{background:linear-gradient(145deg,#d79676,#a95f61)}.app-icon.blue{background:linear-gradient(145deg,#508ba6,#315f86)}.app-icon.sand{background:linear-gradient(145deg,#d5bc87,#917d62)}.app-icon.green{background:linear-gradient(145deg,#71ae9c,#28766f)}.app-icon.violet{background:linear-gradient(145deg,#958ac7,#5c5b99)}.badge{position:absolute;right:-5px;top:-6px;min-width:20px;height:20px;padding:0 4px;border-radius:12px;background:#f0ad72;color:#152537;border:2px solid #fff;display:grid;place-items:center;font-size:10px;text-shadow:none}.home-lock-note{display:flex;align-items:center;gap:6px;font-size:11px;color:#e7eded;margin:22px 6px}.home-bottom{position:relative;flex:none;padding:5px 19px 13px}.page-indicators{display:flex;justify-content:center;gap:7px;margin:0 0 11px}.page-indicators button{width:9px;height:9px;border-radius:50%;border:0;background:#ffffff77;padding:0}.page-indicators button.active{width:23px;border-radius:6px;background:#fff}.dock{display:flex;justify-content:space-around;align-items:center;padding:10px 12px;background:#dbe7eb40;border:1px solid #fff5;backdrop-filter:blur(18px);border-radius:25px;box-shadow:0 10px 28px #0b1f2d40}.dock button{padding:0;border:0;background:none;min-width:60px;min-height:58px;display:grid;place-items:center}\n.app-header,.chat-header{flex:none;display:flex;align-items:center;gap:12px;min-height:79px;padding:10px 17px;border-bottom:1px solid var(--line);background:var(--header)}.app-header h1{font-size:24px;line-height:1.05;letter-spacing:-.03em;margin:2px 0 0}.app-header p{font-size:9px;letter-spacing:.14em;font-weight:800;color:var(--accent);margin:0}.icon-button{display:grid;place-items:center;border:0;border-radius:12px;min-width:44px;min-height:44px;color:var(--accent);background:var(--raised)}.icon-button.bare{background:tran