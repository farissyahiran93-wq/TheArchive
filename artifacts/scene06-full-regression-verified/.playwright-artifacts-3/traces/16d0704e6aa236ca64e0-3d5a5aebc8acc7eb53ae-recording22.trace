:"text","v":{"s":"FIND DANIEL · Maya: Listen."}},{"k":"read","v":{"b":false}}],"id":389},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-06-3"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: I'm not going to pretend this isn't strange."}},{"k":"read","v":{"b":false}}],"id":390},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-06-4"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: I don't know you."}},{"k":"read","v":{"b":false}}],"id":391},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-06-5"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: And I don't know what your number means."}},{"k":"read","v":{"b":false}}],"id":392},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-06-6"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: But I also don't think it's fair to assume the worst just because we don't have an answer."}},{"k":"read","v":{"b":false}}],"id":393},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-06-7"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: That goes both ways."}},{"k":"read","v":{"b":false}}],"id":394},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-06-8"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: It does."}},{"k":"read","v":{"b":false}}],"id":395},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-06-9"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Fine."}},{"k":"read","v":{"b":false}}],"id":396},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-06-11"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Then answer one thing."}},{"k":"read","v":{"b":false}}],"id":397},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-06-12"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Why are you still here?"}},{"k":"read","v":{"b":false}}],"id":398},{"o":[{"k":"id","v":{"s":"OPEN-S02-C07-a-1"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Okay."}},{"k":"read","v":{"b":false}}],"id":399},{"o":[{"k":"id","v":{"s":"OPEN-S02-C07-a-2"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: That's a fair answer."}},{"k":"read","v":{"b":false}}],"id":400},{"o":[{"k":"id","v":{"s":"OPEN-S02-C07-a-3"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: You're going to need a better reason eventually."}},{"k":"read","v":{"b":false}}],"id":401},{"o":[{"k":"id","v":{"s":"OPEN-S02-C07-a-4"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: They don't owe us a lifelong commitment, Lucas."}},{"k":"read","v":{"b":false}}],"id":402},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-2"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Okay, I'm back."}},{"k":"read","v":{"b":false}}],"id":403},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-3"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: What did I miss?"}},{"k":"read","v":{"b":false}}],"id":404},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-4"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Nothing."}},{"k":"read","v":{"b":false}}],"id":405},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-5"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Plenty."}},{"k":"read","v":{"b":false}}],"id":406},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-6"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: ..."}},{"k":"read","v":{"b":false}}],"id":407},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-7"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Oh no."}},{"k":"read","v":{"b":false}}],"id":408},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-8"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Please tell me you didn't start another argument."}},{"k":"read","v":{"b":false}}],"id":409},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-9"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: We were having a conversation."}},{"k":"read","v":{"b":false}}],"id":410},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-10"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: A very educational one."}},{"k":"read","v":{"b":false}}],"id":411},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-11"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Lucas."}},{"k":"read","v":{"b":false}}],"id":412},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-12"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Sophie."}},{"k":"read","v":{"b":false}}],"id":413},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-13"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Children."}},{"k":"read","v":{"b":false}}],"id":414},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-14"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: 🙄"}},{"k":"read","v":{"b":false}}],"id":415},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-16"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Look, I know adding someone without asking wasn't ideal."}},{"k":"read","v":{"b":false}}],"id":416},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-17"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: It wasn't ideal?"}},{"k":"read","v":{"b":false}}],"id":417},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-18"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Fine."}},{"k":"read","v":{"b":false}}],"id":418},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-19"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: It was a bad call."}},{"k":"read","v":{"b":false}}],"id":419},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-20"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Is that what you want me to say?"}},{"k":"read","v":{"b":false}}],"id":420},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-21"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: I want you to understand why it was a bad call."}},{"k":"read","v":{"b":false}}],"id":421},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-22"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I understand."}},{"k":"read","v":{"b":false}}],"id":422},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-23"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Then why did you do it?"}},{"k":"read","v":{"b":false}}],"id":423},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-24"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Because I'm tired of sitting here doing nothing!"}},{"k":"read","v":{"b":false}}],"id":424},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-26"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Sorry."}},{"k":"read","v":{"b":false}}],"id":425},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-27"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I didn't mean to snap."}},{"k":"read","v":{"b":false}}],"id":426},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-28"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: It's okay."}},{"k":"read","v":{"b":false}}],"id":427},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-29"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: No, it's not."}},{"k":"read","v":{"b":false}}],"id":428},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-30"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Lucas..."}},{"k":"read","v":{"b":false}}],"id":429},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-31"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: We're making decisions because we're scared."}},{"k":"read","v":{"b":false}}],"id":430},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-32"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: And we don't even know what we're risking."}},{"k":"read","v":{"b":false}}],"id":431},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-33"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I know!"}},{"k":"read","v":{"b":false}}],"id":432},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-34"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Do you think I don't think about that?"}},{"k":"read","v":{"b":false}}],"id":433},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-35"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Then start acting like it."}},{"k":"read","v":{"b":false}}],"id":434},{"o":[{"k":"id","v":{"s":"OPEN-S02-C08-a-1"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: No."}},{"k":"read","v":{"b":false}}],"id":435},{"o":[{"k":"id","v":{"s":"OPEN-S02-C08-a-2"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: That's not what I want."}},{"k":"read","v":{"b":false}}],"id":436},{"o":[{"k":"id","v":{"s":"OPEN-S02-C08-a-3"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: And we haven't asked you to leave."}},{"k":"read","v":{"b":false}}],"id":437},{"o":[{"k":"id","v":{"s":"OPEN-S02-C08-a-4"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: I might."}},{"k":"read","v":{"b":false}}],"id":438},{"o":[{"k":"id","v":{"s":"OPEN-S02-C08-a-5"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Lucas."}},{"k":"read","v":{"b":false}}],"id":439},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-2"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Fine."}},{"k":"read","v":{"b":false}}],"id":440},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-3"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: What do you want me to do?"}},{"k":"read","v":{"b":false}}],"id":441},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-4"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: I want us to stop sharing things until we know who we're sharing them with."}},{"k":"read","v":{"b":false}}],"id":442},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-5"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: That seems reasonable."}},{"k":"read","v":{"b":false}}],"id":443},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-6"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: So what?"}},{"k":"read","v":{"b":false}}],"id":444},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-7"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: We just ignore the number?"}},{"k":"read","v":{"b":false}}],"id":445},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-8"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: No."}},{"k":"read","v":{"b":false}}],"id":446},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-9"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: We verify it."}},{"k":"read","v":{"b":false}}],"id":447},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-10"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: How?"}},{"k":"read","v":{"b":false}}],"id":448},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-11"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: I don't know yet."}},{"k":"read","v":{"b":false}}],"id":449},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-12"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Exactly."}},{"k":"read","v":{"b":false}}],"id":450},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-13"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Not knowing how to do something doesn't mean we should do the first thing that comes to mind."}},{"k":"read","v":{"b":false}}],"id":451},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-14"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: And waiting doesn't guarantee we'll learn anything!"}},{"k":"read","v":{"b":false}}],"id":452},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-16"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Can both of you stop for a second?"}},{"k":"read","v":{"b":false}}],"id":453},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-17"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Sorry."}},{"k":"read","v":{"b":false}}],"id":454},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-18"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: I'm listening."}},{"k":"read","v":{"b":false}}],"id":455},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-19"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Nobody here knows what happened to Daniel."}},{"k":"read","v":{"b":false}}],"id":456},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-20"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: We keep going in circles."}},{"k":"read","v":{"b":false}}],"id":457},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-21"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: We don't even agree about what happened that night."}},{"k":"read","v":{"b":false}}],"id":458},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-22"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Maya."}},{"k":"read","v":{"b":false}}],"id":459},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-23"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: What?"}},{"k":"read","v":{"b":false}}],"id":460},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-24"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Don't."}},{"k":"read","v":{"b":false}}],"id":461},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-26"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: She's right."}},{"k":"read","v":{"b":false}}],"id":462},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-27"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: ..."}},{"k":"read","v":{"b":false}}],"id":463},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-28"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: We keep acting like we have all these answers."}},{"k":"read","v":{"b":false}}],"id":464},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-29"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: But we don't."}},{"k":"read","v":{"b":false}}],"id":465},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-30"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Can we please not do this right now?"}},{"k":"read","v":{"b":false}}],"id":466},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-31"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: I'm not trying to start anything."}},{"k":"read","v":{"b":false}}],"id":467},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-32"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: I'm just saying we need to stop mixing up what we know and what we think we know."}},{"k":"read","v":{"b":false}}],"id":468},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-33"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Exactly."}},{"k":"read","v":{"b":false}}],"id":469},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-35"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Okay."}},{"k":"read","v":{"b":false}}],"id":470},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-36"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: You're right."}},{"k":"read","v":{"b":false}}],"id":471},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-37"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Both of you."}},{"k":"read","v":{"b":false}}],"id":472},{"o":[{"k":"id","v":{"s":"OPEN-S02-C09-a-1"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: That's what we're trying to establish."}},{"k":"read","v":{"b":false}}],"id":473},{"o":[{"k":"id","v":{"s":"OPEN-S02-C09-a-2"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Which is why we shouldn't be discussing it with someone we just met."}},{"k":"read","v":{"b":false}}],"id":474},{"o":[{"k":"id","v":{"s":"OPEN-S02-C09-a-3"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Lucas has a point."}},{"k":"read","v":{"b":false}}],"id":475},{"o":[{"k":"id","v":{"s":"OPEN-S02-C09-a-5"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Sorry."}},{"k":"read","v":{"b":false}}],"id":476},{"o":[{"