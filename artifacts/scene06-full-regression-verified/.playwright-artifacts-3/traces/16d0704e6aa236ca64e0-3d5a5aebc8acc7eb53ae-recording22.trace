"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-04-32"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: You asked."}},{"k":"read","v":{"b":true}}],"id":356},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-04-33"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: I did."}},{"k":"read","v":{"b":true}}],"id":357},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-04-34"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: 😂"}},{"k":"read","v":{"b":true}}],"id":358},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-04-35"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: There. See?"}},{"k":"read","v":{"b":true}}],"id":359},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-04-36"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: She still remembers how to laugh."}},{"k":"read","v":{"b":true}}],"id":360},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-04-37"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Barely."}},{"k":"read","v":{"b":true}}],"id":361},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-04-39"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: It isn't funny."}},{"k":"read","v":{"b":true}}],"id":362},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-04-40"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Nobody said the situation was funny."}},{"k":"read","v":{"b":true}}],"id":363},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-04-41"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Then can we stay focused?"}},{"k":"read","v":{"b":true}}],"id":364},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-04-42"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: We can be worried and still act like human beings."}},{"k":"read","v":{"b":true}}],"id":365},{"o":[{"k":"id","v":{"s":"OPEN-S02-C05-a-1"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Thank you."}},{"k":"read","v":{"b":true}}],"id":366},{"o":[{"k":"id","v":{"s":"OPEN-S02-C05-a-2"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I probably am."}},{"k":"read","v":{"b":true}}],"id":367},{"o":[{"k":"id","v":{"s":"OPEN-S02-C05-a-3"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: I'm fine."}},{"k":"read","v":{"b":true}}],"id":368},{"o":[{"k":"id","v":{"s":"OPEN-S02-C05-a-4"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: That's exactly what an exhausted person would say."}},{"k":"read","v":{"b":true}}],"id":369},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-05-1"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Okay."}},{"k":"read","v":{"b":true}}],"id":370},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-05-2"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I'm getting some water."}},{"k":"read","v":{"b":true}}],"id":371},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-05-3"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Finally."}},{"k":"read","v":{"b":true}}],"id":372},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-05-4"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Don't celebrate yet."}},{"k":"read","v":{"b":true}}],"id":373},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-05-5"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I'll be back in like two minutes."}},{"k":"read","v":{"b":true}}],"id":374},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-05-6"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Progress is progress."}},{"k":"read","v":{"b":true}}],"id":375},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-05-10"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Maya."}},{"k":"read","v":{"b":true}}],"id":376},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-05-11"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: What?"}},{"k":"read","v":{"b":true}}],"id":377},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-05-12"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: You're being awfully relaxed about this."}},{"k":"read","v":{"b":true}}],"id":378},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-05-13"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: About what?"}},{"k":"read","v":{"b":true}}],"id":379},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-05-14"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: This person."}},{"k":"read","v":{"b":true}}],"id":380},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-05-15"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: I'm not relaxed."}},{"k":"read","v":{"b":true}}],"id":381},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-05-16"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: You're joking with them."}},{"k":"read","v":{"b":true}}],"id":382},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-05-17"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: That doesn't mean I trust them."}},{"k":"read","v":{"b":true}}],"id":383},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-05-19"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Good."}},{"k":"read","v":{"b":true}}],"id":384},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-05-20"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Because I don't."}},{"k":"read","v":{"b":true}}],"id":385},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-05-21"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: You made that pretty clear."}},{"k":"read","v":{"b":true}}],"id":386},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-05-22"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: I don't understand why Sophie is doing this."}},{"k":"read","v":{"b":true}}],"id":387},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-05-23"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: She's scared."}},{"k":"read","v":{"b":true}}],"id":388},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-05-24"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: We're all scared."}},{"k":"read","v":{"b":true}}],"id":389},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-05-25"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: I know."}},{"k":"read","v":{"b":true}}],"id":390},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-05-26"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: And that doesn't mean we invite strangers into everything."}},{"k":"read","v":{"b":true}}],"id":391},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-05-28"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: You're still here, by the way."}},{"k":"read","v":{"b":true}}],"id":392},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-05-29"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: What?"}},{"k":"read","v":{"b":true}}],"id":393},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-05-30"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: The person you're talking about."}},{"k":"read","v":{"b":true}}],"id":394},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-05-31"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: They're still in the group."}},{"k":"read","v":{"b":true}}],"id":395},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-05-32"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: I know."}},{"k":"read","v":{"b":true}}],"id":396},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-05-33"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Then maybe stop talking about them like they aren't."}},{"k":"read","v":{"b":true}}],"id":397},{"o":[{"k":"id","v":{"s":"OPEN-S02-C06-a-1"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Exactly."}},{"k":"read","v":{"b":true}}],"id":398},{"o":[{"k":"id","v":{"s":"OPEN-S02-C06-a-2"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: I wasn't trying to hide it."}},{"k":"read","v":{"b":true}}],"id":399},{"o":[{"k":"id","v":{"s":"OPEN-S02-C06-a-4"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Lucas, just stop digging."}},{"k":"read","v":{"b":true}}],"id":400},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-06-2"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Listen."}},{"k":"read","v":{"b":true}}],"id":401},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-06-3"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: I'm not going to pretend this isn't strange."}},{"k":"read","v":{"b":true}}],"id":402},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-06-4"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: I don't know you."}},{"k":"read","v":{"b":true}}],"id":403},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-06-5"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: And I don't know what your number means."}},{"k":"read","v":{"b":true}}],"id":404},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-06-6"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: But I also don't think it's fair to assume the worst just because we don't have an answer."}},{"k":"read","v":{"b":true}}],"id":405},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-06-7"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: That goes both ways."}},{"k":"read","v":{"b":true}}],"id":406},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-06-8"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: It does."}},{"k":"read","v":{"b":true}}],"id":407},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-06-9"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Fine."}},{"k":"read","v":{"b":true}}],"id":408},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-06-11"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Then answer one thing."}},{"k":"read","v":{"b":true}}],"id":409},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-06-12"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Why are you still here?"}},{"k":"read","v":{"b":true}}],"id":410},{"o":[{"k":"id","v":{"s":"OPEN-S02-C07-a-1"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Okay."}},{"k":"read","v":{"b":true}}],"id":411},{"o":[{"k":"id","v":{"s":"OPEN-S02-C07-a-2"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: That's a fair answer."}},{"k":"read","v":{"b":true}}],"id":412},{"o":[{"k":"id","v":{"s":"OPEN-S02-C07-a-3"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: You're going to need a better reason eventually."}},{"k":"read","v":{"b":true}}],"id":413},{"o":[{"k":"id","v":{"s":"OPEN-S02-C07-a-4"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: They don't owe us a lifelong commitment, Lucas."}},{"k":"read","v":{"b":true}}],"id":414},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-2"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Okay, I'm back."}},{"k":"read","v":{"b":true}}],"id":415},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-3"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: What did I miss?"}},{"k":"read","v":{"b":true}}],"id":416},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-4"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Nothing."}},{"k":"read","v":{"b":true}}],"id":417},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-5"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Plenty."}},{"k":"read","v":{"b":true}}],"id":418},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-6"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: ..."}},{"k":"read","v":{"b":true}}],"id":419},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-7"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Oh no."}},{"k":"read","v":{"b":true}}],"id":420},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-8"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Please tell me you didn't start another argument."}},{"k":"read","v":{"b":true}}],"id":421},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-9"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: We were having a conversation."}},{"k":"read","v":{"b":true}}],"id":422},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-10"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: A very educational one."}},{"k":"read","v":{"b":true}}],"id":423},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-11"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Lucas."}},{"k":"read","v":{"b":true}}],"id":424},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-12"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Sophie."}},{"k":"read","v":{"b":true}}],"id":425},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-13"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Children."}},{"k":"read","v":{"b":true}}],"id":426},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-14"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: 🙄"}},{"k":"read","v":{"b":true}}],"id":427},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-16"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Look, I know adding someone without asking wasn't ideal."}},{"k":"read","v":{"b":true}}],"id":428},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-17"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: It wasn't ideal?"}},{"k":"read","v":{"b":true}}],"id":429},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-18"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Fine."}},{"k":"read","v":{"b":true}}],"id":430},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-19"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: It was a bad call."}},{"k":"read","v":{"b":true}}],"id":431},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-20"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Is that what you want me to say?"}},{"k":"read","v":{"b":true}}],"id":432},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-21"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: I want you to understand why it was a bad call."}},{"k":"read","v":{"b":true}}],"id":433},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-22"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I understand."}},{"k":"read","v":{"b":true}}],"id":434},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-23"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Then why did you do it?"}},{"k":"read","v":{"b":true}}],"id":435},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-24"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Because I'm tired of sitting here doing nothing!"}},{"k":"read","v":{"b":true}}],"id":436},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-26"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Sorry."}},{"k":"read","v":{"b":true}}],"id":437},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-27"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I didn't mean to snap."}},{"k":"read","v":{"b":true}}],"id":438},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-28"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: It's okay."}},{"k":"read","v":{"b":true}}],"id":439},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-29"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: No, it's not."}},{"k":"read","v":{"b":true}}],"id":440},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-30"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Lucas..."}},{"k":"read","v":{"b":true}}],"id":441},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-31"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: We're making decisions because we're scared."}},{"k":"read","v":{"b":true}}],"id":442},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-32"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: And we don't even know what we're risking."}},{"k":"read","v":{"b":true}}],"id":443},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-33"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I know!"}},{"k":"read","v":{"b":true}}],"id":444},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-34"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Do you think I don't think about that?"}},{"k":"read","v":{"b":true}}],"id":445},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-35"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Then start acting like it."}},{"k":"read","v":{"b":true}}],"id":446},{"o":[{"k":"id","v":{"s":"OPEN-S02-C08-a-1"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: No."}},{"k":"read","v":{"b":true}}],"id":447},{"o":[{"k":"id","v":{"s":"OPEN-S02-C08-a-2"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: That's not what I want."}},{"k":"read","v":{"b":true}}],"id":448},{"o":[{"k":"id","v":{"s":"OPEN-S02-C08-a-3"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: And we haven't asked you to leave."}},{"k":"read","v":{"b":true}}],"id":449},{"o":[{"k":"id","v":{"s":"OPEN-S02-C08-a-4"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: I might."}},{"k":"read","v":{"b":true}}],"id":450},{"o":[{"k":"id","v":{"s":"OPEN-S02-C08-a-5"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Lucas."}},{"k":"read","v":{"b":true}}],"id":451},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-2"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Fine."}},{"k":"read","v":{"b":true}}],"id":452},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-3"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: What do you want me to do?"}},{"k":"read","v":{"b":true}}],"id":453},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-4"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: I want us to stop sharing things until we know who we're sharing them with."}},{"k":"read","v":{"b":true}}],"id":454},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-5"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: That seems reasonable."}},{"k":"read","v":{"b":true}}],"id":455},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-6"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: So what?"}},{"k":"read","v":{"b":true}}],"id":456},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-7"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: We just ignore the number?"}},{"k":"read","v":{"b":true}}],"id":457},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-8"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: No."}},{"k":"read","v":{"b":true}}],"id":458},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-9"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: We verify it."}},{"k":"read","v":{"b":true}}],"id":459},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-10"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: How?"}},{"k":"read","v":{"b":true}}],"id":460},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-11"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: I don't know yet."}},{"k":"read","v":{"b":true}}],"id":461},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-12"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Exactly."}},{"k":"read","v":{"b":true}}],"id":462},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-13"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Not knowing how to do something doesn't mean we should do the first thing that comes to mind."}},{"k":"read","v":{"b":true}}],"id":463},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-14"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: And waiting doesn't guarantee we'll learn anything!"}},{"k":"read","v":{"b":true}}],"id":464},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-16"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Can both of you stop for a second?"}},{"k":"read","v":{"b":true}}],"id":465},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-17"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Sorry."}},{"k":"read","v":{"b":true}}],"id":466},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-18"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: I'm listening."}},{"k":"read","v":{"b":true}}],"id":467},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-19"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Nobody here knows what happened to Daniel."}},{"k":"read","v":{"b":true}}],"id":468},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-20"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: We keep going in circles."}},{"k":"read","v":{"b":true}}],"id":469},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-21"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: We don't even agree about what happened that night."}},{"k":"read","v":{"b":true}}],"id":470},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-22"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Maya."}},{"k":"read","v":{"b":true}}],"id":471},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-23"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: What?"}},{"k":"read","v":{"b":true}}],"id":472},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-24"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Don't."}},{"k":"read","v":{"b":true}}],"id":473},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-26"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: She's right."}},{"k":"read","v":{"b":true}}],"id":474},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-27"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: ..."}},{"k":"read","v":{"b":true}}],"id":475},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-28"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: We keep acting like we have all these answers."}},{"k":"read","v":{"b":true}}],"id":476},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-29"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: But we don't."}},{"k":"read","v":{"b":true}}],"id":477},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-30"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Can we please not do this right now?"}},{"k":"read","v":{"b":true}}],"id":478},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-31"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: I'm not trying to start anything."}},{"k":"read","v":{"b":true}}],"id":479},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-32"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: I'm just saying we need to stop mixing up what we know and what we think we know."}},{"k":"read","v":{"b":true}}],"id":480},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-33"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Exactly."}},{"k":"read","v":{"b":true}}],"id":481},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-35"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Okay."}},{"k":"read","v":{"b":true}}],"id":482},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-36"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: You're right."}},{"k":"read","v":{"b":true}}],"id":483},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-37"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Both of you."}},{"k":"read","v":{"b":true}}],"id":484},{"o":[{"k":"id","v":{"s":"OPEN-S02-C09-a-1"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: That's what we're trying to establish."}},{"k":"read","v":{"b":true}}],"id":485},{"o":[{"k":"id","v":{"s":"OPEN-S02-C09-a-2"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Which is why we shouldn't be discussing it with someone we just met."}},{"k":"read","v":{"b":true}}],"id":486},{"o":[{"k":"id","v":{"s":"OPEN-S02-C09-a-3"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Lucas has a point."}},{"k":"read","v":{"b":true}}],"id":487},{"o":[{"k":"id","v":{"s":"OPEN-S02-C09-a-5"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Sorry."}},{"k":"read","v":{"b":true}}],"id":488},{"o":[{"k":"id","v":{"s":"OPEN-S02-C09-a-6"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I know that's frustrating."}},{"k":"read","v":{"b":true}}],"id":489},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-3"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Maya?"}},{"k":"read","v":{"b":true}}],"id":490},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-4"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Sorry."}},{"k":"read","v":{"b":true}}],"id":491},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-5"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Wrong chat."}},{"k":"read","v":{"b":true}}],"id":492},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-6"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: What did you delete?"}},{"k":"read","v":{"b":true}}],"id":493},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-7"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: A message meant for someone else."}},{"k":"read","v":{"b":true}}],"id":494},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-8"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: About what?"}},{"k":"read","v":{"b":true}}],"id":495},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-9"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Something unrelated."}},{"k":"read","v":{"b":true}}],"id":496},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-10"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Right."}},{"k":"read","v":{"b":true}}],"id":497},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-11"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Lucas."}},{"k":"read","v":{"b":true}}],"id":498},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-12"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: What?"}},{"k":"read","v":{"b":true}}],"id":499},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-13"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Please don't make something out of nothing."}},{"k":"read","v":{"b":true}}],"id":500},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-15"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: You know what bothers me the most?"}},{"k":"read","v":{"b":true}}],"id":501},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-16"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: What?"}},{"k":"read","v":{"b":true}}],"id":502},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-17"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: We keep saying we trust each other."}},{"k":"read","v":{"b":true}}],"id":503},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-18"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: But the moment something goes wrong, suddenly everyone has something they don't want to explain."}},{"k":"read","v":{"b":true}}],"id":504},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-19"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: That's not fair."}},{"k":"read","v":{"b":true}}],"id":505},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-20"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Isn't it?"}},{"k":"read","v":{"b":true}}],"id":506},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-21"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: What are you trying to say?"}},{"k":"read","v":{"b":true}}],"id":507},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-22"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: I'm saying maybe we should stop pretending everything's fine."}},{"k":"read","v":{"b":true}}],"id":508},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-23"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Nobody's pretending everything's fine."}},{"k":"read","v":{"b":true}}],"id":509},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-24"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Then why does it feel like I'm the only one asking the obvious questions?"}},{"k":"read","v":{"b":true}}],"id":510},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-25"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: You're not."}},{"k":"read","v":{"b":true}}],"id":511},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-26"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Really?"}},{"k":"read","v":{"b":true}}],"id":512},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-27"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Really."}},{"k":"read","v":{"b":true}}],"id":513},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-28"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Then answer this."}},{"k":"read","v":{"b":true}}],"id":514},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-30"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Why does Daniel have a stranger's number saved without a name?"}},{"k":"read","v":{"b":true}}],"id":515},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-31"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I don't know."}},{"k":"read","v":{"b":true}}],"id":516},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-32"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Who marked it with a star?"}},{"k":"read","v":{"b":true}}],"id":517},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-33"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I don't know!"}},{"k":"read","v":{"b":true}}],"id":518},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-34"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Why has nobody heard from him?"}},{"k":"read","v":{"b":true}}],"id":519},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-35"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: LUCAS!"}},{"k":"read","v":{"b":true}}],"id":520},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-37"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Stop."}},{"k":"read","v":{"b":true}}],"id":521},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-38"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Both of you."}},{"k":"read","v":{"b":true}}],"id":522},{"o":[{"k":"id","v":{"s":"OPEN-S02-C10-a-1"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Exactly."}},{"k":"read","v":{"b":true}}],"id":523},{"o":[{"k":"id","v":{"s":"OPEN-S02-C10-a-2"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Then maybe we shouldn't be acting like we do."}},{"k":"read","v":{"b":true}}],"id":524},{"o":[{"k":"id","v":{"s":"OPEN-S02-C10-a-3"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I'm not!"}},{"k":"read","v":{"b":true}}],"id":525},{"o":[{"k":"id","v":{"s":"OPEN-S02-C10-a-4"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Then stop making decisions for everyone."}},{"k":"read","v":{"b":true}}],"id":526},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-10-2"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Fine."}},{"k":"read","v":{"b":true}}],"id":527},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-10-3"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Maybe adding someone was a mistake."}},{"k":"read","v":{"b":true}}],"id":528},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-10-4"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: But I still think ignoring the number would've been worse."}},{"k":"read","v":{"b":true}}],"id":529},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-10-5"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: That's your opinion."}},{"k":"read","v":{"b":true}}],"id":530},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-10-6"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Yes."}},{"k":"read","v":{"b":true}}],"id":531},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-10-7"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: It is."}},{"k":"read","v":{"b":true}}],"id":532},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-10-9"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Nobody has to decide everything right now."}},{"k":"read","v":{"b":true}}],"id":533},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-10-10"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: No."}},{"k":"read","v":{"b":true}}],"id":534},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-10-11"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: But we do have to decide what we're willing to risk."}},{"k":"read","v":{"b":true}}],"id":535},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-10-12"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: What does that mean?"}},{"k":"read","v":{"b":true}}],"id":536},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-10-13"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: It means I'm not comfortable with this anymore."}},{"k":"read","v":{"b":true}}],"id":537},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-10-14"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: With what?"}},{"k":"read","v":{"b":true}}],"id":538},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-10-15"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: With how we're handling everything."}},{"k":"read","v":{"b":true}}],"id":539},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-10-16"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Lucas..."}},{"k":"read","v":{"b":true}}],"id":540},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-10-17"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: No, Sophie."}},{"k":"read","v":{"b":true}}],"id":541},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-10-18"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: I've been trying to say this for days."}},{"k":"read","v":{"b":true}}],"id":542},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-10-19"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Every time I question something, you act like I'm making things harder."}},{"k":"read","v":{"b":true}}],"id":543},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-10-20"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Because sometimes you are!"}},{"k":"read","v":{"b":true}}],"id":544},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-10-22"}},{"k":"text","v":{"