"v":{"s":"OPEN-S02-AFTER-09-16"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: What?"}},{"k":"read","v":{"b":false}}],"id":490},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-17"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: We keep saying we trust each other."}},{"k":"read","v":{"b":false}}],"id":491},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-18"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: But the moment something goes wrong, suddenly everyone has something they don't want to explain."}},{"k":"read","v":{"b":false}}],"id":492},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-19"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: That's not fair."}},{"k":"read","v":{"b":false}}],"id":493},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-20"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Isn't it?"}},{"k":"read","v":{"b":false}}],"id":494},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-21"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: What are you trying to say?"}},{"k":"read","v":{"b":false}}],"id":495},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-22"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: I'm saying maybe we should stop pretending everything's fine."}},{"k":"read","v":{"b":false}}],"id":496},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-23"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Nobody's pretending everything's fine."}},{"k":"read","v":{"b":false}}],"id":497},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-24"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Then why does it feel like I'm the only one asking the obvious questions?"}},{"k":"read","v":{"b":false}}],"id":498},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-25"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: You're not."}},{"k":"read","v":{"b":false}}],"id":499},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-26"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Really?"}},{"k":"read","v":{"b":false}}],"id":500},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-27"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Really."}},{"k":"read","v":{"b":fals