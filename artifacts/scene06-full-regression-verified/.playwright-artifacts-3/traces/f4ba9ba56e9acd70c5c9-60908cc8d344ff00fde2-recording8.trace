:env(safe-area-inset-top) 21px 0;display:flex;justify-content:space-between;align-items:center;background:var(--header);color:var(--text);font-size:13px;font-weight:700;letter-spacing:.02em}\n.status-brand{font-size:9px;letter-spacing:.12em;color:var(--muted);display:flex;align-items:center;gap:7px}.status-brand i{width:5px;height:5px;border-radius:50%;background:#6bbfa8}\n.system-nav{height:calc(28px + env(safe-area-inset-bottom));padding-bottom:env(safe-area-inset-bottom);display:grid;place-items:center;background:var(--phone-bg);flex:none}.system-nav button{width:94px;height:26px;border:0;background:transparent;display:flex;align-items:center;justify-content:center;gap:8px;color:var(--muted)}.system-nav button:disabled{opacity:.6}.gesture-line{height:4px;width:42px;background:currentColor;border-radius:8px}.native-app .device{padding-top:env(safe-area-inset-top);padding-bottom:env(safe-area-inset-bottom)}\n.boot-message{height:100dvh;background:#102738;color:#fff;display:flex;overflow-y:auto;padding:24px}.recovery{width:min(100%,380px);margin:auto;background:#20394a;padding:25px;border-radius:20px}.recovery p{line-height:1.5}.save-error{background:#9e4844;color:#fff;padding:8px 16px;font-size:12px;flex:none}\n.recovery-secondary{display:block;width:100%;min-height:44px;margin-top:12px;padding:10px 14px;border:1px solid #bcd0db;border-radius:12px;background:transparent;color:#fff;font:inherit;font-weight:650;text-align:center}\n.eyebrow,.section-caption{font-size:10px;font-weight:750;letter-spacing:.15em;color:var(--accent)}.primary-button,.action-button{border:0;border-radius:15px;background:#d6ad8c;color:#182a35;padding:15px 20px;min-height:48px;font-weight:750;display:flex;align-items:center;justify-content:center;gap:10px}.primary-button:disabled{opacity:.45}\n.splash,.setup{flex:1;min-height:0;overflow:auto}.splash{display:flex;align-items:flex-end;position:relative;background:linear-gradient(0deg,#0b202f 0%,#152c3bb8 42%,#57778670 100%),url('/greyhaven-wallpaper.svg') center/cover;padding:24px 30px 38px;color:#fff}.splash-copy{position:relative;width:100%}.splash h1{font-size:clamp(52px,13vw,66px);line-height:.92;letter-spacing:-.055em;margin:0 0 24px}.splash h1 em{font-style:normal;color:#efc49d}.splash p:not(.eyebrow){font-size:16px;margin-bottom:27px;color:#e4ebec}.splash .primary-button{width:100%;justify-content:space-between}.splash small,.setup small{display:block;margin-top:18px;text-align:center;font-size:11px;opacity:.75}.splash-art{position:absolute;right:12%;top:16%;height:140px;width:140px;border:1px solid #fff5;border-radius:50%;box-shadow:0 0 0 22px #fff1,0 0 0 44px #fff1}.splash-art span{position:absolute;left:50%;top:50%;border-radius:50%;background:#fff9}.splash-art span:first-child{width:13px;height:13px;transform:translate(-50%,-50%)}\n.setup{padding:44px 28px;background:var(--phone-bg)}.setup h1{font-size:32px;line-height:1.1;letter-spacing:-.04em;margin-bottom:13px}.setup>p:not(.eyebrow){color:var(--muted);line-height:1.5;font-size:15px;margin-bottom:28px}.setup form{display:flex;flex-direction:column;gap:10px}.setup label{font-size:13px;font-weight:700;margin-top:8px}.setup label span{font-weight:400;color:var(--muted)}.setup input,.setup select,.search-field input,.reply-search input,.note-editor{background:var(--surface);color:var(--text);border:1px solid var(--line);border-radius:12px;padding:13px 15px;min-height:48px;width:100%}.setup .primary-button{margin-top:20px}\n.home{flex:1;min-height:0;position:relative;display:flex;flex-direction:column;color:#fff;overflow:hidden;background:#425d70 url('/greyhaven-wallpaper.svg') center/cover}.home-overlay{position:absolute;inset:0;background:linear-gradient(180deg,#10283755 0%,#1834451f 40%,#081d2fc4 100%);pointer-events:none}.home-content{position:relative;flex:1;min-height:0;overflow-y:auto;padding:20px 21px 12px;scrollbar-width:none}.home-heading>span{font-size:10px;font-weight:800;letter-spacing:.17em;color:#f5e9d9}.home-heading h1{font-size:clamp(28px,7vw,36px);line-height:1.08;letter-spacing:-.035em;margin:10px 0 19px;text-shadow:0 2px 10px #10212b88}.home-heading h1 em{font-style:normal;color:#ffe0b9}.widgets{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin:0 0 22px}.widget{height:126px;border:1px solid #ffffff66;border-radius:21px;position:relative;text-align:left;color:#fff;padding:14px;overflow:hidden;box-shadow:0 8px 22px #0f22343a}.gallery-widget{background:linear-gradient(135deg,#68869a 0%,#3f6674 48%,#253e52 100%)}.gallery-widget:after{content:'';position:absolute;width:150px;height:72px;right:-15px;bottom:16px;border-top:2px solid #c9d7d799;border-radius:50%;transform:rotate(-18deg)}.widget-symbol{display:inline-grid;place-items:center;background:#ffffff33;width:34px;height:34px;border-radius:11px}.gallery-widget>svg{position:absolute;right:12px;bottom:15px}.widget-bottom{position:absolute;bottom:13px;left:14px;display:flex;flex-direction:column;gap:2px}.widget-bottom strong{font-size:15px}.widget-bottom small{font-size:10px;color:#e4eceb}.calendar-widget{background:#243b4be6}.widget-top{display:flex;gap:5px;align-items:center;color:#f7d3ad;font-size:9px;font-weight:700;letter-spacing:.06em}.calendar-widget>strong{display:block;margin-top:7px;font-size:44px;line-height:1;font-weight:550}.home-secondary{min-height:150px;margin:8px 0 24px;background:#1c3545b3;border:1px solid #fff3;border-radius:23px;padding:22px}.home-secondary p{font-size:10px;letter-spacing:.17em;color:#f7d3ad}.home-secondary h2{font-size:23px;line-height:1.05;max-width:230px;margin-bottom:10px}.home-secondary span{font-size:12px;color:#e5edef}.home-apps{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:17px 3px}.app-tile{min-width:0;min-height:83px;display:flex;align-items:center;flex-direction:column;gap:7px;color:#fff;background:transparent;border:0;padding:0;font-size:11px;text-shadow:0 2px 5px #1d2c38}.app-icon{position:relative;width:56px;height:56px;border-radius:17px;display:grid;place-items:center;border:1px solid #ffffff72;box-shadow:0 7px 15px #14253255,inset 0 1px #fff4;color:#fff;transition:transform .2s ease}.app-tile:hover .app-icon,.dock button:hover .app-icon{transform:translateY(-3px)}.app-icon.peach{background:linear-gradient(145deg,#d79676,#a95f61)}.app-icon.blue{background:linear-gradient(145deg,#508ba6,#315f86)}.app-icon.sand{background:linear-gradient(145deg,#d5bc87,#917d62)}.app-icon.green{background:linear-gradient(145deg,#71ae9c,#28766f)}.app-icon.violet{background:linear-gradient(145deg,#958ac7,#5c5b99)}.badge{position:absolute;right:-5px;top:-6px;min-width:20px;height:20px;padding:0 4px;border-radius:12px;background:#f0ad72;color:#152537;border:2px solid #fff;display:grid;place-items:center;font-size:10px;text-shadow:none}.home-lock-note{display:flex;align-items:center;gap:6px;font-size:11px;color:#e7eded;margin:22px 6px}.home-bottom{position:relative;flex:none;padding:5px 19px 13px}.page-indicators{display:flex;justify-content:center;gap:7px;margin:0 0 11px}.page-indicators button{width:9px;height:9px;border-radius:50%;border:0;background:#ffffff77;padding:0}.page-indicators button.active{width:23px;border-radius:6px;background:#fff}.dock{display:flex;justify-content:space-around;align-items:center;padding:10px 12px;background:#dbe7eb40;border:1px solid #fff5;backdrop-filter:blur(18px);border-radius:25px;box-shadow:0 10px 28px #0b1f2d40}.dock button{padding:0;border:0;background:none;min-width:60px;min-height:58px;display:grid;place-items:center}\n.app-header,.chat-header{flex:none;display:flex;align-items:center;gap:12px;min-height:79px;padding:10px 17px;border-bottom:1px solid var(--line);background:var(--header)}.app-header h1{font-size:24px;line-height:1.05;letter-spacing:-.03em;margin:2px 0 0}.app-header p{font-size:9px;letter-spacing:.14em;font-weight:800;color:var(--accent);margin:0}.icon-button{display:grid;place-items:center;border:0;border-radius:12px;min-width:44px;min-height:44px;color:var(--accent);background:var(--raised)}.icon-button.bare{background:transparent}.utility-screen,.inbox-screen,.chat-screen{flex:1;min-height:0;display:flex;flex-direction:column;background:var(--phone-bg)}.utility-content,.utility-scroll,.inbox-content{flex:1;min-height:0;overflow-y:auto;padding:21px 19px 28px;overscroll-behavior:contain}.utility-scroll{padding:0}.utility-scroll .utility-content{overflow:visible}.section-caption{display:flex;justify-content:space-between;margin-bottom:14px;color:var(--muted)}.utility-card{background:var(--surface);border:1px solid var(--line);border-radius:16px;padding:18px;margin-bottom:10px;box-shadow:var(--shadow)}.utility-card h2{font-size:17px;margin:0 0 8px}.utility-card p{font-size:13px;line-height:1.5;color:var(--muted);margin:0}.result-card small{color:var(--accent);font-weight:750;font-size:11px}.result-card h2{margin-top:7px}.empty-card{text-align:center;border:1px dashed var(--line);border-radius:18px;padding:45px 24px;color:var(--muted);margin-top:17px}.empty-card svg{color:var(--accent);margin-bottom:12px}.empty-card h2{color:var(--text);font-size:18px}.empty-card p{font-size:13px;line-height:1.5}.utility-note{font-size:12px;line-height:1.5;color:var(--muted);margin:15px 2px}.search-field,.reply-search{display:flex;align-items:center;gap:8px;color:var(--muted);background:var(--surface);border:1px solid var(--line);border-radius:13px;padding-left:13px}.search-field input,.reply-search input{border:0;background:transparent;outline:0;min-height:45px}.search-field{margin-bottom:20px}.bulletin-card{min-height:220px;background:linear-gradient(140deg,#31586a,#213747);color:#fff;border:0}.bulletin-card span{font-size:10px;color:#e2c9a5;letter-spacing:.14em}.bulletin-card h2{font-size:27px;margin-top:50px}.bulletin-card p{color:#d8e4e8}.photo-placeholder{height:270px;border-radius:18px;background:linear-gradient(0deg,#071a2d66,#0000),url('/greyhaven-wallpaper.svg') center/cover;padding:16px;color:#fff}.photo-placeholder span{font-size:10px;letter-spacing:.15em}.file-row,.alert-row{display:flex;align-items:center;gap:14px}.file-row svg,.alert-row svg{color:var(--accent)}.file-row small{display:block;color:var(--muted);font-size:11px;margin-top:3px}\n.map-canvas{height:320px;position:relative;background:linear-gradient(28deg,#b2bbb2 0 30%,#d0c6b7 30% 70%,#a9c3bc 70%);overflow:hidden}.map-water{position:absolute;width:140%;height:92px;top:44%;left:-20%;transform:rotate(-19deg);background:#79a8b6;border-top:6px solid #b0d3d8;border-bottom:6px solid #b0d3d8}.map-road{position:absolute;height:9px;width:130%;left:-10%;background:#f1e6d4;box-shadow:0 0 0 2px #b2aea4}.map-road.one{top:25%;transform:rotate(17deg)}.map-road.two{top:76%;transform:rotate(-26deg)}.map-label{position:absolute;font-size:10px;letter-spacing:.15em;font-weight:700;color:#4f706e}.map-label.one{top:24px;left:20px}.map-label.two{bottom:28px;right:18px}.map-pin{position:absolute;transform:translate(-50%,-50%);width:44px;height:44px;border-radius:50%;border:0;background:#d47566;color:#fff;display:grid;place-items:center;box-shadow:0 4px 12px #263c4877}.map-pin.active{outline:4px solid #fff9}\n.month-controls{display:flex;justify-content:space-between;align-items:center;margin-bottom:23px}.month-controls button{border:0;border-radius:50%;background:var(--raised);color:var(--accent);width:44px;height:44px;font-size:27px}.calendar-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:7px;text-align:center}.calendar-grid span{display:grid;place-items:center;min-height:42px;font-size:13px}.calendar-weekday{font-size:11px!important;color:var(--muted)}.calendar-grid .today{background:var(--button-accent);color:#fff;border-radius:50%}.note-editor{min-height:210px;resize:vertical;line-height:1.5}.action-button{background:var(--button-accent);color:#fff;margin-top:12px}.settings-content{background:var(--phone-bg)}.settings-group{background:var(--surface);border-radius:18px;border:1px solid var(--line);overflow:hidden;margin-bottom:25px}.settings-row{min-height:66px;padding:10px 13px;display:flex;align-items:center;gap:12px;border-bottom:1px solid var(--line);color:var(--text)}.settings-row:last-child{border-bottom:0}.setting-icon{width:38px;height:38px;flex:none;border-radius:11px;background:var(--button-accent);color:#fff;display:grid;place-items:center}.setting-copy{flex:1;min-width:0}.setting-copy strong{display:block;font-size:14px}.setting-copy small{display:block;font-size:11px;color:var(--muted);margin-top:2px}.settings-row select{max-width:105px;background:var(--raised);color:var(--text);border:1px solid var(--line);border-radius:9px;padding:7px}.settings-row input[type=checkbox]{width:22px;height:22px;accent-color:var(--accent)}.setting-action{width:100%;border:0;background:none;text-align:left;cursor:pointer}.settings-footer{font-size:11px;line-height:1.5;color:var(--muted)}\n.inbox-kicker{font-size:10px;letter-spacing:.15em;font-weight:750;color:var(--muted);margin-bottom:15px}.inbox-kicker span{float:right}.thread-row{width:100%;min-height:83px;padding:11px 2px;display:flex;align-items:center;gap:12px;border:0;border-bottom:1px solid var(--line);background:transparent;text-align:left;color:var(--text)}.contact-avatar,.bubble-avatar{flex:none;width:44px;height:44px;display:grid;place-items:center;border-radius:50%;background:#44677c;color:#fff;font-size:17px;font-weight:750}.thread-text{flex:1;min-width:0}.thread-text strong{display:block;font-size:15px}.thread-text small{display:block;color:var(--muted);font-size:12px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-top:5px}.thread-meta{align-self:stretch;display:flex;align-items:flex-end;flex-direction:column;justify-content:space-around;color:var(--muted);font-size:10px}.thread-meta b{background:var(--button-accent);color:#fff;border-radius:12px;min-width:20px;height:20px;display:grid;place-items:center}.inbox-footnote{display:flex;gap:10px;margin-top:30px;color:var(--muted);font-size:12px;line-height:1.5}.inbox-footnote svg{flex:none}\n.chat-header{min-height:70px}.chat-header .contact-avatar{width:38px;height:38px;font-size:15px}.chat-title{flex:1;min-width:0}.chat-title strong{display:block;font-size:15px}.chat-title small{display:flex;align-items:center;gap:3px;color:var(--muted);font-size:10px;margin-top:2px}.header-mark{font-size:9px;letter-spacing:.08em;color:var(--accent);font-weight:800}.chat-area{position:relative;flex:1;min-height:0;display:flex}.chat-scroll{flex:1;min-height:0;overflow-y:auto;overflow-x:hidden;overscroll-behavior:contain;padding:16px 15px 24px;scrollbar-width:thin;scrollbar-color:var(--line) transparent;overflow-anchor:none}.fixture-disclaimer{font-size:11px;text-align:center;color:var(--muted);padding:8px 12px 14px;line-height:1.4}.chat-date{text-align:center;color:var(--muted);font-size:11px;font-weight:650;margin:16px auto 12px;padding:5px 12px;background:var(--raised);border-radius:20px;width:max-content}.bubble-row{display:flex;gap:7px;align-items:flex-end;margin:3px 0}.bubble-row.group-start{margin-top:12px}.bubble-row.player{justify-content:flex-end}.bubble-avatar{width:25px;height:25px;font-size:11px}.bubble-avatar.invisible{visibility:hidden}.bubble{max-width:81%;min-width:85px;border-radius:17px;padding:10px 12px 6px;overflow-wrap:anywhere}.bubble.fixture{background:var(--incoming);border-bottom-left-radius:5px}.bubble.player{background:var(--outgoing);color:var(--outgoing-text);border-bottom-right-radius:5px}.bubble p{font-size:15px;line-height:1.38;margin:0 0 6px}.bubble small{display:flex;align-items:center;justify-content:flex-end;gap:6px;font-size:10px;opacity:.76}.delivery{display:inline-flex;align-items:center;gap:2px}.typing{display:flex;align-items:flex-end;gap:7px;margin:11px 0}.typing-dots{display:flex;gap:4px;padding:14px;background:var(--incoming);border-radius:17px}.typing-dots i{width:5px;height:5px;border-radius:50%;background:var(--muted);animation:dot 1.2s infinite}.typing-dots i:nth-child(2){animation-delay:.15s}.typing-dots i:nth-child(3){animation-delay:.3s}@keyframes dot{50%{opacity:.3;transform:translateY(-3px)}}.new-messages{position:absolute;bottom:12px;left:50%;transform:translateX(-50%);border:1px solid var(--line);background:var(--surface);color:var(--accent);box-shadow:var(--shadow);border-radius:20px;padding:9px 14px;display:flex;align-items:center;gap:6px;white-space:nowrap;font-size:12px;font-weight:750}.composer{flex:none;max-height:min(43vh,305px);overflow:auto;background:var(--header);border-top:1px solid var(--line);padding:11px 14px 14px}.composer-title{display:flex;justify-content:space-between;gap:8px;align-items:baseline;color:var(--muted);margin-bottom:9px}.composer-title span{font-size:10px;letter-spacing:.13em;font-weight:800}.composer-title small{font-size:10px}.reply-search{margin-bottom:9px}.reply-search input{font-size:14px}.choices{display:grid;gap:7px}.choice{width:100%;min-height:44px;padding:9px 11px;text-align:left;border:1px solid var(--line);border-radius:12px;background:var(--raised);color:var(--text);font-size:13px}.choice.selected{border-color:var(--accent);box-shadow:inset 0 0 0 1px var(--accent)}.send-button{min-height:44px;margin-top:9px;width:100%;display:flex;justify-content:center;align-items:center;gap:7px;border:0;border-radius:12px;background:var(--button-accent);color:#fff;font-size:14px;font-weight:750}.send-button:disabled{opacity:.44}.composer-wait{min-height:44px;display:flex;align-items:center;gap:8px;color:var(--muted);font-size:12px}\n.reduce-motion *, .reduce-motion *:before,.reduce-motion *:after{animation-duration:.01ms!important;transition-duration:.01ms!important;scroll-behavior:auto!important}\n@media(max-width:360px){.home-content{padding-left:15px;padding-right:15px}.app-icon{width:50px;height:50px}.widgets{gap:7px}.widget{height:112px}.home-apps{gap:11px 0}.home-heading h1{font-size:29px}.bubble{max-width:84%}.composer-title small{display:none}}\n@media(max-height:720px){.widgets .widget{height:105px}.home-heading h1{margin-bottom:13px}.home-apps{gap:10px 2px}.app-tile{min-height:74px}.app-icon{width:48px;height:48px}.home-bottom{padding-bottom:8px}}\n.slice-screen{min-height:0}.slice-content{padding-bottom:44px}.slice-content h2{font-size:22px;line-height:1.18;margin:4px 0 14px}.slice-content h3{font-size:15px;line-height:1.35;margin:20px 0 10px}.slice-content>p{font-size:14px;line-height:1.5}.slice-content .utility-card p{margin:0 0 11px}.slice-content .utility-card p:last-child{margin-bottom:0}.slice-article p{line-height:1.58!important}.slice-source small{color:var(--accent);font-size:11px;font-weight:700}.slice-source pre{font:12px/1.55 ui-monospace,SFMono-Regular,Consolas,monospace;white-space:pre-wrap;overflow-wrap:anywhere;background:var(--raised);color:var(--text);padding:13px;border-radius:12px;margin:12px 0 0}.slice-compare .slice-source{padding:13px}.slice-compare .slice-source h2{font-size:14px}.slice-compare .slice-source pre{font-size:11px;padding:10px}.slice-action{width:100%;margin:12px 0 8px}.slice-action:disabled{opacity:.48}.slice-feedback{padding:12px 14px;background:var(--raised);border-left:3px solid var(--accent);border-radius:7px;margin:13px 0!important}.slice-input{width:100%;min-height:46px;background:var(--surface);color:var(--text);border:1px solid var(--line);border-radius:12px;padding:11px;margin:8px 0 14px}.slice-thread-heading{display:flex;align-items:center;gap:10px;padding:11px 17px;border-bottom:1px solid var(--line);background:var(--header)}.slice-thread-heading .contact-avatar{width:37px;height:37px}.slice-thread-heading strong{display:block;font-size:14px}.slice-thread-heading small{display:block;color:var(--muted);font-size:10px;line-height:1.3}.slice-chat-area{min-height:90px}.slice-composer{max-height:min(38vh,260px)}.slice-footer{padding:0 14px 10px;background:var(--header)}.slice-footer .slice-action{margin:4px 0 0}.slice-content .choices{margin:12px 0}.slice-screen .bubble.fixture{background:var(--incoming)}\n.story-home-alert{width:100%;min-height:64px;margin:0 0 14px;padding:11px 14px;display:grid;grid-template-columns:minmax(0,1fr) auto;gap:3px 7px;align-items:center;border:1px solid #fff7;border-radius:14px;background:#173a4cbf;color:#fff;text-align:left}.story-home-alert strong{font-size:12px;display:block;grid-column:1}.story-home-alert span{font-size:11px;color:#e4eceb;grid-column:1}.story-home-alert svg{grid-column:2;grid-row:1/3}.setup-privacy{font-size:12px;line-height:1.45;color:var(--muted);margin:0}\n"],["STYLE",{},"/* Phone UI refresh: original icon artwork and a photographic Greyhaven wallpaper. */\n:root { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; background: #11151b; }\nbutton { -webkit-tap-highlight-color: transparent; }\nbutton:focus-visible, input:focus-visible, select:focus-visible, textarea:focus-visible { outline-color: #0a84ff; }\n.app-root {\n  --phone-bg: #f2f2f7; --surface: #fff; --raised: #f3f3f6; --text: #18191d;\n  --muted: #71747c; --line: #dedee3; --accent: #087df2; --button-accent: #087df2;\n  --incoming: #e8e8ed; --outgoing: #087df2; --header: #fafafcf2;\n  --shadow: 0 3px 16px #101c2c05;\n  background: radial-gradient(ellipse at 50% 0%, #34414d, #141b23 56%, #0d1218);\n}\n.theme-dark {\n  --phone-bg: #0a1a25; --surface: #142b3c; --raised: #203546; --text: #f5f7fa;\n  --muted: #a2b3c1; --line: #ffffff15; --accent: #63aaff; --button-accent: #1878ef;\n  --incoming: #223a4d; --outgoing: #2479ed; --header: #132c3deb;\n  --shadow: 0 4px 20px #0000000a;\n}\n.device { isolation: isolate; width: min(100%, 460px); background: var(--phone-bg); }\n.device.surface-home, .device.surface-lock { background: #3d555f url('/greyhaven-phone-wallpaper.png') center / cover; }\n.device.surface-home::before, .device.surface-lock::before { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(180deg,#11212d24 0%,transparent 35%,#07152245 100%); pointer-events: none; }\n.phone-content { flex: 1; min-height: 0; display: flex; flex-direction: column; position: relative; animation: phone-enter .24s ease-out; }\n@keyframes phone-enter { from { opacity: .4; transform: scale(.975); } to { opacity: 1; transform: scale(1); } }\n.status-bar { height: calc(51px + env(safe-area-inset-top)); padding: env(safe-area-inset-top) 28px 0; position: relative; background: var(--header); font-size: 15px; letter-spacing: -.04em; z-index: 3; }\n.status-time { width: 64px; text-align: center; font-weight: 650; font-variant-numeric: tabular-nums; }\n.device-island { position: absolute; left: 50%; top: calc(10px + env(safe-area-inset-top)); transform: translateX(-50%); height: 26px; width: 90px; border-radius: 30px; background: #060709; box-shadow: inset 0 0 0 1px #000; }\n.device-island i { position: absolute; right: 10px; top: 9px; width: 8px; height: 8px; border-radius: 50%; background: radial-gradient(circle at 35% 30%,#213243,#080c14 70%); }\n.status-indicators { display: flex; align-items: center; gap: 5px; }\n.signal-bars { display: flex; align-items: flex-end; height: 13px; gap: 2px; }\n.signal-bars i { width: 3px; background: currentColor; border-radius: 1px; }\n.signal-bars i:nth-child(1) { height: 4px; }.signal-bars i:nth-child(2) { height: 7px; }.signal-bars i:nth-child(3) { height: 10px; }.signal-bars i:nth-child(4) { height: 13px; }\n.battery-icon { width: 24px; height: 12px; border: 1px solid currentColor; border-radius: 3px; padding: 1.5px; opacity: .95; position: relative; margin-left: 1px; }\n.battery-icon > span { display: block; width: 83%; height: 100%; background: currentColor; border-radius: 1px; }\n.battery-icon::after { content: ''; width: 2px; height: 5px; background: currentColor; opacity: .5; position: absolute; right: -4px; top: 2.5px; border-radius: 0 2px 2px 0; }\n.surface-home .status-bar, .surface-lock .status-bar { color: white; background: transparent; text-shadow: 0 1px 8px #152b4366; }\n.system-nav { height: calc(25px + env(safe-area-inset-bottom)); background: var(--phone-bg); }\n.system-nav button { width: 150px; height: 25px; min-height: 25px; color: var(--text); padding: 0; }\n.system-nav button:disabled { opacity: 1; }\n.gesture-line { width: 126px; height: 5px; border-radius: 6px; }\n.surface-home .system-nav, .surface-lock .system-nav { background: transparent; }\n.surface-home .system-nav button, .surface-lock .system-nav button { color: #fff; }\n\n/* Lock screen uses the same wallpaper and a real click/swipe unlock action. */\n.lock-screen { flex: 1; min-height: 0; display: flex; flex-direction: column; color: #fff; touch-action: pan-x; padding: 22px 24px 8px; }\n.lock-clock { text-align: center; padding-top: clamp(12px,5vh,44px); text-shadow: 0 2px 20px #13232f30; }\n.lock-clock > svg { margin-bottom: 13px; }\n.lock-clock p { font-size: 20px; font-weight: 550; letter-spacing: -.03em; margin: 0; }\n.lock-clock h1 { font-size: clamp(76px,24vw,105px); line-height: 1.12; font-weight: 650; letter-spacing: -.065em; margin: 0; font-variant-numeric: tabular-nums; }\n.lock-bottom { margin-top: auto; text-align: center; padding-bottom: 5px; }\n.lock-bottom > p { font-size: 11px; font-weight: 650; letter-spacing: .23em; margin-bottom: 25px; text-shadow: 0 2px 8px #0008; }\n.lock-bottom > p span { display: block; font-size: 8px; letter-spacing: .32em; opacity: .75; margin-top: 6px; }\n.lock-bottom button { background: transparent; border: 0; color: #fff; min-height: 52px; min-width: 200px; display: inline-flex; flex-direction: column; align-items: center; gap: 3px; text-shadow: 0 1px 8px #0009; font-size: 13px; font-weight: 550; }\n.setup { background: var(--surface); padding-top: 38px; }.setup .primary-button { background: var(--button-accent); color: #fff; border-radius: 14px; }\n\n/* Home: two widgets, four-column app grid, glass notification and fixed dock. */\n.home { background: transparent; overflow: hidden; }\n.home-content { padding: 2px 23px 16px; }\n.home-topline { display: flex; align-items: center; justify-content: space-between; min-height: 36px; margin-bottom: 9px; color: #fff; font-size: 11px; font-weight: 600; text-shadow: 0 1px 6px #0007; }\n.home-topline button { display: grid; place-items: center; width: 32px; min-height: 32px; color: #fff; background: #ffffff18; border: 1px solid #fff2; border-radius: 50%; backdrop-filter: blur(14px); }\n.widgets { grid-template-columns: repeat(2,minmax(0,1fr)); gap: 15px; margin-bottom: 24px; }\n.widgets .widget { height: auto; aspect-ratio: 1.05; padding: 14px; border: 1px solid #ffffff2e; border-radius: 22px; box-shadow: 0 6px 20px #10233422; }\n.photo-widget { background: #3b515a url('/greyhaven-phone-wallpaper.png') center 65% / cover; }\n.photo-widget::after { content: ''; position: absolute; inset: 0; background: linear-gradient(0deg,#0c1d2e94,transparent 65%); }\n.photo-widget-caption { position: absolute; left: 14px; bottom: 14px; z-index: 1; display: flex; flex-direction: column; gap: 3px; }\n.photo-widget-caption small { font-size: 8px; letter-spacing: .1em; font-weight: 650; opacity: .8; }\n.photo-widget-caption strong { font-size: 13px; letter-spacing: -.03em; }\n.month-widget { background: #253744b8; backdrop-filter: blur(25px) saturate(1.2); color: white; }\n.month-widget > strong { display: block; font-size: 11px; font-weight: 650; margin-bottom: 10px; }\n.widget-month { display: grid; grid-template-columns: repeat(7,minmax(0,1fr)); gap: 3px 1px; font-size: 7.5px; line-height: 1; text-align: center; }\n.widget-month > span { aspect-ratio: 1; display: grid; place-items: center; min-height: 12px; }\n.widget-month .week-letter { opacity: .55; font-size: 6.5px; }.widget-month .current-day { background: #ff5a50; border-radius: 50%; color: white; font-weight: 700; }\n.home-apps { gap: 21px 8px; animation: page-enter .2s ease-out; }\n.case-board { display: grid; gap: 12px; }\n.case-board h2, .case-board h3 { margin: 4px 0 0; }\n.case-board-sources { display: grid; gap: 10px; }\n.case-board-source { display: grid; gap: 7px; width: 100%; min-height: 78px; padding: 13px 14px; border: 1px solid var(--line); border-radius: 16px; background: var(--surface); color: var(--text); text-align: left; font: inherit; }\n.case-board-source.selected { border-color: #15806e; box-shadow: 0 0 0 2px #15806e33; }\n.case-board-source-head { display: flex; justify-content: space-between; gap: 8px; align-items: start; }\n.case-board-source-head small { flex: none; color: var(--accent); font-size: 10px; letter-spacing: .08em; }\n.case-board-source > span:not(.case-board-source-head), .case-board-source > small { color: var(--muted, #5e7070); font-size: 12px; line-height: 1.45; }\n.case-board-link, .case-board-status { display: grid; gap: 7px; padding: 13px 14px; border-radius: 15px; background: var(--surface); }\n.case-board-link { grid-template-columns: 1fr auto; align-items: center; }\n.case-board-link small, .case-board-status span { display: block; color: var(--muted, #5e7070); font-size: 12px; line-height: 1.5; }\n@keyframes page-enter { from { opacity: .5; transform: translateX(10px); } to { opacity: 1; transform: translateX(0); } }\n.app-tile { gap: 7px; min-height: 83px; font-size: 11px; letter-spacing: -.015em; font-weight: 500; text-shadow: 0 1px 5px #081b2faa; }\n.native-icon { width: 58px; height: 58px; border-radius: 14px; border: none; box-shadow: 0 3px 8px #15242e28,inset 0 0 0 .5px #ffffff65; color: #fff; transition: transform .16s ease, filter .16s ease; text-shadow: none; }\n.native-icon > svg:not(.native-icon-glyph) { width: 100%; height: 100%; border-radius: inherit; }\n.native-icon .photos-flower { padding: 4px; }\n.app-tile:hover .app-icon, .dock button:hover .app-icon { transform: none; filter: brightness(1.08); }\n.app-tile:active .app-icon, .dock button:active .app-icon { transform: scale(.9); filter: brightness(.85); }\n.icon-calls, .icon-messages { background: linear-gradient(180deg,#58e66b,#12be43); }\n.icon-calls .native-icon-glyph, .icon-messages .native-icon-glyph { fill: #fff; stroke-width: 1; }\n.icon-photos, .icon-calendar, .icon-files, .icon-notes { background: #fff; color: #15161a; }\n.icon-search { background: linear-gradient(#39bcfb,#0879ed); }.icon-maps { background: #d5e7d4; }\n.icon-bulletin { background: linear-gradient(155deg,#fffdf3,#e8e3d5); color: #263e4b; }\n.icon-contacts { background: linear-gradient(145deg,#ddcfba,#bda88f); color: #6f6458; }.icon-contacts svg { fill: #f7f1e7; }\n.icon-alerts { background: linear-gradient(#ff715b,#f13b48); }.icon-alerts svg { fill: #fff; }\n.icon-settings { background: linear-gradient(#dadde2,#999da7); color: #454b55; }.icon-archive { background: linear-gradient(#364d5d,#182c3a); color: #e9d6b0; }\n.calendar-icon { display: flex; flex-direction: column; align-items: center; justify-content: center; padding-top: 2px; height: 100%; }\n.calendar-icon > span { color: #f14f43; font-size: 10px; font-weight: 700; line-height: 1.2; }.calendar-icon strong { font-size: 34px; font-weight: 400; letter-spacing: -.06em; line-height: 1.04; }\n.notes-icon { position: absolute; inset: 0; padding: 24px 8px 0; border-radius: inherit; background: linear-gradient(#ffdc55 0 27%,#fff 27%); overflow: hidden; }\n.notes-icon i { display: block; height: 1px; background: #dedde1; margin: 5px 0; }\n.bulletin-icon { width: 100%; height: 100%; padding: 4px 12px; }.bulletin-icon b { font: 700 36px/1.04 Georgia,serif; display: block; text-align: center; }.bulletin-icon i { display: block; height: 2px; background: #b8b09f; margin-top: 3px; }\n.badge { background: #ff3c36; color: #fff; border: 0; font-size: 12px; min-width: 20px; height: 20px; top: -5px; right: -5px; font-weight: 500; }\n.home-summary { padding: 20px; min-height: 149px; border-radius: 22px; background: #263d4fa6; backdrop-filter: blur(22px); border: 1px solid #fff2; display: flex; flex-direction: column; justify-content: center; gap: 8px; margin-bottom: 24px; }\n.home-summary small { font-size: 9px; letter-spacing: .1em; opacity: .7; }.home-summary strong { font-size: 22px; letter-spacing: -.04em; }.home-summary span { font-size: 12px; color: #dbe4eb; }\n.story-home-alert { min-height: 77px; width: 100%; margin: 24px 0 0; padding: 12px; border-radius: 20px; border: 1px solid #ffffff40; background: #e4eaf0c7; color: #1b2733; display: flex; align-items: center; gap: 10px; backdrop-filter: blur(28px) saturate(1.4); box-shadow: 0 4px 20px #0b1a2a12; }\n.story-home-alert .notification-app-mark { flex: none; display: grid; place-items: center; width: 32px; height: 32px; border-radius: 9px; background: #fffaf0; font: 700 24px Georgia,serif; color: #304553; }\n.story-home-alert .notification-copy { display: flex; flex: 1; min-width: 0; flex-direction: column; gap: 3px; color: #33404c; font-size: 11px; }\n.story-home-alert .notification-source { display: flex; align-items: center; justify-content: space-between; font-size: 8px; letter-spacing: .07em; color: #53606c; font-weight: 550; }\n.notification-source time { font-weight: 400; letter-spacing: 0; font-size: 10px; }.story-home-alert strong { font-size: 12px; font-weight: 650; }\n.home-bottom { padding: 0 17px 6px; }\n.page-indicators { gap: 0; margin-bottom: 6px; min-height: 26px; align-items: center; }\n.page-indicators button, .page-indicators button.active { width: 27px; height: 26px; border-radius: 0; background: none; display: grid; place-items: center; }\n.page-indicators button span { width: 6px; height: 6px; background: #ffffff65; border-radius: 20px; }.page-indicators button.active span { width: 18px; background: #fff; }\n.dock { padding: 14px 22px; border-radius: 29px; background: #c7d6df3b; border: 1px solid #ffffff32; backdrop-filter: blur(25px) saturate(1.3); box-shadow: 0 7px 25px #0a15251c; }\n.dock button { min-height: 58px; min-width: 66px; }.dock .native-icon { width: 58px; height: 58px; }\n\n/* Calm, platform-like app chrome. */\n.app-header { min-height: 62px; gap: 7px; padding: 7px 12px 12px; border-bottom: .5px solid var(--line); backdrop-filter: blur(24px); }\n.app-header h1 { font-size: 25px; font-weight: 700; letter-spacing: -.035em; }.app-header p { font-size: 8px; font-weight: 500; letter-spacing: .07em; color: var(--muted); }\n.icon-button { border-radius: 50%; }.icon-button.bare { background: none; }\n.utility-content { padding: 20px 18px 26px; }.utility-card { border: none; border-radius: 16px; box-shadow: none; }\n.utility-card h2 { letter-spacing: -.02em; }.utility-card p { font-size: 14px; }\n.action-button, .primary-button { border-radius: 13px; font-weight: 600; }\n.search-field, .reply-search { background: var(--raised); border: 0; border-radius: 11px; }\n.search-field input, .reply-search input { min-height: 38px; padding: 8px 10px; font-size: 15px; }\n.photo-placeholder { background-image: url('/greyhaven-phone-wallpaper.png'); height: 350px; }\n.settings-group { border: 0; border-radius: 12px; }.settings-row { min-height: 59px; }.setting-icon { width: 31px; height: 31px; border-radius: 7px; }.setting-copy strong { font-weight: 500; }\n\n/* Messenger shares the same readable light/dark system palette. */\n.native-inbox-header { padding: 4px 22px 14px; background: var(--surface); }\n.native-inbox-toolbar { min-height: 34px; display: flex; align-items: center; }\n.native-back-button { border: 0; background: none; color: var(--accent); min-height: 44px; padding: 0; display: inline-flex; align-items: center; gap: 0; font-size: 15px; }\n.native-inbox-header h1 { font-size: 34px; font-weight: 700; letter-spacing: -.05em; margin: 5px 0 15px; }\n.native-inbox-search { display: flex; gap: 6px; align-items: center; color: var(--muted); background: var(--raised); border-radius: 10px; padding: 0 10px; }\n.native-inbox-search input { color: var(--text); min-height: 37px; min-width: 0; width: 100%; border: 0; outline: 0; background: transparent; font-size: 16px; }\n.native-messenger.inbox-screen { background: var(--surface); }.native-messenger .inbox-content { padding: 4px 21px 24px; }\n.thread-row { min-height: 91px; gap: 13px; }.thread-text strong { font-size: 17px; font-weight: 600; }.thread-text small { font-size: 14px; margin-top: 5px; }\n.thread-timestamp { display: flex; align-items: center; gap: 2px; font-size: 11px; }.contact-avatar { background: linear-gradient(140deg,#8c9ea9,#506774); font-weight: 500; }\n.inbox-footnote { font-size: 12px; line-height: 1.5; }.inbox-no-results { color: var(--muted); text-align: center; font-size: 14px; margin-top: 25px; }\n.native-chat-header { position: relative; min-height: 87px; padding: 3px 15px 9px; display: flex; justify-content: center; border-bottom: .5px solid var(--line); background: var(--header); }\n.native-chat-header > .native-back-button { position: absolute; left: 10px; top: 15px; }\n.native-chat-contact { display: flex; flex-direction: column; align-items: center; gap: 3px; }\n.native-chat-contact .contact-avatar { width: 36px; height: 36px; font-size: 17px; }.native-chat-contact strong { font-size: 13px; font-weight: 600; }.native-chat-contact small { font-size: 9px; color: var(--muted); display: flex; align-items: center; gap: 3px; }\n.chat-scroll { padding: 12px 13px 22px; }.chat-date { background: transparent; font-size: 11px; font-weight: 500; padding: 3px 0; margin: 12px auto; }\n.bubble { max-width: 83%; border-radius: 19px; padding: 10px 13px 7px; }.bubble p { font-size: 15px; line-height: 1.4; }.bubble small { font-size: 9px; }\n.bubble-row.group-start { margin-top: 13px; }.bubble-avatar { width: 22px; height: 22px; font-size: 10px; }.bubble.fixture { border-bottom-left-radius: 7px; }.bubble.player { border-bottom-right-radius: 7px; }\n.bubble.maya { background: var(--incoming); border-bottom-left-radius: 7px; }\n.composer { padding: 9px 13px 11px; background: var(--header); border-top: .5px solid var(--line); max-height: min(42vh,290px); }\n.composer-title span, .slice-composer .section-caption { font-size: 9px; font-weight: 600; letter-spacing: .07em; }.composer-title small { font-size: 9px; }\n.choice { background: var(--surface); border: 1px solid var(--line); border-radius: 12px; min-height: 44px; padding: 10px 12px; font-size: 13px; }\n.choice.selected { background: color-mix(in srgb,var(--accent) 7%,var(--surface)); border-color: var(--accent); box-shadow: none; }\n.send-button { background: var(--button-accent); border-radius: 22px; min-height: 40px; font-weight: 600; }.send-button:disabled { opacity: .35; }\n.fixture-disclaimer { font-size: 10px; color: var(--muted); padding-bottom: 9px; }.composer-wait { font-size: 12px; }\n.slice-thread-heading { min-height: 62px; padding: 8px 15px; }.slice-thread-heading .contact-avatar { width: 37px; height: 37px; }\n.slice-footer { padding: 6px 13px 8px; }.slice-footer .slice-action { background: transparent; color: var(--accent); min-height: 38px; padding: 7px 10px; font-size: 13px; border: 1px solid var(--line); border-radius: 12px; }\n.slice-composer { max-height: min(38vh,260px); }.slice-chat-area { min-height: 65px; }.slice-action { margin-top: 12px; }.slice-source pre { border-radius: 10px; }\n.slice-content > .section-caption { color: var(--muted); font-size: 9px; letter-spacing: .08em; }.slice-content h2 { letter-spacing: -.03em; }.slice-content .utility-card { padding: 18px; }\n\n@media (min-width: 600px) {\n  .app-root { padding: 20px; align-items: center; }\n  .device { width: 414px; height: min(896px,100%); border: 7px solid #101217; border-radius: 47px; box-shadow: 0 25px 80px #0008,0 0 0 1px #68707b,0 0 0 3px #252b34; }\n  .status-bar { padding-left: 21px; padding-right: 21px; }\n  .native-app { padding: 0; }.native-app .device { height: 100%; border: 0; border-radius: 0; }\n}\n@media (max-width: 360px) {\n  .status-bar { padding-left: 18px; padding-right: 18px; }.status-time { width: 47px; }.device-island { width: 76px; height: 24px; }\n  .home-content { padding-left: 19px; padding-right: 19px; }.widgets { gap: 12px; }.widgets .widget { padding: 11px; border-radius: 19px; }.widget-month { font-size: 6.5px; gap: 1px; }.month-widget > strong { font-size: 10px; margin-bottom: 6px; }\n  .native-icon, .dock .native-icon { width: 52px; height: 52px; border-radius: 13px; }.app-tile { min-height: 76px; font-size: 10px; }.home-apps { gap: 17px 3px; }.dock { padding: 12px 15px; }.home-topline { margin-bottom: 4px; }\n  .photo-widget-caption { left: 11px; bottom: 11px; }.photo-widget-caption strong { font-size: 11px; }.story-home-alert { padding: 10px; gap: 8px; }.story-home-alert strong { font-size: 11px; }.story-home-alert .notification-copy { font-size: 9px; }\n}\n@media (max-height: 680px) {\n  .home-topline { min-height: 28px; margin-bottom: 4px; }.widgets { margin-bottom: 18px; }.widgets .widget { aspect-ratio: auto; height: 120px; }.widget-month { gap: 1px; font-size: 7px; }.widget-month > span { min-height: 10px; aspect-ratio: auto; height: 11px; }.month-widget > strong { margin-bottom: 7px; }\n  .home-apps { gap: 11px 4px; }.app-tile { min-height: 74px; }.story-home-alert { margin-top: 16px; min-height: 68px; }.home-bottom { padding-bottom: 3px; }.dock { padding-top: 10px; padding-bottom: 10px; }\n  .lock-clock { padding-top: 8px; }.lock-clock h1 { font-size: 80px; }.lock-bottom > p { margin-bottom: 14px; }\n  .native-chat-header { min-height: 72px; padding-top: 0; }.native-chat-contact .contact-avatar { width: 28px; height: 28px; font-size: 14px; }\n}\n@media (prefers-reduced-motion: reduce) {\n  .phone-content, .home-apps { animation: none; }.native-icon { transition: none; }\n}\n.slice-native-header { gap: 10px; min-height: 67px; padding: 7px 14px 10px 5px; }\n.slice-native-header .native-back-button { min-width: 32px; }\n.slice-native-header strong { font-size: 16px; font-weight: 600; }\n.slice-native-header small { font-size: 10px; margin-top: 3px; }\n.slice-native-header .channel-lock { margin-left: auto; color: var(--muted); }\n/* Final fit and contrast checks at small phone sizes. */\n.lock-clock h1 { font-weight: 300; }\n.month-widget { display: flex; flex-direction: column; }\n.month-widget > strong { flex: none; }\n.widget-month { flex: 1; min-height: 0; grid-template-rows: repeat(6,minmax(0,1fr)); }\n.widget-month > span { aspect-ratio: auto; min-height: 0; height: auto; }\n.widget-month .current-day { justify-self: center; width: 16px; height: 16px; align-self: center; }\n.story-home-alert .notification-copy > span:last-child { color: #4b5965; }\n@media (max-height: 620px) {\n  .home-topline { min-height: 26px; margin-bottom: 4px; }.home-topline button { width: 26px; min-height: 26px; }\n  .widgets { margin-bottom: 14px; }.widgets .widget { height: 100px; padding: 9px 11px; border-radius: 17px; }\n  .month-widget > strong { font-size: 9px; margin-bottom: 5px; }.widget-month { font-size: 6.5px; }.widget-month .current-day { width: 12px; height: 12px; }\n  .home-apps { gap: 8px 3px; }.app-tile { min-height: 64px; gap: 5px; font-size: 10px; }.native-icon, .dock .native-icon { width: 47px; height: 47px; border-radius: 12px; }\n  .native-icon-glyph { width: 30px; height: 30px; }.calendar-icon strong { font-size: 28px; }.calendar-icon > span { font-size: 8px; }\n  .story-home-alert { min-height: 62px; margin-top: 12px; padding: 9px 10px; }.home-content { padding-bottom: 10px; }\n  .dock { padding: 9px 18px; border-radius: 24px; }.dock button { min-height: 47px; }.page-indicators { min-height: 22px; margin-bottom: 3px; }.page-indicators button, .page-indicators button.active { height: 22px; }\n}\n"],["STYLE",{},"/* Fictional city cartography. All map controls operate locally. */\n.maps-screen {\n  --map-land: #eeede6; --map-block: #e3dfd5; --map-block-edge: #d2cfc5;\n  --map-water: #b6dbe2; --map-bank: #e4e9df; --map-park: #d3e1c6;\n  --map-road: #fffdf6; --map-road-edge: #dedbd0; --map-label: #727c74;\n  flex: 1; min-height: 0; display: flex; flex-direction: column; background: var(--map-land);\n}\n.theme-dark .maps-screen {\n  --map-land: #263438; --map-block: #334246; --map-block-edge: #3e4e51;\n  --map-water: #194d60; --map-bank: #385656; --map-park: #344c40;\n  --map-road: #4e5d5c; --map-road-edge: #233436; --map-label: #bdccc5;\n}\n.maps-explore { flex: 1; min-height: 170px; position: relative; overflow: hidden; }\n.city-map-viewport { position: absolute; inset: 140px 0 0; touch-action: none; overflow: hidden; cursor: grab; }\n.city-map-viewport:active { cursor: grabbing; }.city-map-viewport:focus-visible { outline-offset: -4px; }\n.city-map-art { width: 100%; height: 100%; display: block; }\n.map-land-base { fill: var(--map-land); }.map-blocks { fill: var(--map-block); stroke: var(--map-block-edge); stroke-width: 2; }\n.map-park { fill: var(--map-park); }.map-park-path { fill: none; stroke: var(--map-road); stroke-width: 6; }\n.map-street-edge, .map-streets, .map-local-street { fill: none; stroke-linecap: round; }\n.map-street-edge { stroke: var(--map-road-edge); stroke-width: 31; }.map-streets { stroke: var(--map-road); stroke-width: 24; }\n.map-local-street { stroke: var(--map-road); stroke-width: 12; }.map-square-land { fill: #d5d4c4; }.theme-dark .map-square-land { fill: #596052; }\n.map-square-walk { fill: none; stroke: var(--map-road); stroke-width: 5; }.map-trees { fill: #a7c89c; stroke: #91b889; stroke-width: 2; }.theme-dark .map-trees { fill: #486d50; stroke: #527a59; }\n.map-river-edge { fill: var(--map-bank); }.map-river { fill: var(--map-water); }.map-river-line { stroke: #ffffff35; stroke-width: 2; fill: none; }\n.map-bridge-edge { fill: none; stroke: var(--map-road-edge); stroke-width: 39; }.map-bridges { fill: none; stroke: var(--map-road); stroke-width: 29; }.map-bridge-line { fill: none; stroke: #dfc59d; stroke-width: 5; }\n.map-district-labels { fill: var(--map-label); font-size: 19px; letter-spacing: 3px; font-weight: 550; }.map-canal-label { fill: #508998; font-size: 19px; font-style: italic; }.theme-dark .map-canal-label { fill: #84b4bd; }\n.map-building-landmarks { fill: #d9c5a7; stroke: #bfa985; stroke-width: 3; }.theme-dark .map-building-landmarks { fill: #8a795d; stroke: #c0ac8c; }\n.maps-top-panel { position: absolute; top: 0; left: 0; right: 0; padding: 4px 17px 10px; z-index: 4; background: var(--header); border-bottom: 1px solid var(--line); backdrop-filter: blur(20px); }\n.maps-heading { display: flex; align-items: center; gap: 5px; margin-bottom: 10px; }.maps-heading > .icon-button { margin-left: -10px; }\n.maps-heading h1 { font-size: 27px; letter-spacing: -.045em; margin: 0; line-height: 1.1; }.maps-heading > div > span { font-size: 11px; color: var(--muted); }\n.map-offline { font-size: 10px; color: var(--muted); margin-left: auto; display: flex; align-items: center; gap: 5px; }.map-offline i { width: 5px; height: 5px; border-radius: 50%; background: #439a78; }\n.maps-search { height: 39px; display: flex; align-items: center; gap: 7px; border-radius: 11px; background: var(--raised); padding: 0 10px; color: var(--muted); }\n.maps-search input { min-width: 0; flex: 1; width: 100%; background: none; border: 0; color: var(--text); font-size: 15px; height: 100%; outline: 0; }\n.maps-search button { display: grid; place-items: center; border: 0; color: var(--muted); background: transparent; width: 30px; min-height: 35px; }\n.map-categories { display: flex; gap: 7px; padding-top: 8px; }.map-categories button { display: flex; align-items: center; justify-content: center; gap: 5px; border-radius: 20px; border: 1px solid var(--line); color: var(--text); background: var(--surface); padding: 6px 10px; font-size: 11px; min-height: 31px; flex: 1; }\n.map-categories .selected { background: #1779e4; border-color: #1779e4; color: #fff; }\n.map-search-results { position: absolute; top: 104px; left: 17px; right: 17px; border: 1px solid var(--line); border-radius: 12px; background: var(--surface); box-shadow: 0 10px 25px #142e4126; overflow: hidden; max-height: 210px; overflow-y: auto; }\n.map-search-results button { display: flex; align-items: center; gap: 10px; width: 100%; color: var(--text); border: 0; border-bottom: 1px solid var(--line); background: transparent; padding: 15px 12px; text-align: left; }.map-search-results button > span { flex: 1; }.map-search-results strong, .map-search-results small { display: block; }.map-search-results strong { font-size: 14px; }.map-search-results small { color: var(--muted); font-size: 11px; margin-top: 4px; }.map-search-results p { padding: 15px; font-size: 13px; margin: 0; line-height: 1.5; }\n.city-place-pin { position: absolute; z-index: 2; transform: translate(-50%,-50%); border: 0; color: #fff; width: 44px; height: 44px; padding: 0; background: none; display: grid; place-items: center; }\n.city-place-pin > span { width: 33px; height: 33px; display: grid; place-items: center; border-radius: 50%; background: var(--pin); border: 2.5px solid #fff; box-shadow: 0 3px 8px #304f4833; }\n.pin-square { --pin: #dc7552; }.pin-library { --pin: #a16ba0; }.pin-station { --pin: #4286bb; }\n.city-place-pin.is-selected { z-index: 3; }.city-place-pin.is-selected > span { width: 41px; height: 41px; box-shadow: 0 0 0 6px #ffffff60,0 4px 12px #304f4840; }\n.city-place-pin strong { position: absolute; top: 47px; left: 50%; transform: translateX(-50%); white-space: nowrap; font-size: 11px; font-weight: 650; color: #384c4e; text-shadow: 0 1px 2px #fff,0 -1px 2px #fff,1px 0 2px #fff,-1px 0 2px #fff; pointer-events: none; }\n.theme-dark .city-place-pin strong { color: #fff; text-shadow: 0 1px 3px #132828,0 -1px 3px #132828; }\n.map-tools { position: absolute; right: 12px; bottom: 38px; z-index: 3; display: flex; flex-direction: column; gap: 10px; }\n.map-tools > div { border-radius: 13px; overflow: hidden; background: var(--surface); box-shadow: 0 2px 12px #132f4026; }\n.map-tools button { width: 40px; height: 40px; border: 0; background: var(--surface); color: var(--accent); display: grid; place-items: center; }.map-tools > button { border-radius: 13px; box-shadow: 0 2px 12px #132f4026; }.map-tools > div button + button { border-top: 1px solid var(--line); }.map-tools button:disabled { color: var(--muted); opacity: .5; }\n.map-compass { width: 40px; height: 49px; display: flex; flex-direction: column; align-items: center; justify-content: center; background: var(--surface); border-radius: 30px; box-shadow: 0 2px 12px #132f401c; }.map-compass b { font-size: 9px; color: var(--muted); }.map-compass i { width: 8px; height: 18px; background: linear-gradient(#c96653 50%,#d5d8dc 50%); clip-path: polygon(50% 0,100% 50%,50% 100%,0 50%); margin-top: 2px; }\n.map-attribution { position: absolute; left: 12px; bottom: 12px; color: var(--map-label); font-size: 7px; font-weight: 650; letter-spacing: .06em; background: var(--map-land); padding: 4px 6px; border-radius: 3px; pointer-events: none; }\n.map-place-sheet { position: relative; z-index: 5; flex: none; max-height: 44%; overflow-y: auto; background: var(--surface); border-radius: 24px 24px 0 0; box-shadow: 0 -4px 24px #17384513; margin-top: -8px; padding: 0 20px 15px; }\n.map-sheet-toggle { display: grid; place-items: center; width: 100%; min-height: 25px; padding: 0; border: 0; background: transparent; }.map-sheet-toggle > span { width: 34px; height: 4px; background: var(--line); border-radius: 5px; }\n.map-place-summary { display: flex; align-items: center; gap: 12px; margin: 4px 0 17px; }.place-symbol { background: var(--pin); width: 47px; height: 47px; border-radius: 14px; color: #fff; display: grid; place-items: center; flex: none; }\n.map-place-summary > div { flex: 1; min-width: 0; }.map-place-summary small { font-size: 10px; color: var(--muted); }.map-place-summary h2 { margin: 3px 0 4px; font-size: 21px; letter-spacing: -.04em; line-height: 1.1; }.map-place-summary p { font-size: 11px; color: var(--muted); margin: 0; }.map-place-summary > button { border: 0; background: var(--raised); color: var(--muted); border-radius: 50%; width: 32px; height: 32px; display: grid; place-items: center; flex: none; }.map-place-summary .rotated { transform: rotate(180deg); }\n.map-place-meta { display: flex; justify-content: space-between; padding-top: 12px; border-top: 1px solid var(--line); font-size: 10px; color: var(--muted); }.map-place-meta span { display: inline-flex; gap: 4px; align-items: center; }\n.map-place-list { margin-top: 10px; }.map-place-list > button { width: 100%; display: flex; align-items: center; justify-content: space-between; background: transparent; color: var(--text); border: 0; border-top: 1px solid var(--line); padding: 13px 0; text-align: left; }.map-place-list strong,.map-place-list small { display: block; }.map-place-list strong { font-size: 13px; }.map-place-list small { font-size: 11px; margin-top: 4px; color: var(--muted); }.map-place-list p { font-size: 12px; color: var(--muted); }\n\n/* Keep the search header in flow so the map never sits beneath it. */\n.maps-explore{display:grid;grid-template-rows:auto minmax(0,1fr);min-height:0}\n.maps-screen .maps-top-panel{position:relative;grid-row:1;padding:8px 16px 12px}\n.maps-screen .city-map-viewport{position:relative;inset:auto;grid-row:2;min-height:0}\n.maps-screen .map-search-results{top:calc(100% + 6px);max-height:220px}\n.maps-screen .maps-search{height:44px}\n.maps-screen .map-categories button{min-height:40px;font-size:12px}\n.pin-north-quay{--pin:#237bba}.pin-gcro{--pin:#867047}.pin-memory-project{--pin:#8b689c}\n.city-place-pin.is-selected>span{background:#1677df;box-shadow:0 0 0 5px #1677df25,0 3px 10px #17384b40}\n.city-place-pin.is-selected strong{background:var(--surface);color:var(--text);text-shadow:none;padding:5px 8px;border-radius:8px;box-shadow:0 2px 7px #17384520}\n.maps-screen .map-tools button{width:44px;height:44px}\n.maps-screen .map-place-sheet{padding:0 16px 12px;scrollbar-width:thin}\n.maps-screen .map-place-summary{gap:12px;margin:2px 0 12px}\n.maps-screen .map-place-summary h2{font-size:22px;line-height:1.2}\n.maps-screen .map-place-summary p{font-size:12px;line-height:1.5;margin-top:4px}\n.maps-screen .map-place-summary>button{width:44px;height:44px}\n.maps-screen .map-place-meta{gap:8px;flex-wrap:wrap;line-height:1.5;padding-top:10px}\n\n/* Bulletin: a local publication, then a source-focused reading desk. */\n.bulletin-screen:not(.bulletin-chat) { --paper: #fffdf9; --paper-soft: #f2efe7; --ink: #263a3c; --ink-muted: #697673; --paper-line: #e3e1d8; --bulletin-accent: #316a60; background: #f6f5f0; }\n.theme-dark .bulletin-screen:not(.bulletin-chat) { --paper: #1b2b30; --paper-soft: #22363b; --ink: #ecede5; --ink-muted: #a8b6b1; --paper-line: #35494c; --bulletin-accent: #91c4b2; background: #142328; }\n.bulletin-header { flex: none; color: var(--ink); background: var(--paper); }\n.bulletin-brand { display: flex; align-items: center; padding: 9px 18px 15px 7px; gap: 6px; }.bulletin-brand > button { display: grid; place-items: center; width: 40px; min-height: 44px; background: none; color: var(--bulletin-accent); border: 0; flex: none; }.bulletin-brand > div { flex: 1; }.bulletin-brand > div > span { display: block; font-size: 7px; letter-spacing: .13em; font-weight: 650; margin-bottom: 4px; color: var(--ink-muted); }\n.bulletin-brand h1 { margin: 0; font: 700 33px/.95 Georgia,serif; letter-spacing: -1.5px; }.bulletin-brand-dot { color: #cc7054; }.bulletin-edition { font-size: 8px; letter-spacing: .08em; line-height: 1.6; color: var(--ink-muted); border-left: 1px solid var(--paper-line); padding-left: 13px; }\n.bulletin-sections { display: flex; list-style: none; margin: 0; padding: 0 19px; border-top: 1px solid var(--paper-line); border-bottom: 1px solid var(--paper-line); gap: 13px; }.bulletin-sections li { flex: 1; padding: 12px 0 11px; font-size: 10px; color: var(--ink-muted); white-space: nowrap; border-bottom: 2px solid transparent; }.bulletin-sections li > span { font-size: 8px; margin-right: 4px; opacity: .65; }.bulletin-sections .current { color: var(--bulletin-accent); border-bottom-color: var(--bulletin-accent); font-weight: 700; }\n.bulletin-screen .slice-content { padding: 19px 18px 32px; scrollbar-width: thin; scrollbar-color: var(--paper-line) transparent; color: var(--ink); }\n.bulletin-case-line { display: flex; align-items: center; justify-content: space-between; gap: 6px; font-size: 8px!important; letter-spacing: .09em!important; color: var(--ink-muted)!important; margin: 0 0 16px; }.bulletin-case-line > span:last-child { font-weight: 500; font-size: 7px; }\n.brief-cover { border: 1px solid var(--paper-line); border-radius: 17px; overflow: hidden; background: var(--paper); }\n.brief-cover-image { min-height: 156px; position: relative; padding: 20px; display: flex; align-items: flex-end; justify-content: space-between; gap: 10px; background: linear-gradient(0deg,#102724c9,transparent 95%),url('/greyhaven-phone-wallpaper.png') center 45% / cover; color: #fff; }.brief-cover-image > span:first-child { font-size: 9px; letter-spacing: .12em; line-height: 1.7; }.brief-cover-image b { font: 400 23px Georgia,serif; letter-spacing: -.03em; }.cover-image-label { font-size: 6px; letter-spacing: .07em; border: 1px solid #ffffff50; padding: 5px 6px; border-radius: 3px; }\n.brief-cover-copy { padding: 22px 20px 18px; }.bulletin-kicker { display: flex; align-items: center; gap: 6px; font-size: 8px; font-weight: 650; letter-spacing: .09em; color: var(--bulletin-accent); }.bulletin-kicker i { width: 5px; height: 5px; border-radius: 50%; background: #c67453; }\n.bulletin-screen .brief-cover h2, .bulletin-screen .bulletin-article h2 { font: 400 38px/1.02 Georgia,serif; letter-spacing: -1.7px; margin: 13px 0 16px; color: var(--ink); }\n.brief-cover-copy > p { font-size: 13px; color: var(--ink-muted); line-height: 1.65; margin-bottom: 20px; }.brief-byline, .article-byline { display: flex; align-items: center; gap: 9px; }.editor-monogram { width: 30px; height: 30px; display: grid; place-items: center; background: var(--paper-soft); color: var(--bulletin-accent); font: italic 18px Georgia,serif; border-radius: 50%; flex: none; }.brief-byline > div { flex: 1; }.brief-byline strong,.article-byline strong { display: block; font-size: 10px; font-weight: 600; }.brief-byline small,.article-byline small { display: block; font-size: 9px; color: var(--ink-muted); margin-top: 3px; }.brief-byline > svg { color: var(--bulletin-accent); }\n.brief-timeline { display: grid; grid-template-columns: repeat(3,1fr); padding: 15px 8px; border-top: 1px solid var(--paper-line); background: var(--paper-soft); }.brief-timeline > div { text-align: center; padding: 0 5px; }.brief-timeline > div + div { border-left: 1px solid var(--paper-line); }.brief-timeline b { display: block; font: 400 23px Georgia,serif; }.brief-timeline span { display: block; font-size: 6px; letter-spacing: .09em; margin: 3px 0 7px; }.brief-timeline small { display: block; font-size: 8px; color: var(--ink-muted); }\n.bulletin-article { background: var(--paper); padding: 23px 21px; border: 1px solid var(--paper-line); border-radius: 15px; }.article-byline { margin: 21px 0 25px; padding-bottom: 20px; border-bottom: 1px solid var(--paper-line); }.bulletin-article .article-body p { font-size: 14px; line-height: 1.8; color: var(--ink); margin: 0 0 20px; }.bulletin-article .article-body .article-lead { font: 400 19px/1.5 Georgia,serif; letter-spacing: -.2px; }.article-end { border-top: 1px solid var(--paper-line); padding-top: 18px; display: flex; align-items: center; gap: 12px; }.article-end > span { font: 700 32px Georgia,serif; color: var(--bulletin-accent); }.article-end p { font-size: 7px; letter-spacing: .08em; line-height: 1.7; margin: 0; color: var(--ink-muted); }.article-end small { font-size: 9px; letter-spacing: 0; }\n.bulletin-screen:not(.bulletin-chat) .slice-action { background: #285f56; color: #fff; font-size: 13px; border-radius: 12px; min-height: 48px; box-shadow: 0 3px 8px #20463e10; }.theme-dark .bulletin-screen:not(.bulletin-chat) .slice-action { background: #2b7566; }\n.bulletin-screen:not(.bulletin-chat) .choice { border-color: var(--paper-line); background: var(--paper); color: var(--ink); font-size: 12px; line-height: 1.5; padding: 13px; border-radius: 11px; }\n.bulletin-screen:not(.bulletin-chat) .choice.selected { border-color: var(--bulletin-accent); background: var(--paper-soft); }.bulletin-screen:not(.bulletin-chat) .utility-note { color: var(--ink-muted); font-size: 12px; line-height: 1.6; }\n.bulletin-screen:not(.bulletin-chat) .utility-card { background: var(--paper); border: 1px solid var(--paper-line); }.bulletin-screen:not(.bulletin-chat) .utility-card p { color: var(--ink-muted); line-height: 1.7; }.bulletin-screen:not(.bulletin-chat) .slice-feedback { background: var(--paper-soft); border-color: var(--bulletin-accent); color: var(--ink); }.bulletin-screen:not(.bulletin-chat) .slice-input { background: var(--paper); color: var(--ink); border-color: var(--paper-line); }\n.source-reader { border: 1px solid var(--paper-line); background: var(--paper); border-radius: 16px; padding: 16px; margin-bottom: 16px; }.source-topline { display: flex; align-items: center; justify-content: space-between; font-size: 9px; margin-bottom: 13px; }.source-topline > span:first-child { color: var(--bulletin-accent); display: flex; align-items: center; gap: 5px; font-weight: 750; }.source-topline > span:last-child { color: var(--ink-muted); background: var(--paper-soft); border-radius: 5px; padding: 5px 7px; }\n.bulletin-screen .source-reader h2 { font: 400 25px/1.13 Georgia,serif; letter-spacing: -.6px; margin: 0 0 9px; }.source-credit { font-size: 10px; line-height: 1.5; color: var(--ink-muted); margin: 0 0 18px; }\n.record-paper { border: 1px solid var(--paper-line); padding: 16px 13px 12px; background: var(--paper-soft); color: var(--ink); position: relative; }.source-preview .record-paper { border-top-style: dashed; border-bottom-style: dashed; }.record-paper-label { display: flex; align-items: center; gap: 10px; justify-content: space-between; font-size: 6px; letter-spacing: .1em; padding-bottom: 11px; border-bottom: 2px solid var(--ink-muted); color: var(--ink-muted); }.record-paper dl { margin: 13px 0 0; }.record-heading { font: 600 10px/1.5 ui-monospace,Consolas,monospace; margin: 7px 0; overflow-wrap: anywhere; }.record-reference { font: 9px/1.5 ui-monospace,Consolas,monospace; color: var(--ink-muted); margin: 10px 0 14px; overflow-wrap: anywhere; }\n.record-field { padding: 9px 0; border-top: 1px solid var(--paper-line); display: grid; grid-template-columns: minmax(70px,.65fr) minmax(0,1fr); gap: 8px; font: 9px/1.6 ui-monospace,Consolas,monospace; }.record-field dt { color: var(--ink-muted); }.record-field dd { margin: 0; overflow-wrap: anywhere; }.record-omission { text-align: center; color: var(--ink-muted); letter-spacing: .3em; margin: 5px; }.record-print-mark { display: inline-flex; flex-direction: column; gap: 4px; border: 1px dashed var(--ink-muted); color: var(--ink-muted); padding: 7px 9px; margin: 8px 0; }.record-print-mark small { font-size: 6px; letter-spacing: .08em; }.record-print-mark span { font: 9px ui-monospace,Consolas,monospace; }.record-crop-note { font: italic 8px/1.5 ui-monospace,Consolas,monospace; color: var(--ink-muted); }\n.source-boundary { display: flex; align-items: flex-start; gap: 5px; font-size: 9px; line-height: 1.5; color: var(--ink-muted); padding: 12px 0; }.source-boundary > svg { flex: none; }.source-text-view { border-top: 1px solid var(--paper-line); font-size: 10px; color: var(--bulletin-accent); }.source-text-view summary { display: flex; align-items: center; gap: 6px; cursor: pointer; padding: 12px 0 0; min-height: 35px; }.source-text-view summary::after { content: '+'; margin-left: auto; font-size: 16px; }.source-text-view[open] summary::after { content: '−'; }.source-text-view pre { font: 10px/1.6 ui-monospace,Consolas,monospace; white-space: pre-wrap; overflow-wrap: anywhere; color: var(--ink); margin-bottom: 0; }\n.record-comparison { border: 1px solid var(--paper-line); border-radius: 14px; overflow: hidden; background: var(--paper); margin: 20px 0; }.comparison-shared { display: flex; gap: 10px; align-items: center; padding: 14px; background: var(--paper-soft); color: var(--bulletin-accent); }.comparison-shared strong { display: block; font-size: 12px; color: var(--ink); }.comparison-shared small { display: block; font-size: 9px; color: var(--ink-muted); margin-top: 4px; }.comparison-columns { display: grid; grid-template-columns: 1fr 1fr; padding: 14px 0 12px; border-bottom: 1px solid var(--paper-line); }.comparison-columns > div { padding: 0 14px; }.comparison-columns > div + div { border-left: 1px solid var(--paper-line); }.comparison-columns span { font-size: 7px; letter-spacing: .04em; color: var(--bulletin-accent); font-weight: 650; }.bulletin-screen .comparison-columns h3 { font: 400 18px/1.2 Georgia,serif; margin: 7px 0 3px; letter-spacing: -.5px; }.comparison-columns small { font-size: 9px; color: var(--ink-muted); }\n.comparison-field { padding: 11px 14px; border-bottom: 1px solid var(--paper-line); }.comparison-field h4 { font-size: 8px; color: var(--ink-muted); font-weight: 500; text-transform: uppercase; letter-spacing: .07em; margin: 0 0 7px; }.comparison-field > div { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }.comparison-field span { font: 10px/1.6 ui-monospace,Consolas,monospace; color: var(--ink); }.comparison-field .redacted-field { color: var(--ink-muted); letter-spacing: .02em; }.comparison-footnote { display: flex; gap: 6px; align-items: center; color: var(--ink-muted); padding: 11px 14px; font-size: 9px; margin: 0; }\n/* Keep evidence legible at actual phone scale; source text remains available verbatim. */\n.record-lines { margin-top: 13px; }\n.record-paper .record-field { margin: 0; font-size: 11px; line-height: 1.65; grid-template-columns: minmax(75px,.6fr) minmax(0,1fr); }\n.record-heading { font-size: 11px; }.record-reference { font-size: 10px; }\n.record-paper-label { font-size: 7px; }.record-print-mark small { font-size: 7px; }.record-print-mark span { font-size: 10px; }.record-crop-note { font-size: 9px; }\n.source-credit, .source-boundary { font-size: 11px; }.source-text-view { font-size: 11px; }.source-text-view pre { font-size: 12px; }\n.comparison-field h4 { font-size: 9px; }.comparison-field span { font-size: 12px; }.comparison-footnote { font-size: 10px; }\n.comparison-columns span { font-size: 8px; }.comparison-columns small { font-size: 10px; }\n.bulletin-article .article-body p { font-size: 15px; }\n.phase-thread { margin: 18px 0; border: 1px solid var(--paper-line); background: var(--paper-soft); border-radius: 16px; padding: 13px; }\n.phase-thread > .section-caption { color: var(--ink-muted); font-size: 9px; letter-spacing: .08em; margin: 0 0 14px; }\n.phase-line { max-width: 88%; margin-bottom: 11px; padding: 12px 13px; border-radius: 15px; background: var(--paper); border: 1px solid var(--paper-line); color: var(--ink); }\n.phase-line.outgoing { margin-left: auto; background: #deede8; border-color: #c7ded4; }.theme-dark .phase-line.outgoing { background: #225447; border-color: #3c7061; }\n.phase-line small { display: block; margin-bottom: 6px; font-size: 9px; color: var(--ink-muted); }.phase-line p { margin: 0; font-size: 13px; line-height: 1.55; }\n.phase-line img, .phase-share-preview { display: block; width: 100%; height: auto; border-radius: 8px; margin: 10px 0; border: 1px solid var(--paper-line); }\n.phase-typing { font-size: 11px; color: var(--ink-muted); margin: 2px 0 0; }.phase-draft { margin: 18px 0; }.phase-draft > .section-caption { font-size: 9px; letter-spacing: .08em; color: var(--ink-muted); }\n.phase-draft .send-button { min-width: 125px; margin-left: auto; display: flex; align-items: center; justify-content: center; gap: 7px; padding: 9px 20px; border: 0; }\n.phase-permission .phase-permission-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-top: 14px; }.phase-permission .phase-permission-actions .choice { font-size: 11px; min-height: 52px; }\n.phase-permission > small { display: block; color: var(--ink-muted); line-height: 1.5; margin-top: 10px; }.phase-permission [role=\"status\"] { color: var(--bulletin-accent)!important; font-weight: 600; margin-top: 12px!important; }\n.phase-source-list { display: grid; gap: 9px; margin: 17px 0; }.phase-source-list button { text-align: left; background: var(--paper); color: var(--ink); border: 1px solid var(--paper-line); border-radius: 11px; padding: 13px; }.phase-source-list button.selected { border-color: var(--bulletin-accent); box-shadow: inset 3px 0 0 var(--bulletin-accent); }.phase-source-list strong,.phase-source-list small { display: block; }.phase-source-list strong { font-size: 13px; }.phase-source-list small { font-size: 10px; line-height: 1.5; color: var(--ink-muted); margin-top: 6px; }\n.phase-date-row { display: grid; gap: 7px; margin: 10px 0; }.phase-date-row strong { font-size: 13px; }.phase-date-row small { color: var(--ink-muted); line-height: 1.45; }.phase-date-row select { width: 100%; min-height: 40px; border: 1px solid var(--paper-line); border-radius: 8px; color: var(--ink); background: var(--paper-soft); padding: 8px; }\n.phase-export-page { white-space: pre-wrap; overflow-wrap: anywhere; font: 11px/1.65 ui-monospace,Consolas,monospace; color: var(--ink); background: var(--paper-soft); border-radius: 10px; padding: 12px; max-height: 380px; overflow: auto; }\n.phase-finale { min-height: 76%; display: flex; flex-direction: column; justify-content: center; padding: 24px 9px 48px; }.phase-finale .section-caption { color: var(--bulletin-accent); }.phase-finale h2 { font: 400 41px/1.03 Georgia,serif; letter-spacing: -1.2px; margin: 16px 0 22px; }.phase-finale .utility-card { margin-top: 28px; }.phase-finale p { font-size: 14px; line-height: 1.7; }\n@media (max-width: 360px) {\n  .maps-top-panel { padding-left: 13px; padding-right: 13px; }.map-place-sheet { padding-left: 15px; padding-right: 15px; }.map-place-summary h2 { font-size: 18px; }.map-place-summary { gap: 9px; }.place-symbol { width: 41px; height: 41px; }\n  .bulletin-brand h1 { font-size: 30px; }.bulletin-edition { font-size: 7px; }.bulletin-sections { gap: 7px; padding: 0 14px; }.bulletin-sections li { font-size: 9px; }\n  .bulletin-screen .slice-content { padding-left: 13px; padding-right: 13px; }.bulletin-screen .brief-cover h2,.bulletin-screen .bulletin-article h2 { font-size: 34px; }.brief-cover-copy { padding: 20px 17px; }.bulletin-article { padding: 20px 17px; }.source-reader { padding: 13px; }.record-paper { padding: 12px 10px; }.comparison-columns > div { padding-left: 11px; padding-right: 11px; }\n}\n@media (max-height: 640px) {\n  .maps-top-panel { padding-top: 0; }.maps-heading { margin-bottom: 5px; }.maps-heading h1 { font-size: 23px; }.maps-heading > div > span { display: none; }.maps-search { height: 35px; }.map-categories { padding-top: 6px; }.map-categories button { min-height: 28px; padding-top: 4px; padding-bottom: 4px; }.city-map-viewport { top: 122px; }.map-search-results { top: 86px; }\n  .map-place-summary { margin-bottom: 10px; }.map-place-meta { padding-top: 9px; }.map-place-sheet { padding-bottom: 10px; }.map-tools { gap: 5px; bottom: 25px; right: 8px; }.map-tools button { width: 34px; height: 34px; }.map-compass { display: none; }.map-attribution { font-size: 6px; bottom: 7px; }\n  .bulletin-brand { padding-top: 4px; padding-bottom: 10px; }.bulletin-sections li { padding-top: 9px; padding-bottom: 8px; }.brief-cover-image { min-height: 125px; }\n  .maps-screen .maps-top-panel{padding-top:4px;padding-bottom:8px}\n  .maps-screen .map-tools{bottom:24px;gap:5px}\n  .maps-screen:has(.map-place-sheet.expanded) .map-tools>div{display:none}\n  .maps-screen .map-place-summary h2{font-size:18px}\n}\n"],["STYLE",{},"/* The Archive · iPhone-inspired design system. Original artwork, no Apple assets. */\n:root{font-family:-apple-system,BlinkMacSystemFont,\"Inter\",\"Segoe UI\",sans-serif;font-synthesis:none}\n.app-root{--phone-bg:#f2f2f7;--surface:#fff;--raised:#e9e9ef;--text:#101014;--muted:#74747c;--line:#dedee5;--accent:#007aff;--button-accent:#007aff;--incoming:#e9e9eb;--outgoing:#007aff;--header:#f9f9fbeb;letter-spacing:-.012em}\n.app-root.theme-dark{--phone-bg:#000;--surface:#1c1c1e;--raised:#2c2c2e;--text:#f5f5f7;--muted:#9a9aa0;--line:#38383a;--accent:#0a84ff;--button-accent:#0a84ff;--incoming:#262628;--outgoing:#0a84ff;--header:#161618ee}\n.device{box-shadow:0 24px 85px #0008;overflow:hidden}\n.status-bar{background:var(--header);backdrop-filter:blur(24px);-webkit-backdrop-filter:blur(24px);height:calc(54px + env(safe-area-inset-top));}\n.device-island{height:29px;width:96px;top:calc(9px + env(safe-area-inset-top))}\n.system-nav{height:calc(24px + env(safe-area-inset-bottom));display:flex;justify-content:center;align-items:center}\n.system-nav button{height:23px}.gesture-line{width:108px;height:5px}\n.surface-home .status-bar,.surface-lock .status-bar{background:transparent;backdrop-filter:none}\n.surface-home .device-island,.surface-lock .device-island{box-shadow:0 1px 5px #0003}\n.lock-clock h1{font-size:clamp(76px,22vw,100px);font-weight:550;letter-spacing:-.075em}\n.lock-clock p{font-size:19px;font-weight:450}\n.opening-lock-message{background:#f8f9facc;color:#202126;border:1px solid #fff9;border-radius:21px;backdrop-filter:blur(30px) saturate(170%);padding:15px 17px;box-shadow:0 8px 34px #0003}\n.opening-lock-message span{color:#526071;font-weight:700}.opening-lock-message small{color:#3d4a59}\n.home-content{padding-left:20px;padding-right:20px}.home-apps{gap:17px 6px}.app-tile{font-size:11px;text-shadow:0 1px 8px #0008}.native-icon{box-shadow:0 3px 9px #0003}\n.dock{background:#e5ebf35a!important;backdrop-filter:blur(36px) saturate(175%);-webkit-backdrop-filter:blur(36px) saturate(175%);border:1px solid #fff4;border-radius:29px!important}\n.widgets .widget{border-radius:24px}.story-home-alert{backdrop-filter:blur(22px)}\n.app-header,.native-chat-header,.opening-chat-header{background:var(--header);backdrop-filter:blur(22px);-webkit-backdrop-filter:blur(22px);border-bottom:1px solid var(--line)}\n.app-header h1{font-size:30px;font-weight:700;letter-spacing:-.045em}.app-header p{font-size:11px;letter-spacing:.055em}\n.utility-card,.settings-group,.empty-card{border-radius:17px;box-shadow:none;border-color:var(--line)}\n.utility-content{background:var(--phone-bg)}.settings-row{min-height:55px}.setting-icon{border-radius:9px}\n.note-editor{border-radius:14px;background:var(--surface);font-size:16px;line-height:1.6}\n.search-field{border-radius:12px;background:var(--raised)}\n.native-messenger{background:var(--phone-bg)}.chat-area{background:var(--phone-bg)}\n.bubble{border-radius:19px;max-width:min(78%,330px);font-size:15px;line-height:1.4}\n.bubble.player{background:var(--outgoing);color:white}.bubble.fixture,.bubble.maya{background:var(--incoming);color:var(--text)}\n.composer{background:var(--header);backdrop-filter:blur(22px);border-top:1px solid var(--line)}.choice{border-radius:17px}\n/* Sophie: native-message layout while maintaining existing story/save actions. */\n.opening-screen{background:var(--phone-bg)!important;color:var(--text)!important}\n.opening-chat-header{padding:11px 18px;min-height:75px;justify-content:center;position:relative}\n.opening-chat-header>div{display:flex;flex-direction:column;align-items:center;gap:2px}.opening-chat-header>svg{position:absolute;right:20px;color:var(--accent)}\n.opening-avatar{background:linear-gradient(145deg,#a4b5c8,#596d83);color:white;box-shadow:0 2px 10px #0002}\n.opening-chat-header strong{font-size:14px;font-weight:650}.opening-chat-header small{font-size:10px;color:var(--muted)!important}\n.opening-thread{background:var(--phone-bg);padding:22px 15px!important;scroll-behavior:smooth}\n.opening-timestamp{color:var(--muted)!important;font-weight:600;font-size:11px;letter-spacing:.02em}\n.opening-bubble{background:var(--incoming)!important;color:var(--text)!important;border:0!important;border-radius:19px!important;font-size:15px;line-height:1.43;max-width:83%}\n.opening-bubble.player{background:var(--outgoing)!important;color:white!important;margin-left:auto;border-bottom-right-radius:6px!important}\n.opening-bubble.sophie{border-bottom-left-radius:6px!important}\n.opening-actions{background:var(--header)!important;border-top:1px solid var(--line)!important;backdrop-filter:blur(20px);padding:11px 15px calc(14px + env(safe-area-inset-bottom))!important}\n.opening-action-heading{color:var(--muted)!important;font-size:10px;letter-spacing:.08em}\n.opening-choice{border:1px solid var(--line)!important;border-radius:17px!important;background:var(--surface)!important;color:var(--text)!important;min-height:45px}\n.opening-choice.selected{border-color:var(--accent)!important;background:color-mix(in srgb,var(--accent) 10%,var(--surface))!important}\n.opening-primary{border-radius:15px!important;background:var(--accent)!important;color:#fff!important;min-height:47px}\n.opening-help{color:var(--muted)!important}.opening-attachment{background:var(--surface)!important;color:var(--text)!important;border-radius:18px!important;border:1px solid var(--line)!important}\n.opening-note{background:#fff6d9!important;color:#342e20!important;border-radius:16px!important;box-shadow:0 8px 24px #0001}\n.opening-recovery,.opening-mirror-stage,.opening-found{background:#08090d!important;color:#f4f5f9!important}\n.opening-stage-top{background:#14151a!important;border-bottom:1px solid #292930!important;color:#d4d5dc!important}\n.opening-recovery .opening-properties,.opening-legal,.opening-mismatch,.opening-hook{border-radius:18px!important}\n.opening-recovery .opening-primary,.opening-mirror-stage .opening-primary{background:#0a84ff!important}\n/* Mirror becomes a separate iOS-like home screen, with authentic document navigation. */\n.mirror{background:linear-gradient(155deg,#25374b 0%,#141a2b 49%,#0d1019 100%)!important;color:#f6f7fa!important}\n.mirror-top{background:#0e141dbb!important;backdrop-filter:blur(18px);border-bottom:1px solid #ffffff1d}\n.mirror-hero{border:0!important;background:transparent!important;padding:20px 10px 12px!important}\n.mirror-hero>svg{padding:10px;width:56px;height:56px;background:#ffffff14;border-radius:16px}\n.mirror-hero strong{font-size:27px;font-weight:700;letter-spacing:-.04em;margin-top:9px}\n.mirror-grid{grid-template-columns:repeat(3,minmax(0,1fr));gap:19px 8px;padding:12px 8px}\n.mirror-icon>span{border:1px solid #ffffff2b!important;background:linear-gradient(155deg,#4085c6,#1b4c7d)!important;border-radius:17px!important;width:61px!important;height:61px!important;box-shadow:0 4px 15px #0003}\n.mirror-icon:nth-child(2n)>span{background:linear-gradient(150deg,#707c90,#343d56)!important}\n.mirror-icon:nth-child(3n)>span{background:linear-gradient(150deg,#cca14a,#99733d)!important}\n.mirror-icon strong{font-weight:500!important;font-size:11px!important}.mirror-icon small{font-size:9px!important}\n.mirror-detail{background:#101115!important}.mirror-file{background:#25252b!important;border:0!important;border-bottom:1px solid #38383d!important;border-radius:12px!important;font-size:14px!important;min-height:52px}\n.mirror-file.is-active{background:#203e5d!important}.mirror-document{background:#1c1c21!important;border-color:#35353a!important;border-radius:18px!important}\n.mirror-compare{background:#0a84ff!important;border-radius:15px!important}\n@media(prefers-reduced-motion:reduce){.opening-thread{scroll-behavior:auto}.phone-content{animation:none}}\n\n/* Phase UI 02 · iMessage-inspired Messages experience (original game UI). */\n.native-messenger.inbox-screen,.native-messenger.chat-screen{background:var(--phone-bg)}\n.native-inbox-header{background:var(--phone-bg);padding:7px 18px 12px}\n.native-inbox-header h1{font-size:35px;font-weight:750;letter-spacing:-.05em}\n.native-inbox-search{background:var(--raised);border:0;border-radius:12px;min-height:37px}\n.native-messenger .inbox-content{background:var(--surface);padding:0 0 20px 16px}\n.thread-row{width:100%;padding:10px 18px 10px 0;min-height:82px;gap:12px;border-bottom:1px solid var(--line);text-align:left}\n.thread-row .contact-avatar{width:50px;height:50px;font-size:20px;border-radius:50%;background:linear-gradient(145deg,#849bad,#354d65);color:#fff}\n.thread-row .thread-text{min-width:0;flex:1}.thread-row .thread-text strong{font-size:16px}.thread-row .thread-text small{font-size:13px;line-height:1.35;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}\n.thread-meta{color:var(--muted)}.inbox-footnote{margin:20px 17px 0 0}\n.native-chat-header{min-height:89px;background:var(--header);border-bottom:1px solid var(--line);padding-bottom:10px}\n.native-chat-contact .contact-avatar{width:39px;height:39px;background:linear-gradient(145deg,#849bad,#354d65);color:white;border-radius:50%}\n.native-chat-contact .chat-title{text-align:center}.native-chat-contact .chat-title strong{font-size:13px}\n.native-chat-header .native-back-button{color:var(--accent);top:16px}\n.chat-scroll{padding:13px 12px 22px}.chat-date{color:var(--muted);text-align:center;font-size:11px}\n.bubble-row{margin:3px 0}.bubble-row.group-start{margin-top:12px}\n.bubble-row .bubble{max-width:82%;border:0;box-shadow:none;padding:10px 13px 8px;border-radius:18px}\n.bubble-row .bubble p{font-size:16px;line-height:1.38;white-space:pre-wrap}\n.bubble-row .bubble small{display:flex;gap:5px;align-items:center;justify-content:flex-end;font-size:10px;opacity:.68;margin-top:3px}\n.bubble-row .bubble.player{background:var(--outgoing);color:#fff;border-bottom-right-radius:5px}\n.bubble-row .bubble.maya,.bubble-row .bubble.fixture{background:var(--incoming);color:var(--text);border-bottom-left-radius:5px}\n.typing-dots{background:var(--incoming);border-radius:20px;padding:11px 14px}\n.composer{border-top:1px solid var(--line);background:var(--header);padding:10px 13px calc(11px + env(safe-area-inset-bottom));max-height:min(46vh,340px)}\n.composer-title{font-size:10px;color:var(--muted)}\n.composer .choices{gap:7px}.composer .choice{min-height:43px;background:var(--surface);border:1px solid var(--line);border-radius:18px;text-align:left;padding:11px 13px;font-size:14px}\n.composer .choice.selected{border:2px solid var(--accent);padding:10px 12px;background:color-mix(in srgb,var(--accent) 9%,var(--surface))}\n.composer .send-button{margin-top:9px;width:100%;min-height:43px;border-radius:22px;background:var(--accent);font-size:14px}\n/* Sophie is the opening iMessage thread; all existing reply permissions are preserved. */\n.opening-chat-header{min-height:91px;padding:5px 54px 9px;display:flex;justify-content:center;align-items:center;gap:5px;position:relative}\n.opening-chat-header .opening-avatar{width:38px;height:38px;flex:none}\n.opening-chat-header>div{flex:0 1 auto;min-width:0;text-align:center;display:flex;align-items:center;flex-direction:column}\n.opening-chat-header>svg{right:18px;top:19px;color:var(--accent)}\n.opening-chat-header .opening-chat-back{position:absolute;left:12px;top:18px;border:0;background:none;color:var(--accent);padding:7px}\n.opening-chat-header strong{font-size:13px}.opening-chat-header small{font-size:10px;max-width:210px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\n.opening-thread{padding:14px 13px 25px!important;gap:5px}\n.opening-timestamp{font-size:11px;letter-spacing:0;text-transform:none;padding:7px 0 10px}\n.opening-bubble{padding:10px 13px!important;font-size:16px!important;line-height:1.4!important;white-space:pre-wrap;max-width:83%!important}\n.opening-bubble.sophie{align-self:flex-start;background:var(--incoming)!important;border-bottom-left-radius:5px!important}\n.opening-bubble.player{align-self:flex-end;background:var(--accent)!important;border-bottom-right-radius:5px!important}\n.opening-actions{padding:10px 13px calc(12px + env(safe-area-inset-bottom))!important}\n.opening-action-heading{color:var(--muted);font-size:11px!important;letter-spacing:0!important}\n.opening-choice{font-size:14px;border-radius:20px!important;text-align:left!important;line-height:1.4}\n.opening-primary{border-radius:23px!important;background:var(--accent)!important}\n.opening-attachment{align-self:flex-start;max-width:87%;text-align:left}\n.opening-thread .opening-note{align-self:flex-start;max-width:96%}\n.imessage-preserved{padding:12px 15px;min-height:51px;border-top:1px solid var(--line);background:var(--header);display:flex;align-items:center;gap:10px;color:var(--muted);font-size:12px}\n.imessage-preserved .imessage-pill{flex:1;border:1px solid var(--line);border-radius:21px;padding:10px 14px;color:var(--muted);background:var(--surface)}\n@media(max-width:360px){.opening-chat-header small{max-width:164px}.thread-row .contact-avatar{width:43px;height:43px}}\n"],["STYLE",{},"/* Phase 04 recovered-device UI. Scoped to avoid changing the live player phone. */\r\n.mirror{position:relative;isolation:isolate;min-width:0;overflow:auto;overscroll-behavior:contain;color-scheme:dark}\r\n.mirror .mirror-grid{grid-template-columns:repeat(4,minmax(0,1fr));gap:18px 5px;padding:12px 0}\r\n.mirror .mirror-icon>span{width:54px!important;height:54px!important;border-radius:14px!important}\r\n.mirror .mirror-icon{min-height:84px;min-width:0}.mirror .mirror-icon small{font-size:9px!important}\r\n.mirror .mirror-hero{min-height:120px}.mirror .mirror-main{padding:12px 14px 24px}\r\n.mirror .mirror-detail{padding:12px 14px max(24px,env(safe-area-inset-bottom));min-height:100%}\r\n.mirror-app-toolbar{display:flex;align-items:center;justify-content:space-between;gap:8px}.mirror-app-toolbar .mirror-back{padding:0;min-height:44px}\r\n.mirror button{min-height:44px;touch-action:manipulation}.mirror button:focus-visible,.mirror input:focus-visible{outline:3px solid #7fc1ff;outline-offset:2px}\r\n.mirror-search{display:flex;align-items:center;gap:8px;border-radius:11px;background:#292a30;color:#c4c4cb;margin:14px 0;padding:0 11px}\r\n.mirror-search input{background:transparent;color:#fff;border:0;min-width:0;width:100%;min-height:44px;font-size:16px;outline:none}\r\n.mirror-tabs{display:flex;gap:6px;overflow:auto;margin:10px 0;padding-bottom:3px}.mirror-tabs button{flex:none;border:1px solid #45454d;border-radius:11px;background:#232329;color:#eee;padding:8px 11px;font-size:12px}\r\n.mirror-tabs button[aria-pressed=true]{background:#174876;border-color:#71b5fa;color:#fff}\r\n.mirror .mirror-file{display:flex;text-align:left;min-width:0;padding:12px;gap:9px}.mirror-file-copy{display:flex;flex-direction:column;gap:5px;min-width:0;flex:1}\r\n.mirror-file-copy strong{font-size:13px;font-weight:600;overflow-wrap:anywhere}.mirror-file-copy small{font-size:10px;color:#b5b5bf;line-height:1.4}\r\n.mirror-file-preview{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;font-size:12px;color:#c4c4cd;line-height:1.45}\r\n.mirror-time{font-size:11px!important;color:#b9bbc6!important;line-height:1.6}.mirror .mirror-document{padding:16px;margin-top:12px;overflow-wrap:anywhere}\r\n.mirror-source-details{margin:18px 0;border-top:1px solid #41414a;padding-top:10px}.mirror-source-details summary{min-height:44px;cursor:pointer;padding:12px 0;color:#a5d2ff;font-size:13px}\r\n.mirror dl{display:grid;grid-template-columns:90px minmax(0,1fr);gap:9px;font-size:12px;line-height:1.5}.mirror dt{color:#aaaebc}.mirror dd{margin:0;overflow-wrap:anywhere;color:#e4e5ec}\r\n.mirror-related{display:grid;gap:8px;margin:15px 0}.mirror-related strong{font-size:12px;color:#c2c4ce}.mirror-related button,.mirror-save-record,.mirror-workspace-button,.mirror-record-action{border:1px solid #4f6480;border-radius:11px;padding:10px;background:#1b334d;color:#cce7ff;text-align:left;line-height:1.4}\r\n.mirror-save-record{width:100%;margin-top:12px}.mirror-save-record:disabled{color:#9cddba;background:#1a352b;border-color:#467d62}\r\n.mirror-note-body button,.mirror-photo-record button,.mirror-evidence-board button,.mirror-media-viewer button{padding:10px 13px;color:#d2e8ff;border:1px solid #4a637b;border-radius:12px;background:#21374c;font:inherit;font-size:13px}\r\n.mirror-photo-record{display:grid;gap:10px;padding:14px 0}.mirror-photo-record>svg{color:#9da5b8}.mirror-photo-record strong{font-size:15px}\r\n.mirror .mirror-photo-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}\r\n.mirror .mirror-photo-art{border:1px dashed #737582;background:#272830!important;min-height:86px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;width:100%;aspect-ratio:1.3}\r\n.mirror-photo-art small{white-space:normal!important;font-size:10px;color:#d2d4df}.mirror-photo-tile{min-width:0;padding:5px!important}.mirror-photo-tile>small{white-space:normal!important;text-align:center;font-size:11px;line-height:1.4}\r\n.mirror-place-card,.mirror-contact-profile,.mirror-call-detail{display:flex;flex-direction:column;gap:10px;padding:18px 0}.mirror-contact-profile{align-items:center;text-align:center}.mirror-contact-avatar{height:80px;width:80px;background:#414551;border-radius:50%;display:grid;place-items:center}\r\n.mirror-contact-profile h4{font-size:23px;margin:5px 0}.mirror-contact-profile small{color:#b8b8c4}.mirror-address-bar{background:#34343b;border-radius:10px;padding:12px;font-size:12px;color:#bbc2d2}\r\n.mirror-readonly-composer{border:1px solid #55555d;border-radius:22px;color:#b6b7c1;font-size:12px;padding:12px;text-align:center;margin-top:15px}\r\n.mirror .mirror-lock-panel{text-align:left}.mirror-lock-panel input{font-size:16px;scroll-margin:80px 0 120px}.mirror-lock-panel label{font-size:13px}\r\n.mirror-evidence-board{padding:14px 0;font-size:13px;line-height:1.6;overflow-wrap:anywhere}.mirror-evidence-board h2{font-size:23px}.mirror-evidence-board p{color:inherit}\r\n.mirror-evidence-board button{min-height:44px}.mirror-evidence-board button:disabled{opacity:.5}.mirror-board-sources{display:grid;gap:10px;margin:16px 0}.mirror-board-sources>div{display:flex;gap:6px}.mirror-board-sources button:first-child{flex:1;text-align:left;min-width:0}.mirror-board-sources small{display:block;font-size:10px;margin-top:7px}\r\n.mirror-board-sources .selected{outline:2px solid #6ab3ff}.mirror-evidence-board article{border:1px solid #626674;padding:13px;border-radius:12px;margin:10px 0}\r\n.mirror-media-viewer{position:fixed;inset:0;z-index:40;max-width:100%;background:#101114;color:#f5f5fa;display:flex;flex-direction:column;overflow:hidden;text-align:left;transform:none}\r\n.mirror-media-viewer>header{display:flex;align-items:center;gap:12px;flex:none;padding:max(12px,env(safe-area-inset-top)) 14px 12px;border-bottom:1px solid #47474f;background:#17181d}\r\n.mirror-media-scroll{flex:1;min-height:0;overflow:auto;padding:24px 18px max(26px,env(safe-area-inset-bottom));overscroll-behavior:contain}.mirror-media-scroll h2{font-size:24px;line-height:1.3;overflow-wrap:anywhere}.mirror-media-scroll p{font-size:14px;line-height:1.6}\r\n.mirror-media-scroll button{margin:9px 8px 9px 0}.mirror-media-scroll button:disabled{opacity:.6}\r\n@media(min-width:600px){.mirror-media-viewer{position:absolute}}\r\n@media(max-width:340px){.mirror .mirror-icon>span{width:48px!important;height:48px!important}.mirror .mirror-icon strong{font-size:10px!important}.mirror-app-toolbar{flex-wrap:wrap}.mirror .mirror-detail{padding-left:11px;padding-right:11px}}\r\n@media(prefers-reduced-motion:reduce){.mirror *{animation:none!important;transition:none!important;scroll-behavior:auto!important}}\r\n\r\n.phase-thread-scroll{max-height:min(46dvh,380px);min-height:60px;overflow:auto;overscroll-behavior:contain;padding:3px 1px 14px}\r\n.opening-chat-header .icon-button{min-width:44px;min-height:44px}\r\n@media(max-height:600px){.mirror-media-viewer>header{padding-top:7px;padding-bottom:7px}.mirror-media-scroll{padding-top:14px}.mirror .mirror-lock-panel{gap:9px}}\r\n\r\n/* Portal at the device level keeps the viewer above simulated status/navigation chrome. */\r\n.device>.mirror-media-viewer{position:absolute;inset:0;z-index:1000;color-scheme:dark}\r\n.mirror-media-viewer button{min-height:44px;touch-action:manipulation}\r\n.mirror-media-viewer button:focus-visible{outline:3px solid #7fc1ff;outline-offset:2px}\r\n.mirror-media-viewer dl{display:grid;grid-template-columns:100px minmax(0,1fr);gap:10px;font-size:12px;line-height:1.6}\r\n.mirror-media-viewer dt{color:#aeb3c0}.mirror-media-viewer dd{margin:0;overflow-wrap:anywhere}\r\n\r\n.character-avatar{display:inline-flex;align-items:center;justify-content:center;flex-shrink:0;overflow:hidden;border-radius:50%}.character-avatar img{display:block;width:100%;height:100%;object-fit:cover}.mirror-contact-avatar.character-avatar{width:76px;height:76px}.mirror-identity{display:flex;align-items:center;gap:12px}.mirror-identity .character-avatar{width:42px;height:42px;background:#343640}\r\n\r\n.mirror-photo-art img{width:100%;height:100%;object-fit:cover;position:absolute;inset:0}.mirror-photo-art{position:relative;overflow:hidden}.mirror-photo-art small{position:relative;background:#101114dd;padding:3px 6px;border-radius:5px}.mirror-record-images{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;width:100%}.mirror-record-images button{min-width:0;overflow:hidden;padding:0 0 9px;display:flex;flex-direction:column;gap:8px}.mirror-record-images img{width:100%;height:120px;object-fit:cover}.mirror-record-images span{padding:0 6px}.mirror-image-pan{max-height:calc(48dvh + 2px);min-height:100px;overflow:auto;background:#08090b;border:1px solid #454956;overscroll-behavior:contain;touch-action:pan-x pan-y;outline-offset:-3px}.mirror-image-pan img{display:block;height:auto;max-height:none;object-fit:contain}.mirror-image-navigation,.mirror-zoom-controls{display:flex;align-items:center;justify-content:space-between;gap:6px}.mirror-media-scroll .mirror-image-navigation button,.mirror-media-scroll .mirror-zoom-controls button{margin:4px 0;padding:8px}.mirror-zoom-controls output{min-width:45px;text-align:center}.mirror-media-viewer>header strong{font-size:14px}.mirror-record-images button:focus-visible,.mirror-image-pan:focus-visible{outline:3px solid #7fc1ff}.mirror-media-scroll>h2{margin-top:0}\r\n\r\n.mirror-board-sources>div{flex-wrap:wrap}.mirror-board-sources button:first-child{flex:1 1 100%}.mirror-thumbnail-error{display:flex;align-items:center;justify-content:center;min-height:110px;padding:8px;font-size:12px}.mirror-photo-record .mirror-thumbnail-error{width:100%}\r\n\r\n.mirror-recovery-status { display: grid; grid-template-columns: 1fr 1fr; gap: 6px 16px; font-size: 12px; text-align: left; margin: 14px auto; }\r\n.mirror-recovery-status dd { margin: 0; font-weight: 600; }\r\n/* Daniel's recovered device: native app surfaces inside the existing phone shell. */\r\n.device:has(.mirror-on-home)>.status-bar{background:#342438;color:white;backdrop-filter:none}\r\n.device:has(.mirror-in-app)>.status-bar{background:#101114;color:white}\r\n.device:has(.mirror)>.system-nav{display:none}\r\n.mirror.mirror-on-home{background:radial-gradient(ellipse at 10% 0%,#c77c68 0,transparent 48%),radial-gradient(ellipse at 100% 30%,#785e9a 0,transparent 55%),linear-gradient(150deg,#332335 15%,#132636 65%,#071823)!important}\r\n.mirror.mirror-in-app{background:#101114!important}\r\n.mirror-device-switch{display:flex;justify-content:space-between;align-items:center;gap:8px;padding:5px 16px;min-height:36px;flex:none;font-size:10px;color:#e0dce5;background:#0002}\r\n.mirror-device-switch button{display:flex;align-items:center;gap:4px;min-height:36px;padding:0;background:transparent;border:0;color:#fff;font:inherit;font-size:11px}\r\n.mirror .mirror-main{display:flex;flex-direction:column;padding:14px 14px 0;overflow:auto}\r\n.mirror-wallpaper-date{display:flex;flex-direction:column;align-items:center;gap:7px;padding:17px 0 25px;color:#fff;text-shadow:0 2px 8px #0005}\r\n.mirror-wallpaper-date>span{font-size:20px;font-weight:600;letter-spacing:-.5px}.mirror-wallpaper-date>strong{font-size:11px;font-weight:400;letter-spacing:.06em;color:#eee2eb}\r\n.mirror .mirror-grid{gap:20px 5px;padding:8px 0 20px}\r\n.mirror .mirror-icon{min-height:83px;color:#fff;gap:7px;padding:0;text-shadow:0 1px 4px #0008}\r\n.mirror .mirror-icon>span{width:58px!important;height:58px!important;border-radius:15px!important;color:#fff!important;border:1px solid #ffffff30!important;box-shadow:0 5px 12px #0003; text-shadow:none}\r\n.mirror .mirror-icon strong{font-size:11px!important;font-weight:500!important;line-height:1.2}\r\n.mirror .mirror-app-messages>span,.mirror .mirror-app-calls>span{background:linear-gradient(#5be976,#17ae3b)!important}\r\n.mirror .mirror-app-mail>span{background:linear-gradient(#37bbff,#0875e6)!important}\r\n.mirror .mirror-app-gallery>span{background:conic-gradient(#ff6767,#f9cc45,#70d370,#55c3e9,#a580ec,#ff6767)!important}\r\n.mirror .mirror-app-notes>span{background:linear-gradient(#ffda55 0 29%,#f6f1dd 30%)!important;color:#8c793b!important}\r\n.mirror .mirror-app-files>span{background:linear-gradient(#e5f3ff,#fff)!important;color:#168cf0!important}\r\n.mirror .mirror-app-browser>span{background:radial-gradient(circle,#5bd3f5,#1877e8 65%,#e2f3ff 68%)!important}\r\n.mirror .mirror-app-contacts>span{background:linear-gradient(130deg,#c9bdb1,#726f70)!important}\r\n.mirror .mirror-app-maps>span{background:linear-gradient(35deg,#82c9a0 35%,#f8edd0 36% 45%,#69b9e4 46% 60%,#cee3b0 61%)!important;color:#164673!important}\r\n.mirror .mirror-app-index>span{background:linear-gradient(150deg,#3c495e,#151e2e)!important}\r\n.mirror .mirror-app-protected>span{background:linear-gradient(#8e91a4,#4a4d62)!important}\r\n.mirror-home-tools{display:flex;justify-content:center;gap:14px;margin:12px 0}.mirror-home-tools button{display:flex;align-items:center;gap:5px;border:0;background:#0003;border-radius:18px;color:#f4edf7;padding:5px 9px;font-size:10px}\r\n.mirror-main>.mirror-workspace-button{align-self:center;background:#0003;border:0;font-size:11px;margin:2px 0 8px;padding:8px 13px;min-height:36px}\r\n\r\n.mirror-dock{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:7px;margin-top:auto;padding:12px 9px 5px;border-radius:28px;background:#ffffff22;backdrop-filter:blur(22px);flex:none}\r\n.mirror-dock .mirror-icon{min-height:77px}.mirror-dock .mirror-icon strong{font-size:10px!important}\r\n.mirror-home-indicator{display:grid;place-items:center;flex:none;min-height:27px!important;width:100%;border:0;background:transparent;padding:0}.mirror-home-indicator span{width:112px;height:5px;border-radius:5px;background:#f5f5fa}\r\n.mirror .mirror-detail{background:#101114!important;animation:mirror-app-enter .18s ease-out;padding-top:5px}\r\n.mirror .mirror-app-toolbar{position:sticky;top:-5px;background:#101114ed;z-index:2;backdrop-filter:blur(18px);padding:3px 0;margin-bottom:10px}\r\n.mirror .mirror-back{color:#60afff;gap:3px;font-size:12px}.mirror-app-toolbar>.mirror-workspace-button{background:none;border:0;font-size:12px;color:#60afff;padding:5px}\r\n.mirror .mirror-items{gap:0;border-radius:14px;overflow:hidden;margin-top:16px}.mirror .mirror-file{border-radius:0!important;background:#1c1c1f!important;padding:17px 12px}.mirror .mirror-file-copy strong{font-size:15px}\r\n.mirror .mirror-document{border:0!important;background:transparent!important;padding:5px 0;margin-top:8px}.mirror .mirror-document>h3{font-size:21px;letter-spacing:-.4px}\r\n.mirror .mirror-photo-grid{grid-template-columns:repeat(3,minmax(0,1fr));gap:6px}.mirror .mirror-photo-art{aspect-ratio:1;min-height:80px;border:0}\r\n.mirror .mirror-email-body{background:transparent;padding:0}.mirror .mirror-note-body{background:#1e1d19;color:#eee8d7;padding:20px;border-radius:8px;min-height:220px}.mirror-note-body>p{font-size:16px;line-height:1.85}\r\n.mirror .mirror-message-history{gap:12px}.mirror .mirror-message-history>.mirror-identity{justify-content:center;flex-direction:column;background:#1c1c1f;padding:15px;border-radius:15px}.mirror .mirror-message-history>.mirror-time{text-align:center;font-size:10px!important}.mirror .mirror-chat-bubble{font-size:15px;max-width:85%}.mirror .mirror-readonly-composer{color:#aeb0bb;text-align:left;padding-left:17px}\r\n.mirror-source-note{font-size:10px!important}.mirror-save-record{font-size:12px;background:transparent}\r\n@keyframes mirror-app-enter{from{opacity:.3;transform:scale(.97)}to{opacity:1;transform:scale(1)}}\r\n@media(max-width:340px){.mirror .mirror-icon>span{width:51px!important;height:51px!important}.mirror-wallpaper-date{padding:12px 0}.mirror-home-tools{gap:5px}}\r\n@media(max-height:650px){.mirror-wallpaper-date{padding:0 0 10px}.mirror .mirror-grid{gap:10px 5px}.mirror-home-tools{margin:0}.mirror-dock{margin-top:12px}}\r\n.utility-screen>.mirror{flex:1;min-height:0}\r\n.mirror .mirror-file>.mirror-list-initial{display:grid;place-items:center;flex:none;width:38px;height:38px;border-radius:50%;background:#565964;color:#fff;font-size:18px;font-weight:500}\n.mirror-area-calls .mirror-file>svg:first-child{color:#60d484}.mirror-area-notes .mirror-file>svg:first-child{color:#efce62}.mirror-area-files .mirror-file>svg:first-child{color:#5cbaff}\r\n.mirror-area-messages.mirror-reading .mirror-detail>h2,.mirror-area-messages .mirror-document>h3,.mirror-area-messages .mirror-document>small,.mirror-area-contacts .mirror-document>h3{display:none}\n.mirror-area-messages .mirror-message-history>.mirror-identity{background:transparent;padding:0 0 12px;border-bottom:1px solid #ffffff15;border-radius:0;gap:6px}.mirror-area-messages .mirror-identity strong{font-size:14px}.mirror-area-messages .mirror-message-history{margin-top:0}\r\n\r\n/* Native phone presentation. Investigation tools live in the optional menu. */\r\n.device:has(.mirror-on-home){background:#172534 url('/greyhaven-phone-wallpaper.png') center/cover}\r\n.device:has(.mirror-on-home)>.status-bar{background:transparent;color:#fff}\r\n.utility-screen:has(>.mirror-on-home),.opening-mirror-stage:has(>.mirror-on-home){background:transparent!important}\r\n.mirror.mirror-on-home{background:linear-gradient(#07111f10,#07111f38)!important}\r\n.mirror-device-switch{background:transparent;padding:0 16px;min-height:28px;font-size:10px;letter-spacing:0;color:inherit}\r\n.mirror-device-switch>span{margin-left:auto;opacity:.65}\r\n.mirror-in-app>.mirror-device-switch{color:#666!important}\r\n.mirror-on-home>.mirror-device-switch{color:white;text-shadow:0 1px 4px #000}\r\n.mirror-device-switch button{color:inherit;min-height:28px;font-size:11px}\r\n.mirror .mirror-main{padding:15px 20px 0}\r\n.mirror-widgets{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin:0 0 24px}\r\n.mirror-calendar-widget,.mirror-photo-widget{height:138px;border-radius:24px;overflow:hidden;box-shadow:0 5px 16px #0002}\r\n.mirror-calendar-widget{background:#fdfdfdef;color:#141414;padding:15px 18px;display:flex;flex-direction:column;backdrop-filter:blur(20px)}\r\n.mirror-calendar-widget small{font-size:11px;font-weight:650;color:#e34b43;letter-spacing:.03em}\r\n.mirror-calendar-widget strong{font-size:52px;font-weight:300;line-height:1.08;letter-spacing:-3px}\r\n.mirror-calendar-widget>span{font-size:12px;margin-top:auto}\r\n.mirror-photo-widget{position:relative;background:url('/greyhaven-phone-wallpaper.png') center 42%/cover}\r\n.mirror-photo-widget>span{position:absolute;bottom:0;left:0;right:0;padding:25px 12px 12px;background:linear-gradient(transparent,#0009);font-size:12px;font-weight:600;color:white}\r\n.mirror .mirror-grid{gap:17px 7px;padding:0 0 16px}\r\n.mirror .mirror-icon>span{border:0!important;box-shadow:0 3px 8px #0002;width:59px!important;height:59px!important;border-radius:15px!important}\r\n.mirror .mirror-icon strong{font-size:11px!important;text-shadow:0 1px 4px #000}\r\n.mirror .mirror-app-gallery>span{background:#fff!important}\r\n.mirror-photos-flower{width:42px;height:42px;position:relative;display:block}\r\n.mirror-photos-flower i{position:absolute;left:13px;top:0;width:16px;height:25px;border-radius:12px;transform-origin:8px 21px;opacity:.8}\r\n.mirror-home-tools{margin:auto 0 8px;gap:9px}\r\n.mirror-home-tools button{background:#e0e6ed40;backdrop-filter:blur(25px);color:white;font-size:11px;min-height:32px;padding:5px 10px}\r\n.mirror-main>.mirror-workspace-button{color:white;background:#ffffff25;font-size:11px}\r\n.mirror-dock{margin-top:9px;border:1px solid #ffffff22;padding:12px 4px 2px;background:#d7e4f34d;border-radius:30px}\r\n.mirror-dock .mirror-icon{min-height:63px}.mirror-dock .mirror-icon strong{display:none}\r\n.mirror-home-indicator{min-height:28px!important}\r\n.mirror.mirror-in-app{background:#f2f2f7!important;color:#111;color-scheme:light}\r\n.device:has(.mirror-in-app)>.status-bar{background:#f2f2f7;color:#111}\r\n.mirror-in-app .mirror-home-indicator span{background:#111}\r\n.mirror-in-app>.mirror-home-indicator span{background:#111!important}\r\n.mirror{overflow:hidden}\r\n.mirror .mirror-detail{background:#f2f2f7!important;padding:4px 16px 20px;min-height:0}\r\n.mirror .mirror-app-toolbar{top:-4px;background:#f2f2f7ec;margin:0 -5px 8px;padding:0;min-height:44px;gap:0;z-index:5}\r\n.mirror .mirror-back{font-size:15px;color:#007aff;min-height:44px;padding:0;gap:0;white-space:nowrap}\r\n.mirror-toolbar-actions{display:flex;align-items:center;margin-left:auto}\r\n.mirror-reading .mirror-app-toolbar>.mirror-back[aria-label]{margin-left:auto;min-width:38px;justify-content:center}\r\n.mirror-reading .mirror-toolbar-actions{margin-left:0}\r\n.mirror-toolbar-actions button{border:0;background:transparent;color:#007aff;display:flex;align-items:center;justify-content:center;padding:9px;min-width:40px;min-height:44px}\r\n.mirror-detail>h2{font-size:33px;letter-spacing:-1px;font-weight:750;color:#111;margin:0 0 14px}\r\n.mirror-search{background:#e3e3e8;color:#8e8e93;margin:0 0 16px;border-radius:11px}\r\n.mirror-search input{color:#111;min-height:37px;font-size:16px}\r\n.mirror-tabs{gap:0;border-radius:9px;padding:3px;background:#e3e3e8;margin:10px 0 16px}\r\n.mirror-tabs button{flex:1;border:0;background:transparent;color:#18181a;border-radius:7px;padding:5px 10px;min-height:30px;font-size:12px}\r\n.mirror-tabs button[aria-pressed=true]{background:#fff;color:#111;box-shadow:0 2px 5px #0002}\r\n.mirror .mirror-items{background:#fff;border-radius:12px;margin-top:0}\r\n.mirror .mirror-file{background:#fff!important;color:#111;border:0!important;border-bottom:1px solid #e6e6eb!important;padding:14px 12px;min-height:72px;gap:12px}\r\n.mirror .mirror-file:last-child{border-bottom:0!important}\r\n.mirror .mirror-file-copy strong{font-size:16px;color:#111;letter-spacing:-.2px}\r\n.mirror .mirror-file-copy small,.mirror-file-preview{color:#8e8e93;font-size:12px;line-height:1.4}\r\n.mirror .mirror-file-copy small:empty{display:none}\r\n.mirror .mirror-file>svg:last-child{color:#c1c1c6}\r\n.mirror .mirror-file>.mirror-list-initial{width:43px;height:43px;flex:none;background:#b4b6be}\r\n.mirror-folder-count{font-size:12px;color:#8e8e93;margin:8px 0 14px}\r\n.mirror .mirror-document{color:#111;margin:0;padding:0;background:transparent!important}\r\n.mirror .mirror-document>small{color:#8e8e93;font-size:12px}\r\n.mirror .mirror-document p{color:inherit;font-size:16px;line-height:1.6}\r\n.mirror .mirror-document>h3{font-size:23px;color:inherit;line-height:1.25;margin:12px 0 20px}\r\n.mirror-reading.mirror-area-notes .mirror-detail>h2,.mirror-reading.mirror-area-gallery .mirror-detail>h2{display:none}\r\n.mirror .mirror-note-body{padding:0;background:transparent;color:#171717;min-height:300px}\r\n.mirror-note-body>p{font-size:17px!important;line-height:1.65!important;white-space:pre-wrap;margin:0}\r\n.mirror-area-notes.mirror-in-app,.mirror-area-notes .mirror-detail{background:#fffdf7!important}\r\n.mirror-area-notes .mirror-app-toolbar{background:#fffdf7ed}\r\n.mirror-area-notes .mirror-back,.mirror-area-notes .mirror-toolbar-actions button{color:#b78700}\r\n.device:has(.mirror-area-notes)>.status-bar{background:#fffdf7}\r\n.mirror-area-messages.mirror