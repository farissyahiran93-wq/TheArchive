:"OPEN-S02-C03-a-5"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Of course you wouldn't."}},{"k":"read","v":{"b":false}}],"id":319},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-03-1"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Okay."}},{"k":"read","v":{"b":false}}],"id":320},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-03-2"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Enough with the questions about where people were."}},{"k":"read","v":{"b":false}}],"id":321},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-03-3"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: We barely know who's on the other side of the screen."}},{"k":"read","v":{"b":false}}],"id":322},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-03-4"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Exactly my point."}},{"k":"read","v":{"b":false}}],"id":323},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-03-5"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: No. Your point was to accuse them before we know anything."}},{"k":"read","v":{"b":false}}],"id":324},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-03-6"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: I'm trying to be careful."}},{"k":"read","v":{"b":false}}],"id":325},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-03-7"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Then be careful."}},{"k":"read","v":{"b":false}}],"id":326},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-03-8"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Not cruel."}},{"k":"read","v":{"b":false}}],"id":327},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-03-10"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Can I explain why I thought adding them was a good idea?"}},{"k":"read","v":{"b":false}}],"id":328},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-03-11"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: You could try."}},{"k":"read","v":{"b":false}}],"id":329},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-03-12"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Go ahead, Soph."}},{"k":"read","v":{"b":false}}],"id":330},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-03-13"}},{"k":"