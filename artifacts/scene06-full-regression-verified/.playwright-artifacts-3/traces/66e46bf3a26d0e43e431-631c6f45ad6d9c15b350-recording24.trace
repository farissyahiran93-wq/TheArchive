d","v":{"b":false}}],"id":605},{"o":[{"k":"id","v":{"s":"OPEN-S02-C11-a-1"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Good."}},{"k":"read","v":{"b":false}}],"id":606},{"o":[{"k":"id","v":{"s":"OPEN-S02-C11-a-2"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Because I don't."}},{"k":"read","v":{"b":false}}],"id":607},{"o":[{"k":"id","v":{"s":"OPEN-S02-C11-a-3"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Nobody's asking you to."}},{"k":"read","v":{"b":false}}],"id":608},{"o":[{"k":"id","v":{"s":"OPEN-S02-C11-a-4"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Then we're clear."}},{"k":"read","v":{"b":false}}],"id":609},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-11-2"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Sophie."}},{"k":"read","v":{"b":false}}],"id":610},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-11-3"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Yeah?"}},{"k":"read","v":{"b":false}}],"id":611},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-11-4"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Please be careful."}},{"k":"read","v":{"b":false}}],"id":612},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-11-5"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I am being careful."}},{"k":"read","v":{"b":false}}],"id":613},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-11-6"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: I know you think you are."}},{"k":"read","v":{"b":false}}],"id":614},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-11-8"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: That's what worries me."}},{"k":"read","v":{"b":false}}],"id":615},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-11-13"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Lucas, seriously?"}},{"k":"read","v":{"b":false}}],"id":616},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-11-15"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: He's gone, Soph."}},{"k":"read","v":{"b":false}}],"id":617},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-11-16"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I can see that."}},{"k":"read","v":{"b":false}}],"id":618},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-11-18"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: You should've told us before adding someone."}},{"k":"read","v":{"b":false}}],"id":619},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-11-19"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Would you have said yes?"}},{"k":"read","v":{"b":false}}],"id":620},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-11-20"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: That's not the point."}},{"k":"read","v":{"b":false}}],"id":621},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-11-23"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Can we not do this here?"}},{"k":"read","v":{"b":false}}],"id":622},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-11-24"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Fine."}},{"k":"read","v":{"b":false}}],"id":623},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-11-25"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: But we need to talk about this."}},{"k":"read","v":{"b":false}}],"id":624},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-11-26"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I know."}},{"k":"read","v":{"b":false}}],"id":625},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-11-28"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Later, then."}},{"k":"read","v":{"b":false}}],"id":626},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-11-31"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: ..."}},{"k":"read","v":{"b":false}}],"id":627},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-11-32"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Well."}},{"k":"read","v":{"b":false}}],"id":628},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-11-33"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: That went brilliantly."}},{"k":"read","v":{"b":false}}],"id":629},{"o":[{"k":"id","v":{"s":"OPEN-S02-C12-a-1"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I know."}},{"k":"read","v":{"b":false}}],"id":630},{"o":[{"k":"id","v":{"s":"OPEN-S02-C12-a-2"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: You didn't."}},{"k":"read","v":{"b":false}}],"id":631},{"o":[{"k":"id","v":{"s":"OPEN-S02-C12-a-3"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: This started long before you joined."}},{"k":"read","v":{"b":false}}],"id":632},{"o":[{"k":"id","v":{"s":"OPEN-S02-C12-a-4"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I'm sorry you had to see it."}},{"k":"read","v":{"b":false}}],"id":633},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-12-2"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Listen."}},{"k":"read","v":{"b":false}}],"id":634},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-12-3"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I think I owe you an explanation."}},{"k":"read","v":{"b":false}}],"id":635},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-12-4"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: But I'd rather not have this conversation in front of everyone."}},{"k":"read","v":{"b":false}}],"id":636},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-12-6"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Can we talk privately?"}},{"k":"read","v":{"b":false}}],"id":637},{"o":[{"k":"id","v":{"s":"OPEN-S02-C13-a-1"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Thank you."}},{"k":"read","v":{"b":false}}],"id":638},{"o":[{"k":"id","v":{"s":"OPEN-S02-C13-a-2"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I'll message you."}},{"k":"read","v":{"b":false}}],"id":639},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-13-2"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I'll send you a message."}},{"k":"read","v":{"b":false}}],"id":640},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-13-4"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: And..."}},{"k":"read","v":{"b":false}}],"id":641},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-13-5"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I'm sorry about all of this."}},{"k":"read","v":{"b":false}}],"id":642},{"o":[{"k":"id","v":{"s":"OPEN-S03-FIRST-MESSAGE"}},{"k":"text","v":{"s":"Sophie: Hey."}},{"k":"read","v":{"b":true}}],"id":643},{"o":[{"k":"id","v":{"s":"OPEN-S03-OPENING-2"}},{"k":"text","v":{"s":"Sophie: It's me."}},{"k":"read","v":{"b":true}}],"id":644},{"o":[{"k":"id","v":{"s":"OPEN-S03-OPENING-3"}},{"k":"text","v":{"s":"Sophie: Obviously."}},{"k":"read","v":{"b":true}}],"id":645},{"o":[{"k":"id","v":{"s":"CH1-SENDER-FIRST"}},{"k":"text","v":{"s":"Be careful who you trust in that group."}},{"k":"read","v":{"b":false}}],"id":646},{"o":[{"k":"id","v":{"s":"OPEN-S03-OPENING-4"}},{"k":"text","v":{"s":"Sophie: Not sure why I felt the need to clarify that 😅"}},{"k":"read","v":{"b":true}}],"id":647},{"o":[{"k":"id","v":{"s":"OPEN-S03-OPENING-6"}},{"k":"text","v":{"s":"Sophie: Sorry about what happened back there."}},{"k":"read","v":{"b":true}}],"id":648},{"o":[{"k":"id","v":{"s":"OPEN-S03-OPENING-7"}},{"k":"text","v":{"s":"Sophie: That was..."}},{"k":"read","v":{"b":true}}],"id":649},{"o":[{"k":"id","v":{"s":"OPEN-S03-OPENING-9"}},{"k":"text","v":{"s":"Sophie: Well, you've seen it."}},{"k":"read","v":{"b":true}}],"id":650},{"o":[{"k":"id","v":{"s":"OPEN-S03-C01-a-1"}},{"k":"text","v":{"s":"Sophie: That's one word for it."}},{"k":"read","v":{"b":true}}],"id":651},{"o":[{"k":"id","v":{"s":"OPEN-S03-C01-a-2"}},{"k":"text","v":{"s":"Sophie: And you caught us on a relatively good day."}},{"k":"read","v":{"b":true}}],"id":652},{"o":[{"k":"id","v":{"s":"OPEN-S03-C01-a-4"}},{"k":"text","v":{"s":"Sophie: Kidding."}},{"k":"read","v":{"b":true}}],"id":653},{"o":[{"k":"id","v":{"s":"OPEN-S03-C01-a-5"}},{"k":"text","v":{"s":"Sophie: Mostly."}},{"k":"read","v":{"b":true}}],"id":654},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-01-1"}},{"k":"text","v":{"s":"Sophie: Okay."}},{"k":"read","v":{"b":true}}],"id":655},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-01-2"}},{"k":"text","v":{"s":"Sophie: Let's start over."}},{"k":"read","v":{"b":true}}],"id":656},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-01-3"}},{"k":"text","v":{"s":"Sophie: Properly this time."}},{"k":"read","v":{"b":true}}],"id":657},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-01-4"}},{"k":"text","v":{"s":"Sophie: There's something I should've told you before I added you."}},{"k":"read","v":{"b":true}}],"id":658},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-01-5"}},{"k":"text","v":{"s":"Sophie: Daniel isn't just someone I know."}},{"k":"read","v":{"b":true}}],"id":659},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-01-7"}},{"k":"text","v":{"s":"Sophie: He's my brother."}},{"k":"read","v":{"b":true}}],"id":660},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-01-8"}},{"k":"text","v":{"s":"Sophie: My older brother, actually."}},{"k":"read","v":{"b":true}}],"id":661},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-01-10"}},{"k":"text","v":{"s":"Sophie: Daniel Mercer."}},{"k":"read","v":{"b":true}}],"id":662},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-01-11"}},{"k":"text","v":{"s":"Sophie: I guess I should've mentioned that earlier."}},{"k":"read","v":{"b":true}}],"id":663},{"o":[{"k":"id","v":{"s":"OPEN-S03-C02-a-1"}},{"k":"text","v":{"s":"Sophie: Yeah."}},{"k":"read","v":{"b":true}}],"id":664},{"o":[{"k":"id","v":{"s":"OPEN-S03-C02-a-2"}},{"k":"text","v":{"s":"Sophie: Sorry."}},{"k":"read","v":{"b":true}}],"id":665},{"o":[{"k":"id","v":{"s":"OPEN-S03-C02-a-3"}},{"k":"text","v":{"s":"Sophie: I keep forgetting you don't know anything about us."}},{"k":"read","v":{"b":true}}],"id":666},{"o":[{"k":"id","v":{"s":"OPEN-S03-C02-a-4"}},{"k":"text","v":{"s":"Sophie: I've spent days talking to people who already know him."}},{"k":"read","v":{"b":true}}],"id":667},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-02-2"}},{"k":"text","v":{"s":"Sophie: It's strange."}},{"k":"read","v":{"b":true}}],"id":668},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-02-3"}},{"k":"text","v":{"s":"Sophie: I've spent all day talking about Daniel."}},{"k":"read","v":{"b":true}}],"id":669},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-02-4"}},{"k":"text","v":{"s":"Sophie: Where he might be."}},{"k":"read","v":{"b":true}}],"id":670},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-02-5"}},{"k":"text","v":{"s":"Sophie: Who he last spoke to."}},{"k":"read","v":{"b":true}}],"id":671},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-02-6"}},{"k":"text","v":{"s":"Sophie: Whether anyone remembers something useful."}},{"k":"read","v":{"b":true}}],"id":672},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-02-8"}},{"k":"text","v":{"s":"Sophie: But I haven't really told you what he's like."}},{"k":"read","v":{"b":true}}],"id":673},{"o":[{"k":"id","v":{"s":"OPEN-S03-C03-a-1"}},{"k":"text","v":{"s":"Sophie: That's harder than I expected."}},{"k":"read","v":{"b":true}}],"id":674},{"o":[{"k":"id","v":{"s":"OPEN-S03-C03-a-2"}},{"k":"text","v":{"s":"Sophie: He's a good person."}},{"k":"read","v":{"b":true}}],"id":675},{"o":[{"k":"id","v":{"s":"OPEN-S03-C03-a-3"}},{"k":"text","v":{"s":"Sophie: Which is what everybody says about someone they love."}},{"k":"read","v":{"b":true}}],"id":676},{"o":[{"k":"id","v":{"s":"OPEN-S03-C03-a-4"}},{"k":"text","v":{"s":"Sophie: Not very helpful, is it?"}},{"k":"read","v":{"b":true}}],"id":677},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-03-1"}},{"k":"text","v":{"s":"Sophie: He's patient with things."}},{"k":"read","v":{"b":true}}],"id":678},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-03-2"}},{"k":"text","v":{"s":"Sophie: Not always with people."}},{"k":"read","v":{"b":true}}],"id":679},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-03-3"}},{"k":"text","v":{"s":"Sophie: If something breaks, he'll spend hours trying to fix it."}},{"k":"read","v":{"b":true}}],"id":680},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-03-4"}},{"k":"text","v":{"s":"Sophie: Even if replacing it would take five minutes."}},{"k":"read","v":{"b":true}}],"id":681},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-03-5"}},{"k":"text","v":{"s":"Sophie: And he'll be absolutely convinced he's being clever about it."}},{"k":"read","v":{"b":true}}],"id":682},{"o":[{"k":"id","v":{"s":"OPEN-S03-C04-a-1"}},{"k":"text","v":{"s":"Sophie: Oh, incredibly."}},{"k":"read","v":{"b":true}}],"id":683},{"o":[{"k":"id","v":{"s":"OPEN-S03-C04-a-2"}},{"k":"text","v":{"s":"Sophie: Don't ever tell him that."}},{"k":"read","v":{"b":true}}],"id":684},{"o":[{"k":"id","v":{"s":"OPEN-S03-C04-a-3"}},{"k":"text","v":{"s":"Sophie: He'll spend the next twenty minutes explaining why he's not stubborn."}},{"k":"read","v":{"b":true}}],"id":685},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-04-1"}},{"k":"text","v":{"s":"Sophie: And he has this habit."}},{"k":"read","v":{"b":true}}],"id":686},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-04-2"}},{"k":"text","v":{"s":"Sophie: Whenever something gets complicated, he'll say..."}},{"k":"read","v":{"b":true}}],"id":687},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-04-3"}},{"k":"text","v":{"s":"Sophie: \"I'll explain later.\""}},{"k":"read","v":{"b":true}}],"id":688},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-04-5"}},{"k":"text","v":{"s":"Sophie: I hate that sentence."}},{"k":"read","v":{"b":true}}],"id":689},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-04-6"}},{"k":"text","v":{"s":"Sophie: Because he normally does explain later."}},{"k":"read","v":{"b":true}}],"id":690},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-04-7"}},{"k":"text","v":{"s":"Sophie: You just have to wait until he's ready."}},{"k":"read","v":{"b":true}}],"id":691},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-04-9"}},{"k":"text","v":{"s":"Sophie: This time..."}},{"k":"read","v":{"b":true}}],"id":692},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-04-13"}},{"k":"text","v":{"s":"Sophie: Never mind."}},{"k":"read","v":{"b":true}}],"id":693},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-04-14"}},{"k":"text","v":{"s":"Sophie: You know what I remembered earlier?"}},{"k":"read","v":{"b":true}}],"id":694},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-04-15"}},{"k":"text","v":{"s":"Sophie: My birthday."}},{"k":"read","v":{"b":true}}],"id":695},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-04-16"}},{"k":"text","v":{"s":"Sophie: Not this year."}},{"k":"read","v":{"b":true}}],"id":696},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-04-17"}},{"k":"text","v":{"s":"Sophie: A while ago."}},{"k":"read","v":{"b":true}}],"id":697},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-04-18"}},{"k":"text","v":{"s":"Sophie: Daniel told me he couldn't make it."}},{"k":"read","v":{"b":true}}],"id":698},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-04-19"}},{"k":"text","v":{"s":"Sophie: Said he was busy."}},{"k":"read","v":{"b":true}}],"id":699},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-04-20"}},{"k":"text","v":{"s":"Sophie: I was so annoyed with him."}},{"k":"read","v":{"b":true}}],"id":700},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-04-21"}},{"k":"text","v":{"s":"Sophie: Didn't speak to him all afternoon."}},{"k":"read","v":{"b":true}}],"id":701},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-04-23"}},{"k":"text","v":{"s":"Sophie: Then he showed up that evening."}},{"k":"read","v":{"b":true}}],"id":702},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-04-24"}},{"k":"text","v":{"s":"Sophie: With a cake."}},{"k":"read","v":{"b":true}}],"id":703},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-04-25"}},{"k":"text","v":{"s":"Sophie: A completely ruined cake."}},{"k":"read","v":{"b":true}}],"id":704},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-04-26"}},{"k":"text","v":{"s":"Sophie: It had slid sideways in the box."}},{"k":"read","v":{"b":true}}],"id":705},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-04-27"}},{"k":"text","v":{"s":"Sophie: Half the writing was stuck to the lid."}},{"k":"read","v":{"b":true}}],"id":706},{"o":[{"k":"id","v":{"s":"OPEN-S03-C05-a-1"}},{"k":"text","v":{"s":"Sophie: That's exactly what he said!"}},{"k":"read","v":{"b":true}}],"id":707},{"o":[{"k":"id","v":{"s":"OPEN-S03-C05-a-2"}},{"k":"text","v":{"s":"Sophie: Word for word."}},{"k":"read","v":{"b":true}}],"id":708},{"o":[{"k":"id","v":{"s":"OPEN-S03-C05-a-3"}},{"k":"text","v":{"s":"Sophie: Very convenient, considering the state of that cake."}},{"k":"read","v":{"b":true}}],"id":709},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-05-2"}},{"k":"text","v":{"s":"Sophie: Sorry."}},{"k":"read","v":{"b":true}}],"id":710},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-05-3"}},{"k":"text","v":{"s":"Sophie: I'm rambling."}},{"k":"read","v":{"b":true}}],"id":711},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-05-4"}},{"k":"text","v":{"s":"Sophie: You asked about Daniel and now I'm telling you about a cake."}},{"k":"read","v":{"b":true}}],"id":712},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-05-6"}},{"k":"text","v":{"s":"Sophie: But that's the kind of thing I think about when I think of him."}},{"k":"read","v":{"b":true}}],"id":713},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-05-7"}},{"k":"text","v":{"s":"Sophie: Not the arguments."}},{"k":"read","v":{"b":true}}],"id":714},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-05-8"}},{"k":"text","v":{"s":"Sophie: Not whatever is happening right now."}},{"k":"read","v":{"b":true}}],"id":715},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-05-9"}},{"k":"text","v":{"s":"Sophie: That's why I know something isn't right."}},{"k":"read","v":{"b":true}}],"id":716},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-05-10"}},{"k":"text","v":{"s":"Sophie: He might forget an appointment."}},{"k":"read","v":{"b":true}}],"id":717},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-05-11"}},{"k":"text","v":{"s":"Sophie: He might ignore a call because he's busy."}},{"k":"read","v":{"b":true}}],"id":718},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-05-12"}},{"k":"text","v":{"s":"Sophie: But if he knows people are worried..."}},{"k":"read","v":{"b":true}}],"id":719},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-05-13"}},{"k":"text","v":{"s":"Sophie: He doesn't usually leave them like that."}},{"k":"read","v":{"b":true}}],"id":720},{"o":[{"k":"id","v":{"s":"OPEN-S03-C06-b-1"}},{"k":"text","v":{"s":"Sophie: Yes."}},{"k":"read","v":{"b":true}}],"id":721},{"o":[{"k":"id","v":{"s":"OPEN-S03-C06-b-2"}},{"k":"text","v":{"s":"Sophie: We've reported it."}},{"k":"read","v":{"b":true}}],"id":722},{"o":[{"k":"id","v":{"s":"OPEN-S03-C06-b-3"}},{"k":"text","v":{"s":"Sophie: I know talking to strangers isn't a substitute for that."}},{"k":"read","v":{"b":true}}],"id":723},{"o":[{"k":"id","v":{"s":"OPEN-S03-C06-b-4"}},{"k":"text","v":{"s":"Sophie: I just can't stand sitting here waiting for answers."}},{"k":"read","v":{"b":true}}],"id":724},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-06-1"}},{"k":"text","v":{"s":"Sophie: And before you ask..."}},{"k":"read","v":{"b":true}}],"id":725},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-06-2"}},{"k":"text","v":{"s":"Sophie: No, we haven't figured out exactly what happened."}},{"k":"read","v":{"b":true}}],"id":726},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-06-3"}},{"k":"text","v":{"s":"Sophie: We don't even agree on parts of the timeline."}},{"k":"read","v":{"b":true}}],"id":727},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-06-4"}},{"k":"text","v":{"s":"Sophie: That's why things got so tense in the group."}},{"k":"read","v":{"b":true}}],"id":728},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-06-5"}},{"k":"text","v":{"s":"Sophie: Can I tell you something?"}},{"k":"read","v":{"b":true}}],"id":729},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-06-6"}},{"k":"text","v":{"s":"Sophie: I keep opening my last conversation with him."}},{"k":"read","v":{"b":true}}],"id":730},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-06-7"}},{"k":"text","v":{"s":"Sophie: I know it isn't going to change."}},{"k":"read","v":{"b":true}}],"id":731},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-06-8"}},{"k":"text","v":{"s":"Sophie: But I keep looking anyway."}},{"k":"read","v":{"b":true}}],"id":732},{"o":[{"k":"id","v":{"s":"OPEN-S03-C07-a-1"}},{"k":"text","v":{"s":"Sophie: Nothing dramatic."}},{"k":"read","v":{"b":true}}],"id":733},{"o":[{"k":"id","v":{"s":"OPEN-S03-C07-a-2"}},{"k":"text","v":{"s":"Sophie: That's the frustrating part."}},{"k":"read","v":{"b":true}}],"id":734},{"o":[{"k":"id","v":{"s":"OPEN-S03-C07-a-3"}},{"k":"text","v":{"s":"Sophie: Just normal things."}},{"k":"read","v":{"b":true}}],"id":735},{"o":[{"k":"id","v":{"s":"OPEN-S03-C07-a-4"}},{"k":"text","v":{"s":"Sophie: Like we were going to talk again the next day."}},{"k":"read","v":{"b":true}}],"id":736},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-07-1"}},{"k":"text","v":{"s":"Sophie: Anyway."}},{"k":"read","v":{"b":true}}],"id":737},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-07-2"}},{"k":"text","v":{"s":"Sophie: I don't want you thinking I already know what happened."}},{"k":"read","v":{"b":true}}],"id":738},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-07-3"}},{"k":"text","v":{"s":"Sophie: I don't."}},{"k":"read","v":{"b":true}}],"id":739},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-07-4"}},{"k":"text","v":{"s":"Sophie: I just know this silence doesn't feel like him."}},{"k":"read","v":{"b":true}}],"id":740},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-07-6"}},{"k":"text","v":{"s":"Sophie: Wow."}},{"k":"read","v":{"b":true}}],"id":741},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-07-7"}},{"k":"text","v":{"s":"Sophie: This conversation got depressing fast."}},{"k":"read","v":{"b":true}}],"id":742},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-07-8"}},{"k":"text","v":{"s":"Sophie: Sorry 😅"}},{"k":"read","v":{"b":true}}],"id":743},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-07-9"}},{"k":"text","v":{"s":"Sophie: I should probably tell you a little about the others."}},{"k":"read","v":{"b":true}}],"id":744},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-07-10"}},{"k":"text","v":{"s":"Sophie: Since you've already met them at their absolute best."}},{"k":"read","v":{"b":true}}],"id":745},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-07-11"}},{"k":"text","v":{"s":"Sophie: That was sarcasm, by the way."}},{"k":"read","v":{"b":true}}],"id":746},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-07-12"}},{"k":"text","v":{"s":"Sophie: In case it wasn't obvious."}},{"k":"read","v":{"b":true}}],"id":747},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-07-14"}},{"k":"text","v":{"s":"Sophie: Maya first."}},{"k":"read","v":{"b":true}}],"id":748},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-07-15"}},{"k":"text","v":{"s":"Sophie: She's been having a really hard time."}},{"k":"read","v":{"b":true}}],"id":749},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-07-16"}},{"k":"text","v":{"s":"Sophie: She barely sleeps."}},{"k":"read","v":{"b":true}}],"id":750},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-07-17"}},{"k":"text","v":{"s":"Sophie: Keeps saying she's fine."}},{"k":"read","v":{"b":true}}],"id":751},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-07-18"}},{"k":"text","v":{"s":"Sophie: Which is usually how I know she's not."}},{"k":"read","v":{"b":true}}],"id":752},{"o":[{"k":"id","v":{"s":"OPEN-S03-C08-a-1"}},{"k":"text","v":{"s":"Sophie: ..."}},{"k":"read","v":{"b":true}}],"id":753},{"o":[{"k":"id","v":{"s":"OPEN-S03-C08-a-2"}},{"k":"text","v":{"s":"Sophie: Because she's Daniel's fiancée."}},{"k":"read","v":{"b":true}}],"id":754},{"o":[{"k":"id","v":{"s":"OPEN-S03-C08-a-4"}},{"k":"text","v":{"s":"Sophie: They were planning a wedding."}},{"k":"read","v":{"b":true}}],"id":755},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-08-1"}},{"k":"text","v":{"s":"Sophie: Maya Chen."}},{"k":"read","v":{"b":true}}],"id":756},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-08-2"}},{"k":"text","v":{"s":"Sophie: That's her full name, by the way."}},{"k":"read","v":{"b":true}}],"id":757},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-08-3"}},{"k":"text","v":{"s":"Sophie: She's usually the organized one."}},{"k":"read","v":{"b":true}}],"id":758},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-08-4"}},{"k":"text","v":{"s":"Sophie: Lists."}},{"k":"read","v":{"b":true}}],"id":759},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-08-5"}},{"k":"text","v":{"s":"Sophie: Plans."}},{"k":"read","v":{"b":true}}],"id":760},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-08-6"}},{"k":"text","v":{"s":"Sophie: Reminders."}},{"k":"read","v":{"b":true}}],"id":761},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-08-7"}},{"k":"text","v":{"s":"Sophie: Sometimes I think she has a spreadsheet for everything."}},{"k":"read","v":{"b":true}}],"id":762},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-08-8"}},{"k":"text","v":{"s":"Sophie: Which is probably why Daniel needed her."}},{"k":"read","v":{"b":true}}],"id":763},{"o":[{"k":"id","v":{"s":"OPEN-S03-C09-a-2"}},{"k":"text","v":{"s":"Sophie: As far as I knew, yes."}},{"k":"read","v":{"b":true}}],"id":764},{"o":[{"k":"id","v":{"s":"OPEN-S03-C09-a-3"}},{"k":"text","v":{"s":"Sophie: Every couple has disagreements."}},{"k":"read","v":{"b":true}}],"id":765},{"o":[{"k":"id","v":{"s":"OPEN-S03-C09-a-4"}},{"k":"text","v":{"s":"Sophie: But they were making plans for the future."}},{"k":"read","v":{"b":true}}],"id":766},{"o":[{"k":"id","v":{"s":"OPEN-S03-C09-a-5"}},{"k":"text","v":{"s":"Sophie: Real plans."}},{"k":"read","v":{"b":true}}],"id":767},{"o":[{"k":"id","v":{"s":"OPEN-S03-C09-a-6"}},{"k":"text","v":{"s":"Sophie: I don't want to pretend I know every detail of their relationship, though."}},{"k":"read","v":{"b":true}}],"id":768},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-09-1"}},{"k":"text","v":{"s":"Sophie: Maya can be sarcastic."}},{"k":"read","v":{"b":true}}],"id":769},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-09-2"}},{"k":"text","v":{"s":"Sophie: Very sarcastic."}},{"k":"read","v":{"b":true}}],"id":770},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-09-3"}},{"k":"text","v":{"s":"Sophie: But she usually means well."}},{"k":"read","v":{"b":true}}],"id":771},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-09-4"}},{"k":"text","v":{"s":"Sophie: She also won't pretend to agree with you just to make you feel better."}},{"k":"read","v":{"b":true}}],"id":772},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-09-5"}},{"k":"text","v":{"s":"Sophie: Trust me."}},{"k":"read","v":{"b":true}}],"id":773},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-09-6"}},{"k":"text","v":{"s":"Sophie: I've been on the receiving end of that plenty of times."}},{"k":"read","v":{"b":true}}],"id":774},{"o":[{"k":"id","v":{"s":"OPEN-S03-C10-a-1"}},{"k":"text","v":{"s":"Sophie: I noticed."}},{"k":"read","v":{"b":true}}],"id":775},{"o":[{"k":"id","v":{"s":"OPEN-S03-C10-a-2"}},{"k":"text","v":{"s":"Sophie: I didn't see what it said."}},{"k":"read","v":{"b":true}}],"id":776},{"o":[{"k":"id","v":{"s":"OPEN-S03-C10-a-3"}},{"k":"text","v":{"s":"Sophie: I don't know if it was important."}},{"k":"read","v":{"b":true}}],"id":777},{"o":[{"k":"id","v":{"s":"OPEN-S03-C10-a-4"}},{"k":"text","v":{"s":"Sophie: We can ask her later."}},{"k":"read","v":{"b":true}}],"id":778},{"o":[{"k":"id","v":{"s":"OPEN-S03-C10-a-5"}},{"k":"text","v":{"s":"Sophie: I just don't want to turn every little thing into an accusation."}},{"k":"read","v":{"b":true}}],"id":779},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-10-1"}},{"k":"text","v":{"s":"Sophie: Just..."}},{"k":"read","v":{"b":true}}],"id":780},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-10-2"}},{"k":"text","v":{"s":"Sophie: Be patient with her, okay?"}},{"k":"read","v":{"b":true}}],"id":781},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-10-3"}},{"k":"text","v":{"s":"Sophie: She's dealing with more than she lets on."}},{"k":"read","v":{"b":true}}],"id":782},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-10-4"}},{"k":"text","v":{"s":"Sophie: And then there's Lucas."}},{"k":"read","v":{"b":true}}],"id":783},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-10-6"}},{"k":"text","v":{"s":"Sophie: Oh boy."}},{"k":"read","v":{"b":true}}],"id":784},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-10-7"}},{"k":"text","v":{"s":"Sophie: Where do I even start?"}},{"k":"read","v":{"b":true}}],"id":785},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-10-8"}},{"k":"text","v":{"s":"Sophie: He's known Daniel since they were kids."}},{"k":"read","v":{"b":true}}],"id":786},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-10-9"}},{"k":"text","v":{"s":"Sophie: They practically grew up together."}},{"k":"read","v":{"b":true}}],"id":787},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-10-10"}},{"k":"text","v":{"s":"Sophie: Which means he's had years to perfect the art of being impossible."}},{"k":"read","v":{"b":true}}],"id":788},{"o":[{"k":"id","v":{"s":"OPEN-S03-AFTER-10-11"}},{"k":"text","v":{"s":"Sophie: 😅"}},{"k":"read","v":{"b":true}}],"id":789},{"o":[{"k":"id","v":{"s":"OPEN-S03-C11-a-1"}},{"k":"text","v":{"s":"Sophie: Yeah."}},{"k":"read","v":{"b":true}}],"id":790},