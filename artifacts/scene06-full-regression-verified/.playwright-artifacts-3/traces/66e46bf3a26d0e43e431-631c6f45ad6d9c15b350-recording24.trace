o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-33"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I know!"}},{"k":"read","v":{"b":false}}],"id":440},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-34"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Do you think I don't think about that?"}},{"k":"read","v":{"b":false}}],"id":441},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-35"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Then start acting like it."}},{"k":"read","v":{"b":false}}],"id":442},{"o":[{"k":"id","v":{"s":"OPEN-S02-C08-a-1"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: No."}},{"k":"read","v":{"b":false}}],"id":443},{"o":[{"k":"id","v":{"s":"OPEN-S02-C08-a-2"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: That's not what I want."}},{"k":"read","v":{"b":false}}],"id":444},{"o":[{"k":"id","v":{"s":"OPEN-S02-C08-a-3"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: And we haven't asked you to leave."}},{"k":"read","v":{"b":false}}],"id":445},{"o":[{"k":"id","v":{"s":"OPEN-S02-C08-a-4"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: I might."}},{"k":"read","v":{"b":false}}],"id":446},{"o":[{"k":"id","v":{"s":"OPEN-S02-C08-a-5"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Lucas."}},{"k":"read","v":{"b":false}}],"id":447},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-2"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Fine."}},{"k":"read","v":{"b":false}}],"id":448},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-3"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: What do you want me to do?"}},{"k":"read","v":{"b":false}}],"id":449},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-4"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: I want us to stop sharing things until we know who we're sharing them with."}},{"k":"read","v":{"b":false}}],"id":450},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-5"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: That seems reasonable."}},{"k":"read","v":{"b":false}}],"id":451},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-6"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: So what?"}},{"k":"read","v":{"b":false}}],"id":452},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-7"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: We just ignore the number?"}},{"k":"read","v":{"b":false}}],"id":453},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-8"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: No."}},{"k":"read","v":{"b":false}}],"id":454},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-9"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: We verify it."}},{"k":"read","v":{"b":false}}],"id":455},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-10"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: How?"}},{"k":"read","v":{"b":false}}],"id":456},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-11"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: I don't know yet."}},{"k":"read","v":{"b":false}}],"id":457},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-12"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Exactly."}},{"k":"read","v":{"b":false}}],"id":458},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-13"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Not knowing how to do something doesn't mean we should do the first thing that comes to mind."}},{"k":"read","v":{"b":false}}],"id":459},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-14"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: And waiting doesn't guarantee we'll learn anything!"}},{"k":"read","v":{"b":false}}],"id":460},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-16"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Can both of you stop for a second?"}},{"k":"read","v":{"b":false}}],"id":461},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-17"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Sorry."}},{"k":"read","v":{"b":false}}],"id":462},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-18"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: I'm listening."}},{"k":"read","v":{"b":false}}],"id":463},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-19"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Nobody here knows what happened to Daniel."}},{"k":"read","v":{"b":false}}],"id":464},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-20"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: We keep going in circles."}},{"k":"read","v":{"b":false}}],"id":465},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-21"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: We don't even agree about what happened that night."}},{"k":"read","v":{"b":false}}],"id":466},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-22"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Maya."}},{"k":"read","v":{"b":false}}],"id":467},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-23"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: What?"}},{"k":"read","v":{"b":false}}],"id":468},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-24"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Don't."}},{"k":"read","v":{"b":false}}],"id":469},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-26"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: She's right."}},{"k":"read","v":{"b":false}}],"id":470},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-27"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: ..."}},{"k":"read","v":{"b":false}}],"id":471},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-28"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: We keep acting like we have all these answers."}},{"k":"read","v":{"b":false}}],"id":472},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-29"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: But we don't."}},{"k":"read","v":{"b":false}}],"id":473},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-30"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Can we please not do this right now?"}},{"k":"read","v":{"b":false}}],"id":474},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-31"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: I'm not trying to start anything."}},{"k":"read","v":{"b":false}}],"id":475},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-32"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: I'm just saying we need to stop mixing up what we know and what we think we know."}},{"k":"read","v":{"b":false}}],"id":476},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-33"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Exactly."}},{"k":"read","v":{"b":false}}],"id":477},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-35"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Okay."}},{"k":"read","v":{"b":false}}],"id":478},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-36"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: You're right."}},{"k":"read","v":{"b":false}}],"id":479},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-37"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Both of you."}},{"k":"read","v":{"b":false}}],"id":480},{"o":[{"k":"id","v":{"s":"OPEN-S02-C09-a-1"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: That's what we're trying to establish."}},{"k":"read","v":{"b":false}}],"id":481},{"o":[{"k":"id","v":{"s":"OPEN-S02-C09-a-2"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Which is why we shouldn't be discussing it with someone we just met."}},{"k":"read","v":{"b":false}}],"id":482},{"o":[{"k":"id","v":{"s":"OPEN-S02-C09-a-3"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Lucas has a point."}},{"k":"read","v":{"b":false}}],"id":483},{"o":[{"k":"id","v":{"s":"OPEN-S02-C09-a-5"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Sorry."}},{"k":"read","v":{"b":false}}],"id":484},{"o":[{"k":"id","v":{"s":"OPEN-S02-C09-a-6"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I know that's frustrating."}},{"k":"read","v":{"b":false}}],"id":485},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-3"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Maya?"}},{"k":"read","v":{"b":false}}],"id":486},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-4"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Sorry."}},{"k":"read","v":{"b":false}}],"id":487},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-5"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Wrong chat."}},{"k":"read","v":{"b":false}}],"id":488},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-6"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: What did you delete?"}},{"k":"read","v":{"b":false}}],"id":489},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-7"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: A message meant for someone else."}},{"k":"read","v":{"b":false}}],"id":490},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-8"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: About what?"}},{"k":"read","v":{"b":false}}],"id":491},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-9"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Something unrelated."}},{"k":"read","v":{"b":false}}],"id":492},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-10"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Right."}},{"k":"read","v":{"b":false}}],"id":493},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-11"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Lucas."}},{"k":"read","v":{"b":false}}],"id":494},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-12"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: What?"}},{"k":"read","v":{"b":false}}],"id":495},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-13"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Please don't make something out of nothing."}},{"k":"read","v":{"b":false}}],"id":496},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-15"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: You know what bothers me the most?"}},{"k":"read","v":{"b":false}}],"id":497},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-16"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: What?"}},{"k":"read","v":{"b":false}}],"id":498},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-17"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: We keep saying we trust each other."}},{"k":"read","v":{"b":false}}],"id":499},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-18"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: But the moment something goes wrong, suddenly everyone has something they don't want to explain."}},{"k":"read","v":{"b":false}}],"id":500},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-19"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: That's not fair."}},{"k":"read","v":{"b":false}}],"id":501},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-20"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Isn't it?"}},{"k":"read","v":{"b":false}}],"id":502},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-21"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: What are you trying to say?"}},{"k":"read","v":{"b":false}}],"id":503},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-22"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: I'm saying maybe we should stop pretending everything's fine."}},{"k":"read","v":{"b":false}}],"id":504},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-23"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Nobody's pretending everything's fine."}},{"k":"read","v":{"b":false}}],"id":505},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-24"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Then why does it feel like I'm the only one asking the obvious questions?"}},{"k":"read","v":{"b":false}}],"id":506},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-25"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: You're not."}},{"k":"read","v":{"b":false}}],"id":507},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-26"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Really?"}},{"k":"read","v":{"b":false}}],"id":508},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-27"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Really."}},{"k":"read","v":{"b":false}}],"id":509},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-28"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Then answer this."}},{"k":"read","v":{"b":false}}],"id":510},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-30"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Why does Daniel have a stranger's number saved without a name?"}},{"k":"read","v":{"b":false}}],"id":511},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-31"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I don't know."}},{"k":"read","v":{"b":false}}],"id":512},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-32"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Who marked it with a star?"}},{"k":"read","v":{"b":false}}],"id":513},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-33"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I don't know!"}},{"k":"read","v":{"b":false}}],"id":514},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-34"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Why has nobody heard from him?"}},{"k":"read","v":{"b":false}}],"id":515},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-35"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: LUCAS!"}},{"k":"read","v":{"b":false}}],"id":516},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-37"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Stop."}},{"k":"read","v":{"b":false}}],"id":517},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-09-38"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Both of you."}},{"k":"read","v":{"b":false}}],"id":518},{"o":[{"k":"id","v":{"s":"OPEN-S02-C10-a-1"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Exactly."}},{"k":"read","v":{"b":false}}],"id":519},{"o":[{"k":"id","v":{"s":"OPEN-S02-C10-a-2"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Then maybe we shouldn't be acting like we do."}},{"k":"read","v":{"b":false}}],"id":520},{"o":[{"k":"id","v":{"s":"OPEN-S02-C10-a-3"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I'm not!"}},{"k":"read","v":{"b":false}}],"id":521},{"o":[{"k":"id","v":{"s":"OPEN-S02-C10-a-4"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Then stop making decisions for everyone."}},{"k":"read","v":{"b":false}}],"id":522},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-10-2"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Fine."}},{"k":"read","v":{"b":false}}],"id":523},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-10-3"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Maybe adding someone was a mistake."}},{"k":"read","v":{"b":false}}],"id":524},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-10-4"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: But I still think ignoring the number would've been worse."}},{"k":"read","v":{"b":false}}],"id":525},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-10-5"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: That's your opinion."}},{"k":"read","v":{"b":false}}],"id":526},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-10-6"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Yes."}},{"k":"read","v":{"b":false}}],"id":527},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-10-7"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: It is."}},{"k":"read","v":{"b":false}}],"id":528},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-10-9"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Nobody has to decide everything right now."}},{"k":"read","v":{"b":false}}],"id":529},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-10-10"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: No."}},{"k":"read","v":{"b":false}}],"id":530},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-10-11"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: But we do have to decide what we're willing to risk."}},{"k":"read","v":{"b":false}}],"id":531},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-10-12"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: What does that mean?"}},{"k":"read","v":{"b":false}}],"id":532},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-10-13"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: It means I'm not comfortable with this anymore."}},{"k":"read","v":{"b":false}}],"id":533},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-10-14"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: With what?"}},{"k":"read","v":{"b":false}}],"id":534},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-10-15"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: With how we're handling everything."}},{"k":"read","v":{"b":false}}],"id":535},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-10-16"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Lucas..."}},{"k":"read","v":{"b":false}}],"id":536},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-10-17"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: No, Sophie."}},{"k":"read","v":{"b":false}}],"id":537},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-10-18"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: I've been trying to say this for days."}},{"k":"read","v":{"b":false}}],"id":538},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-10-19"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Every time I question something, you act like I'm making things harder."}},{"k":"read","v":{"b":false}}],"id":539},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-10-20"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Because sometimes you are!"}},{"k":"read","v":{"b":false}}],"id":540},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-10-22"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: ..."}},{"k":"read","v":{"b":false}}],"id":541},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-10-23"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Sophie."}},{"k":"read","v":{"b":false}}],"id":542},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-10-24"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I'm sorry."}},{"k":"read","v":{"b":false}}],"id":543},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-10-25"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I didn't mean—"}},{"k":"read","v":{"b":false}}],"id":544},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-10-26"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: No."}},{"k":"read","v":{"b":false}}],"id":545},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-10-27"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: You did."}},{"k":"read","v":{"b":false}}],"id":546},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-10-29"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Lucas, please."}},{"k":"read","v":{"b":false}}],"id":547},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-10-30"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: I'm not doing this."}},{"k":"read","v":{"b":false}}],"id":548},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-10-31"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Don't be dramatic."}},{"k":"read","v":{"b":false}}],"id":549},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-10-32"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: I'm not being dramatic."}},{"k":"read","v":{"b":false}}],"id":550},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-10-33"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: I'm stepping away before I say something I regret."}},{"k":"read","v":{"b":false}}],"id":551},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-10-34"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: We're all upset."}},{"k":"read","v":{"b":false}}],"id":552},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-10-35"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: That's not the point."}},{"k":"read","v":{"b":false}}],"id":553},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-10-36"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Then what is?"}},{"k":"read","v":{"b":false}}],"id":554},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-10-37"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: The point is that none of us knows who we're supposed to trust right now."}},{"k":"read","v":{"b":false}}],"id":555},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-10-39"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: And apparently I'm the only one willing to admit it."}},{"k":"read","v":{"b":false}}],"id":556},{"o":[{"k":"id","v":{"s":"OPEN-S02-C11-a-1"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Good."}},{"k":"read","v":{"b":false}}],"id":557},{"o":[{"k":"id","v":{"s":"OPEN-S02-C11-a-2"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Because I don't."}},{"k":"read","v":{"b":false}}],"id":558},{"o":[{"k":"id","v":{"s":"OPEN-S02-C11-a-3"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Nobody's asking you to."}},{"k":"read","v":{"b":false}}],"id":559},{"o":[{"k":"id","v":{"s":"OPEN-S02-C11-a-4"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Then we're clear."}},{"k":"read","v":{"b":false}}],"id":560},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-11-2"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Sophie."}},{"k":"read","v":{"b":false}}],"id":561},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-11-3"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Yeah?"}},{"k":"read","v":{"b":false}}],"id":562},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-11-4"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Please be careful."}},{"k":"read","v":{"b":false}}],"id":563},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-11-5"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I am being careful."}},{"k":"read","v":{"b":false}}],"id":564},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-