IV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble sophie"},"Daniel isn't just someone I know."]]],["DIV",{"class":"conversation-line incoming chat-group-continuation chat-group-open"},["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble sophie"},"He's my brother."]]],["DIV",{"class":"conversation-line incoming chat-group-continuation chat-group-open"},["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble sophie"},"My older brother, actually."]]],["DIV",{"class":"conversation-line incoming chat-group-continuation chat-group-open"},["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble sophie"},"Daniel Mercer."]]],["DIV",{"class":"conversation-line incoming chat-group-continuation chat-group-end"},["SPAN",{"class":"chat-contact-avatar"},["SPAN",{"class":"character-avatar message-avatar","aria-hidden":"true"},["IMG",{"__playwright_current_src__":"http://127.0.0.1:4206/media/portraits/sophie-avatar.webp","alt":"","loading":"lazy","decoding":"async","src":"/media/portraits/sophie-avatar.webp"}]]],["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble sophie"},"I guess I should've mentioned that earlier."]]],[[17,545]]],["DIV",{"class":"opening-actions opening-v4-composer"},["DIV",{"class":"opening-action-heading"},"Choose a reply"],["DIV",{"class":"scene01-options"},["BUTTON",{"class":"opening-choice ","aria-pressed":"false"},"Wait. Daniel's your brother?"],["BUTTON",{"class":"opening-choice ","aria-pressed":"false"},"That explains why you're so worried."],["BUTTON",{"class":"opening-choice ","aria-pressed":"false"},"Why didn't you tell me that before?"],["BUTTON",{"class":"opening-choice ","aria-pressed":"false"},"So this is really personal for you."]],["BUTTON",{"class":"opening-primary","disabled":""},["svg",{"xmlns":"http://www.w3.org/2000/svg","width":"17","height":"17","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","stroke-width":"2","stroke-linecap":"round","stroke-linejoin":"r