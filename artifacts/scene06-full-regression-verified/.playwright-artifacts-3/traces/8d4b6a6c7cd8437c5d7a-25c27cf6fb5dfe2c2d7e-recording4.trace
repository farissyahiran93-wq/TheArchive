{"type":"frame-snapshot","snapshot":{"callId":"qmmb@577","phase":"action","pageId":"page@6689e86995e2efbc826aec6fafa945c4","frameId":"frame@4ae941a7eaa284505a53758fc6a06bfe","frameUrl":"http://127.0.0.1:4206/?devtools=1&legacyopening=1","doctype":"html","html":["HTML",{"lang":"en","style":"--visual-height: 900px;"},[[43,53]],[[43,54]],["BODY",{},[[43,55]],["DIV",{"id":"root"},["DIV",{"class":"app-root theme-light"},["DIV",{"class":"device surface-app"},["DIV",{"class":"status-bar","aria-label":"Greyhaven story time 8 October 2026 08:45"},["SPAN",{"class":"status-time"},"8:45"],[[41,3]],[[41,16]]],["DIV",{"class":"phone-content"},["SECTION",{"class":"opening-screen","aria-label":"Sophie Mercer first contact"},["HEADER",{"class":"opening-chat-header"},[[26,3]],["SPAN",{"class":"character-avatar opening-avatar","aria-hidden":"true"},["IMG",{"__playwright_current_src__":"http://127.0.0.1:4206/media/portraits/sophie-avatar.webp","alt":"","loading":"lazy","decoding":"async","src":"/media/portraits/sophie-avatar.webp"}]],["DIV",{},["STRONG",{},"Sophie Mercer"],["SMALL",{},"Unknown number · identity unverified"]],[[26,12]]],["DIV",{"__playwright_scroll_top_":"232","class":"opening-thread"},["DIV",{"class":"opening-timestamp"},"Thursday 8 October · 08:41"],["DIV",{"class":"opening-bubble sophie"},"Hi. I'm sorry for messaging out of nowhere."],["DIV",{"class":"opening-bubble sophie"},"Sorry. I know you don't know me. Is this a bad time?"],["DIV",{"class":"opening-bubble sophie"},"My name is Sophie Mercer."],["DIV",{"class":"opening-bubble sophie"},"My brother Daniel gave me this number before he disappeared."],["DIV",{"class":"opening-bubble sophie"},"He said if anything happened to him, I should contact you."],["DIV",{"class":"opening-bubble sophie"},"He hasn't come home in three days."],["DIV",{"class":"opening-bubble player"},"Who is Daniel Mercer?"],["DIV",{"class":"opening-bubble sophie"},"My older brother. He worked with old civic records."],["DIV",{"class":"opening-bubble sophie"},"There is a small chat with people close to Daniel. I could add you, if you're comfortable. They don't know why he left your number either."],["DIV",{"class":"opening-bubble player"},"You can add me. I will listen first."],["DIV",{"class":"opening-bubble sophie"},"I'm sorry about the group. I thought it would help to explain why Daniel gave me your number."],["DIV",{"class":"opening-bubble sophie"},"I didn't tell them everything he left me. He made me keep a page. I can send you a photo, if you still want to see it."]],["DIV",{"class":"opening-actions"},["DIV",{"class":"opening-action-heading"},"Open the photo Sophie sent"],["BUTTON",{"__playwright_target__":"","aria-pressed":"false","class":"opening-choice "},"Send it. I will look, but I cannot promise what it means."],["BUTTON",{"aria-pressed":"false","class":"opening-choice "},"Why didn't you show the group?"],["BUTTON",{"aria-pressed":"false","class":"opening-choice "},"I need to know where it came from first."],["BUTTON",{"class":"opening-primary","disabled":""},["svg",{"xmlns":"http://www.w3.org/2000/svg","width":"17","height":"17","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","stroke-width":"2","stroke-linecap":"round","stroke-linejoin":"round","class":"lucide lucide-send","aria-hidden":"true"},["path",{"d":"M14.536 21.686a.5.5 0 0 0 .937-.024l6.5-19a.496.496 0 0 0-.635-.635l-19 6.5a.5.5 0 0 0-.024.937l7.93 3.18a2 2 0 0 1 1.112 1.11z"}],["path",{"d":"m21.854 2.147-10.94 10.939"}]]," Send message"]]]],[[26,25]]]]],[[43,59]],[[43,60]]]],"viewport":{"width":1280,"height":900},"timestamp":2158562.808,"wallTime":1792825199142,"collectionTime":0.7999999523162842,"resourceOverrides":[],"isMainFrame":true}}
