round:linear-gradient(160deg,#4094ed,#1a64b8);border-radius:15px;box-shadow:0 4px 10px #0004;color:#fff}.mirror-icon:nth-child(2n)>span{background:linear-gradient(150deg,#767d8a,#3e4757)}.mirror-icon:nth-child(3n)>span{background:linear-gradient(140deg,#64bd8c,#218551)}.mirror-icon:nth-child(5n)>span{background:linear-gradient(140deg,#e3bb65,#ad7531)}.mirror-icon strong{font-size:10px}.mirror-icon small{font-size:8px}.mirror-detail{background:#080809}.mirror-detail h2{font-size:32px;letter-spacing:-.04em}.mirror-file{background:#1c1c1e;border:0;border-radius:11px;min-height:51px}.mirror-file.is-active{background:#2c2c2e;border:1px solid #0a84ff}.mirror-document{background:#1c1c1e;border:0;border-radius:14px}.mirror-lock-panel{display:flex;align-items:stretch;flex-direction:column;gap:12px;text-align:center;padding:16px 2px}.mirror-lock-panel>svg{align-self:center;color:#a6a6ad}.mirror-lock-panel strong{font-size:16px}.mirror-lock-panel p{color:#aaa;font-size:12px}.mirror-lock-panel label{text-align:left;font-size:11px;color:#babac0}.mirror-lock-panel input{height:44px;padding:12px;color:white;background:#323237;border:1px solid #5d5d65;border-radius:11px}.mirror-lock-panel button{display:flex;justify-content:center;align-items:center;gap:8px;border:0;color:#fff;background:#0a84ff;border-radius:12px;padding:13px}.mirror-success{display:flex;align-items:center;gap:7px;color:#45d28c!important}.opening-bubble.player{background:#0a84ff}.opening-bubble.sophie{background:#303033}.opening-chat-header{background:#1c1c1ecc;backdrop-filter:blur(12px)}.opening-actions{background:#151517}.opening-choice.selected{border-color:#0a84ff;background:#203b60}.opening-primary{background:#0a84ff}\r\n\r\n/* Episode 01: item-level iOS-style locks and clue-driven optional puzzles */\r\n.mirror-folder-count{color:#aaaab1;font-size:12px;margin:12px 0 4px}\r\n.mirror-photo-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:7px;margin:16px 0 5px}\r\n.mirror-photo-tile{display:flex;flex-direction:column;align-items:center;gap:5px;background:none;color:#dfe2ec;border:0;padding:3px;border-radius:10px;min-width:0}\r\n.mirror-photo-tile.selected{outline:2px solid #0a84ff}\r\n.mirror-photo-art{width:100%;aspect-ratio:1;display:grid;place-items:center;background:linear-gradient(145deg,#455674,#1e2b43 55%,#4c5668);border-radius:7px;color:#d5e3ef}\r\n.mirror-photo-tile:nth-child(2n) .mirror-photo-art{background:linear-gradient(145deg,#756749,#3b4448,#293851)}\r\n.mirror-photo-tile small{font-size:10px;white-space:nowrap;color:#b6c2d0}\r\n.mirror-media-preview{border-radius:12px;background:linear-gradient(130deg,#364760,#29354e 65%,#68583e);height:142px;display:flex;flex-direction:column;gap:7px;align-items:center;justify-content:center;color:#dceaf7;padding:15px;text-align:center;font-size:12px}\r\n.mirror-media-preview small{color:#bac2ca;font-size:10px}\r\n.mirror-source-note{font-size:11px!important;color:#a6adba!important;display:flex;align-items:center;gap:6px}\r\n.mirror-hint-toggle{background:#2b2c33!important;color:#a4cffe!important;border:1px solid #49505c!important}\r\n.mirror-hints{text-align:left;margin:0;padding:12px 12px 12px 29px;background:#252834;border-radius:12px;color:#e1e6f0;font-size:12px;line-height:1.7}\r\n.mirror-lock-panel p[role=alert]{color:#ffa9a0!important}\r\n.opening-next-lead{border:1px solid #3d6b89;background:#1a364d;padding:15px;border-radius:14px;margin-top:18px;color:#d9ecfb}\r\n.opening-next-lead strong{font-size:11px;letter-spacing:.03em}\r\n.opening-next-lead p{font-size:13px;line-height:1.6;margin-bottom:0}\r\n\r\n.mirror-message-history{display:flex;flex-direction:column;gap:9px;margin-top:16px;align-items:stretch}\r\n.mirror-chat-bubble{max-width:83%;padding:10px 13px;border-radius:18px;font-size:14px;line-height:1.45;display:flex;flex-direction:column;gap:4px}\r\n.mirror-chat-bubble small{font-size:10px;opacity:.75}\r\n.mirror-chat-bubble span{white-space:pre-wrap}\r\n.mirror-chat-bubble.incoming{background:#323237;border-bottom-left-radius:4px;align-self:flex-start}\r\n.mirror-chat-bubble.outgoing{background:#0a84ff;border-bottom-right-radius:4px;align-self:flex-end;color:#fff}\r\n.mirror-email-body{background:#26262b;padding:15px;border-radius:13px;margin-top:14px}\r\n.mirror-mail-label{color:#89b8ec;font-weight:600;font-size:10px;letter-spacing:.09em}\r\n.mirror-note-body{border-radius:12px;background:#27282c;padding:15px;margin-top:14px}\r\n\r\n.opening-jump{position:absolute;right:16px;top:85px;z-index:3;background:#0a84ff;color:white;border:0;border-radius:20px;padding:10px 14px}\r\n.opening-actions{max-height:47%;overflow-y:auto;padding-bottom:max(12px,env(safe-area-inset-bottom))}\r\n.opening-screen{min-width:0;position:relative}.opening-choice{overflow-wrap:anywhere;min-height:44px}\r\n@media(prefers-reduced-motion:reduce){.opening-screen *{animation:none!important;transition:none!important;scroll-behavior:auto!important}}\r\n\r\n.opening-note[role=dialog]{position:absolute;inset:0;z-index:10;overflow-y:auto;margin:0;border-radius:0;background:#1c1c1e;padding:20px;color:#eee}\r\n.opening-note[role=dialog] img{display:block;width:100%;height:auto;margin:14px 0}\r\n.opening-note-close{min-height:44px;margin-left:auto!important}\r\n\r\n.opening-screen .opening-note[role=dialog]{max-width:none;width:auto;transform:none;border-radius:0!important;background:#1c1c1e!important;color:#eee!important}\r\n.opening-screen .opening-note[role=dialog]>p{color:#eee!important}\r\n.opening-screen .opening-note[role=dialog] .opening-confirm{color:#83d8aa}\r\n.daniel-note-content{max-width:480px;margin:0 auto 18px}\r\n.opening-note[role=dialog] .daniel-note-content img{max-height:62vh;object-fit:contain;margin:16px auto}\r\n.daniel-note-transcript{border:1px solid #45454d;border-radius:12px;background:#252529;color:#eee;overflow:hidden}\r\n.daniel-note-transcript summary{min-height:44px;padding:12px 14px;cursor:pointer;font:600 14px/1.5 system-ui,sans-serif}\r\n.daniel-note-t