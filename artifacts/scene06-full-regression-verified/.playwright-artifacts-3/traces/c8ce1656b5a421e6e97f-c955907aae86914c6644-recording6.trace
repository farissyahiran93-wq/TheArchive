n: 0 0 10px; }\n.recovery-puzzle p { font-size: 13px; line-height: 1.6; }\n.recovery-cards { list-style: none; padding: 0; display: grid; gap: 10px; }\n.recovery-cards .opening-choice { width: 100%; display: grid; gap: 8px; text-align: left; margin: 0; min-height: 110px; }\n.recovery-cards small { font-size: 11px; line-height: 1.5; color: var(--muted); }\n.recovery-cards button:disabled { opacity: 1; cursor: default; }\n.recovery-tools { display: grid; gap: 8px; }\n.recovery-puzzle aside { border-left: 3px solid #8bcbd7; padding-left: 12px; }\n"],["STYLE",{},"/* Shared phone behaviour; independent of narrative progression. */\n.device * { scrollbar-width: none; }\n.device *::-webkit-scrollbar { display: none; width: 0; height: 0; }\n.device .opening-chat-header { justify-content: flex-start; gap: 11px; padding: 10px 14px; min-height: 72px; text-align: left; }\n.device .opening-chat-header > div { flex: 1; align-items: flex-start; text-align: left; min-width: 0; }\n.device .opening-chat-header > .icon-button { position: static; flex: 0 0 32px; padding: 4px; min-width: 32px; }\n.device .opening-chat-header strong { font-size: 15px; }\n.device .opening-chat-header small { margin-top: 4px; font-size: 11px; max-width: 100%; }\n.device .native-chat-header { display: flex; flex-direction: row; align-items: center; justify-content: flex-start; gap: 12px; min-height: 72px; padding: 10px 14px; }\n.device .native-chat-header > .native-back-button { position: static; flex: none; }\n.device .native-chat-contact { display: flex; flex-direction: row; gap: 10px; align-items: center; text-align: left; }\n.device .native-chat-contact .chat-title { align-items: flex-start; text-align: left; }\n.chat-contact-avatar { position: relative; display: flex; flex: none; }\n.presence-dot { position: absolute; bottom: 0; right: 0; border: 2px solid var(--header); background: #35af78; width: 11px; height: 11px; border-radius: 50%; }\n.device .thread-row { position: relative; }\n.thread-online { position: absolute; left: 46px; top: 48px; width: 11px; height: 11px; border-radius: 50%; background: #35af78; border: 2px solid var(--surface); }\n.device .conversation-line { display: flex; gap: 8px; align-items: flex-end; flex: none; width: 100%; }\n.device .conversation-line.outgoing { justify-content: flex-end; }\n.device .conversation-line.incoming.chat-group-open { padding-left: 36px; }\n.device .conversation-line.incoming.chat-group-open .conversation-body { max-width: 100%; }\n.device .conversation-line.chat-group-start { margin-top: 5px; }\n.device .conversation-body .opening-bubble { overflow-wrap: anywhere; }\n.device .scene01-chat .chat-group-action { display: inline-flex; align-items: center; justify-content: center; align-self: flex-start; flex: none; width: fit-content; max-width: 100%; min-height: 44px; margin: 12px 0 4px 36px; padding: 10px 14px; border: 1px solid #547e7b; border-radius: 12px; background: #244b4b; color: #f1faf8; font: inherit; font-size: 13px; font-weight: 600; cursor: pointer; }\n.device .scene01-chat .chat-group-action:focus-visible { outline: 2px solid #72bdb4; outline-offset: 3px; }\n.device .message-avatar { flex: 0 0 28px; width: 28px; height: 28px; border-radius: 50%; overflow: hidden; display: grid; place-items: center; background: #506576; color: white; font-size: 12px; }\n.message-avatar img { width: 100%; height: 100%; object-fit: cover; }\n.conversation-body { max-width: calc(100% - 38px); min-width: 0; }\n.outgoing .conversation-body { max-width: 84%; }\n.device .conversation-body .opening-bubble { max-width: 100% !important; margin: 0; border-radius: 15px 15px 15px 5px; padding: 11px 13px; }\n.device .conversation-body .opening-bubble.player { background: #286f70 !important; border-radius: 15px 15px 5px 15px; color: #fff !important; }\n.device .group-sender { display: block; font-size: 11px; font-weight: 650; margin: 0 0 5px 5px; color: var(--muted); }\n.device .opening-v4-typing { display: flex; align-items: center;