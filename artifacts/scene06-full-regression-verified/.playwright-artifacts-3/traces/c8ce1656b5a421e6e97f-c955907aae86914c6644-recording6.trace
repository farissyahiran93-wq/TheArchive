y:Georgia,serif;margin:10px 0}.opening-note>p.opening-note-caption{font:11px/1.4 sans-serif;color:#62665f;margin-top:20px}.opening-note button{display:flex;align-items:center;gap:7px;padding:10px;border-radius:9px;background:#25394a;color:#fff;border:0;font-size:12px}.opening-confirm{display:flex;align-items:center;gap:5px;font-size:11px;color:#196151;font-weight:700}\r\n.opening-stage-top{color:#bad1df;font-size:11px;letter-spacing:.1em;font-weight:800}.opening-stage-top small{margin-left:auto;color:#f1b78b;font-size:9px}.opening-stage-scroll{flex:1;min-height:0;overflow:auto;padding:25px 22px 35px}.opening-center-icon{display:grid;place-items:center;width:91px;height:91px;margin:30px auto;background:#213747;border:1px solid #527486;border-radius:24px;color:#8bd2d9}.opening-recovery h1,.opening-found h1{font-size:26px;line-height:1.16;letter-spacing:-.03em;margin:18px 0}.opening-stage-scroll>p{font-size:13px;color:#b7cad8;line-height:1.7}.opening-properties{display:grid;grid-template-columns:1fr 1fr;gap:14px 6px;border:1px solid #30475a;background:#182737;padding:19px 14px;border-radius:14px;margin:25px 0}.opening-properties span{font-size:12px;color:#adc1d1}.opening-properties strong{text-align:right;font-size:11px;letter-spacing:.03em}.opening-warning{color:#eab086}.opening-legal{display:flex;gap:12px;padding:12px;border-radius:12px;border:1px solid #47727c;background:#1c3540}.opening-legal svg{flex:none;color:#90d1cd}.opening-legal p{font-size:12px;line-height:1.55;margin:0}\r\n.opening-mirror-stage .mirror{flex:1;min-height:0}.mirror{background:#0c1623;color:#e3edf5;min-height:0;display:flex;flex-direction:column}.mirror-top{flex:none;display:flex;gap:6px;align-items:center;justify-content:space-between;padding:12px 14px;border-bottom:1px solid #25394e;font-size:9px;color:#9ebacb}.mirror-top>span:nth-child(2){flex:1}.mirror-top>span:last-child{color:#9cdbbb}.mirror-main,.mirror-detail{flex:1;min-height:0;overflow:auto;padding:16px 18px 28px}.mirror-hero{text-al