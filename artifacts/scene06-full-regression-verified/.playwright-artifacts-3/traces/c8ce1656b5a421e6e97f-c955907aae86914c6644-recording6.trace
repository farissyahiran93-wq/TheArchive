oto-viewer header > div { display: flex; gap: 10px; }\n.chat-photo-viewer button { display: grid; place-items: center; width: 44px; height: 44px; border: 0; border-radius: 50%; background: #ffffff15; color: white; }\n.chat-photo-viewer button:disabled { opacity: .35; }\n.chat-photo-canvas { display: flex; flex: 1; min-height: 0; align-items: center; justify-content: center; overflow: hidden; touch-action: none; }\n.chat-photo-canvas img { width: 100%; max-height: 100%; object-fit: contain; user-select: none; transform-origin: center; }\n.phone-notification-layer { position: absolute; z-index: 2000; top: 52px; left: 10px; right: 10px; pointer-events: none; }\n.native-app .phone-notification-layer { top: calc(env(safe-area-inset-top) + 8px); }\n.phone-notification { position: relative; pointer-events: auto; background: color-mix(in srgb, var(--surface) 94%, transparent); border: 1px solid var(--line); border-radius: 19px; color: var(--text); box-shadow: 0 8px 28px #0003; backdrop-filter: blur(24px); touch-action: none; overflow: hidden; animation: phone-notice-enter .2s ease-out; }\n.phone-notification-open { display: flex; align-items: center; gap: 10px; width: 100%; min-height: 88px; background: none; border: 0; color: inherit; padding: 12px 34px 12px 12px; text-align: left; cursor: pointer; }\n.phone-notification-open > span:last-child { display: grid; gap: 3px; min-width: 0; flex: 1; }\n.phone-notification-open small { font-size: 9px; font-weight: 650; color: var(--muted); letter-spacing: .04em; }\n.phone-notification-open time { float: right; font-weight: 400; }\n.phone-notification-open strong { font-size: 13px; }\n.phone-notification-open > span > span { font-size: 12px; line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }\n.phone-notification .notice-avatar { flex: 0 0 38px; width: 38px; height: 38px; display: grid; place-items: center; border-radius: 11px; overflow: hidden; background: #476a70; color: white; }\n.notice-avatar img { width: 100%; height: 100%; object-fit: cover; }\n.phone-notification-dismiss { position: absolute; top: 4px; right: 3px; width: 30px; height: 30px; display: grid; place-items: center; background: none; border: 0; color: var(--muted); cursor: pointer; }\n@keyframes phone-notice-enter { from { translate: 0 -110%; opacity: 0; } to { translate: 0 0; opacity: 1; } }\n@media (prefers-reduced-motion: reduce) { .phone-notification { animation: none; } }\n"],["STYLE",{},":root{font-family:system-ui,-apple-system,\"Segoe UI\",sans-serif;font-synthesis:none;text-rendering:optimizeLegibility;color:#1e2935;background:#172734}\n*{box-sizing:border-box}html,body,#root{width:100%;height:100%;margin:0;overflow:hidden}button,input,select,textarea{font:inherit}button{cursor:pointer}button:disabled{cursor:not-allowed}button:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible{outline:3px solid #eaa26e;outline-offset:2px}h1,h2,p{margin-top:0}.sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap}\n.app-root{--phone-bg:#f5f3f8;--surface:#fff;--raised:#f8f7fb;--text:#202736;--muted:#667081;--line:#dedfe7;--accent:#6759aa;--button-accent:#6759aa;--incoming:#e9e9ef;--outgoing:#6b5caf;--outgoing-text:#fff;--header:#faf9fd;--shadow:0 10px 30px #192d3b12;display:flex;justify-content:center;width:100%;height:var(--visual-height,100dvh);overflow:hidden;background:#172734;color:var(--text)}\n.theme-dark{--phone-bg:#081c2c;--surface:#13293e;--raised:#1a344c;--text:#f2f6f8;--muted:#aec0d1;--line:#31495e;--accent:#5595ff;--button-accent:#286bd4;--incoming:#263d55;--outgoing:#2a70de;--outgoing-text:#fff;--header:#10283d;--shadow:0 10px 30px #0003}\n.device{width:min(100%,460px);height:100%;display:flex;flex-direction:column;min-height:0;overflow:hidden;position:relative;background:var(--phone-bg);box-shadow:0 0 70px #0005}\n.status-bar{flex:none;height:calc(36px + env(safe-area-inset-top));padding:env(safe-area-inset-top) 21px 0;display:flex;justify-content:space-between;align-items:center;background:var(--header);color:var(--text);font-size:13px;font-weight:700;letter-spacing:.02em}\n.status-brand{font-size:9px;letter-spacing:.12em;color:var(--muted);display:flex;align-items:center;gap:7px}.status-brand i{width:5px;height:5px;border-radius:50%;background:#6bbfa8}\n.system-nav{height:calc(28px + env(safe-area-inset-bottom));padding-bottom:env(safe-area-inset-bottom);display:grid;place-items:center;background:var(--phone-bg);flex:none}.system-nav button{width:94px;height:26px;border:0;background:transparent;display:flex;align-items:center;justify-content:center;gap:8px;color:var(--muted)}.system-nav button:disabled{opacity:.6}.gesture-line{height:4px;width:42px;background:currentColor;border-radius:8px}.native-app .device{padding-top:env(safe-area-inset-top);padding-bottom:env(safe-area-inset-bottom)}\n.boot-message{height:100dvh;background:#102738;color:#fff;display:flex;overflow-y:auto;padding:24px}.recovery{width:min(100%,380px);margin:auto;background:#20394a;padding:25px;border-radius:20px}.recovery p{line-height:1.5}.save-error{background:#9e4844;color:#fff;padding:8px 16px;font-size:12px;flex:none}\n.recovery-secondary{display:block;width:100%;min-height:44px;margin-top:12px;padding:10px 14px;border:1px solid #bcd0db;border-radius:12px;background:transparent;color:#fff;font:inherit;font-weight:650;text-align:center}\n.eyebrow,.section-caption{font-size:10px;font-weight:750;letter-spacing:.15em;color:var(--accent)}.primary-button,.action-button{border:0;border-radius:15px;background:#d6ad8c;color:#182a35;padding:15px 20px;min-height:48px;font-weight:750;display:flex;align-items:center;justify-content:center;gap:10px}.primary-button:disabled{opacity:.45}\n.splash,.setup{flex:1;min-height:0;overflow:auto}.splash{display:flex;align-items:flex-end;position:relative;background:linear-gradient(0deg,#0b202f 0%,#152c3bb8 42%,#57778670 100%),url('/greyhaven-wallpaper.svg') center/cover;padding:24px 30px 38px;color:#fff}.splash-copy{position:relative;width:100%}.splash h1{font-size:clamp(52px,13vw,66px);line-height:.92;letter-spacing:-.055em;margin:0 0 24px}.splash h1 em{font-style:normal;color:#efc49d}.splash p:not(.eyebrow){font-size:16px;margin-bottom:27px;color:#e4ebec}.splash .primary-button{width:100%;justify-content:space-between}.splash small,.setup small{display:block;margin-top:18px;text-align:center;font-size:11px;opacity:.75}.splash-art{position:absolute;right:12%;top:16%;height:140px;width:140px;border:1px solid #fff5;border-radius:50%;box-shadow:0 0 0 22px #fff1,0 0 0 44px #fff1}.splash-art span{position:absolute;left:50%;top:50%;border-radius:50%;background:#fff9}.splash-art span:first-child{width:13px;height:13px;transform:translate(-50%,-50%)}\n.setup{padding:44px 28px;background:var(--phone-bg)}.setup h1{font-size:32px;line-height:1.1;letter-spacing:-.04em;margin-bottom:13px}.setup>p:not(.eyebrow){color:var(--muted);line-height:1.5;font-size:15px;margin-bottom:28px}.setup form{display:flex;flex-direction:column;gap:10px}.setup label{font-size:13px;font-weight:700;margin-top:8px}.setup label span{font-weight:400;color:var(--muted)}.setup input,.setup select,.search-field input,.reply-search input,.note-editor{background:var(--surface);color:var(--text);border:1px solid var(--line);border-radius:12px;padding:13px 15px;min-height:48px;width:100%}.setup .primary-button{margin-top:20px}\n.home{flex:1;min-height:0;position:relative;display:flex;flex-direction:column;color:#fff;overflow:hidden;background:#425d70 url('/greyhaven-wallpaper.svg') center/cover}.home-overlay{position:absolute;inset:0;background:linear-gradient(180deg,#10283755 0%,#1834451f 40%,#081d2fc4 100%);pointer-events:none}.home-content{position:relative;flex:1;min-height:0;overflow-y:auto;padding:20px 21px 12px;scrollbar-width:none}.home-heading>span{font-size:10px;font-weight:800;letter-spacing:.17em;color:#f5e9d9}.home-heading h1{font-size:clamp(28px,7vw,36px);line-height:1.08;letter-spacing:-.035em;margin:10px 0 19px;text-shadow:0 2px 10px #10212b88}.home-heading h1 em{font-style:normal;color:#ffe0b9}.widgets{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin:0 0 22px}.widget{height:126px;border:1px solid #ffffff66;border-radius:21px;position:relative;text-align:left;color:#fff;padding:14px;overflow:hidden;box-shadow:0 8px 22px #0f22343a}.gallery-widget{background:linear-gradient(135deg,#68869a 0%,#3f6674 48%,#253e52 100%)}.gallery-widget:after{content:'';position:absolute;width:150px;height:72px;right:-15px;bottom:16px;border-top:2px solid #c9d7d799;border-radius:50%;transform:rotate(-18deg)}.widget-symbol{display:inline-grid;place-items:center;background:#ffffff33;width:34px;height:34px;border-radius:11px}.gallery-widget>svg{position:absolute;right:12px;bottom:15px}.widget-bottom{position:absolute;bottom:13px;left:14px;display:flex;flex-direction:column;gap:2px}.widget-bottom strong{font-size:15px}.widget-bottom small{font-size:10px;color:#e4eceb}.calendar-widget{background:#243b4be6}.widget-top{display:flex;gap:5px;align-items:center;color:#f7d3ad;font-size:9px;font-weight:700;letter-spacing:.06em}.calendar-widget>strong{display:block;margin-top:7px;font-size:44px;line-height:1;font-weight:550}.home-secondary{min-height:150px;margin:8px 0 24px;background:#1c3545b3;border:1px solid #fff3;border-radius:23px;padding:22px}.home-secondary p{font-size:10px;letter-spacing:.17em;color:#f7d3ad}.home-secondary h2{font-size:23px;line-height:1.05;max-width:230px;margin-bottom:10px}.home-secondary span{font-size:12px;color:#e5edef}.home-apps{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:17px 3px}.app-tile{min-width:0;min-height:83px;display:flex;align-items:center;flex-direction:column;gap:7px;color:#fff;background:transparent;border:0;padding:0;font-size:11px;text-shadow:0 2px 5px #1d2c38}.app-icon{position:relative;width:56px;height:56px;border-radius:17px;display:grid;place-items:cente