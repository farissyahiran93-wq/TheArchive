ground:var(--raised)}.icon-button.bare{background:transparent}.utility-screen,.inbox-screen,.chat-screen{flex:1;min-height:0;display:flex;flex-direction:column;background:var(--phone-bg)}.utility-content,.utility-scroll,.inbox-content{flex:1;min-height:0;overflow-y:auto;padding:21px 19px 28px;overscroll-behavior:contain}.utility-scroll{padding:0}.utility-scroll .utility-content{overflow:visible}.section-caption{display:flex;justify-content:space-between;margin-bottom:14px;color:var(--muted)}.utility-card{background:var(--surface);border:1px solid var(--line);border-radius:16px;padding:18px;margin-bottom:10px;box-shadow:var(--shadow)}.utility-card h2{font-size:17px;margin:0 0 8px}.utility-card p{font-size:13px;line-height:1.5;color:var(--muted);margin:0}.result-card small{color:var(--accent);font-weight:750;font-size:11px}.result-card h2{margin-top:7px}.empty-card{text-align:center;border:1px dashed var(--line);border-radius:18px;padding:45px 24px;color:var(--muted);margin-top:17px}.empty-card svg{color:var(--accent);margin-bottom:12px}.empty-card h2{color:var(--text);font-size:18px}.empty-card p{font-size:13px;line-height:1.5}.utility-note{font-size:12px;line-height:1.5;color:var(--muted);margin:15px 2px}.search-field,.reply-search{display:flex;align-items:center;gap:8px;color:var(--muted);background:var(--surface);border:1px solid var(--line);border-radius:13px;padding-left:13px}.search-field input,.reply-search input{border:0;background:transparent;outline:0;min-height:45px}.search-field{margin-bottom:20px}.bulletin-card{min-height:220px;background:linear-gradient(140deg,#31586a,#213747);color:#fff;border:0}.bulletin-card span{font-size:10px;color:#e2c9a5;letter-spacing:.14em}.bulletin-card h2{font-size:27px;margin-top:50px}.bulletin-card p{color:#d8e4e8}.photo-placeholder{height:270px;border-radius:18px;background:linear-gradient(0deg,#071a2d66,#0000),url('/greyhaven-wallpaper.svg') center/cover;padding:16px;color:#fff}.photo-placeholder span{font-size:10px;lette