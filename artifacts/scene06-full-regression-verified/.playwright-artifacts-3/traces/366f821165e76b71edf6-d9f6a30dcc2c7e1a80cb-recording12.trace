.08;letter-spacing:-.035em;margin:10px 0 19px;text-shadow:0 2px 10px #10212b88}.home-heading h1 em{font-style:normal;color:#ffe0b9}.widgets{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin:0 0 22px}.widget{height:126px;border:1px solid #ffffff66;border-radius:21px;position:relative;text-align:left;color:#fff;padding:14px;overflow:hidden;box-shadow:0 8px 22px #0f22343a}.gallery-widget{background:linear-gradient(135deg,#68869a 0%,#3f6674 48%,#253e52 100%)}.gallery-widget:after{content:'';position:absolute;width:150px;height:72px;right:-15px;bottom:16px;border-top:2px solid #c9d7d799;border-radius:50%;transform:rotate(-18deg)}.widget-symbol{display:inline-grid;place-items:center;background:#ffffff33;width:34px;height:34px;border-radius:11px}.gallery-widget>svg{position:absolute;right:12px;bottom:15px}.widget-bottom{position:absolute;bottom:13px;left:14px;display:flex;flex-direction:column;gap:2px}.widget-bottom strong{font-size:15px}.widget-bottom small{font-size:10px;color:#e4eceb}.calendar-widget{background:#243b4be6}.widget-top{display:flex;gap:5px;align-items:center;color:#f7d3ad;font-size:9px;font-weight:700;letter-spacing:.06em}.calendar-widget>strong{display:block;margin-top:7px;font-size:44px;line-height:1;font-weight:550}.home-secondary{min-height:150px;margin:8px 0 24px;background:#1c3545b3;border:1px solid #fff3;border-radius:23px;padding:22px}.home-secondary p{font-size:10px;letter-spacing:.17em;color:#f7d3ad}.home-secondary h2{font-size:23px;line-height:1.05;max-width:230px;margin-bottom:10px}.home-secondary span{font-size:12px;color:#e5edef}.home-apps{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:17px 3px}.app-tile{min-width:0;min-height:83px;display:flex;align-items:center;flex-direction:column;gap:7px;color:#fff;background:transparent;border:0;padding:0;font-size:11px;text-shadow:0 2px 5px #1d2c38}.app-icon{position:relative;width:56px;height:56px;border-radius:17px;display:grid;place-items:center;border:1px solid #ffffff72;bo