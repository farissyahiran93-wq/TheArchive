opening-note>p.opening-note-caption{font:11px/1.4 sans-serif;color:#62665f;margin-top:20px}.opening-note button{display:flex;align-items:center;gap:7px;padding:10px;border-radius:9px;background:#25394a;color:#fff;border:0;font-size:12px}.opening-confirm{display:flex;align-items:center;gap:5px;font-size:11px;color:#196151;font-weight:700}\r\n.opening-stage-top{color:#bad1df;font-size:11px;letter-spacing:.1em;font-weight:800}.opening-stage-top small{margin-left:auto;color:#f1b78b;font-size:9px}.opening-stage-scroll{flex:1;min-height:0;overflow:auto;padding:25px 22px 35px}.opening-center-icon{display:grid;place-items:center;width:91px;height:91px;margin:30px auto;background:#213747;border:1px solid #527486;border-radius:24px;color:#8bd2d9}.opening-recovery h1,.opening-found h1{font-size:26px;line-height:1.16;letter-spacing:-.03em;margin:18px 0}.opening-stage-scroll>p{font-size:13px;color:#b7cad8;line-height:1.7}.opening-properties{display:grid;grid-template-columns:1fr 1fr;gap:14px 6px;border:1px solid #30475a;background:#182737;padding:19px 14px;border-radius:14px;margin:25px 0}.opening-properties span{font-size:12px;color:#adc1d1}.opening-properties strong{text-align:right;font-size:11px;letter-spacing:.03em}.opening-warning{color:#eab086}.opening-legal{display:flex;gap:12px;padding:12px;border-radius:12px;border:1px solid #47727c;background:#1c3540}.opening-legal svg{flex:none;color:#90d1cd}.opening-legal p{font-size:12px;line-height:1.55;margin:0}\r\n.opening-mirror-stage .mirror{flex:1;min-height:0}.mirror{background:#0c1623;color:#e3edf5;min-height:0;display:flex;flex-direction:column}.mirror-top{flex:none;display:flex;gap:6px;align-items:center;justify-content:space-between;padding:12px 14px;border-bottom:1px solid #25394e;font-size:9px;color:#9ebacb}.mirror-top>span:nth-child(2){flex:1}.mirror-top>span:last-child{color:#9cdbbb}.mirror-main,.mirror-detail{flex:1;min-height:0;overflow:auto;padding:16px 18px 28px}.mirror-hero{text-align:center;background:linear-gradient(150deg,#203649,#142536);border-radius:18px;padding:19px 12px;margin-bottom:19px}.mirror-hero svg{margin:0 auto 7px;color:#9ecfdf}.mirror-hero strong,.mirror-hero small{display:block}.mirror-hero strong{font-size:20px}.mirror-hero small{font-size:11px;margin-top:6px;color:#99b6c8}.mirror-hero p{font-size:11px;color:#abc0ce;line-height:1.5;margin:12px auto 0;max-width:300px}.mirror-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px 9px}.mirror-icon{border:0;background:none;color:#ddebf5;min-width:0;display:flex;flex-direction:column;align-items:center;gap:4px}.mirror-icon>span{width:57px;height:57px;border:1px solid #365269;background:#203a4e;border-radius:17px;display:grid;place-items:center;color:#b3d9e6}.mirror-icon strong{font-size:11px}.mirror-icon small{color:#8faabc;font-size:9px;line-height:1.2}.mirror-caption,.mirror-guidance{display:flex;align-items:flex-start;gap:8px;font-size:11px;line-height:1.55;color:#9cb8c5;background:#183042;border-radius:11px;padding:11px;margin-top:15px}.mirror-caption svg,.mirror-guidance svg{flex:none}.mirror-guidance{color:#b8e6d4;border:1px solid #326859}.mirror-back{display:flex;align-items:center;gap:8px;border:0;background:none;color:#99c5d5;padding:4px 0 17px}.mirror-detail h2{font-size:25px;margin:0 0 7px}.mirror-detail>small{color:#91abbd}.mirror-items{margin:20px 0;display:grid;gap:8px}.mirror-file{display:flex;align-items:center;gap:10px;color:#d8e8f1;background:#17293a;padding:12px;border-radius:12px;text-align:left;border:1px solid #344a5f;font-size:12px}.mirror-file span{flex:1}.mirror-file.is-active{border-color:#7aafb9;background:#254454}.mirror-document{border:1px solid #365668;background:#17293a;border-radius:13px;padding:19px}.mirror-document small{font-size:10px;color:#a3cdcf}.mirror-document h3{font-size:15px}.mirror-document p{white-space:pre-wrap;line-height:1.65;font-size:13px;color:#d6e4ec}.mirror-compare{display:flex;align-items:center;justify-content:center;gap:6px;width:100%;border:0;border-radius:12px;background:#3a8082;color:#fff;font-weight:700;padding:14px 10px;margin-top:16px}.mirror-compare:disabled{opacity:.5}.opening-found .opening-stage-scroll>svg{color:#dda67b;margin-top:18px}.opening-found h1{font-size:30px}.opening-found small{color:#b4c8d9;letter-spacing:.13em}.opening-mismatch{display:grid;gap:10px;background:#203243;padding:17px;border-radius:14px;border:1px solid #4d6477}.opening-mismatch span{display:flex;justify-content:space-between}.opening-mismatch strong{font-size:20px}.opening-hook{display:flex;gap:11px;margin-top:23px;background:#223648;border-radius:13px;padding:15px}.opening-hook p{margin:0;flex:1;font-size:13px;line-height:1.5}.opening-hook p span{display:block;margin-top:5px}.opening-found h2{font-size:16px;margin:25px 0 8px}.opening-found ol{font-size:13px;line-height:1.8;color:#c7d9e4;padding-left:20px}\r\n\r\n.opening-lock-message{position:absolute;left:18px;right:18px;bottom:118px;z-index:3;border:1px solid #bed7e888;border-radius:15px;background:#12293cdd;backdrop-filter:blur(12px);padding:13px;text-align:left;color:#fff;display:grid;gap:4px;box-shadow:0 8px 28px #0004}.opening-lock-message span{font-size:10px;color:#b6c9d7;letter-spacing:.09em}.opening-lock-message strong{font-size:14px}.opening-lock-message small{font-size:12px;color:#d1dce4}\r\n\r\n/* Daniel's iPhone mirror and protected apps */\r\n.mirror{background:linear-gradient(145deg,#111b32,#0b101c 62%,#202b49);color:#f5f5f7}.mirror-ios-status{color:#f7f7fa;background:#101623;border-bottom:0;padding:11px 20px;font-weight:700}.mirror-main{padding:15px 16px 28px}.mirror-hero{min-height:142px;display:flex;flex-direction:column;justify-content:center;background:transparent;margin-bottom:14px}.mirror-hero strong{font-weight:650;font-size:31px;letter-spacing:-1.3px}.mirror-hero p{font-size:10px}.mirror-grid{grid-template-columns:repeat(4,minmax(0,1fr));gap:16px 5px}.mirror-icon>span{width:56px;height:56px;border:0;background:linear-gradient(160deg,#4094ed,#1a64b8);border-radius:15px;box-shadow:0 4px 10px #0004;color:#fff}.mirror-icon:nth-child(2n)>span{background:linear-gradient(150deg,#767d8a,#3e4757)}.mirror-icon:nth-child(3n)>span{background:linear-gradient(140deg,#64bd8c,#218551)}.mirror-icon:nth-child(5n)>span{background:linear-gradient(140deg,#e3bb65,#ad7531)}.mirror-icon strong{font-size:10px}.mirror-icon small{font-size:8px}.mirror-detail{background:#080809}.mirror-detail h2{font-size:32px;letter-spacing:-.04em}.mirror-file{background:#1c1c1e;border:0;border-radius:11px;min-height:51px}.mirror-file.is-active{background:#2c2c2e;border:1px solid #0a84ff}.mirror-document{background:#1c1c1e;border:0;border-radius:14px}.mirror-lock-panel{display:flex;align-items:stretch;flex-direction:column;gap:12px;text-align:center;padding:16px 2px}.mirror-lock-panel>svg{align-self:center;color:#a6a6ad}.mirror-lock-panel strong{font-size:16px}.mirror-lock-panel p{color:#aaa;font-size:12px}.mirror-lock-panel label{text-align:left;font-size:11px;color:#babac0}.mirror-lock-panel input{height:44px;padding:12px;color:white;background:#323237;border:1px solid #5d5d65;border-radius:11px}.mirror-lock-panel button{display:flex;justify-content:center;align-items:center;gap:8px;border:0;color:#fff;background:#0a84ff;border-radius:12px;padding:13px}.mirror-success{display:flex;align-items:center;gap:7px;color:#45d28c!important}.opening-bubble.player{background:#0a84ff}.opening-bubble.sophie{background:#303033}.opening-chat-header{background:#1c1c1ecc;backdrop-filter:blur(12px)}.opening-actions{background:#151517}.opening-choice.selected{border-color:#0a84ff;background:#203b60}.opening-primary{background:#0a84ff}\r\n\r\n/* Episode 01: item-level iOS-style locks and clue-driven optional puzzles */\r\n.mirror-folder-count{color:#aaaab1;font-size:12px;margin:12px 0 4px}\r\n.mirror-photo-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:7px;margin:16px 0 5px}\r\n.mirror-photo-tile{display:flex;flex-direction:column;align-items:center;gap:5px;background:none;color:#dfe2ec;border:0;padding:3px;border-radius:10px;min-width:0}\r\n.mirror-photo-tile.selected{outline:2px solid #0a84ff}\r\n.mirror-photo-art{width:100%;aspect-ratio:1;display:grid;place-items:center;background:linear-gradient(145deg,#455674,#1e2b43 55%,#4c5668);border-radius:7px;color:#d5e3ef}\r\n.mirror-photo-tile:nth-child(2n) .mirror-photo-art{background:linear-gradient(145deg,#756749,#3b4448,#293851)}\r\n.mirror-photo-tile small{font-size:10px;white-space:nowrap;color:#b6c2d0}\r\n.mirror-media-preview{border-radius:12px;background:linear-gradient(130deg,#364760,#29354e 65%,#68583e);height:142px;display:flex;flex-direction:column;gap:7px;align-items:center;justify-content:center;color:#dceaf7;padding:15px;text-align:center;font-size:12px}\r\n.mirror-media-preview small{color:#bac2ca;font-size:10px}\r\n.mirror-source-note{font-size:11px!important;color:#a6adba!important;display:flex;align-items:center;gap:6px}\r\n.mirror-hint-toggle{background:#2b2c33!important;color:#a4cffe!important;border:1px solid #49505c!important}\r\n.mirror-hints{text-align:left;margin:0;padding:12px 12px 12px 29px;background:#252834;border-radius:12px;color:#e1e6f0;font-size:12px;line-height:1.7}\r\n.mirror-lock-panel p[role=alert]{color:#ffa9a0!important}\r\n.opening-next-lead{border:1px solid #3d6b89;background:#1a364d;padding:15px;border-radius:14px;margin-top:18px;color:#d9ecfb}\r\n.opening-next-lead strong{font-size:11px;letter-spacing:.03em}\r\n.opening-next-lead p{font-size:13px;line-height:1.6;margin-bottom:0}\r\n\r\n.mirror-message-history{display:flex;flex-direction:column;gap:9px;margin-top:16px;align-items:stretch}\r\n.mirror-chat-bubble{max-width:83%;padding:10px 13px;border-radius:18px;font-size:14px;line-height:1.45;display:flex;flex-direction:column;gap:4px}\r\n.mirror-chat-bubble small{font-size:10px;opacity:.75}\r\n.mirror-chat-bubble span{white-space:pre-wrap}\r\n.mirror-chat-bubble.incoming{background:#323237;border-bottom-left-radius:4px;align-self:flex-start}\r\n.mirror-chat-bubble.outgoing{background:#0a84ff;border-bottom-right-radius:4px;align-self:flex-end;color:#fff}\r\n.mirror-email-body{background:#26262b;padding:15px;border-radius:13px;margin-top:14px}\r\n.mirror-mail-label{color:#89b8ec;font-weight:600;font-size:10px;letter-spacing:.09em}\r\n.mirror-note-body{border-radius:12px;background:#27282c;padding:15px;margin-top:14px}\r\n\r\n.opening-jump{position:absolute;right:16px;top:85px;z-index:3;background:#0a84ff;color:white;border:0;border-radius:20px;padding:10px 14px}\r\n.opening-actions{max-height:47%;overflow-y:auto;padding-bottom:max(12px,env(safe-area-inset-bottom))}\r\n.opening-screen{min-width:0;position:relative}.opening-choice{overflow-wrap:anywhere;min-height:44px}\r\n@media(prefers-reduced-motion:reduce){.opening-screen *{animation:none!important;transition:none!important;scroll-behavior:auto!important}}\r\n\r\n.opening-note[role=dialog]{position:absolute;inset:0;z-index:10;overflow-y:auto;margin:0;border-radius:0;background:#1c1c1e;padding:20px;color:#eee}\r\n.opening-note[role=dialog] img{display:block;width:100%;height:auto;margin:14px 0}\r\n.opening-note-close{min-height:44px;margin-left:auto!important}\r\n\r\n.opening-screen .opening-note[role=dialog]{max-width:none;width:auto;transform:none;border-radius:0!important;background:#1c1c1e!important;color:#eee!important}\r\n.opening-screen .opening-note[role=dialog]>p{color:#eee!important}\r\n.opening-screen .opening-note[role=dialog] .opening-confirm{color:#83d8aa}\r\n.daniel-note-content{max-width:480px;margin:0 auto 18px}\r\n.opening-note[role=dialog] .daniel-note-content img{max-height:62vh;object-fit:contain;margin:16px auto}\r\n.daniel-note-transcript{border:1px solid #45454d;border-radius:12px;background:#252529;color:#eee;overflow:hidden}\r\n.daniel-note-transcript summary{min-height:44px;padding:12px 14px;cursor:pointer;font:600 14px/1.5 system-ui,sans-serif}\r\n.daniel-note-transcript>div{padding:0 16px 12