lock}\r\n.mirror-record-images img{height:auto;aspect-ratio:1;object-fit:cover}\r\n.mirror-photo-record .mirror-open-photos{color:#007aff;border:0;background:none;font-size:16px}\r\n.mirror .mirror-lock-panel{padding:38px 10px;align-items:center;text-align:center;gap:15px;color:#111}\r\n.mirror .mirror-lock-panel input{background:white;color:#111;border:1px solid #d1d1d6;width:100%}\r\n.mirror .mirror-lock-panel label{color:#666;align-self:flex-start}\r\n.mirror .mirror-lock-panel p{font-size:14px;color:#777}\r\n.mirror .mirror-lock-panel button{width:100%;background:#007aff;border-radius:12px;color:white}\r\n.mirror .mirror-lock-panel .mirror-hint-toggle{background:transparent;color:#007aff}\r\n.mirror-hints{padding-left:20px;text-align:left;font-size:13px;line-height:1.7}\r\n.mirror-contact-profile p{background:white;border-radius:12px;padding:18px;width:100%;text-align:left}\r\n.mirror-contact-profile .mirror-contact-avatar{width:96px;height:96px}\r\n.mirror-map-placeholder{display:flex;flex-direction:column;justify-content:center;align-items:center;gap:12px;min-height:200px;border-radius:18px;background:#e8e9e3;color:#8a8f83}\r\n.mirror-address-bar{background:#e6e6eb;color:#555;text-align:center}\r\n.mirror-email-body h4{font-size:24px;letter-spacing:-.5px;margin:12px 0 20px}.mirror-mail-label{font-size:12px;color:#8e8e93}\r\n.mirror-options{position:static}\r\n.mirror-options-sheet{position:absolute;right:0;top:46px;width:min(310px,calc(100vw - 42px));max-height:65dvh;overflow:auto;padding:8px 12px;background:#fffffffa;border:1px solid #e5e5ea;border-radius:16px;box-shadow:0 12px 40px #0003;color:#111;z-index:10;backdrop-filter:blur(30px)}\r\n.mirror-options-sheet header{display:flex;align-items:center;justify-content:space-between;padding-left:8px;font-size:15px}\r\n.mirror-options-sheet>button{width:100%;justify-content:flex-start;text-align:left;font-size:14px;gap:9px;border-top:1px solid #e5e5ea;border-radius:0;padding:12px 8px;white-space:normal}\r\n.mirro