."]]],["DIV",{"class":"conversation-line incoming chat-group-continuation chat-group-open"},["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble sophie"},"Whether you'd heard from him recently."]]],["DIV",{"class":"conversation-line incoming chat-group-continuation chat-group-open"},["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble sophie"},"Daniel hasn't been answering anyone."]]],["DIV",{"class":"conversation-line incoming chat-group-continuation chat-group-open"},["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble sophie"},"Calls, messages..."]]],["DIV",{"class":"conversation-line incoming chat-group-continuation chat-group-open"},["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble sophie"},"Nothing."]]],["DIV",{"class":"conversation-line incoming chat-group-continuation chat-group-end"},["SPAN",{"class":"chat-contact-avatar"},["SPAN",{"class":"character-avatar message-avatar","aria-hidden":"true"},["IMG",{"__playwright_current_src__":"","alt":"","loading":"lazy","decoding":"async","src":"/media/portraits/sophie-avatar.webp"}]]],["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble sophie"},"For days."]]],["DIV",{"class":"conversation-line outgoing chat-group-start chat-group-end"},["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble player"},"Maybe he needs some time alone?"]]],["DIV",{"class":"conversation-line incoming chat-group-start chat-group-open"},["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble sophie"},"I thought that too."]]],["DIV",{"class":"conversation-line incoming chat-group-continuation chat-group-open"},["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble sophie"},"At first."]]],["DIV",{"class":"conversation-line incoming chat-group-continuation chat-group-open"},["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble sophie"},"But it's gone on longer than anyone expected."]]],["DIV",{"class":"conversation-line incoming chat-group-continuation chat-group-open"},["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble sophie"},"Sorry."]]],["DIV",{"class":"conversation-line incoming chat-group-continuation chat-group-open"},["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble sophie"},"I shouldn't have dropped all that on you."]]],["DIV",{"class":"conversation-line incoming chat-group-continuation chat-group-end"},["SPAN",{"class":"chat-contact-avatar"},["SPAN",{"class":"character-avatar message-avatar","aria-hidden":"true"},["IMG",{"__playwright_current_src__":"","alt":"","loading":"lazy","decoding":"async","src":"/media/portraits/sophie-avatar.webp"}]]],["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble sophie"},"We don't even know each other."]]],["DIV",{"class":"conversation-line outgoing chat-group-start chat-group-end"},["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble player"},"You can call me Alex."]]],["DIV",{"class":"conversation-line incoming chat-group-start chat-group-open"},["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble sophie"},"Alex."]]],["DIV",{"class":"conversation-line incoming chat-group-continuation chat-group-open"},["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble sophie"},"Okay. Nice to meet you."]]],["DIV",{"class":"conversation-line incoming chat-group-continuation chat-group-open"},["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble sophie"},"Under very strange circumstances. 😅"]]],["DIV",{"class":"conversation-line incoming chat-group-continuation chat-group-open"},["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble sophie"},"Can I be honest about something?"]]],["DIV",{"class":"conversation-line incoming chat-group-continuation chat-group-end"},["SPAN",{"class":"chat-contact-avatar"},["SPAN",{"class":"character-avatar message-avatar","aria-hidden":"true"},["IMG",{"__playwright_current_src__":"","alt":"","loading":"lazy","decoding":"async","src":"/media/portraits/sophie-avatar.webp"}]]],["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble sophie"},"I almost deleted your number before messaging you."]]],["DIV",{"class":"conversation-line outgoing chat-group-start chat-group-end"},["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble player"},"Why didn't you?"]]],["DIV",{"class":"conversation-line incoming chat-group-start chat-group-open"},["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble sophie"},"I kept thinking about the fact that it had been saved."]]],["DIV",{"class":"conversation-line incoming chat-group-continuation chat-group-open"},["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble sophie"},"There had to be a reason."]]],["DIV",{"class":"conversation-line incoming chat-group-continuation chat-group-open"},["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble sophie"},"Or at least I hoped there was."]]],["DIV",{"class":"conversation-line incoming chat-group-continuation chat-group-open"},["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble sophie"},"Anyway."]]],["DIV",{"class":"conversation-line incoming chat-group-continuation chat-group-open"},["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble sophie"},"I should probably let you go."]]],["DIV",{"class":"conversation-line incoming chat-group-continuation chat-group-open"},["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble sophie"},"You've already been more patient than I expected."]]],["DIV",{"class":"conversation-line incoming chat-group-continuation chat-group-open"},["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble sophie"},"Actually, wait."]]],["DIV",{"class":"conversation-line incoming chat-group-continuation chat-group-open"},["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble sophie"},"There's something else."]]],["DIV",{"cl