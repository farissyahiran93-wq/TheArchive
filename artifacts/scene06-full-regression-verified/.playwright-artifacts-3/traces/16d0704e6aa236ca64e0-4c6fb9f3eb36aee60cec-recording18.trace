-11"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: You could try."}},{"k":"read","v":{"b":false}}],"id":289},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-03-12"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Go ahead, Soph."}},{"k":"read","v":{"b":false}}],"id":290},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-03-13"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I found a saved contact export."}},{"k":"read","v":{"b":false}}],"id":291},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-03-14"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: It's labelled as Daniel's contacts."}},{"k":"read","v":{"b":false}}],"id":292},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-03-15"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I already told you about it."}},{"k":"read","v":{"b":false}}],"id":293},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-03-16"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Right."}},{"k":"read","v":{"b":false}}],"id":294},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-03-17"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: And the number didn't have a name."}},{"k":"read","v":{"b":false}}],"id":295},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-03-18"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: We know."}},{"k":"read","v":{"b":false}}],"id":296},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-03-19"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I'm getting there."}},{"k":"read","v":{"b":false}}],"id":297},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-03-20"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: There was something beside it."}},{"k":"read","v":{"b":false}}],"id":298},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-03-21"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: A star next to the number."}},{"k":"read","v":{"b":false}}],"id":299},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-03-22"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: A favourite contact?"}},{"k":"read","v":{"b":false}}],"id":300},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-03-23"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Maybe. I don't know how that export uses it."}},{"k":"read","v":{"b":false}}],"id":301},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-03-24"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: It just says starred. There's no saved name or label."}},{"k":"read","v":{"b":false}}],"id":302},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-03-25"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Do we even know Daniel was the one who marked it?"}},{"k":"read","v":{"b":false}}],"id":303},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-03-26"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: No. We don't."}},{"k":"read","v":{"b":false}}],"id":304},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-03-27"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I know. I'm not saying he was."}},{"k":"read","v":{"b":false}}],"id":305},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-03-29"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Then what made you contact the number?"}},{"k":"read","v":{"b":false}}],"id":306},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-03-30"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I hoped whoever answered might recognise him."}},{"k":"read","v":{"b":false}}],"id":307},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-03-31"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Did they?"}},{"k":"read","v":{"b":false}}],"id":308},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-03-32"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: No. But I didn't want to shut the door without asking."}},{"k":"read","v":{"b":false}}],"id":309},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-03-34"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: ..."}},{"k":"read","v":{"b":false}}],"id":310},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-03-35"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: So this was a guess?"}},{"k":"read","v":{"b":false}}],"id":311},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-03-36"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: A question. I hoped it might lead somewhere."}},{"k":"read","v":{"b":false}}],"id":312},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-03-37"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: That's different from knowing it would."}},{"k":"read","v":{"b":false}}],"id":313},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-03-38"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: You've been going through a lot of his things."}},{"k":"read","v":{"b":false}}],"id":314},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-03-39"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: We can ask questions without treating the star as proof."}},{"k":"read","v":{"b":false}}],"id":315},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-03-40"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I know."}},{"k":"read","v":{"b":false}}],"id":316},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-03-41"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I just don't want us to stop looking."}},{"k":"read","v":{"b":false}}],"id":317},{"o":[{"k":"id","v":{"s":"OPEN-S02-C04-a-1"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: No. The copy doesn't show who did it."}},{"k":"read","v":{"b":false}}],"id":318},{"o":[{"k":"id","v":{"s":"OPEN-S02-C04-a-2"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I shouldn't have assumed it was Daniel."}},{"k":"read","v":{"b":false}}],"id":319},{"o":[{"k":"id","v":{"s":"OPEN-S02-C04-a-3"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: That's what I've been trying to say."}},{"k":"read","v":{"b":false}}],"id":320},{"o":[{"k":"id","v":{"s":"OPEN-S02-C04-a-4"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Then we keep that question open."}},{"k":"read","v":{"b":false}}],"id":321},{"o":[{"k":"id","v":{"s":"OPEN-S02-C04-a-5"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Yeah. That's fair."}},{"k":"read","v":{"b":false}}],"id":322},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-04-2"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Sophie, can you check something for me?"}},{"k":"read","v":{"b":false}}],"id":323},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-04-3"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Yeah?"}},{"k":"read","v":{"b":false}}],"id":324},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-04-4"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Does the export show when the number was starred?"}},{"k":"read","v":{"b":false}}],"id":325},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-04-5"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: No. Not in the copy I have."}},{"k":"read","v":{"b":false}}],"id":326},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-04-6"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Or who changed it?"}},{"k":"read","v":{"b":false}}],"id":327},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-04-7"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: No. I checked for that too."}},{"k":"read","v":{"b":false}}],"id":328},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-04-8"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Then the star doesn't tell us it was his decision."}},{"k":"read","v":{"b":false}}],"id":329},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-04-9"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Lucas, I am trying."}},{"k":"read","v":{"b":false}}],"id":330},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-04-10"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: I know."}},{"k":"read","v":{"b":false}}],"id":331},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-04-11"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: But we can't keep building theories around things nobody's verified."}},{"k":"read","v":{"b":false}}],"id":332},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-04-12"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: For once, that part is fair."}},{"k":"read","v":{"b":false}}],"id":333},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-04-13"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Okay."}},{"k":"read","v":{"b":false}}],"id":334},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-04-14"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I'll look at it again."}},{"k":"read","v":{"b":false}}],"id":335},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-04-17"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Can we talk about something else for a second?"}},{"k":"read","v":{"b":false}}],"id":336},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-04-18"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Like what?"}},{"k":"read","v":{"b":false}}],"id":337},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-04-19"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Whether anyone's actually eaten today."}},{"k":"read","v":{"b":false}}],"id":338},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-04-20"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Maya..."}},{"k":"read","v":{"b":false}}],"id":339},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-04-21"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: I'm serious."}},{"k":"read","v":{"b":false}}],"id":340},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-04-22"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: You were still awake when I went to bed."}},{"k":"read","v":{"b":false}}],"id":341},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-04-23"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I slept."}},{"k":"read","v":{"b":false}}],"id":342},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-04-24"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: For how long?"}},{"k":"read","v":{"b":false}}],"id":343},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-04-25"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Enough."}},{"k":"read","v":{"b":false}}],"id":344},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-04-26"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: That's not a number."}},{"k":"read","v":{"b":false}}],"id":345},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-04-27"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: You're starting to sound like my mother."}},{"k":"read","v":{"b":false}}],"id":346},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-04-28"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Someone has to."}},{"k":"read","v":{"b":false}}],"id":347},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-04-30"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: I ate."}},{"k":"read","v":{"b":false}}],"id":348},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-04-31"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Congratulations, Lucas."}},{"k":"read","v":{"b":false}}],"id":349},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-04-32"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: You asked."}},{"k":"read","v":{"b":false}}],"id":350},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-04-33"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: I did."}},{"k":"read","v":{"b":false}}],"id":351},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-04-34"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: 😂"}},{"k":"read","v":{"b":false}}],"id":352},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-04-35"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: There. See?"}},{"k":"read","v":{"b":false}}],"id":353},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-04-36"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: She still remembers how to laugh."}},{"k":"read","v":{"b":false}}],"id":354},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-04-37"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Barely."}},{"k":"read","v":{"b":false}}],"id":355},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-04-39"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: It isn't funny."}},{"k":"read","v":{"b":false}}],"id":356},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-04-40"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Nobody said the situation was funny."}},{"k":"read","v":{"b":false}}],"id":357},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-04-41"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Then can we stay focused?"}},{"k":"read","v":{"b":false}}],"id":358},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-04-42"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: We can be worried and still act like human beings."}},{"k":"read","v":{"b":false}}],"id":359},{"o":[{"k":"id","v":{"s":"OPEN-S02-C05-a-1"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Thank you."}},{"k":"read","v":{"b":false}}],"id":360},{"o":[{"k":"id","v":{"s":"OPEN-S02-C05-a-2"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I probably am."}},{"k":"read","v":{"b":false}}],"id":361},{"o":[{"k":"id","v":{"s":"OPEN-S02-C05-a-3"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: I'm fine."}},{"k":"read","v":{"b":false}}],"id":362},{"o":[{"k":"id","v":{"s":"OPEN-S02-C05-a-4"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: That's exactly what an exhausted person would say."}},{"k":"read","v":{"b":false}}],"id":363},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-05-1"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Okay."}},{"k":"read","v":{"b":false}}],"id":364},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-05-2"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I'm getting some water."}},{"k":"read","v":{"b":false}}],"id":365},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-05-3"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Finally."}},{"k":"read","v":{"b":false}}],"id":366},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-05-4"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Don't celebrate yet."}},{"k":"read","v":{"b":false}}],"id":367},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-05-5"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I'll be back in like two minutes."}},{"k":"read","v":{"b":false}}],"id":368},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-05-6"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Progress is progress."}},{"k":"read","v":{"b":false}}],"id":369},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-05-10"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Maya."}},{"k":"read","v":{"b":false}}],"id":370},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-05-11"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: What?"}},{"k":"read","v":{"b":false}}],"id":371},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-05-12"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: You're being awfully relaxed about this."}},{"k":"read","v":{"b":false}}],"id":372},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-05-13"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: About what?"}},{"k":"read","v":{"b":false}}],"id":373},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-05-14"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: This person."}},{"k":"read","v":{"b":false}}],"id":374},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-05-15"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: I'm not relaxed."}},{"k":"read","v":{"b":false}}],"id":375},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-05-16"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: You're joking with them."}},{"k":"read","v":{"b":false}}],"id":376},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-05-17"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: That doesn't mean I trust them."}},{"k":"read","v":{"b":false}}],"id":377},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-05-19"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Good."}},{"k":"read","v":{"b":false}}],"id":378},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-05-20"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Because I don't."}},{"k":"read","v":{"b":false}}],"id":379},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-05-21"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: You made that pretty clear."}},{"k":"read","v":{"b":false}}],"id":380},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-05-22"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: I don't understand why Sophie is doing this."}},{"k":"read","v":{"b":false}}],"id":381},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-05-23"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: She's scared."}},{"k":"read","v":{"b":false}}],"id":382},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-05-24"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: We're all scared."}},{"k":"read","v":{"b":false}}],"id":383},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-05-25"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: I know."}},{"k":"read","v":{"b":false}}],"id":384},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-05-26"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: And that doesn't mean we invite strangers into everything."}},{"k":"read","v":{"b":false}}],"id":385},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-05-28"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: You're still here, by the way."}},{"k":"read","v":{"b":false}}],"id":386},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-05-29"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: What?"}},{"k":"read","v":{"b":false}}],"id":387},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-05-30"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: The person you're talking about."}},{"k":"read","v":{"b":false}}],"id":388},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-05-31"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: They're still in the group."}},{"k":"read","v":{"b":false}}],"id":389},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-05-32"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: I know."}},{"k":"read","v":{"b":false}}],"id":390},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-05-33"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Then maybe stop talking about them like they aren't."}},{"k":"read","v":{"b":false}}],"id":391},{"o":[{"k":"id","v":{"s":"OPEN-S02-C06-a-1"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Exactly."}},{"k":"read","v":{"b":false}}],"id":392},{"o":[{"k":"id","v":{"s":"OPEN-S02-C06-a-2"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: I wasn't trying to hide it."}},{"k":"read","v":{"b":false}}],"id":393},{"o":[{"k":"id","v":{"s":"OPEN-S02-C06-a-4"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Lucas, just stop digging."}},{"k":"read","v":{"b":false}}],"id":394},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-06-2"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Listen."}},{"k":"read","v":{"b":false}}],"id":395},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-06-3"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: I'm not going to pretend this isn't strange."}},{"k":"read","v":{"b":false}}],"id":396},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-06-4"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: I don't know you."}},{"k":"read","v":{"b":false}}],"id":397},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-06-5"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: And I don't know what your number means."}},{"k":"read","v":{"b":false}}],"id":398},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-06-6"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: But I also don't think it's fair to assume the worst just because we don't have an answer."}},{"k":"read","v":{"b":false}}],"id":399},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-06-7"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: That goes both ways."}},{"k":"r