e}}],"id":226},{"o":[{"k":"id","v":{"s":"OPEN-S02-OPENING-20"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Please what?"}},{"k":"read","v":{"b":false}}],"id":227},{"o":[{"k":"id","v":{"s":"OPEN-S02-OPENING-21"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: We don't even know who this is."}},{"k":"read","v":{"b":false}}],"id":228},{"o":[{"k":"id","v":{"s":"OPEN-S02-OPENING-22"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Can we just calm down for a second?"}},{"k":"read","v":{"b":false}}],"id":229},{"o":[{"k":"id","v":{"s":"OPEN-S02-OPENING-23"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: I'm calm."}},{"k":"read","v":{"b":false}}],"id":230},{"o":[{"k":"id","v":{"s":"OPEN-S02-OPENING-24"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: You're really not."}},{"k":"read","v":{"b":false}}],"id":231},{"o":[{"k":"id","v":{"s":"OPEN-S02-OPENING-25"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Fine."}},{"k":"read","v":{"b":false}}],"id":232},{"o":[{"k":"id","v":{"s":"OPEN-S02-OPENING-26"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Then maybe our new guest would like to explain why they're here."}},{"k":"read","v":{"b":false}}],"id":233},{"o":[{"k":"id","v":{"s":"OPEN-S02-C01-a-1"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Great."}},{"k":"read","v":{"b":false}}],"id":234},{"o":[{"k":"id","v":{"s":"OPEN-S02-C01-a-2"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: That makes two of us."}},{"k":"read","v":{"b":false}}],"id":235},{"o":[{"k":"id","v":{"s":"OPEN-S02-C01-a-3"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: At least they're being honest."}},{"k":"read","v":{"b":false}}],"id":236},{"o":[{"k":"id","v":{"s":"OPEN-S02-C01-a-4"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Or they know how to sound honest."}},{"k":"read","v":{"b":false}}],"id":237},{"o":[{"k":"id","v":{"s":"OPEN-S02-C01-a-5"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Lucas."}},{"k":"read","v":{"b":false}}],"id":238},{"o":[{"k":"id","v":{"s":"OPEN-S02-C01-a-6"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: What?"}},{"