v":{"a":[{"o":[{"k":"id","v":{"s":"OPEN-S01-OPENING-1"}},{"k":"text","v":{"s":"Unknown number: Hey"}},{"k":"read","v":{"b":false}}],"id":107},{"o":[{"k":"id","v":{"s":"OPEN-S01-OPENING-3"}},{"k":"text","v":{"s":"Unknown number: Sorry, is this a bad time?"}},{"k":"read","v":{"b":false}}],"id":108},{"o":[{"k":"id","v":{"s":"OPEN-S01-OPENING-5"}},{"k":"text","v":{"s":"Unknown number: Actually"}},{"k":"read","v":{"b":false}}],"id":109},{"o":[{"k":"id","v":{"s":"OPEN-S01-OPENING-6"}},{"k":"text","v":{"s":"Unknown number: I'm not even sure I have the right number 😅"}},{"k":"read","v":{"b":false}}],"id":110},{"o":[{"k":"id","v":{"s":"OPEN-S01-OPENING-8"}},{"k":"text","v":{"s":"Unknown number: Could you just reply when you see this?"}},{"k":"read","v":{"b":false}}],"id":111},{"o":[{"k":"id","v":{"s":"OPEN-S01-C01-a-1"}},{"k":"text","v":{"s":"Unknown number: Oh, right."}},{"k":"read","v":{"b":false}}],"id":112},{"o":[{"k":"id","v":{"s":"OPEN-S01-C01-a-2"}},{"k":"text","v":{"s":"Unknown number: Sorry."}},{"k":"read","v":{"b":false}}],"id":113},{"o":[{"k":"id","v":{"s":"OPEN-S01-C01-a-3"}},{"k":"text","v":{"s":"Sophie: I'm Sophie."}},{"k":"read","v":{"b":false}}],"id":114},{"o":[{"k":"id","v":{"s":"OPEN-S01-C01-a-4"}},{"k":"text","v":{"s":"Sophie: I probably should've started with that."}},{"k":"read","v":{"b":false}}],"id":115},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-01-1"}},{"k":"text","v":{"s":"Sophie: Can I ask you something?"}},{"k":"read","v":{"b":false}}],"id":116},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-01-2"}},{"k":"text","v":{"s":"Sophie: And I promise I'm not selling anything."}},{"k":"read","v":{"b":false}}],"id":117},{"o":[{"k":"id","v":{"s":"OPEN-S01-C02-a-1"}},{"k":"text","v":{"s":"Sophie: Thanks."}},{"k":"read","v":{"b":false}}],"id":118},{"o":[{"k":"id","v":{"s":"OPEN-S01-C02-a-2"}},{"k":"text","v":{"s":"Sophie: Okay, this might sound strange."}},{"k":"read","v":{"b":false}}],"id":119},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-02-1"}},{"k":"text","v":{"s":"Sophie: Okay."}},{"k":"read","v":{"b":false}}],"id":120},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-02-2"}},{"k":"text","v":{"s":"Sophie: I found your number in a saved copy of someone's contacts."}},{"k":"read","v":{"b":false}}],"id":121},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-02-3"}},{"k":"text","v":{"s":"Sophie: There wasn't a name attached to it."}},{"k":"read","v":{"b":false}}],"id":122},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-02-4"}},{"k":"text","v":{"s":"Sophie: Just the number."}},{"k":"read","v":{"b":false}}],"id":123},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-02-5"}},{"k":"text","v":{"s":"Sophie: And a star next to it."}},{"k":"read","v":{"b":false}}],"id":124},{"o":[{"k":"id","v":{"s":"OPEN-S01-C03-a-1"}},{"k":"text","v":{"s":"Sophie: Yeah. That's what caught my eye."}},{"k":"read","v":{"b":false}}],"id":125},{"o":[{"k":"id","v":{"s":"OPEN-S01-C03-a-2"}},{"k":"text","v":{"s":"Sophie: I don't know what it means."}},{"k":"read","v":{"b":false}}],"id":126},{"o":[{"k":"id","v":{"s":"OPEN-S01-C03-a-3"}},{"k":"text","v":{"s":"Sophie: I was hoping you might."}},{"k":"read","v":{"b":false}}],"id":127},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-03-1"}},{"k":"text","v":{"s":"Sophie: The copy is labelled as Daniel's contact export."}},{"k":"read","v":{"b":false}}],"id":128},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-03-3"}},{"k":"text","v":{"s":"Sophie: Daniel Mercer."}},{"k":"read","v":{"b":false}}],"id":129},{"o":[{"k":"id","v":{"s":"OPEN-S01-C04-a-1"}},{"k":"text","v":{"s":"Sophie: Okay."}},{"k":"read","v":{"b":false}}],"id":130},{"o":[{"k":"id","v":{"s":"OPEN-S01-C04-a-2"}},{"k":"text","v":{"s":"Sophie: That's what I was afraid you'd say."}},{"k":"read","v":{"b":false}}],"id":131},{"o":[{"k":"id","v":{"s":"OPEN-S01-C04-a-3"}},{"k":"text","v":{"s":"Sophie: Not that it's your fault."}},{"k":"read","v":{"b":false}}],"id":132},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-04-1"}},{"k":"text","v":{"s":"Sophie: Can I ask if you've ever spoken to anyone called Daniel?"}},{"k":"read","v":{"b":false}}],"id":133},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-04-2"}},{"k":"text","v":{"s":"Sophie: Even online?"}},{"k":"read","v":{"b":false}}],"id":134},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-04-3"}},{"k":"text","v":{"s":"Sophie: Maybe a long time ago?"}},{"k":"read","v":{"b":false}}],"id":135},{"o":[{"k":"id","v":{"s":"OPEN-S01-C05-a-1"}},{"k":"text","v":{"s":"Sophie: Okay."}},{"k":"read","v":{"b":false}}],"id":136},{"o":[{"k":"id","v":{"s":"OPEN-S01-C05-a-2"}},{"k":"text","v":{"s":"Sophie: Thanks for being clear."}},{"k":"read","v":{"b":false}}],"id":137},{"o":[{"k":"id","v":{"s":"OPEN-S01-C05-a-3"}},{"k":"text","v":{"s":"Sophie: That makes this even stranger, though."}},{"k":"read","v":{"b":false}}],"id":138},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-05-1"}},{"k":"text","v":{"s":"Sophie: Anyway."}},{"k":"read","v":{"b":false}}],"id":139},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-05-2"}},{"k":"text","v":{"s":"Sophie: If you don't know him, then I guess that answers one question."}},{"k":"read","v":{"b":false}}],"id":140},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-05-4"}},{"k":"text","v":{"s":"Sophie: Just not the one I really wanted answered."}},{"k":"read","v":{"b":false}}],"id":141},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-05-5"}},{"k":"text","v":{"s":"Sophie: Sorry."}},{"k":"read","v":{"b":false}}],"id":142},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-05-6"}},{"k":"text","v":{"s":"Sophie: I keep making this awkward."}},{"k":"read","v":{"b":false}}],"id":143},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-05-7"}},{"k":"text","v":{"s":"Sophie: You probably have better things to do than talk to a stranger."}},{"k":"read","v":{"b":false}}],"id":144},{"o":[{"k":"id","v":{"s":"OPEN-S01-C06-a-1"}},{"k":"text","v":{"s":"Sophie: Why your number was saved."}},{"k":"read","v":{"b":false}}],"id":145},{"o":[{"k":"id","v":{"s":"OPEN-S01-C06-a-2"}},{"k":"text","v":{"s":"Sophie: Whether Daniel knew you."}},{"k":"read","v":{"b":false}}],"id":146},{"o":[{"k":"id","v":{"s":"OPEN-S01-C06-a-3"}},{"k":"text","v":{"s":"Sophie: Whether you'd heard from him recently."}},{"k":"read","v":{"b":false}}],"id":147},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-06-2"}},{"k":"text","v":{"s":"Sophie: Daniel hasn't been answering anyone."}},{"k":"read","v":{"b":false}}],"id":148},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-06-3"}},{"k":"text","v":{"s":"Sophie: Calls, messages..."}},{"k":"read","v":{"b":false}}],"id":149},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-06-4"}},{"k":"text","v":{"s":"Sophie: Nothing."}},{"k":"read","v":{"b":false}}],"id":150},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-06-6"}},{"k":"text","v":{"s":"Sophie: For days."}},{"k":"read","v":{"b":false}}],"id":151},{"o":[{"k":"id","v":{"s":"OPEN-S01-C07-a-1"}},{"k":"text","v":{"s":"Sophie: I thought that too."}},{"k":"read","v":{"b":false}}],"id":152},{"o":[{"k":"id","v":{"s":"OPEN-S01-C07-a-2"}},{"k":"text","v":{"s":"Sophie: At first."}},{"k":"read","v":{"b":false}}],"id":153},{"o":[{"k":"id","v":{"s":"OPEN-S01-C07-a-3"}},{"k":"text","v":{"s":"Sophie: But it's gone on longer than anyone expected."}},{"k":"read","v":{"b":false}}],"id":154},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-07-1"}},{"k":"text","v":{"s":"Sophie: Sorry."}},{"k":"read","v":{"b":false}}],"id":155},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-07-2"}},{"k":"text","v":{"s":"Sophie: I shouldn't have dropped all that on you."}},{"k":"read","v":{"b":false}}],"id":156},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-07-3"}},{"k":"text","v":{"s":"Sophie: We don't even know each other."}},{"k":"read","v":{"b":false}}],"id":157},{"o":[{"k":"id","v":{"s":"OPEN-S01-C08-a-1"}},{"k":"text","v":{"s":"Sophie: Alex."}},{"k":"read","v":{"b":false}}],"id":158},{"o":[{"k":"id","v":{"s":"OPEN-S01-C08-a-2"}},{"k":"text","v":{"s":"Sophie: Okay. Nice to meet you."}},{"k":"read","v":{"b":false}}],"id":159},{"o":[{"k":"id","v":{"s":"OPEN-S01-C08-a-3"}},{"k":"text","v":{"s":"Sophie: Under very strange circumstances. 😅"}},{"k":"read","v":{"b":false}}],"id":160},{"o":