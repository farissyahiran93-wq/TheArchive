":{"s":"Sophie: I almost deleted your number before messaging you."}},{"k":"read","v":{"b":false}}],"id":160},{"o":[{"k":"id","v":{"s":"OPEN-S01-C09-a-1"}},{"k":"text","v":{"s":"Sophie: I kept thinking about the fact that it had been saved."}},{"k":"read","v":{"b":false}}],"id":161},{"o":[{"k":"id","v":{"s":"OPEN-S01-C09-a-2"}},{"k":"text","v":{"s":"Sophie: There had to be a reason."}},{"k":"read","v":{"b":false}}],"id":162},{"o":[{"k":"id","v":{"s":"OPEN-S01-C09-a-3"}},{"k":"text","v":{"s":"Sophie: Or at least I hoped there was."}},{"k":"read","v":{"b":false}}],"id":163},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-09-1"}},{"k":"text","v":{"s":"Sophie: Anyway."}},{"k":"read","v":{"b":false}}],"id":164},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-09-2"}},{"k":"text","v":{"s":"Sophie: I should probably let you go."}},{"k":"read","v":{"b":false}}],"id":165},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-09-3"}},{"k":"text","v":{"s":"Sophie: You've already been more patient than I expected."}},{"k":"read","v":{"b":false}}],"id":166},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-09-7"}},{"k":"text","v":{"s":"Sophie: Actually, wait."}},{"k":"read","v":{"b":false}}],"id":167},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-09-8"}},{"k":"text","v":{"s":"Sophie: There's something else."}},{"k":"read","v":{"b":false}}],"id":168},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-09-9"}},{"k":"text","v":{"s":"Sophie: I wasn't sure if I should mention it."}},{"k":"read","v":{"b":false}}],"id":169},{"o":[{"k":"id","v":{"s":"OPEN-S01-C10-a-1"}},{"k":"text","v":{"s":"Sophie: Okay."}},{"k":"read","v":{"b":false}}],"id":170},{"o":[{"k":"id","v":{"s":"OPEN-S01-C10-a-2"}},{"k":"text","v":{"s":"Sophie: Just give me a second."}},{"k":"read","v":{"b":false}}],"id":171},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-10-1"}},{"k":"text","v":{"s":"Sophie: I'm not the only one trying to understand what happened."}},{"k":"read","v":{"b":false}}],"id":172},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-10-2"}},{"k":"text","v":{"s":"Sophie: There are a few other people."}},{"k":"read","v":{"b":false}}],"id":173},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-10-3"}},{"k":"text","v":{"s":"Sophie: People who know Daniel."}},{"k":"read","v":{"b":false}}],"id":174},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-10-4"}},{"k":"text","v":{"s":"Sophie: We've been talking."}},{"k":"read","v":{"b":false}}],"id":175},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-10-5"}},{"k":"text","v":{"s":"Sophie: Although \"talking\" might be a generous way of putting it lately."}},{"k":"read","v":{"b":false}}],"id":176},{"o":[{"k":"id","v":{"s":"OPEN-S01-C11-a-1"}},{"k":"text","v":{"s":"Sophie: Everyone has their own idea of what we should do."}},{"k":"read","v":{"b":false}}],"id":177},{"o":[{"k":"id","v":{"s":"OPEN-S01-C11-a-2"}},{"k":"text","v":{"s":"Sophie: And no one seems to agree."}},{"k":"read","v":{"b":false}}],"id":178},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-11-1"}},{"k":"text","v":{"s":"Sophie: There's a group chat."}},{"k":"read","v":{"b":false}}],"id":179},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-11-2"}},{"k":"text","v":{"s":"Sophie: We've been using it to keep track of things."}},{"k":"read","v":{"b":false}}],"id":180},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-11-3"}},{"k":"text","v":{"s":"Sophie: Well..."}},{"k":"read","v":{"b":false}}],"id":181},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-11-4"}},{"k":"text","v":{"s":"Sophie: Trying to."}},{"k":"read","v":{"b":false}}],"id":182},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-11-5"}},{"k":"text","v":{"s":"Sophie: I was thinking..."}},{"k":"read","v":{"b":false}}],"id":183},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-11-7"}},{"k":"text","v":{"s":"Sophie: Maybe you could join us?"}},{"k":"read","v":{"b":false}}],"id":184},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-11-8"}},{"k":"text","v":{"s":"Sophie: Just for a little while."}},{"k":"read","v":{"b":false}}],"id":185},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-11-9"}},{"k":"text","v":{"s":"Sophie: You don't have to do anything."}},{"k":"read","v":{"b":false}}],"id":186},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-11-10"}},{"k":"text","v":{"s":"Sophie: You could just listen."}},{"k":"read","v":{"b":false}}],"id":187},{"o":[{"k":"id","v":{"s":"OPEN-S01-C12-a-1"}},{"k":"text","v":{"s":"Sophie: That's a very good question."}},{"k":"read","v":{"b":false}}],"id":188},{"o":[{"k":"id","v":{"s":"OPEN-S01-C12-a-2"}},{"k":"text","v":{"s":"Sophie: And I don't have a very convincing answer."}},{"k":"read","v":{"b":false}}],"id":189},{"o":[{"k":"id","v":{"s":"OPEN-S01-C12-a-3"}},{"k":"text","v":{"s":"Sophie: I just thought maybe you'd notice something we missed."}},{"k":"read","v":{"b":false}}],"id":190},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-12-1"}},{"k":"text","v":{"s":"Sophie: Look."}},{"k":"read","v":{"b":false}}],"id":191},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-12-2"}},{"k":"text","v":{"s":"Sophie: I'm not asking you to solve anything."}},{"k":"read","v":{"b":false}}],"id":192},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-12-3"}},{"k":"text","v":{"s":"Sophie: And I don't expect you to believe everything I'm saying."}},{"k":"read","v":{"b":false}}],"id":193},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-12-4"}},{"k":"text","v":{"s":"Sophie: I'd be suspicious too."}},{"k":"read","v":{"b":false}}],"id":194},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-12-5"}},{"k":"text","v":{"s":"Sophie: But if there's even a small chance your number means something..."}},{"k":"read","v":{"b":false}}],"id":195},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-12-6"}},{"k":"text","v":{"s":"Sophie: I don't want to ignore it."}},{"k":"read","v":{"b":false}}],"id":196},{"o":[{"k":"id","v":{"s":"OPEN-S01-C13-a-1"}},{"k":"text","v":{"s":"Sophie: Really?"}},{"k":"read","v":{"b":false}}],"id":197},{"o":[{"k":"id","v":{"s":"OPEN-S01-C13-a-2"}},{"k":"text","v":{"s":"Sophie: Okay."}},{"k":"read","v":{"b":false}}],"id":198},{"o":[{"k":"id","v":{"s":"OPEN-S01-C13-a-3"}},{"k":"text","v":{"s":"Sophie: Thank you."}},{"k":"read","v":{"b":false}}],"id":199},{"o":[{"k":