e p { font-size: 13px; line-height: 1.6; }\n.recovery-cards { list-style: none; padding: 0; display: grid; gap: 10px; }\n.recovery-cards .opening-choice { width: 100%; display: grid; gap: 8px; text-align: left; margin: 0; min-height: 110px; }\n.recovery-cards small { font-size: 11px; line-height: 1.5; color: var(--muted); }\n.recovery-cards button:disabled { opacity: 1; cursor: default; }\n.recovery-tools { display: grid; gap: 8px; }\n.recovery-puzzle aside { border-left: 3px solid #8bcbd7; padding-left: 12px; }\n"],["STYLE",{},"/* Shared phone behaviour; independent of narrative progression. */\n.device * { scrollbar-width: none; }\n.device *::-webkit-scrollbar { display: none; width: 0; height: 0; }\n.device .opening-chat-header { justify-content: flex-start; gap: 11px; padding: 10px 14px; min-height: 72px; text-align: left; }\n.device .opening-chat-header > div { flex: 1; align-items: flex-start; text-align: left; min-width: 0; }\n.device .opening-chat-header > .icon-button { position: static; flex: 0 0 32px; padding: 4px; min-width: 32px; }\n.device .opening-chat-header strong { font-size: 15px; }\n.device .opening-chat-header small { margin-top: 4px; font-size: 11px; max-width: 100%; }\n.device .native-chat-header { display: flex; flex-direction: row; align-items: center; justify-content: flex-start; gap: 12px; min-height: 72px; padding: 10px 14px; }\n.device .native-chat-header > .native-back-button { position: static; flex: none; }\n.device .native-chat-contact { display: flex; flex-direction: row; gap: 10px; align-items: center; text-align: left; }\n.device .native-chat-contact .chat-title { align-items: flex-start; text-align: left; }\n.chat-contact-avatar { position: relative; display: flex; flex: none; }\n.presence-dot { position: absolute; bottom: 0; right: 0; border: 2px solid var(--header); background: #35af78; width: 11px; height: 11px; border-radius: 50%; }\n.device .thread-row { position: relative; }\n.thread-online { position: absolute; left: 46px; top: 48px; width: 11px; height: 11px; border-radius: 50%; background: #35af78; border: 2px solid var(--surface); }\n.device .conversation-line { display: flex; gap: 8px; align-items: flex-end; flex: none; width: 100%; }\n.device .conversation-line.outgoing { justify-content: flex-end; }\n.device .conversation-line.incoming.chat-group-open { padding-left: 36px; }\n.device .conversation-line.incoming.chat-group-open .conversation-body { max-width: 100%; }\n.device .conversation-line.chat-group-start { margin-top: 5px; }\n.device .conversation-body .opening-bubble { overflow-wrap: anywhere; }\n.device .scene01-chat .chat-group-action { display: inline-flex; align-items: center; justify-content: center; align-self: flex-start; flex: none; width: fit-content; max-width: 100%; min-height: 44px; margin: 12px 0 4px 36px; padding: 10px 14px; border: 1px solid #547e7b; border-radius: 12px; background: #244b4b; color: #f1faf8; font: inherit; font-size: 13px; font-weight: 600; cursor: pointer; }\n.device .scene01-chat .chat-group-action:focus-visible { outline: 2px solid #72bdb4; outline-offset: 3px; }\n.device .message-avatar { flex: 0 0 28px; width: 28px; height: 28px; border-radius: 50%; overflow: hidden; display: grid; place-items: center; background: #506576; color: white; font-size: 12px; }\n.message-avatar img { width: 100%; height: 100%; object-fit: cover; }\n.conversation-body { max-width: calc(100% - 38px); min-width: 0; }\n.outgoing .conversation-body { max-width: 84%; }\n.device .conversation-body .opening-bubble { max-width: 100% !important; margin: 0; border-radius: 15px 15px 15px 5px; padding: 11px 13px; }\n.device .conversation-body .opening-bubble.player { background: #286f70 !important; border-radius: 15px 15px 5px 15px; color: #fff !important; }\n.device .group-sender { display: block; font-size: 11px; font-weight: 650; margin: 0 0 5px 5px; color: var(--muted); }\n.device .opening-v4-typing { display: flex; align-items: center; gap: 8px; margin: 5px 0; min-height: 32px; }\n.device .opening-v4-typing .typing-dots { background: var(--incoming); border-radius: 14px; padding: 11px 15px; }\n.presence-event { align-self: center; margin: 8px 0; color: var(--muted); font-size: 11px; }\n.opening-v4-composer:empty { display: none; }\n.device .scene01-chat .opening-thread { scroll-behavior: auto; }\n.scene01-invitation { align-self: flex-start; width: min(100%, 290px); margin-top: 12px; padding: 16px; border: 1px solid var(--line); border-radius: 16px; background: var(--surface); }\n.scene01-invitation p { color: var(--muted); font-size: 12px; line-height: 1.6; }\n.scene01-codename { display: grid; gap: 6px; font-size: 12px; margin: 12px 0; }\n.scene01-codename input { width: 100%; padding: 11px; border: 1px solid var(--line); border-radius: 10px; background: var(--surface); color: var(--text); font: inherit; }\n.scene01-chat .opening-choice > svg { display: inline; vertical-align: -2px; margin-right: 6px; color: #b58c32; }\n.device .scene01-chat .opening-actions { display: flex; flex-direction: column; overflow: hidden; }\n.scene01-chat .scene01-options { min-height: 0; overflow-y: auto; overscroll-behavior: contain; }\n.scene01-chat .opening-action-heading, .scene01-chat .opening-actions > .opening-primary { flex-shrink: 0; }\n.device .status-time { white-space: nowrap; }\n.device .chat-attachment { display: block; width: min(230px, 100%); margin: 8px 0 0; padding: 0; border: 0; border-radius: 13px; overflow: hidden; background: #182028; }\n.chat-attachment img { display: block; width: 100%; height: auto; max-height: 290px; object-fit: cover; object-position: top; }\n.chat-photo-viewer { position: absolute; inset: 0; z-index: 1300; background: #080b0e; color: white; display: flex; flex-direction: column; overflow: hidden; }\n.chat-photo-viewer > header { display: flex; justify-content: space-between; align-items: center; flex: none; padding: 16px; min-height: 64px; background: #080b0e; }\n.chat-photo-viewer header > div { display: flex; gap: 10px; }\n.chat-photo-viewer button { display: grid; place-items: center; width: 44px; height: 44px; border: 0; border-radius: 50%; background: #ffffff15; color: white; }\n.chat-photo-viewer button:disabled { opacity: .35; }\n.chat-photo-canvas { display: flex; flex: 1; min-height: 0; align-items: center; justify-content: center; overflow: hidden; touch-action: none; }\n.chat-photo-canvas img { width: 100%; max-height: 100%; object-fit: contain; user-select: none; transform-origin: center; }\n.phone-notification-layer { position: absolute; z-index: 2000; top: 52px; left: 10px; right: 10px; pointer-events: none; }\n.native-app .phone-notification-layer { top: calc(env(safe-area-inset-top) + 8px); }\n.phone-notification { position: relative; pointer-events: auto; background: color-mix(in srgb, var(--surface) 94%, transparent); border: 1px solid var(--line); border-radius: 19px; color: var(--text); box-shadow: 0 8px 28px #0003; backdrop-filter: blur(24px); touch-action: none; overflow: hidden; animation: phone-notice-enter .2s ease-out; }\n.phone-notification-open { display: flex; align-items: center; gap: 10px; width: 100%; min-height: 88px; background: none; border: 0; color: inherit; padding: 12px 34px 12px 12px; text-align: left; cursor: pointer; }\n.phone-notification-open > span:last-child { display: grid; gap: 3px; min-width: 0; flex: 1; }\n.phone-notification-open small { font-size: 9px; font-weight: 650; color: var(--muted); letter-spacing: .04em; }\n.phone-notification-open time { float: right; font-weight: 400; }\n.phone-notification-open strong { font-size: 13px; }\n.phone-notification-open > span > span { font-size: 12px; line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }\n.phone-notification .notice-avatar { flex: 0 0 38px; width: 38px; height: 38px; display: grid; place-items: center; border-radius: 11px; overflow: hidden; background: #476a70; color: white; }\n.notice-avatar img { width: 100%; height: 100%; object-fit: cover; }\n.phone-notification-dismiss { position: absolute; top: 4px; right: 3px; width: 30px; height: 30px; display: grid; place-items: center; background: none; border: 0; color: var(--muted); cursor: pointer; }\n@keyframes phone-notice-enter { from { translate: 0 -110%; opacity: 0; } to { translate: 0 0; opacity: 1; } }\n@media (prefers-reduced-motion: reduce) { .phone-notification { animation: none; } }\n"],["STYLE",{},":root{font-family:system-ui,-apple-system,\"Segoe UI\",sans-serif;font-synthesis:none;text-rendering:optimizeLegibility;color:#1e2935;background:#172734}\n*{box-sizing:border-box}html,body,#root{width:100%;height:100%;margin:0;overflow:hidden}button,input,select,textarea{font:inherit}button{cursor:pointer}button:disabled{cursor:not-allowed}button:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible{outline:3px solid #eaa26e;outline-offset:2px}h1,h2,p{margin-top:0}.sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap}\n.app-root{--phone-bg:#f5f3f8;--surface:#fff;--raised:#f8f7fb;--text:#202736;--muted:#667081;--line:#dedfe7;--accent:#6759aa;--button-accent:#6759aa;--incoming:#e9e9ef;--outgoing:#6b5caf;--outgoing-text:#fff;--header:#faf9fd;--shadow:0 10px 30px #192d3b12;display:flex;justify-content:center;width:100%;height:var(--visual-height,100dvh);overflow:hidden;background:#172734;color:var(--text)}\n.theme-dark{--phone-bg:#081c2c;--surface:#13293e;--raised:#1a344c;--text:#f2f6f8;--muted:#aec0d1;--line:#31495e;--accent:#5595ff;--button-accent:#286bd4;--incoming:#263d55;--outgoing:#2a70de;--outgoing-text:#fff;--header:#10283d;--shadow:0 10px 30px #0003}\n.device{width:min(100%,460px);height:100%;display:flex;flex-direction:column;min-height:0;overflow:hidden;position:relative;background:var(--phone-bg);box-shadow:0 0 70px #0005}\n.status-bar{flex:none;height:calc(36px + env(safe-area-inset-top));padding:env(safe-area-inset-top) 21px 0;display:flex;justify-content:space-between;align-items:center;background:var(--header);color:var(--text);font-size:13px;font-weight:700;letter-spacing:.02em}\n.status-brand{font-size:9px;letter-spacing:.12em;color:var(--muted);display:flex;align-items:center;gap:7px}.status-brand i{width:5px;height:5px;border-radius:50%;background:#6bbfa8}\n.system-nav{height:calc(28px + env(safe-area-inset-bottom));padding-bottom:env(safe-area-inset-bottom);display:grid;place-items:center;background:var(--phone-bg);flex:none}.system-nav button{width:94px;height:26px;border:0;background:transparent;display:flex;align-items:center;justify-content:center;gap:8px;color:var(--muted)}.system-nav button:disabled{opacity:.6}.gesture-line{height:4px;width:42px;background:currentColor;border-radius:8px}.native-app .device{padding-top:env(safe-area-inset-top);padding-bottom:env(safe-area-inset-bottom)}\n.boot-message{height:100dvh;background:#102738;color:#fff;display:flex;overflow-y:auto;padding:24px}.recovery{width:min(100%,380px);margin:auto;background:#20394a;padding:25px;border-radius:20px}.recovery p{line-height:1.5}.save-error{background:#9e4844;color:#fff;padding:8px 16px;font-size:12px;flex:none}\n.recovery-secondary{display:block;width:100%;min-height:44px;margin-top:12px;padding:10px 14px;border:1px solid #bcd0db;border-radius:12px;background:transparent;color:#fff;font:inherit;font-weight:650;text-align:center}\n.eyebrow,.section-caption{font-size:10px;font-weight:750;letter-spacing:.15em;color:var(--accent)}.primary-button,.action-button{border:0;border-radius:15px;background:#d6ad8c;color:#182a35;padding:15px 20px;min-height:48px;font-weight:750;display:flex;align-items:center;justify-content:center;gap:10px}.primary-button:disabled{opacity:.45}\n.splash,.setup{flex:1;min-height:0;overflow:auto}.splash{display:flex;align-items:flex-end;position:relative;background:linear-gradient(0deg,#0b202f 0%,#152c3bb8 42%,#57778670 100%),url('/greyhaven-wallpaper.svg') center/cover;padding