k":"read","v":{"b":true}}],"id":444},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-AFTER-11-8"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I don't want that either."}},{"k":"read","v":{"b":true}}],"id":445},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-AFTER-11-9"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Lucas, are you leaving the chat or just going offline?"}},{"k":"read","v":{"b":true}}],"id":446},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-AFTER-11-12"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: I don't know."}},{"k":"read","v":{"b":true}}],"id":447},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-AFTER-11-13"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: I need some space from this group."}},{"k":"read","v":{"b":true}}],"id":448},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-AFTER-11-14"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Okay."}},{"k":"read","v":{"b":true}}],"id":449},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-AFTER-11-15"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Just don't shut us out completely."}},{"k":"read","v":{"b":true}}],"id":450},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-AFTER-11-16"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: I'm not shutting you out."}},{"k":"read","v":{"b":true}}],"id":451},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-AFTER-11-17"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: I'm trying not to say something that makes it harder to come back."}},{"k":"read","v":{"b":true}}],"id":452},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-AFTER-11-21"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: ..."}},{"k":"read","v":{"b":true}}],"id":453},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-AFTER-11-22"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: He actually left."}},{"k":"read","v":{"b":true}}],"id":454},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-AFTER-11-23"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: He'll be alright."}},{"k":"read","v":{"b":true}}],"id":455},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-AFTER-11-24"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: You don