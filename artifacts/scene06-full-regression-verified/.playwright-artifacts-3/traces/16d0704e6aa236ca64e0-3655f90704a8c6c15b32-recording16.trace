"s":"OPEN-S02-FINAL-AFTER-08-19"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: The last thing any of us needs is to turn fear into certainty."}},{"k":"read","v":{"b":true}}],"id":374},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-C09-a-1"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: That's exactly the sort of detail I'm not ready to share here."}},{"k":"read","v":{"b":true}}],"id":375},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-C09-a-2"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: And that's okay."}},{"k":"read","v":{"b":true}}],"id":376},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-C09-a-3"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: What we can say is that the timeline isn't settled."}},{"k":"read","v":{"b":true}}],"id":377},{"o":[{"k":"id","v":{"s":"CH1-SENDER-FIRST"}},{"k":"text","v":{"s":"You shouldn't be talking to her."}},{"k":"read","v":{"b":false}}],"id":378},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-RETURN-3"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Maya?"}},{"k":"read","v":{"b":true}}],"id":379},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-RETURN-4"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Sorry."}},{"k":"read","v":{"b":true}}],"id":380},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-RETURN-5"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: I was typing about the last time I spoke to Daniel."}},{"k":"read","v":{"b":true}}],"id":381},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-RETURN-6"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Then I read it back and realised half of it was me guessing what he meant."}},{"k":"read","v":{"b":true}}],"id":382},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-RETURN-7"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Oh."}},{"k":"read","v":{"b":true}}],"id":383},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-RETURN-8"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: I don't want to turn that into evidence just because I'm upset."}},{"k":"read","v":{"b":true}}],"id":384},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-RETURN-9"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: You