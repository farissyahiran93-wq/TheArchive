"s":"OPEN-S02-FINAL-AFTER-08-19"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: The last thing any of us needs is to turn fear into certainty."}},{"k":"read","v":{"b":true}}],"id":374},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-C09-a-1"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: That's exactly the sort of detail I'm not ready to share here."}},{"k":"read","v":{"b":true}}],"id":375},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-C09-a-2"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: And that's okay."}},{"k":"read","v":{"b":true}}],"id":376},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-C09-a-3"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: What we can say is that the timeline isn't settled."}},{"k":"read","v":{"b":true}}],"id":377},{"o":[{"k":"id","v":{"s":"CH1-SENDER-FIRST"}},{"k":"text","v":{"s":"You shouldn't be talking to her."}},{"k":"read","v":{"b":false}}],"id":378},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-RETURN-3"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Maya?"}},{"k":"read","v":{"b":true}}],"id":379},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-RETURN-4"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Sorry."}},{"k":"read","v":{"b":true}}],"id":380},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-RETURN-5"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: I was typing about the last time I spoke to Daniel."}},{"k":"read","v":{"b":true}}],"id":381},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-RETURN-6"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Then I read it back and realised half of it was me guessing what he meant."}},{"k":"read","v":{"b":true}}],"id":382},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-RETURN-7"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Oh."}},{"k":"read","v":{"b":true}}],"id":383},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-RETURN-8"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: I don't want to turn that into evidence just because I'm upset."}},{"k":"read","v":{"b":true}}],"id":384},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-RETURN-9"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: You could've just said that without deleting it."}},{"k":"read","v":{"b":true}}],"id":385},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-RETURN-10"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: I just said it."}},{"k":"read","v":{"b":true}}],"id":386},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-RETURN-11"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: After we all saw that you'd deleted something."}},{"k":"read","v":{"b":true}}],"id":387},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-RETURN-12"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Lucas."}},{"k":"read","v":{"b":true}}],"id":388},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-RETURN-13"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: What?"}},{"k":"read","v":{"b":true}}],"id":389},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-RETURN-14"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Not every deleted message is a conspiracy."}},{"k":"read","v":{"b":true}}],"id":390},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-RETURN-16"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Can we call it a night?"}},{"k":"read","v":{"b":true}}],"id":391},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-RETURN-17"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: We said that yesterday."}},{"k":"read","v":{"b":true}}],"id":392},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-RETURN-18"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I know."}},{"k":"read","v":{"b":true}}],"id":393},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-RETURN-19"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: And the day before."}},{"k":"read","v":{"b":true}}],"id":394},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-RETURN-20"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: We don't have to solve anything in this chat tonight."}},{"k":"read","v":{"b":true}}],"id":395},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-RETURN-21"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: That's easy to say when nobody will admit we're running out of things to try."}},{"k":"read","v":{"b":true}}],"id":396},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-RETURN-22"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I haven't stopped trying."}},{"k":"read","v":{"b":true}}],"id":397},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-RETURN-23"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: I know you haven't."}},{"k":"read","v":{"b":true}}],"id":398},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-RETURN-24"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: I just don't think all of this is helping."}},{"k":"read","v":{"b":true}}],"id":399},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-RETURN-25"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Then what would help?"}},{"k":"read","v":{"b":true}}],"id":400},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-RETURN-26"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Not inviting people we can't identify into private conversations, for a start."}},{"k":"read","v":{"b":true}}],"id":401},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-RETURN-27"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: They're still here, Lucas."}},{"k":"read","v":{"b":true}}],"id":402},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-RETURN-28"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Yes, I can see that."}},{"k":"read","v":{"b":true}}],"id":403},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-RETURN-29"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Then stop talking as if they aren't."}},{"k":"read","v":{"b":true}}],"id":404},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-RETURN-31"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I thought one more person might make something clearer."}},{"k":"read","v":{"b":true}}],"id":405},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-RETURN-32"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Instead I've made everyone angrier."}},{"k":"read","v":{"b":true}}],"id":406},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-C10-a-1"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: You're right."}},{"k":"read","v":{"b":true}}],"id":407},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-C10-a-2"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I know."}},{"k":"read","v":{"b":true}}],"id":408},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-C10-a-3"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: I know too."}},{"k":"read","v":{"b":true}}],"id":409},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-AFTER-10-2"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Do you know what the worst part is?"}},{"k":"read","v":{"b":true}}],"id":410},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-AFTER-10-3"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: I keep opening this chat and expecting him to have written something."}},{"k":"read","v":{"b":true}}],"id":411},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-AFTER-10-5"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Me too."}},{"k":"read","v":{"b":true}}],"id":412},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-AFTER-10-6"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: I know."}},{"k":"read","v":{"b":true}}],"id":413},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-AFTER-10-7"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: And I can't stand it."}},{"k":"read","v":{"b":true}}],"id":414},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-AFTER-10-8"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Lucas..."}},{"k":"read","v":{"b":true}}],"id":415},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-AFTER-10-9"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: There are conversations I should've had with him."}},{"k":"read","v":{"b":true}}],"id":416},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-AFTER-10-10"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Stuff I thought there'd be time for."}},{"k":"read","v":{"b":true}}],"id":417},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-AFTER-10-12"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: I keep thinking if I knew where to start looking, we could actually do something."}},{"k":"read","v":{"b":true}}],"id":418},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-AFTER-10-13"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Instead we're fighting about a star beside a number."}},{"k":"read","v":{"b":true}}],"id":419},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-AFTER-10-14"}},{"k":"text","v":