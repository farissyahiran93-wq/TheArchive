d","v":{"s":"OPEN-S01-FINAL-AFTER-05-3"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Something like that."}},{"k":"at","v":{"n":1792670799171}}],"id":527},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-05-5"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Sorry. I'm talking as if you already know what's happened."}},{"k":"at","v":{"n":1792670806157}}],"id":528},{"o":[{"k":"id","v":{"s":"OPEN-S01-C06-PLAYER-a"}},{"k":"sender","v":{"s":"player"}},{"k":"text","v":{"s":"Then tell me."}},{"k":"at","v":{"n":1792670842943}}],"id":529},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-C06-a-1"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Right."}},{"k":"at","v":{"n":1792670845529}}],"id":530},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-06-1"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Daniel stopped replying."}},{"k":"at","v":{"n":1792670848288}}],"id":531},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-06-2"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Messages. Calls."}},{"k":"at","v":{"n":1792670851044}}],"id":532},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-06-4"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"For days now."}},{"k":"at","v":{"n":1792670856217}}],"id":533},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-06-5"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"At first we thought he was busy."}},{"k":"at","v":{"n":1792670860284}}],"id":534},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-06-6"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"Then we thought maybe he wanted space."}},{"k":"at","v":{"n":1792670864453}}],"id":535},{"o":[{"k":"id","v":{"s":"OPEN-S01-FINAL-AFTER-06-8"}},{"k":"sender","v":{"s":"sophie"}},{"k":"text","v":{"s":"I don't know what to think anymore."}},{"k":"at","v":{"n":1792670872071}}],"id":536},{"o":[{"k":"id","v":{"s":"OPEN-S01-C07-PLAYER-a"}},{"k":"sender","v":{"s":"player"}},{"k":"text","v":{"s":"Have you tried checking on him in person?"}},{"k