esence-dot","aria-label":"Maya online"}]],["DIV",{"class":"conversation-body"},["DIV",{"class":"opening-bubble sophie"},"Nobody has confirmed how they fit together."]]],["DIV",{"class":"conversation-line incoming chat-group-start chat-group-end"},["SPAN",{"class":"chat-contact-avatar"},["SPAN",{"class":"character-avatar message-avatar","aria-hidden":"true"},["IMG",{"__playwright_current_src__":"http://127.0.0.1:4206/media/portraits/lucas-avatar.webp","alt":"","loading":"lazy","decoding":"async","src":"/media/portraits/lucas-avatar.webp"}]],["I",{"class":"presence-dot","aria-label":"Lucas online"}]],["DIV",{"class":"conversation-body"},["STRONG",{"class":"group-sender"},"Lucas"],["DIV",{"class":"opening-bubble sophie"},"And yet people keep talking like we have a final answer."]]],["DIV",{"class":"conversation-line incoming chat-group-start chat-group-end"},["SPAN",{"class":"chat-contact-avatar"},["SPAN",{"class":"character-avatar message-avatar","aria-hidden":"true"},["IMG",{"__playwright_current_src__":"http://127.0.0.1:4206/media/portraits/sophie-avatar.webp","alt":"","loading":"lazy","decoding":"async","src":"/media/portraits/sophie-avatar.webp"}]],["I",{"class":"presence-dot","aria-label":"Sophie online"}]],["DIV",{"class":"conversation-body"},["STRONG",{"class":"group-sender"},"Sophie"],["DIV",{"class":"opening-bubble sophie"},"No one here thinks we do."]]],["DIV",{"class":"conversation-line incoming chat-group-start chat-group-end"},["SPAN",{"class":"chat-contact-avatar"},["SPAN",{"class":"character-avatar message-avatar","aria-hidden":"true"},["IMG",{"__playwright_current_src__":"http://127.0.0.1:4206/media/portraits/lucas-avatar.webp","alt":"","loading":"lazy","decoding":"async","src":"/media/portraits/lucas-avatar.webp"}]],["I",{"class":"presence-dot","aria-label":"Lucas online"}]],["DIV",{"class":"conversation-body"},["STRONG",{"class":"group-sender"},"Lucas"],["DIV",{"class":"opening-bubble sophie"},"I'm not convinced."]]],["DIV",{"class":"conversation-lin