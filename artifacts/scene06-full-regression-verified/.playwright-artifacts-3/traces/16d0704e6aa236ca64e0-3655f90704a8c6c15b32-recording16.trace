-C03-a-2"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Then I can't connect you to him."}},{"k":"read","v":{"b":true}}],"id":244},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-C03-a-3"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Neither can we."}},{"k":"read","v":{"b":true}}],"id":245},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-AFTER-03-1"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Sophie, can I ask you to check something?"}},{"k":"read","v":{"b":true}}],"id":246},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-AFTER-03-2"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Yeah."}},{"k":"read","v":{"b":true}}],"id":247},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-AFTER-03-3"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Does the export say when that number was saved?"}},{"k":"read","v":{"b":true}}],"id":248},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-AFTER-03-4"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: No."}},{"k":"read","v":{"b":true}}],"id":249},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-AFTER-03-5"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Or who starred it?"}},{"k":"read","v":{"b":true}}],"id":250},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-AFTER-03-6"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: No."}},{"k":"read","v":{"b":true}}],"id":251},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-AFTER-03-7"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Is there any indication the star was added by Daniel, rather than copied from somewhere else?"}},{"k":"read","v":{"b":true}}],"id":252},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-AFTER-03-8"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Not in the version I have."}},{"k":"read","v":{"b":true}}],"id":253},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-AFTER-03-9"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: That's what I was trying to say."}},{"k":"read","v":{"b":true}}],"id":254},{"o":[{"k":"id","v":{"s":"OPEN-S02-FINAL-AFTER-03-10"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I know, Lucas."}},{"k":"read","v":{"b":true}}],"id":255},{"o":[{"k":"id","v":{"s"