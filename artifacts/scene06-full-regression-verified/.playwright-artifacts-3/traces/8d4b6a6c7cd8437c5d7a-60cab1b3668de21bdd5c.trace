:Georgia,serif;margin:10px 0}.opening-note>p.opening-note-caption{font:11px/1.4 sans-serif;color:#62665f;margin-top:20px}.opening-note button{display:flex;align-items:center;gap:7px;padding:10px;border-radius:9px;background:#25394a;color:#fff;border:0;font-size:12px}.opening-confirm{display:flex;align-items:center;gap:5px;font-size:11px;color:#196151;font-weight:700}\r\n.opening-stage-top{color:#bad1df;font-size:11px;letter-spacing:.1em;font-weight:800}.opening-stage-top small{margin-left:auto;color:#f1b78b;font-size:9px}.opening-stage-scroll{flex:1;min-height:0;overflow:auto;padding:25px 22px 35px}.opening-center-icon{display:grid;place-items:center;width:91px;height:91px;margin:30px auto;background:#213747;border:1px solid #527486;border-radius:24px;color:#8bd2d9}.opening-recovery h1,.opening-found h1{font-size:26px;line-height:1.16;letter-spacing:-.03em;margin:18px 0}.opening-stage-scroll>p{font-size:13px;color:#b7cad8;line-height:1.7}.opening-properties{display:grid;grid-template-columns:1fr 1fr;gap:14px 6px;border:1px solid #30475a;background:#182737;padding:19px 14px;border-radius:14px;margin:25px 0}.opening-properties span{font-size:12px;color:#adc1d1}.opening-properties strong{text-align:right;font-size:11px;letter-spacing:.03em}.opening-warning{color:#eab086}.opening-legal{display:flex;gap:12px;padding:12px;border-radius:12px;border:1px solid #47727c;background:#1c3540}.opening-legal svg{flex:none;color:#90d1cd}.opening-legal p{font-size:12px;line-height:1.55;margin:0}\r\n.opening-mirror-stage .mirror{flex:1;min-height:0}.mirror{background:#0c1623;color:#e3edf5;min-height:0;display:flex;flex-direction:column}.mirror-top{flex:none;display:flex;gap:6px;align-items:center;justify-content:space-between;padding:12px 14px;border-bottom:1px solid #25394e;font-size:9px;color:#9ebacb}.mirror-top>span:nth-child(2){flex:1}.mirror-top>span:last-child{color:#9cdbbb}.mirror-main,.mirror-detail{flex:1;min-height:0;overflow:auto;padding:16px 18px 28px}.mirror-hero{text-align:center;background:linear-gradient(150deg,#203649,#142536);border-radius:18px;padding:19px 12px;margin-bottom:19px}.mirror-hero svg{margin:0 auto 7px;color:#9ecfdf}.mirror-hero strong,.mirror-hero small{display:block}.mirror-hero strong{font-size:20px}.mirror-hero small{font-size:11px;margin-top:6px;color:#99b6c8}.mirror-hero p{font-size:11px;color:#abc0ce;line-height:1.5;margin:12px auto 0;max-width:300px}.mirror-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px 9px}.mirror-icon{border:0;background:none;color:#ddebf5;min-width:0;display:flex;flex-direction:column;align-items:center;gap:4px}.mirror-icon>span{width:57px;height:57px;border:1px solid #365269;background:#203a4e;border-radius:17px;display:grid;place-items:center;color:#b3d9e6}.mirror-icon strong{font-size:11px}.mirror-icon small{color:#8faabc;font-size:9px;line-height:1.2}.mirror-caption,.mirror-guidance{display:flex;align-items:flex-start;gap:8px;font-size:11px;line-height:1.55;color:#9cb8c5;background:#183042;border-radius:11px;padding:11px;margin-top:15px}.mirror-caption svg,.mirror-guidance svg{flex:none}.mirror-guidance{color:#b8e6d4;border:1px solid #326859}.mirror-back{display:flex;align-items:center;gap:8px;border:0;background:none;color:#99c5d5;padding:4px 0 17px}.mirror-detail h2{font-size:25px;margin:0 0 7px}.mirror-detail>small{color:#91abbd}.mirror-items{margin:20px 0;display:grid;gap:8px}.mirror-file{display:flex;align-items:center;gap:10px;color:#d8e8f1;background:#17293a;padding:12px;border-radius:12px;text-align:left;border:1px solid #344a5f;font-size:12px}.mirror-file span{flex:1}.mirror-file.is-active{border-color:#7aafb9;background:#254454}.mirror-document{border:1px solid #365668;background:#17293a;border-radius:13px;padding:19px}.mirror-document small{font-size:10px;color:#a3cdcf}.mirror-document h3{font-size:15px}.mirror-document p{white-space:pre-wrap;line-height:1.65;font-size:13px;color:#d6e4ec}.mirror-compare{display:flex;align-items:center;justify-cont