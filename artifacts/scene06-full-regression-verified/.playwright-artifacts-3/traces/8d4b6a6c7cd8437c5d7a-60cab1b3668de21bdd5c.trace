n.mirror-dock{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:7px;margin-top:auto;padding:12px 9px 5px;border-radius:28px;background:#ffffff22;backdrop-filter:blur(22px);flex:none}\r\n.mirror-dock .mirror-icon{min-height:77px}.mirror-dock .mirror-icon strong{font-size:10px!important}\r\n.mirror-home-indicator{display:grid;place-items:center;flex:none;min-height:27px!important;width:100%;border:0;background:transparent;padding:0}.mirror-home-indicator span{width:112px;height:5px;border-radius:5px;background:#f5f5fa}\r\n.mirror .mirror-detail{background:#101114!important;animation:mirror-app-enter .18s ease-out;padding-top:5px}\r\n.mirror .mirror-app-toolbar{position:sticky;top:-5px;background:#101114ed;z-index:2;backdrop-filter:blur(18px);padding:3px 0;margin-bottom:10px}\r\n.mirror .mirror-back{color:#60afff;gap:3px;font-size:12px}.mirror-app-toolbar>.mirror-workspace-button{background:none;border:0;font-size:12px;color:#60afff;padding:5px}\r\n.mirror .mirror-items{gap:0;border-radius:14px;overflow:hidden;margin-top:16px}.mirror .mirror-file{border-radius:0!important;background:#1c1c1f!important;padding:17px 12px}.mirror .mirror-file-copy strong{font-size:15px}\r\n.mirror .mirror-document{border:0!important;background:transparent!important;padding:5px 0;margin-top:8px}.mirror .mirror-document>h3{font-size:21px;letter-spacing:-.4px}\r\n.mirror .mirror-photo-grid{grid-template-columns:repeat(3,minmax(0,1fr));gap:6px}.mirror .mirror-photo-art{aspect-ratio:1;min-height:80px;border:0}\r\n.mirror .mirror-email-body{background:transparent;padding:0}.mirror .mirror-note-body{background:#1e1d19;color:#eee8d7;padding:20px;border-radius:8px;min-height:220px}.mirror-note-body>p{font-size:16px;line-height:1.85}\r\n.mirror .mirror-message-history{gap:12px}.mirror .mirror-message-history>.mirror-identity{justify-content:center;flex-direction:column;background:#1c1c1f;padding:15px;border-radius:15px}.mirror .mirror-message-history>.mirror-time{text-align:center;font-size:10px!important}.mirror .mirror-chat-bubble{font-size:15px;max-width:85%}.mirror .mirror-readonly-composer{color:#aeb0bb;text-align:left;padding-left:17px}\r\n.mirror-source-note{font-size:10px!important}.mirror-save-record{font-size:12px;background:transparent}\r\n@keyframes mirror-app-enter{from{opacity:.3;transform:scale(.97)}to{opacity:1;transform:scale(1)}}\r\n@media(max-width:340px){.mirror .mirror-icon>span{width:51px!important;height:51px!important}.mirror-wallpaper-date{padding:12px 0}.mirror-home-tools{gap:5px}}\r\n@media(max-height:650px){.mirror-wallpaper-date{padding:0 0 10px}.mirror .mirror-grid{gap:10px 5px}.mirror-home-tools{margin:0}.mirror-dock{margin-top:12px}}\r\n.utility-screen>.mirror{flex:1;min-height:0}\r\n.mirror .mirror-file>.mirror-list-initial{display:grid;place-items:center;flex:none;width:38px;height:38px;border-radius:50%;background:#565964;color:#fff;font-size:18px;font-weight:500}\n.mirror-area-calls .mirror-file>svg:first-child{color:#60d484}.mirror-area-notes .mirror-file>svg:first-child{color:#efce62}.mirror-area-files .mirror-file>svg:first-child{color:#5cbaff}\r\n.mirror-area-messages.mirror-reading .mirror-detail>h2,.mirror-area-messages .mirror-document>h3,.mirror-area-messages .mirror-document>small,.mirror-area-contacts .mirror-document>h3{display:none}\n.mirror-area-messages .mirror-message-history>.mirror-identity{background:transparent;padding:0 0 12px;border-bottom:1px solid #ffffff15;border-radius:0;gap:6px}.mirror-area-messages .mirror-identity strong{font-size:14px}.mirror-area-messages .mirror-message-history{margin-top:0}\r\n\r\n/* Native phone presentation. Investigation tools live in the optional menu. */\r\n.device:has(.mirror-on-home){background:#172534 url('/greyhaven-phone-wallpaper.png') center/cover}\r\n.device:has(.mirror-on-home)>.status-bar{background:transparent;color:#fff}\r\n.utility-screen:has(>.mirror-on-home),.opening-mirror-stage:has(>.mirror-on-home){background:transparent!important}\r\n.mirror.mirror-on-home{background:linear-gradient(#07111f10,#07111f38)!important}\r\n.mirror-device-switch{background:transparent;padding:0 16px;min-height:28px;font-size:10px;letter-spacing:0;color:inherit}\r\n.mirror-device-switch>span{margin-left:auto;opacity:.65}\r\n.mirror-in-app>.mirror-device-switch{color:#666!important}\r\n.mirror-on-home>.mirror-device-switch{color:white;text-shadow:0 1px 4px #000}\r\n.mirror-device-switch button{color:inherit;min-height:28px;font-size:11px}\r\n.mirror .mirror-main{padding:15px 20px 0}\r\n.mirror-widgets{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin:0 0 24px}\r\n.mirror-calendar-widget,.mirror-photo-widget{height:138px;border-radius:24px;overflow:hidden;box-shadow:0 5px 16px #0002}\r\n.mirror-calendar-widget{background:#fdfdfdef;color:#141414;padding:15px 18px;display:flex;flex-direction:column;backdrop-filter:blur(20px)}\r\n.mirror-calendar-widget small{font-size:11px;font-weight:650;color:#e34b43;letter-spacing:.03em}\r\n.mirror-calendar-widget strong{font-size:52px;font-weight:300;line-height:1.08;letter-spacing:-3px}\r\n.mirror-calendar-widget>span{font-size:12px;margin-top:auto}\r\n.mirror-photo-widget{position:relative;background:url('/greyhaven-phone-wallpaper.png') center 42%/cover}\r\n.mirror-photo-widget>span{position:absolute;bottom:0;left:0;right:0;padding:25px 12px 12px;background:linear-gradient(transparent,#0009);font-size:12px;font-weight:600;color:white}\r\n.mirror .mirror-grid{gap:17px 7px;padding:0 0 16px}\r\n.mirror .mirror-icon>span{border:0!important;box-shadow:0 3px 8px #0002;width:59px!important;height:59px!important;border-radius:15px!important}\r\n.mirror .mirror-icon strong{font-size:11px!important;text-shadow:0 1px 4px #000}\r\n.mirror .mirror-app-gallery>span{background:#fff!important}\r\n.mirror-photos-flower{width:42px;height:42px;position:relative;display:block}\r\n.mirror-photos-flower i{position:absolute;left:13px;top:0;width:16px;height:25px;border-radius:12px;transform-origin:8px 21px;opacity:.8}\r\n.mirror-home-tools{margin:auto 0 8px;gap:9px}\r\n.mirror-home-tools button{background:#e0e6ed40;backdrop-filter:blur(25px);color:white;font-size:11px;min-height:32px;padding:5px 10px}\r\n.mirror-main>.mirror-workspace-button{color:white;background:#ffffff25;font-size:11px}\r\n.mirror-dock{margin-top:9px;border:1px solid #ffffff22;padding:12px 4px 2px;background:#d7e4f34d;border-radius:30px}\r\n.mirror-dock .mirror-icon{min-height:63px}.mirror-dock .mirror-icon strong{display:none}\r\n.mirror-home-indicator{min-height:28px!important}\r\n.mirror.mirror-in-app{background:#f2f2f7!important;color:#111;color-scheme:light}\r\n.device:has(.mirror-in-app)>.status-bar{background:#f2f2f7;color:#111}\r\n.mirror-in-app .mirror-home-indicator span{background:#111}\r\n.mirror-in-app>.mirror-home-indicator span{background:#111!important}\r\n.mirror{overflow:hidden}\r\n.mirror .mirror-detail{background:#f2f2f7!important;padding:4px 16px 20px;min-height:0}\r\n.mirror .mirror-app-toolbar{top:-4px;background:#f2f2f7ec;margin:0 -5px 8px;padding:0;min-height:44px;gap:0;z-index:5}\r\n.mirror .mirror-back{font-size:15px;color:#007aff;min-height:44px;padding:0;gap:0;white-space:nowrap}\r\n.mirror-toolbar-actions{display:flex;align-items:center;margin-left:auto}\r\n.mirror-reading .mirror-app-toolbar>.mirror-back[aria-label]{margin-left:auto;min-width:38px;justify-content:center}\r\n.mirror-reading .mirror-toolbar-actions{margin-left:0}\r\n.mirror-toolbar-actions button{border:0;background:transparent;color:#007aff;display:flex;align-items:center;justify-content:center;padding:9px;min-width:40px;min-height:44px}\r\n.mirror-detail>h2{font-size:33px;letter-spacing:-1px;font-weight:750;color:#111;margin:0 0 14px}\r\n.mirror-search{background:#e3e3e8;color:#8e8e93;margin:0 0 16px;border-radius:11px}\r\n.mirror-search input{color:#111;min-height:37px;font-size:16px}\r\n.mirror-tabs{gap:0;border-radius:9px;padding:3px;background:#e3e3e8;margin:10px 0 16px}\r\n.mirror-tabs button