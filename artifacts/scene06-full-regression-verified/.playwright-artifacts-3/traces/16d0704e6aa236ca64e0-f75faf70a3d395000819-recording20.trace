{"type":"before","callId":"qmmb@2530","startTime":2451431.757,"class":"Frame","method":"evaluateExpression","params":{"expression":"async () => {\n    const journal = sessionStorage.getItem('the-archive-reboot:pending-save:v1');\n    if (journal) return JSON.parse(journal).save;\n    const db = await new Promise(resolve => {\n      const request = indexedDB.open('the-archive-reboot', 1);\n      request.onsuccess = () => resolve(request.result);\n    });\n    const value = await new Promise(resolve => {\n      const request = db.transaction('saves').objectStore('saves').get('primary');\n      request.onsuccess = () => resolve(request.result);\n    });\n    db.close();\n    return value;\n  }","isFunction":true,"arg":{"value":{"v":"undefined"},"handles":[]}}}
