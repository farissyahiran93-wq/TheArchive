xt","v":{"s":"FIND DANIEL · Lucas: Fine."}},{"k":"read","v":{"b":true}}],"id":267},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-02-20"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Let's ask something else."}},{"k":"read","v":{"b":true}}],"id":268},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-02-21"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Lucas, don't start."}},{"k":"read","v":{"b":true}}],"id":269},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-02-22"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: It's a question, Sophie."}},{"k":"read","v":{"b":true}}],"id":270},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-02-23"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Where were you three nights ago?"}},{"k":"read","v":{"b":true}}],"id":271},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-02-24"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Oh, come on."}},{"k":"read","v":{"b":true}}],"id":272},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-02-25"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Lucas!"}},{"k":"read","v":{"b":true}}],"id":273},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-02-26"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: What?"}},{"k":"read","v":{"b":true}}],"id":274},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-02-27"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: We don't know anything about this person."}},{"k":"read","v":{"b":true}}],"id":275},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-02-28"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: And you think asking for an alibi is going to help?"}},{"k":"read","v":{"b":true}}],"id":276},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-02-29"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: It might."}},{"k":"read","v":{"b":true}}],"id":277},{"o":[{"k":"id","v":{"s":"OPEN-S02-C03-a-1"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: See?"}},{"k":"read","v":{"b":true}}],"id":278},{"o":[{"k":"id","v":{"s":"OPEN-S02-C03-a-2"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Already being difficult."}},{"k":"read","v":{"b":true}}],"id":279},{"o":[{"k":"id","v":{"s":"OPEN-S02-C03-a-3"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: No, they're setting a boundary."}},{"k":"read","v":{"b":true}}],"id":280},{"o":[{"k":"id","v":{"s":"OPEN-S02-C03-a-4"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I wouldn't answer that either."}},{"k":"read","v":{"b":true}}],"id":281},{"o":[{"k":"id","v":{"s":"OPEN-S02-C03-a-5"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Of course you wouldn't."}},{"k":"read","v":{"b":true}}],"id":282},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-03-1"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Okay."}},{"k":"read","v":{"b":true}}],"id":283},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-03-2"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Enough with the questions about where people were."}},{"k":"read","v":{"b":true}}],"id":284},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-03-3"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: We barely know who's on the other side of the screen."}},{"k":"read","v":{"b":true}}],"id":285},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-03-4"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Exactly my point."}},{"k":"read","v":{"b":true}}],"id":286},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-03-5"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: No. Your point was to accuse them before we know anything."}},{"k":"read","v":{"b":true}}],"id":287},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-03-6"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: I'm trying to be careful."}},{"k":"read","v":{"b":true}}],"id":288},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-03-7"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Then be careful."}},{"k":"read","v":{"b":true}}],"id":289},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-03-8"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Not cruel."}},{"k":"read","v":{"b":true}}],"id":290},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-03-10"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Can I explain why I thought adding them was a good idea?"}},{"k":"read","v":{"b":true}}],"id":291},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-03-11"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: You could try."}},{"k":"read","v":{"b":true}}],"id":292},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-03-12"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Go ahead, Soph."}},{"k":"read","v":{"b":true}}],"id":293},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-03-13"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I found a saved contact export."}},{"k":"read","v":{"b":true}}],"id":294},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-03-14"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: It's labelled as Daniel's contacts."}},{"k":"read","v":{"b":true}}],"id":295},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-03-15"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I already told you about it."}},{"k":"read","v":{"b":true}}],"id":296},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-03-16"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Right."}},{"k":"read","v":{"b":true}}],"id":297},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-03-17"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: And the number didn't have a name."}},{"k":"read","v":{"b":true}}],"id":298},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-03-18"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: We know."}},{"k":"read","v":{"b":true}}],"id":299},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-03-19"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I'm getting there."}},{"k":"read","v":{"b":true}}],"id":300},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-03-20"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: There was something beside it."}},{"k":"read","v":{"b":true}}],"id":301},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-03-21"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: A star next to the number."}},{"k":"read","v":{"b":true}}],"id":302},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-03-22"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: A favourite contact?"}},{"k":"read","v":{"b":true}}],"id":303},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-03-23"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Maybe. I don't know how that export uses it."}},{"k":"read","v":{"b":true}}],"id":304},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-03-24"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: It just says starred. There's no saved name or label."}},{"k":"read","v":{"b":true}}],"id":305},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-03-25"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Do we even know Daniel was the one who marked it?"}},{"k":"read","v":{"b":true}}],"id":306},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-03-26"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: No. We don't."}},{"k":"read","v":{"b":true}}],"id":307},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-03-27"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I know. I'm not saying he was."}},{"k":"read","v":{"b":true}}],"id":308},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-03-29"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Then what made you contact the number?"}},{"k":"read","v":{"b":true}}],"id":309},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-03-30"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I hoped whoever answered might recognise him."}},{"k":"read","v":{"b":true}}],"id":310},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-03-31"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Did they?"}},{"k":"read","v":{"b":true}}],"id":311},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-03-32"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: No. But I didn't want to shut the door without asking."}},{"k":"read","v":{"b":true}}],"id":312},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-03-34"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: ..."}},{"k":"read","v":{"b":true}}],"id":313},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-03-35"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: So this was a guess?"}},{"k":"read","v":{"b":true}}],"id":314},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-03-36"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: A question. I hoped it might lead somewhere."}},{"k":"read","v":{"b":true}}],"id":315},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-03-37"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: That's different from knowing it would."}},{"k":"read","v":{"b":true}}],"id":316},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-03-38"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: You've been going through a lot of his things."}},{"k":"read","v":{"b":true}}],"id":317},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-03-39"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: We can ask questions without treating the star as proof."}},{"k":"read","v":{"b":true}}],"id":318},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-03-40"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I know."}},{"k":"read","v":{"b":true}}],"id":319},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-03-41"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I just don't want us to stop looking."}},{"k":"read","v":{"b":true}}],"id":320},{"o":[{"k":"id","v":{"s":"OPEN-S02-C04-a-1"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: No. The copy doesn't show who did it."}},{"k":"read","v":{"b":true}}],"id":321},{"o":[{"k":"id","v":{"s":"OPEN-S02-C04-a-2"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I shouldn't have assumed it was Daniel."}},{"k":"read","v":{"b":true}}],"id":322},{"o":[{"k":"id","v":{"s":"OPEN-S02-C04-a-3"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: That's what I've been trying to say."}},{"k":"read","v":{"b":true}}],"id":323},{"o":[{"k":"id","v":{"s":"OPEN-S02-C04-a-4"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Then we keep that question open."}},{"k":"read","v":{"b":true}}],"id":324},{"o":[{"k":"id","v":{"s":"OPEN-S02-C04-a-5"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Yeah. That's fair."}},{"k":"read","v":{"b":true}}],"id":325},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-04-2"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Sophie, can you check something for me?"}},{"k":"read","v":{"b":true}}],"id":326},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-04-3"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Yeah?"}},{"k":"read","v":{"b":true}}],"id":327},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-04-4"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Does the export show when the number was starred?"}},{"k":"read","v":{"b":true}}],"id":328},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-04-5"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: No. Not in the copy I have."}},{"k":"read","v":{"b":true}}],"id":329},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-04-6"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Or who changed it?"}},{"k":"read","v":{"b":true}}],"id":330},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-04-7"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: No. I checked for that too."}},{"k":"read","v":{"b":true}}],"id":331},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-04-8"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Then the star doesn't tell us it was his decision."}},{"k":"read","v":{"b":true}}],"id":332},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-04-9"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Lucas, I am trying."}},{"k":"read","v":{"b":true}}],"id":333},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-04-10"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: I know."}},{"k":"read","v":{"b":true}}],"id":334},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-04-11"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: But we can't keep building theories around things nobody's verified."}},{"k":"read","v":{"b":true}}],"id":335},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-04-12"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: For once, that part is fair."}},{"k":"read","v":{"b":true}}],"id":336},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-04-13"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Okay."}},{"k":"read","v":{"b":true}}],"id":337},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-04-14"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I'll look at it again."}},{"k":"read","v":{"b":true}}],"id":338},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-04-17"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Can we talk about something else for a second?"}},{"k":"read","v":{"b":true}}],"id":339},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-04-18"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Like what?"}},{"k":"read","v":{"b":true}}],"id":340},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-04-19"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Whether anyone's actually eaten today."}},{"k":"read","v":{"b":true}}],"id":341},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-04-20"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Maya..."}},{"k":"read","v":{"b":true}}],"id":342},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-04-21"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: I'm serious."}},{"k":"read","v":{"b":true}}],"id":343},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-04-22"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: You were still awake when I went to bed."}},{"k":"read","v":{"b":true}}],"id":344},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-04-23"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I slept."}},{"k":"read","v":{"b":true}}],"id":345},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-04-24"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: For how long?"}},{"k":"read","v":{"b":true}}],"id":346},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-04-25"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Enough."}},{"k":"read","v":{"b":true}}],"id":347},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-04-26"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: That's not a number."}},{"k":"read","v":{"b":true}}],"id":348},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-04-27"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: You're starting to sound like my mother."}},{"k":"read","v":{"b":true}}],"id":349},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-04-28"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Someone has to."}},{"k":"read","v":{"b":true}}],"id":350},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-04-30"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: I ate."}},{"k":"read","v":{"b":true}}],"id":351},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-04-31"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Congratulations, Lucas."}},{"k":"read","v":{"b":true}}],"id":352},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-04-32"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: You asked."}},{"k":"read","v":{"b":true}}],"id":353},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-04-33"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: I did."}},{"k":"read","v":{"b":true}}],"id":354},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-04-34"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: 😂"}},{"k":"read","v":{"b":true}}],"id":355},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-04-35"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: There. See?"}},{"k":"read","v":{"b":true}}],"id":356},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-04-36"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: She still remembers how to laugh."}},{"k":"read","v":{"b":true}}],"id":357},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-04-37"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Barely."}},{"k":"read","v":{"b":true}}],"id":358},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-04-39"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: It isn't funny."}},{"k":"read","v":{"b":true}}],"id":359},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-04-40"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Nobody said the situation was funny."}},{"k":"read","v":{"b":true}}],"id":360},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-04-41"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Then can we stay focused?"}},{"k":"read","v":{"b":true}}],"id":361},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-04-42"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: We can be worried and still act like human beings."}},{"k":"read","v":{"b":true}}],"id":362},{"o":[{"k":"id","v":{"s":"OPEN-S02-C05-a-1"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Thank you."}},{"k":"read","v":{"b":true}}],"id":363},{"o":[{"k":"id","v":{"s":"OPEN-S02-C05-a-2"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I probably am."}},{"k":"read","v":{"b":true}}],"id":364},{"o":[{"k":"id","v":{"s":"OPEN-S02-C05-a-3"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: I'm fine."}},{"k":"read","v":{"b":true}}],"id":365},{"o":[{"k":"id","v":{"s":"OPEN-S02-C05-a-4"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: That's exactly what an exhausted person would say."}},{"k":"read","v":{"b":true}}],"id":366},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-05-1"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Okay."}},{"k":"read","v":{"b":true}}],"id":367},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-05-2"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I'm getting some water."}},{"k":"read","v":{"b":true}}],"id":368},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-05-3"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Finally."}},{"k":"read","v":{"b":true}}],"id":369},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-05-4"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Don't celebrate yet."}},{"k":"read","v":{"b":true}}],"id":370},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-05-5"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I'll be back in like two minutes."}},{"k":"read","v":{"b":true}}],"id":371},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-05-6"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Progress is progress."}},{"k":"read","v":{"b":true}}],"id":372},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-05-10"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Maya."}},{"k":"read","v":{"b":true}}],"id":373},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-05-11"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: What?"}},{"k":"read","v":{"b":true}}],"id":374},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-05-12"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: You're being awfully relaxed about this."}},{"k":"read","v":{"b":true}}],"id":375},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-05-13"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: About what?"}},{"k":"read","v":{"b":true}}],"id":376},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-05-14"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: This person."}},{"k":"read","v":{"b":true}}],"id":377},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-05-15"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: I'm not relaxed."}},{"k":"read","v":{"b":true}}],"id":378},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-05-16"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: You're joking with them."}},{"k":"read","v":{"b":true}}],"id":379},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-05-17"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: That doesn't mean I trust them."}},{"k":"read","v":{"b":true}}],"id":380},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-05-19"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Good."}},{"k":"read","v":{"b":true}}],"id":381},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-05-20"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Because I don't."}},{"k":"read","v":{"b":true}}],"id":382},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-05-21"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: You made that pretty clear."}},{"k":"read","v":{"b":true}}],"id":383},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-05-22"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: I don't understand why Sophie is doing this."}},{"k":"read","v":{"b":true}}],"id":384},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-05-23"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: She's scared."}},{"k":"read","v":{"b":true}}],"id":385},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-05-24"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: We're all scared."}},{"k":"read","v":{"b":true}}],"id":386},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-05-25"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: I know."}},{"k":"read","v":{"b":true}}],"id":387},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-05-26"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: And that doesn't mean we invite strangers into everything."}},{"k":"read","v":{"b":true}}],"id":388},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-05-28"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: You're still here, by the way."}},{"k":"read","v":{"b":true}}],"id":389},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-05-29"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: What?"}},{"k":"read","v":{"b":true}}],"id":390},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-05-30"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: The person you're talking about."}},{"k":"read","v":{"b":true}}],"id":391},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-05-31"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: They're still in the group."}},{"k":"read","v":{"b":true}}],"id":392},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-05-32"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: I know."}},{"k":"read","v":{"b":true}}],"id":393},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-05-33"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Then maybe stop talking about them like they aren't."}},{"k":"read","v":{"b":true}}],"id":394},{"o":[{"k":"id","v":{"s":"OPEN-S02-C06-a-1"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Exactly."}},{"k":"read","v":{"b":true}}],"id":395},{"o":[{"k":"id","v":{"s":"OPEN-S02-C06-a-2"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: I wasn't trying to hide it."}},{"k":"read","v":{"b":true}}],"id":396},{"o":[{"k":"id","v":{"s":"OPEN-S02-C06-a-4"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Lucas, just stop digging."}},{"k":"read","v":{"b":true}}],"id":397},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-06-2"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Listen."}},{"k":"read","v":{"b":true}}],"id":398},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-06-3"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: I'm not going to pretend this isn't strange."}},{"k":"read","v":{"b":true}}],"id":399},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-06-4"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: I don't know you."}},{"k":"read","v":{"b":true}}],"id":400},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-06-5"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: And I don't know what your number means."}},{"k":"read","v":{"b":true}}],"id":401},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-06-6"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: But I also don't think it's fair to assume the worst just because we don't have an answer."}},{"k":"read","v":{"b":true}}],"id":402},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-06-7"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: That goes both ways."}},{"k":"read","v":{"b":true}}],"id":403},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-06-8"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: It does."}},{"k":"read","v":{"b":true}}],"id":404},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-06-9"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Fine."}},{"k":"read","v":{"b":true}}],"id":405},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-06-11"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Then answer one thing."}},{"k":"read","v":{"b":true}}],"id":406},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-06-12"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Why are you still here?"}},{"k":"read","v":{"b":true}}],"id":407},{"o":[{"k":"id","v":{"s":"OPEN-S02-C07-a-1"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Okay."}},{"k":"read","v":{"b":true}}],"id":408},{"o":[{"k":"id","v":{"s":"OPEN-S02-C07-a-2"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: That's a fair answer."}},{"k":"read","v":{"b":true}}],"id":409},{"o":[{"k":"id","v":{"s":"OPEN-S02-C07-a-3"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: You're going to need a better reason eventually."}},{"k":"read","v":{"b":true}}],"id":410},{"o":[{"k":"id","v":{"s":"OPEN-S02-C07-a-4"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: They don't owe us a lifelong commitment, Lucas."}},{"k":"read","v":{"b":true}}],"id":411},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-2"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Okay, I'm back."}},{"k":"read","v":{"b":true}}],"id":412},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-3"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: What did I miss?"}},{"k":"read","v":{"b":true}}],"id":413},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-4"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Nothing."}},{"k":"read","v":{"b":true}}],"id":414},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-5"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Plenty."}},{"k":"read","v":{"b":true}}],"id":415},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-6"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: ..."}},{"k":"read","v":{"b":true}}],"id":416},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-7"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Oh no."}},{"k":"read","v":{"b":true}}],"id":417},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-8"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Please tell me you didn't start another argument."}},{"k":"read","v":{"b":true}}],"id":418},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-9"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: We were having a conversation."}},{"k":"read","v":{"b":true}}],"id":419},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-10"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: A very educational one."}},{"k":"read","v":{"b":true}}],"id":420},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-11"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Lucas."}},{"k":"read","v":{"b":true}}],"id":421},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-12"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Sophie."}},{"k":"read","v":{"b":true}}],"id":422},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-13"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Children."}},{"k":"read","v":{"b":true}}],"id":423},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-14"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: 🙄"}},{"k":"read","v":{"b":true}}],"id":424},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-16"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Look, I know adding someone without asking wasn't ideal."}},{"k":"read","v":{"b":true}}],"id":425},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-17"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: It wasn't ideal?"}},{"k":"read","v":{"b":true}}],"id":426},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-18"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Fine."}},{"k":"read","v":{"b":true}}],"id":427},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-19"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: It was a bad call."}},{"k":"read","v":{"b":true}}],"id":428},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-20"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Is that what you want me to say?"}},{"k":"read","v":{"b":true}}],"id":429},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-21"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: I want you to understand why it was a bad call."}},{"k":"read","v":{"b":true}}],"id":430},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-22"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I understand."}},{"k":"read","v":{"b":true}}],"id":431},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-23"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Then why did you do it?"}},{"k":"read","v":{"b":true}}],"id":432},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-24"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Because I'm tired of sitting here doing nothing!"}},{"k":"read","v":{"b":true}}],"id":433},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-26"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Sorry."}},{"k":"read","v":{"b":true}}],"id":434},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-27"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I didn't mean to snap."}},{"k":"read","v":{"b":true}}],"id":435},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-28"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: It's okay."}},{"k":"read","v":{"b":true}}],"id":436},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-29"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: No, it's not."}},{"k":"read","v":{"b":true}}],"id":437},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-30"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Lucas..."}},{"k":"read","v":{"b":true}}],"id":438},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-31"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: We're making decisions because we're scared."}},{"k":"read","v":{"b":true}}],"id":439},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-32"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: And we don't even know what we're risking."}},{"k":"read","v":{"b":true}}],"id":440},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-33"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I know!"}},{"k":"read","v":{"b":true}}],"id":441},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-34"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Do you think I don't think about that?"}},{"k":"read","v":{"b":true}}],"id":442},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-07-35"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Then start acting like it."}},{"k":"read","v":{"b":true}}],"id":443},{"o":[{"k":"id","v":{"s":"OPEN-S02-C08-d-1"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Honestly?"}},{"k":"read","v":{"b":true}}],"id":444},{"o":[{"k":"id","v":{"s":"OPEN-S02-C08-d-2"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: We probably should have done that earlier."}},{"k":"read","v":{"b":true}}],"id":445},{"o":[{"k":"id","v":{"s":"OPEN-S02-C08-d-3"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Maya..."}},{"k":"read","v":{"b":true}}],"id":446},{"o":[{"k":"id","v":{"s":"OPEN-S02-C08-d-4"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: I'm not blaming you."}},{"k":"read","v":{"b":true}}],"id":447},{"o":[{"k":"id","v":{"s":"OPEN-S02-C08-d-5"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: I'm saying we should've agreed on what to do before involving someone else."}},{"k":"read","v":{"b":true}}],"id":448},{"o":[{"k":"id","v":{"s":"OPEN-S02-C08-d-6"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Finally."}},{"k":"read","v":{"b":true}}],"id":449},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-2"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Fine."}},{"k":"read","v":{"b":true}}],"id":450},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-3"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: What do you want me to do?"}},{"k":"read","v":{"b":true}}],"id":451},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-4"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: I want us to stop sharing things until we know who we're sharing them with."}},{"k":"read","v":{"b":true}}],"id":452},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-5"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: That seems reasonable."}},{"k":"read","v":{"b":true}}],"id":453},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-6"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: So what?"}},{"k":"read","v":{"b":true}}],"id":454},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-7"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: We just ignore the number?"}},{"k":"read","v":{"b":true}}],"id":455},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-8"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: No."}},{"k":"read","v":{"b":true}}],"id":456},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-9"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: We verify it."}},{"k":"read","v":{"b":true}}],"id":457},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-10"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: How?"}},{"k":"read","v":{"b":true}}],"id":458},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-11"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: I don't know yet."}},{"k":"read","v":{"b":true}}],"id":459},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-12"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Exactly."}},{"k":"read","v":{"b":true}}],"id":460},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-13"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Not knowing how to do something doesn't mean we should do the first thing that comes to mind."}},{"k":"read","v":{"b":true}}],"id":461},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-14"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: And waiting doesn't guarantee we'll learn anything!"}},{"k":"read","v":{"b":true}}],"id":462},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-16"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Can both of you stop for a second?"}},{"k":"read","v":{"b":true}}],"id":463},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-17"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Sorry."}},{"k":"read","v":{"b":true}}],"id":464},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-18"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: I'm listening."}},{"k":"read","v":{"b":true}}],"id":465},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-19"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Nobody here knows what happened to Daniel."}},{"k":"read","v":{"b":true}}],"id":466},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-08-20"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: We keep going in circles."}},{"k":"read","v