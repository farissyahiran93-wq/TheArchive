NING-3"}},{"k":"text","v":{"s":"Unknown number: Sorry, is this a bad time?"}},{"k":"read","v":{"b":true}}],"id":134},{"o":[{"k":"id","v":{"s":"OPEN-S01-OPENING-5"}},{"k":"text","v":{"s":"Unknown number: Actually"}},{"k":"read","v":{"b":true}}],"id":135},{"o":[{"k":"id","v":{"s":"OPEN-S01-OPENING-6"}},{"k":"text","v":{"s":"Unknown number: I'm not even sure I have the right number 😅"}},{"k":"read","v":{"b":true}}],"id":136},{"o":[{"k":"id","v":{"s":"OPEN-S01-OPENING-8"}},{"k":"text","v":{"s":"Unknown number: Could you just reply when you see this?"}},{"k":"read","v":{"b":true}}],"id":137},{"o":[{"k":"id","v":{"s":"OPEN-S01-C01-a-1"}},{"k":"text","v":{"s":"Unknown number: Oh, right."}},{"k":"read","v":{"b":true}}],"id":138},{"o":[{"k":"id","v":{"s":"OPEN-S01-C01-a-2"}},{"k":"text","v":{"s":"Unknown number: Sorry."}},{"k":"read","v":{"b":true}}],"id":139},{"o":[{"k":"id","v":{"s":"OPEN-S01-C01-a-3"}},{"k":"text","v":{"s":"Sophie: I'm Sophie."}},{"k":"read","v":{"b":true}}],"id":140},{"o":[{"k":"id","v":{"s":"OPEN-S01-C01-a-4"}},{"k":"text","v":{"s":"Sophie: I probably should've started with that."}},{"k":"read","v":{"b":true}}],"id":141},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-01-1"}},{"k":"text","v":{"s":"Sophie: Can I ask you something?"}},{"k":"read","v":{"b":true}}],"id":142},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-01-2"}},{"k":"text","v":{"s":"Sophie: And I promise I'm not selling anything."}},{"k":"read","v":{"b":true}}],"id":143},{"o":[{"k":"id","v":{"s":"OPEN-S01-C02-a-1"}},{"k":"text","v":{"s":"Sophie: Thanks."}},{"k":"read","v":{"b":true}}],"id":144},{"o":[{"k":"id","v":{"s":"OPEN-S01-C02-a-2"}},{"k":"text","v":{"s":"Sophie: Okay, this might sound strange."}},{"k":"read","v":{"b":true}}],"id":145},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-02-1"}},{"k":"text","v":{"s":"Sophie: Okay."}},{"k":"read","v":{"b":true}}],"id":146},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-02-2"}},{"k":"text","v":{"s":"Sophie: I found your number in a saved copy of someone's contacts."}},{"k":"read","v":{"b":true}}],"id":147},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-02-3"}},{"k":"text","v":{"s":"Sophie: There wasn't a name attached to it."}},{"k":"read","v":{"b":true}}],"id":148},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-02-4"}},{"k":"text","v":{"s":"Sophie: Just the number."}},{"k":"read","v":{"b":true}}],"id":149},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-02-5"}},{"k":"text","v":{"s":"Sophie: And a star next to it."}},{"k":"read","v":{"b":true}}],"id":150},{"o":[{"k":"id","v":{"s":"OPEN-S01-C03-a-1"}},{"k":"text","v":{"s":"Sophie: Yeah. That's what caught my eye."}},{"k":"read","v":{"b":true}}],"id":151},{"o":[{"k":"id","v":{"s":"OPEN-S01-C03-a-2"}},{"k":"text","v":{"s":"Sophie: I don't know what it means."}},{"k":"read","v":{"b":true}}],"id":152},{"o":[{"k":"id","v":{"s":"OPEN-S01-C03-a-3"}},{"k":"text","v":{"s":"Sophie: I was hoping you might."}},{"k":"read","v":{"b":true}}],"id":153},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-03-1"}},{"k":"text","v":{"s":"Sophie: The copy is labelled as Daniel's contact export."}},{"k":"read","v":{"b":true}}],"id":154},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-03-3"}},{"k":"text","v":{"s":"Sophie: Daniel Mercer."}},{"k":"read","v":{"b":true}}],"id":155},{"o":[{"k":"id","v":{"s":"OPEN-S01-C04-a-1"}},{"k":"text","v":{"s":"Sophie: Okay."}},{"k":"read","v":{"b":true}}],"id":156},{"o":[{"k":"id","v":{"s":"OPEN-S01-C04-a-2"}},{"k":"text","v":{"s":"Sophie: That's what I was afraid you'd say."}},{"k":"read","v":{"b":true}}],"id":157},{"o":[{"k":"id","v":{"s":"OPEN-S01-C04-a-3"}},{"k":"text","v":{"s":"Sophie: Not that it's your fault."}},{"k":"read","v":{"b":true}}],"id":158},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-04-1"}},{"k":"text","v":{"s":"Sophie: Can I ask if you've ever spoken to anyone called Daniel?"}},{"k":"read","v":{"b":true}}],"id":159},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-04-2"}},{"k":"text","v":{"s":"Sophie: Even online?"}},{"k":"read","v":{"b":true}}],"id":160},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-04-3"}},{"k":"text","v":{"s":"Sophie: Maybe a long time ago?"}},{"k":"read","v":{"b":true}}],"id":161},{"o":[{"k":"id","v":{"s":"OPEN-S01-C05-a-1"}},{"k":"text","v":{"s":"Sophie: Okay."}},{"k":"read","v":{"b":true}}],"id":162},{"o":[{"k":"id","v":{"s":"OPEN-S01-C05-a-2"}},{"k":"text","v":{"s":"Sophie: Thanks for being clear."}},{"k":"read","v":{"b":true}}],"id":163},{"o":[{"k":"id","v":{"s":"OPEN-S01-C05-a-3"}},{"k":"text","v":{"s":"Sophie: That makes this even stranger, though."}},{"k":"read","v":{"b":true}}],"id":164},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-05-1"}},{"k":"text","v":{"s":"Sophie: Anyway."}},{"k":"read","v":{"b":true}}],"id":165},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-05-2"}},{"k":"text","v":{"s":"Sophie: If you don't know him, then I guess that answers one question."}},{"k":"read","v":{"b":true}}],"id":166},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-05-4"}},{"k":"text","v":{"s":"Sophie: Just not the one I really wanted answered."}},{"k":"read","v":{"b":true}}],"id":167},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-05-5"}},{"k":"text","v":{"s":"Sophie: Sorry."}},{"k":"read","v":{"b":true}}],"id":168},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-05-6"}},{"k":"text","v":{"s":"Sophie: I keep making this awkward."}},{"k":"read","v":{"b":true}}],"id":169},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-05-7"}},{"k":"text","v":{"s":"Sophie: You probably have better things to do than talk to a stranger."}},{"k":"read","v":{"b":true}}],"id":170},{"o":[{"k":"id","v":{"s":"OPEN-S01-C06-a-1"}},{"k":"text","v":{"s":"Sophie: Why your number was saved."}},{"k":"read","v":{"b":true}}],"id":171},{"o":[{"k":"id","v":{"s":"OPEN-S01-C06-a-2"}},{"k":"text","v":{"s":"Sophie: Whether Daniel knew you."}},{"k":"read","v":{"b":true}}],"id":172},{"o":[{"k":"id","v":{"s":"OPEN-S01-C06-a-3"}},{"k":"text","v":{"s":"Sophie: Whether you'd heard from him recently."}},{"k":"read","v":{"b":true}}],"id":173},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-06-2"}},{"k":"text","v":{"s":"Sophie: Daniel hasn't been answering anyone."}},{"k":"read","v":{"b":true}}],"id":174},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-06-3"}},{"k":"text","v":{"s":"Sophie: Calls, messages..."}},{"k":"read","v":{"b":true}}],"id":175},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-06-4"}},{"k":"text","v":{"s":"Sophie: Nothing."}},{"k":"read","v":{"b":true}}],"id":176},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-06-6"}},{"k":"text","v":{"s":"Sophie: For days."}},{"k":"read","v":{"b":true}}],"id":177},{"o":[{"k":"id","v":{"s":"OPEN-S01-C07-a-1"}},{"k":"text","v":{"s":"Sophie: I thought that too."}},{"k":"read","v":{"b":true}}],"id":178},{"o":[{"k":"id","v":{"s":"OPEN-S01-C07-a-2"}},{"k":"text","v":{"s":"Sophie: At first."}},{"k":"read","v":{"b":true}}],"id":179},{"o":[{"k":"id","v":{"s":"OPEN-S01-C07-a-3"}},{"k":"text","v":{"s":"Sophie: But it's gone on longer than anyone expected."}},{"k":"read","v":{"b":true}}],"id":180},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-07-1"}},{"k":"text","v":{"s":"Sophie: Sorry."}},{"k":"read","v":{"b":true}}],"id":181},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-07-2"}},{"k":"text","v":{"s":"Sophie: I shouldn't have dropped all that on you."}},{"k":"read","v":{"b":true}}],"id":182},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-07-3"}},{"k":"text","v":{"s":"Sophie: We don't even know each other."}},{"k":"read","v":{"b":true}}],"id":183},{"o":[{"k":"id","v":{"s":"OPEN-S01-C08-a-1"}},{"k":"text","v":{"s":"Sophie: Alex."}},{"k":"read","v":{"b":true}}],"id":184},{"o":[{"k":"id","v":{"s":"OPEN-S01-C08-a-2"}},{"k":"text","v":{"s":"Sophie: Okay. Nice to meet you."}},{"k":"read","v":{"b":true}}],"id":185},{"o":[{"k":"id","v":{"s":"OPEN-S01-C08-a-3"}},{"k":"text","v":{"s":"Sophie: Under very strange circumstances. 😅"}},{"k":"read","v":{"b":true}}],"id":186},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-08-1"}},{"k":"text","v":{"s":"Sophie: Can I be honest about something?"}},{"k":"read","v":{"b":true}}],"id":187},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-08-2"}},{"k":"text","v":{"s":"Sophie: I almost deleted your number before messaging you."}},{"k":"read","v":{"b":true}}],"id":188},{"o":[{"k":"id","v":{"s":"OPEN-S01-C09-a-1"}},{"k":"text","v":{"s":"Sophie: I kept thinking about the fact that it had been saved."}},{"k":"read","v":{"b":true}}],"id":189},{"o":[{"k":"id","v":{"s":"OPEN-S01-C09-a-2"}},{"k":"text","v":{"s":"Sophie: There had to be a reason."}},{"k":"read","v":{"b":true}}],"id":190},{"o":[{"k":"id","v":{"s":"OPEN-S01-C09-a-3"}},{"k":"text","v":{"s":"Sophie: Or at least I hoped there was."}},{"k":"read","v":{"b":true}}],"id":191},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-09-1"}},{"k":"text","v":{"s":"Sophie: Anyway."}},{"k":"read","v":{"b":true}}],"id":192},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-09-2"}},{"k":"text","v":{"s":"Sophie: I should probably let you go."}},{"k":"read","v":{"b":true}}],"id":193},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-09-3"}},{"k":"text","v":{"s":"Sophie: You've already been more patient than I expected."}},{"k":"read","v":{"b":true}}],"id":194},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-09-7"}},{"k":"text","v":{"s":"Sophie: Actually, wait."}},{"k":"read","v":{"b":true}}],"id":195},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-09-8"}},{"k":"text","v":{"s":"Sophie: There's something else."}},{"k":"read","v":{"b":true}}],"id":196},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-09-9"}},{"k":"text","v":{"s":"Sophie: I wasn't sure if I should mention it."}},{"k":"read","v":{"b":true}}],"id":197},{"o":[{"k":"id","v":{"s":"OPEN-S01-C10-a-1"}},{"k":"text","v":{"s":"Sophie: Okay."}},{"k":"read","v":{"b":true}}],"id":198},{"o":[{"k":"id","v":{"s":"OPEN-S01-C10-a-2"}},{"k":"text","v":{"s":"Sophie: Just give me a second."}},{"k":"read","v":{"b":true}}],"id":199},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-10-1"}},{"k":"text","v":{"s":"Sophie: I'm not the only one trying to understand what happened."}},{"k":"read","v":{"b":true}}],"id":200},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-10-2"}},{"k":"text","v":{"s":"Sophie: There are a few other people."}},{"k":"read","v":{"b":true}}],"id":201},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-10-3"}},{"k":"text","v":{"s":"Sophie: People who know Daniel."}},{"k":"read","v":{"b":true}}],"id":202},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-10-4"}},{"k":"text","v":{"s":"Sophie: We've been talking."}},{"k":"read","v":{"b":true}}],"id":203},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-10-5"}},{"k":"text","v":{"s":"Sophie: Although \"talking\" might be a generous way of putting it lately."}},{"k":"read","v":{"b":true}}],"id":204},{"o":[{"k":"id","v":{"s":"OPEN-S01-C11-a-1"}},{"k":"text","v":{"s":"Sophie: Everyone has their own idea of what we should do."}},{"k":"read","v":{"b":true}}],"id":205},{"o":[{"k":"id","v":{"s":"OPEN-S01-C11-a-2"}},{"k":"text","v":{"s":"Sophie: And no one seems to agree."}},{"k":"read","v":{"b":true}}],"id":206},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-11-1"}},{"k":"text","v":{"s":"Sophie: There's a group chat."}},{"k":"read","v":{"b":true}}],"id":207},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-11-2"}},{"k":"text","v":{"s":"Sophie: We've been using it to keep track of things."}},{"k":"read","v":{"b":true}}],"id":208},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-11-3"}},{"k":"text","v":{"s":"Sophie: Well..."}},{"k":"read","v":{"b":true}}],"id":209},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-11-4"}},{"k":"text","v":{"s":"Sophie: Trying to."}},{"k":"read","v":{"b":true}}],"id":210},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-11-5"}},{"k":"text","v":{"s":"Sophie: I was thinking..."}},{"k":"read","v":{"b":true}}],"id":211},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-11-7"}},{"k":"text","v":{"s":"Sophie: Maybe you could join us?"}},{"k":"read","v":{"b":true}}],"id":212},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-11-8"}},{"k":"text","v":{"s":"Sophie: Just for a little while."}},{"k":"read","v":{"b":true}}],"id":213},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-11-9"}},{"k":"text","v":{"s":"Sophie: You don't have to do anything."}},{"k":"read","v":{"b":true}}],"id":214},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-11-10"}},{"k":"text","v":{"s":"Sophie: You could just listen."}},{"k":"read","v":{"b":true}}],"id":215},{"o":[{"k":"id","v":{"s":"OPEN-S01-C12-a-1"}},{"k":"text","v":{"s":"Sophie: That's a very good question."}},{"k":"read","v":{"b":true}}],"id":216},{"o":[{"k":"id","v":{"s":"OPEN-S01-C12-a-2"}},{"k":"text","v":{"s":"Sophie: And I don't have a very convincing answer."}},{"k":"read","v":{"b":true}}],"id":217},{"o":[{"k":"id","v":{"s":"OPEN-S01-C12-a-3"}},{"k":"text","v":{"s":"Sophie: I just thought maybe you'd notice something we missed."}},{"k":"read","v":{"b":true}}],"id":218},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-12-1"}},{"k":"text","v":{"s":"Sophie: Look."}},{"k":"read","v":{"b":true}}],"id":219},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-12-2"}},{"k":"text","v":{"s":"Sophie: I'm not asking you to solve anything."}},{"k":"read","v":{"b":true}}],"id":220},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-12-3"}},{"k":"text","v":{"s":"Sophie: And I don't expect you to believe everything I'm saying."}},{"k":"read","v":{"b":true}}],"id":221},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-12-4"}},{"k":"text","v":{"s":"Sophie: I'd be suspicious too."}},{"k":"read","v":{"b":true}}],"id":222},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-12-5"}},{"k":"text","v":{"s":"Sophie: But if there's even a small chance your number means something..."}},{"k":"read","v":{"b":true}}],"id":223},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-12-6"}},{"k":"text","v":{"s":"Sophie: I don't want to ignore it."}},{"k":"read","v":{"b":true}}],"id":224},{"o":[{"k":"id","v":{"s":"OPEN-S01-C13-a-1"}},{"k":"text","v":{"s":"Sophie: Really?"}},{"k":"read","v":{"b":true}}],"id":225},{"o":[{"k":"id","v":{"s":"OPEN-S01-C13-a-2"}},{"k":"text","v":{"s":"Sophie: Okay."}},{"k":"read","v":{"b":true}}],"id":226},{"o":[{"k":"id","v":{"s":"OPEN-S01-C13-a-3"}},{"k":"text","v":{"s":"Sophie: Thank you."}},{"k":"read","v":{"b":true}}],"id":227},{"o":[{"k":"id","v":{"s":"OPEN-S01-C13-a-4"}},{"k":"text","v":{"s":"Sophie: I'll send you an invite."}},{"k":"read","v":{"b":true}}],"id":228},{"o":[{"k":"id","v":{"s":"OPEN-S01-WARNING-1"}},{"k":"text","v":{"s":"Sophie: Okay, before you join..."}},{"k":"read","v":{"b":true}}],"id":229},{"o":[{"k":"id","v":{"s":"OPEN-S01-WARNING-2"}},{"k":"text","v":{"s":"Sophie: Just so you know."}},{"k":"read","v":{"b":true}}],"id":230},{"o":[{"k":"id","v":{"s":"OPEN-S01-WARNING-3"}},{"k":"text","v":{"s":"Sophie: Not everyone in there is as friendly as me."}},{"k":"read","v":{"b":true}}],"id":231},{"o":[{"k":"id","v":{"s":"OPEN-S01-WARNING-5"}},{"k":"text","v":{"s":"Sophie: Wow. That sounded incredibly arrogant."}},{"k":"read","v":{"b":true}}],"id":232},{"o":[{"k":"id","v":{"s":"OPEN-S01-WARNING-6"}},{"k":"text","v":{"s":"Sophie: You know what I mean. 😅"}},{"k":"read","v":{"b":true}}],"id":233},{"o":[{"k":"id","v":{"s":"OPEN-S01-C14-a-1"}},{"k":"text","v":{"s":"Sophie: Good."}},{"k":"read","v":{"b":true}}],"id":234},{"o":[{"k":"id","v":{"s":"OPEN-S01-C14-a-2"}},{"k":"text","v":{"s":"Sophie: Because I can't guarantee a warm welcome."}},{"k":"read","v":{"b":true}}],"id":235},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-14-1"}},{"k":"text","v":{"s":"Sophie: Anyway."}},{"k":"read","v":{"b":true}}],"id":236},{"o":[{"k":"id","v":{"s":"OPEN-S01-AFTER-14-2"}},{"k":"text","v":{"s":"Sophie: Here goes nothing."}},{"k":"read","v":{"b":true}}],"id":237},{"o":[{"k":"id","v":{"s":"OPEN-S01-INVITATION"}},{"k":"text","v":{"s":"Sophie sent a group invitation"}},{"k":"read","v":{"b":true}}],"id":238},{"o":[{"k":"id","v":{"s":"OPEN-S02-OPENING-2"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Hey, everyone."}},{"k":"read","v":{"b":false}}],"id":239},{"o":[{"k":"id","v":{"s":"OPEN-S02-OPENING-4"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Before anyone says anything..."}},{"k":"read","v":{"b":false}}],"id":240},{"o":[{"k":"id","v":{"s":"OPEN-S02-OPENING-5"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I added someone."}},{"k":"read","v":{"b":false}}],"id":241},{"o":[{"k":"id","v":{"s":"OPEN-S02-OPENING-6"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: You added someone?"}},{"k":"read","v":{"b":false}}],"id":242},{"o":[{"k":"id","v":{"s":"OPEN-S02-OPENING-7"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Yes."}},{"k":"read","v":{"b":false}}],"id":243},{"o":[{"k":"id","v":{"s":"OPEN-S02-OPENING-8"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Sophie."}},{"k":"read","v":{"b":false}}],"id":244},{"o":[{"k":"id","v":{"s":"OPEN-S02-OPENING-9"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: We literally talked about this."}},{"k":"read","v":{"b":false}}],"id":245},{"o":[{"k":"id","v":{"s":"OPEN-S02-OPENING-10"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: I know."}},{"k":"read","v":{"b":false}}],"id":246},{"o":[{"k":"id","v":{"s":"OPEN-S02-OPENING-11"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Who?"}},{"k":"read","v":{"b":false}}],"id":247},{"o":[{"k":"id","v":{"s":"OPEN-S02-OPENING-13"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Who did you add?"}},{"k":"read","v":{"b":false}}],"id":248},{"o":[{"k":"id","v":{"s":"OPEN-S02-OPENING-14"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: The number I told you about."}},{"k":"read","v":{"b":false}}],"id":249},{"o":[{"k":"id","v":{"s":"OPEN-S02-OPENING-15"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Wait."}},{"k":"read","v":{"b":false}}],"id":250},{"o":[{"k":"id","v":{"s":"OPEN-S02-OPENING-16"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: You actually contacted it?"}},{"k":"read","v":{"b":false}}],"id":251},{"o":[{"k":"id","v":{"s":"OPEN-S02-OPENING-17"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Yeah."}},{"k":"read","v":{"b":false}}],"id":252},{"o":[{"k":"id","v":{"s":"OPEN-S02-OPENING-18"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: You've got to be kidding me."}},{"k":"read","v":{"b":false}}],"id":253},{"o":[{"k":"id","v":{"s":"OPEN-S02-OPENING-19"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Lucas, please."}},{"k":"read","v":{"b":false}}],"id":254},{"o":[{"k":"id","v":{"s":"OPEN-S02-OPENING-20"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Please what?"}},{"k":"read","v":{"b":false}}],"id":255},{"o":[{"k":"id","v":{"s":"OPEN-S02-OPENING-21"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: We don't even know who this is."}},{"k":"read","v":{"b":false}}],"id":256},{"o":[{"k":"id","v":{"s":"OPEN-S02-OPENING-22"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Can we just calm down for a second?"}},{"k":"read","v":{"b":false}}],"id":257},{"o":[{"k":"id","v":{"s":"OPEN-S02-OPENING-23"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: I'm calm."}},{"k":"read","v":{"b":false}}],"id":258},{"o":[{"k":"id","v":{"s":"OPEN-S02-OPENING-24"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: You're really not."}},{"k":"read","v":{"b":false}}],"id":259},{"o":[{"k":"id","v":{"s":"OPEN-S02-OPENING-25"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Fine."}},{"k":"read","v":{"b":false}}],"id":260},{"o":[{"k":"id","v":{"s":"OPEN-S02-OPENING-26"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Then maybe our new guest would like to explain why they're here."}},{"k":"read","v":{"b":false}}],"id":261},{"o":[{"k":"id","v":{"s":"OPEN-S02-C01-a-1"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Great."}},{"k":"read","v":{"b":false}}],"id":262},{"o":[{"k":"id","v":{"s":"OPEN-S02-C01-a-2"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: That makes two of us."}},{"k":"read","v":{"b":false}}],"id":263},{"o":[{"k":"id","v":{"s":"OPEN-S02-C01-a-3"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: At least they're being honest."}},{"k":"read","v":{"b":false}}],"id":264},{"o":[{"k":"id","v":{"s":"OPEN-S02-C01-a-4"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Or they know how to sound honest."}},{"k":"read","v":{"b":false}}],"id":265},{"o":[{"k":"id","v":{"s":"OPEN-S02-C01-a-5"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Lucas."}},{"k":"read","v":{"b":false}}],"id":266},{"o":[{"k":"id","v":{"s":"OPEN-S02-C01-a-6"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: What?"}},{"k":"read","v":{"b":false}}],"id":267},{"o":[{"k":"id","v":{"s":"OPEN-S02-C01-a-7"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: I'm allowed to have questions."}},{"k":"read","v":{"b":false}}],"id":268},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-01-2"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Alright."}},{"k":"read","v":{"b":false}}],"id":269},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-01-3"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Let's start with something simple."}},{"k":"read","v":{"b":false}}],"id":270},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-01-4"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Do you know Daniel?"}},{"k":"read","v":{"b":false}}],"id":271},{"o":[{"k":"id","v":{"s":"OPEN-S02-C02-a-1"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Then why was your number saved?"}},{"k":"read","v":{"b":false}}],"id":272},{"o":[{"k":"id","v":{"s":"OPEN-S02-C02-a-3"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Fair enough."}},{"k":"read","v":{"b":false}}],"id":273},{"o":[{"k":"id","v":{"s":"OPEN-S02-C02-a-4"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: See? That's why I added them."}},{"k":"read","v":{"b":false}}],"id":274},{"o":[{"k":"id","v":{"s":"OPEN-S02-C02-a-5"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: That doesn't answer anything."}},{"k":"read","v":{"b":false}}],"id":275},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-02-1"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: So let me get this straight."}},{"k":"read","v":{"b":false}}],"id":276},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-02-2"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Daniel had your number."}},{"k":"read","v":{"b":false}}],"id":277},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-02-3"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: You don't know Daniel."}},{"k":"read","v":{"b":false}}],"id":278},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-02-4"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: And you have absolutely no idea why he saved it."}},{"k":"read","v":{"b":false}}],"id":279},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-02-5"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: That's what we're trying to figure out."}},{"k":"read","v":{"b":false}}],"id":280},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-02-6"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Doesn't that seem a little convenient to anyone else?"}},{"k":"read","v":{"b":false}}],"id":281},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-02-7"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Convenient for who?"}},{"k":"read","v":{"b":false}}],"id":282},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-02-8"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: I don't know, Maya."}},{"k":"read","v":{"b":false}}],"id":283},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-02-9"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: That's the problem."}},{"k":"read","v":{"b":false}}],"id":284},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-02-11"}},{"k":"text","v":{"s":"FIND DANIEL · Sophie: Maybe he saved the wrong number."}},{"k":"read","v":{"b":false}}],"id":285},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-02-12"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: Possible."}},{"k":"read","v":{"b":false}}],"id":286},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-02-13"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Sure."}},{"k":"read","v":{"b":false}}],"id":287},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-02-14"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: And maybe this is all one big misunderstanding."}},{"k":"read","v":{"b":false}}],"id":288},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-02-15"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: It could be."}},{"k":"read","v":{"b":false}}],"id":289},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-02-16"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: You don't actually believe that."}},{"k":"read","v":{"b":false}}],"id":290},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-02-17"}},{"k":"text","v":{"s":"FIND DANIEL · Maya: I believe we don't have enough information."}},{"k":"read","v":{"b":false}}],"id":291},{"o":[{"k":"id","v":{"s":"OPEN-S02-AFTER-02-19"}},{"k":"text","v":{"s":"FIND DANIEL · Lucas: Fine."}},{"k":"read","v":{"b":false}}],"id":2